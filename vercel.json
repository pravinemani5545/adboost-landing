{
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://app.cal.com https://cal.com https://admin.adboost.health; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://admin.adboost.health https://app.cal.com https://cal.com; frame-src https://app.cal.com https://cal.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https://app.cal.com; frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/(logos|ads|people|og)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/blog/(.*)\\.(webp|jpg|jpeg|png|avif|svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(favicon.ico|favicon.png|apple-touch-icon.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "adboost-landing.vercel.app"
        }
      ],
      "destination": "https://www.adboost.health/:path",
      "permanent": true
    },
    {
      "source": "/protocol/",
      "destination": "/zero-ban-protocol/",
      "permanent": true
    },
    {
      "source": "/free/zero-ban-protocol/",
      "destination": "/zero-ban-protocol/",
      "permanent": true
    },
    {
      "source": "/free/zero-ban-protocol/checklist/",
      "destination": "/zero-ban-protocol/checklist/",
      "permanent": true
    },
    {
      "source": "/case-studies",
      "destination": "/industries/",
      "permanent": true
    },
    {
      "source": "/case-studies/:path(.*)",
      "destination": "/industries/",
      "permanent": true
    },
    {
      "source": "/services/compliance",
      "destination": "/services/",
      "permanent": true
    },
    {
      "source": "/services/compliance/:path(.*)",
      "destination": "/services/",
      "permanent": true
    },
    {
      "source": "/benchmarks/telehealth/",
      "destination": "/industries/telehealth/",
      "permanent": true
    },
    {
      "source": "/benchmarks/med-spa/",
      "destination": "/industries/med-spa/",
      "permanent": true
    },
    {
      "source": "/benchmarks/glp-1-weight-loss/",
      "destination": "/industries/glp-1-weight-loss/",
      "permanent": true
    },
    {
      "source": "/benchmarks/supplements-dtc/",
      "destination": "/industries/supplements-dtc/",
      "permanent": true
    },
    {
      "source": "/benchmarks/fertility-ivf/",
      "destination": "/industries/fertility-ivf/",
      "permanent": true
    },
    {
      "source": "/benchmarks/peptides/",
      "destination": "/industries/peptides/",
      "permanent": true
    },
    {
      "source": "/benchmarks/:path(.*)",
      "destination": "/industries/",
      "permanent": true
    },
    {
      "source": "/guides/health-ad-compliance/",
      "destination": "/blog/glp1-advertising-compliance-2026/",
      "permanent": true
    },
    {
      "source": "/guides/:path(.*)",
      "destination": "/advertising/",
      "permanent": true
    },
    {
      "source": "/blog/choosing-paid-media-agency-2026/",
      "destination": "https://www.adboost.media/blog/choosing-paid-media-agency-2026/",
      "permanent": true
    },
    {
      "source": "/blog/b2b-reviews-buying-decisions/",
      "destination": "https://www.adboost.media/blog/b2b-reviews-buying-decisions/",
      "permanent": true
    },
    {
      "source": "/blog/ecommerce-advertising-budget/",
      "destination": "https://www.adboost.media/blog/ecommerce-advertising-budget/",
      "permanent": true
    }
  ]
}
{
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(logos|ads|people|og)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/blog/(.*)\\.(webp|jpg|jpeg|png|avif|svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(favicon.ico|favicon.png|apple-touch-icon.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/case-studies",
      "destination": "/industries/",
      "permanent": false
    },
    {
      "source": "/case-studies/:path(.*)",
      "destination": "/industries/",
      "permanent": false
    },
    {
      "source": "/services/compliance",
      "destination": "/services/",
      "permanent": false
    },
    {
      "source": "/services/compliance/:path(.*)",
      "destination": "/services/",
      "permanent": false
    },
    {
      "source": "/benchmarks",
      "destination": "/blog/telehealth-cac-benchmarks-2026/",
      "permanent": false
    },
    {
      "source": "/benchmarks/:path(.*)",
      "destination": "/blog/telehealth-cac-benchmarks-2026/",
      "permanent": false
    },
    {
      "source": "/guides",
      "destination": "/blog/glp1-advertising-compliance-2026/",
      "permanent": false
    },
    {
      "source": "/guides/:path(.*)",
      "destination": "/blog/glp1-advertising-compliance-2026/",
      "permanent": false
    },
    {
      "source": "/advertising",
      "destination": "/blog/glp1-advertising-compliance-2026/",
      "permanent": false
    },
    {
      "source": "/advertising/:path(.*)",
      "destination": "/blog/glp1-advertising-compliance-2026/",
      "permanent": false
    }
  ]
}
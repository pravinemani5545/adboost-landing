{
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://admin.adboost.health; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; connect-src 'self' https://admin.adboost.health; frame-src https://calendar.google.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/health/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/health/(logos|ads|people|og)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/health/blog/(.*)\\.(webp|jpg|jpeg|png|avif|svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/health/(favicon.ico|favicon.png|apple-touch-icon.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "adboost-landing.vercel.app"
        }
      ],
      "destination": "https://www.adboost.health/:path",
      "permanent": true
    },
    {
      "source": "/",
      "destination": "/health/",
      "permanent": false
    },
    {
      "source": "/health/protocol/",
      "destination": "/health/zero-ban-protocol/",
      "permanent": true
    },
    {
      "source": "/health/free/zero-ban-protocol/",
      "destination": "/health/zero-ban-protocol/",
      "permanent": true
    },
    {
      "source": "/health/free/zero-ban-protocol/checklist/",
      "destination": "/health/zero-ban-protocol/checklist/",
      "permanent": true
    },
    {
      "source": "/health/case-studies",
      "destination": "/health/industries/",
      "permanent": true
    },
    {
      "source": "/health/case-studies/:path(.*)",
      "destination": "/health/industries/",
      "permanent": true
    },
    {
      "source": "/health/services/compliance",
      "destination": "/health/services/",
      "permanent": true
    },
    {
      "source": "/health/services/compliance/:path(.*)",
      "destination": "/health/services/",
      "permanent": true
    },
    {
      "source": "/health/benchmarks/telehealth/",
      "destination": "/health/industries/telehealth/",
      "permanent": true
    },
    {
      "source": "/health/benchmarks/med-spa/",
      "destination": "/health/industries/med-spa/",
      "permanent": true
    },
    {
      "source": "/health/benchmarks/glp-1-weight-loss/",
      "destination": "/health/industries/glp-1-weight-loss/",
      "permanent": true
    },
    {
      "source": "/health/benchmarks/supplements-dtc/",
      "destination": "/health/industries/supplements-dtc/",
      "permanent": true
    },
    {
      "source": "/health/benchmarks/fertility-ivf/",
      "destination": "/health/industries/fertility-ivf/",
      "permanent": true
    },
    {
      "source": "/health/benchmarks/peptides/",
      "destination": "/health/industries/peptides/",
      "permanent": true
    },
    {
      "source": "/health/benchmarks/:path(.*)",
      "destination": "/health/industries/",
      "permanent": true
    },
    {
      "source": "/health/guides/health-ad-compliance/",
      "destination": "/health/advertising/",
      "permanent": true
    },
    {
      "source": "/health/guides/:path(.*)",
      "destination": "/health/advertising/",
      "permanent": true
    },
    {
      "source": "/health/blog/choose-health-growth-agency/",
      "destination": "/health/compare/generalist-dtc-agency-alternative/",
      "permanent": true
    },
    {
      "source": "/health/glossary/payback-period/",
      "destination": "/health/glossary/cac-payback-period/",
      "permanent": true
    },
    {
      "source": "/health/glossary/server-side-tracking/",
      "destination": "/health/glossary/capi/",

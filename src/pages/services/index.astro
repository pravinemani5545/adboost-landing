---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import { SERVICES } from '../../data/services';
import { siteBase } from '../../lib/site';
import { breadcrumb } from '../../lib/schema';

const SITE = siteBase(Astro.site);
const title = 'Paid Media, Creative & CRO for Health Brands | AdBoost';
const description = 'Compliant paid media, in-house creative, and CRO for health, telehealth, GLP-1 and supplement brands. One acquisition system built to lower CAC and scale spend.';
const jsonLd = [
  breadcrumb(SITE, [{ label: 'Home', href: '/' }, { label: 'Services', href: '/services/' }]),
  { '@type': 'CollectionPage', name: 'AdBoost Health services', url: `${SITE}/services/` },
];
---
<BaseLayout {title} {description} canonicalPath="/services/" {jsonLd}>
  <section class="phero wide">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Services' }]} />
      <span class="eyebrow sec-eyebrow" style="display:block;margin-top:16px"><span class="dot"></span>SERVICES</span>
      <h1>One <span class="serif">compliant</span> acquisition system, built for health.</h1>
      <p class="phero-lede">Paid media, creative, and conversion, with compliance built into every step. The three services below work as one engine: the reason our partners average 24% lower CAC in the first 30 days.</p>
    </div>
  </section>

  <section class="iwrap">
    <div class="container">
      <div class="grid-cards">
        {SERVICES.map((s) => (
          <a class="lcard reveal" href={`/services/${s.slug}/`}>
            <h3>{s.name}</h3>
            <p>{s.lede}</p>
            <span class="lc-more">Learn more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

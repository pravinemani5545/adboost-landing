---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import Closing from '../../components/Closing.astro';
import Faq from '../../components/Faq.astro';
import Steps from '../../components/Steps.astro';
import Brief from '../../components/doc/Brief.astro';
import Toc from '../../components/doc/Toc.astro';
import AsideLinks from '../../components/doc/AsideLinks.astro';
import AsideCta from '../../components/doc/AsideCta.astro';
import { SERVICES, getService } from '../../data/services';
import { siteBase } from '../../lib/site';
import { breadcrumb, faqPage, serviceNode } from '../../lib/schema';

export function getStaticPaths() {
  return SERVICES.map((s) => ({ params: { slug: s.slug } }));
}
const { slug } = Astro.params;
const s = getService(slug!)!;
const SITE = siteBase(Astro.site);
const path = `/services/${s.slug}/`;
const title = s.seoTitle ?? `${s.h1} | AdBoost Health`;
const description = s.lede;
const jsonLd = [
  serviceNode(SITE, { name: s.name, description: s.desc, path }),
  breadcrumb(SITE, [{ label: 'Home', href: '/' }, { label: 'Services', href: '/services/' }, { label: s.name, href: path }]),
  faqPage(s.faq),
];
const otherServices = SERVICES.filter((x) => x.slug !== s.slug);
const RELATED_RESOURCES: Record<string, { href: string; label: string }[]> = {
  'paid-media': [
    { href: '/glossary/cpc/', label: 'CPC: what a fair cost per click looks like' },
    { href: '/glossary/cpm/', label: 'CPM: what drives it up in health auctions' },
    { href: '/tools/ad-budget-calculator/', label: 'Ad budget calculator' },
  ],
  'cro': [
    { href: '/glossary/landing-page-conversion-rate/', label: 'Landing page conversion rate benchmarks' },
    { href: '/glossary/quiz-funnel/', label: 'Quiz funnels: when they beat a standard lander' },
    { href: '/tools/poas-calculator/', label: 'POAS calculator' },
  ],
  'creative': [
    { href: '/glossary/hook-rate/', label: 'Hook rate: the first metric we check' },
    { href: '/glossary/creative-fatigue/', label: 'Creative fatigue and how to spot it early' },
    { href: '/glossary/creative-testing/', label: 'How structured creative testing works' },
  ],
};
const relatedResources = RELATED_RESOURCES[s.slug] ?? [];
const toc = [
  { id: 'outcomes', label: 'What you get' },
  { id: 'process', label: 'How it works' },
  { id: 'deliverables', label: 'Deliverables' },
  { id: 'depth', label: 'Why it matters in health' },
  { id: 'faq', label: 'FAQ' },
];
---
<BaseLayout {title} {description} canonicalPath={path} {jsonLd}>
  <PageHead label="Services" labelHref="/services/" title={s.h1} lede={s.lede} dots />

  <section class="tone-paper page-body" data-nav="paper">
    <div class="wrap doc">
      <div class="doc-main">
        <Brief>{s.answer}</Brief>

        <div class="doc-sec" id="outcomes">
          <h2>What you get</h2>
          <ul class="ticks">{s.outcomes.map((o) => <li>{o}</li>)}</ul>
        </div>

        <div class="doc-sec" id="process">
          <h2>How it works</h2>
          <Steps items={s.process.map((p) => ({ title: p.phase.split(' · ')[0], meta: p.phase.split(' · ')[1], body: p.detail }))} />
        </div>

        <div class="doc-sec" id="deliverables">
          <h2>What you receive</h2>
          <ul class="ticks">{s.deliverables.map((d) => <li>{d}</li>)}</ul>
          <p class="small"><strong>Measured on:</strong> {s.howMeasured.join(' · ')}</p>
        </div>

        <div class="doc-sec" id="depth">
          <h2>Why it’s different in health</h2>
          {s.deepPoints.map((d) => (<><h3>{d.h}</h3><p>{d.p}</p></>))}
          <div class="note">
            <p class="label">By the numbers</p>
            <p>{s.stat.text} <a href={s.stat.url} target="_blank" rel="noopener">({s.stat.source})</a></p>
          </div>
        </div>

        <div class="doc-sec" id="faq">
          <h2>FAQ</h2>
          <Faq items={s.faq} />
        </div>
      </div>

      <aside class="doc-aside">
        <AsideLinks
          label="The rest of the system"
          links={[...otherServices.map((o) => ({ href: `/services/${o.slug}/`, label: o.name })), { href: '/industries/', label: 'Industries we serve' }]}
        />
        {relatedResources.length > 0 && <AsideLinks label="Definitions & tools" links={relatedResources} />}
        <AsideCta heading="See it on your account" text="Free audit with a senior strategist, a written plan you keep either way." />
        <Toc items={toc} />
      </aside>
    </div>
  </section>

  <Closing />
</BaseLayout>

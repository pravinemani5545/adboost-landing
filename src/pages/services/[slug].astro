---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import Faq from '../../components/Faq.astro';
import { SERVICES, getService } from '../../data/services';
import { siteBase } from '../../lib/site';
import { breadcrumb, faqPage, serviceNode } from '../../lib/schema';

export function getStaticPaths() {
  return SERVICES.map((s) => ({ params: { slug: s.slug } }));
}
const { slug } = Astro.params;
const s = getService(slug!)!;
const SITE = siteBase(Astro.site);
const path = `/services/${s.slug}/`;
const title = `${s.h1} | AdBoost Health`;
const description = s.lede;
const jsonLd = [
  serviceNode(SITE, { name: s.name, description: s.desc, path }),
  breadcrumb(SITE, [{ label: 'Home', href: '/' }, { label: 'Services', href: '/services/' }, { label: s.name, href: path }]),
  faqPage(s.faq),
];
const otherServices = SERVICES.filter((x) => x.slug !== s.slug);
const RELATED_RESOURCES: Record<string, { href: string; label: string }[]> = {
  'paid-media': [
    { href: '/glossary/cpc/', label: 'CPC: what a fair cost per click looks like' },
    { href: '/glossary/cpm/', label: 'CPM: what drives it up in health auctions' },
    { href: '/tools/ad-budget-calculator/', label: 'Ad budget calculator' },
  ],
  'cro': [
    { href: '/glossary/landing-page-conversion-rate/', label: 'Landing page conversion rate benchmarks' },
    { href: '/glossary/quiz-funnel/', label: 'Quiz funnels: when they beat a standard lander' },
    { href: '/tools/poas-calculator/', label: 'POAS calculator' },
  ],
  'creative': [
    { href: '/glossary/hook-rate/', label: 'Hook rate: the first metric we check' },
    { href: '/glossary/creative-fatigue/', label: 'Creative fatigue and how to spot it early' },
    { href: '/glossary/creative-testing/', label: 'How structured creative testing works' },
  ],
};
const relatedResources = RELATED_RESOURCES[s.slug] ?? [];
const toc = [
  { id: 'outcomes', label: 'What you get' },
  { id: 'process', label: 'How it works' },
  { id: 'deliverables', label: 'Deliverables' },
  { id: 'depth', label: 'Why it matters in health' },
  { id: 'faq', label: 'FAQ' },
];
---
<BaseLayout {title} {description} canonicalPath={path} {jsonLd}>
  <section class="phero">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Services', href: '/services/' }, { label: s.name }]} />
      <span class="eyebrow sec-eyebrow" style="display:block;margin-top:16px"><span class="dot"></span>{s.navLabel.toUpperCase()}</span>
      <h1>{s.h1}</h1>
      <p class="phero-lede">{s.lede}</p>
    </div>
  </section>

  <section class="iwrap">
    <div class="container">
      <div class="doc-grid">
        <div class="doc-main">
          <div class="answer-box reveal"><span class="al">In short</span>{s.answer}</div>
          <div class="prose">
            <h2 id="outcomes">What you get</h2>
            <ul class="checks">
              {s.outcomes.map((o) => (
                <li><span class="ck"><svg width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M5 12l4.5 4.5L19 7" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>{o}</li>
              ))}
            </ul>

            <h2 id="process">How it works</h2>
            <div class="playbook">
              {s.process.map((p) => (<div class="pb"><h3>{p.phase}</h3><p>{p.detail}</p></div>))}
            </div>

            <h2 id="deliverables">What you receive</h2>
            <ul class="checks">
              {s.deliverables.map((d) => (
                <li><span class="ck"><svg width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M5 12l4.5 4.5L19 7" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>{d}</li>
              ))}
            </ul>
            <p style="font-size:14px;color:var(--mute)"><strong>Measured on:</strong> {s.howMeasured.join(' · ')}</p>

            <h2 id="depth">Why it’s different in health</h2>
            {s.deepPoints.map((d) => (<><h3>{d.h}</h3><p>{d.p}</p></>))}

            <div class="callout"><span class="cl-label">By the numbers</span>{s.stat.text} <a href={s.stat.url} target="_blank" rel="noopener">({s.stat.source})</a></div>

            <h2 id="faq">FAQ</h2>
            <Faq items={s.faq} idPrefix={`svc-${s.slug}`} />
          </div>
        </div>

        <aside class="doc-aside">
          <div class="aside-toc">
            <div class="at-label">On this page</div>
            <ul>{toc.map((t) => <li><a href={`#${t.id}`}>{t.label}</a></li>)}</ul>
          </div>
          <div class="aside-card">
            <h4>The rest of the system</h4>
            <div class="link-list">
              {otherServices.map((o) => <a href={`/services/${o.slug}/`}>{o.name}</a>)}
              <a href="/industries/">Industries we serve</a>
            </div>
          </div>
          {relatedResources.length > 0 && (
            <div class="aside-card">
              <h4>Definitions & tools</h4>
              <div class="link-list">
                {relatedResources.map((r) => <a href={r.href}>{r.label}</a>)}
              </div>
            </div>
          )}
          <div class="aside-card dark">
            <h4 style="color:#fff">See it on your account</h4>
            <p>Free audit with a senior strategist - a written plan you keep either way.</p>
            <a class="btn btn-primary" href="https://cal.com/pira-ahilan-ef2dl8/strategy-call" target="_blank" rel="noopener">Book a call →</a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

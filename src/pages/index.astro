<script is:inline>
  // ---- sticky nav
  const nav = document.getElementById('nav');
  const onScroll = () => nav.classList.toggle('scrolled', window.scrollY > 6);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // ---- duplicate marquee for seamless loop
  const m = document.getElementById('marquee');
  if (m) m.innerHTML = m.innerHTML + m.innerHTML;

  // ---- ops clock
  const opsTime = document.getElementById('opsTime');
  function tickClock() {
    if (!opsTime) return;
    const d = new Date();
    const h = d.getHours() % 12 || 12;
    const m = String(d.getMinutes()).padStart(2, '0');
    const s = String(d.getSeconds()).padStart(2, '0');
    const am = d.getHours() < 12 ? 'AM' : 'PM';
    opsTime.textContent = `${String(h).padStart(2, '0')}:${m}:${s} ${am}`;
  }
  tickClock();
  setInterval(tickClock, 1000);

  // ---- gauge ticks
  (function () {
    const tickG = document.querySelector('#gaugeTicks');
    if (!tickG) return;
    const total = 32;
    let html = '';
    for (let i = 0; i < total; i++) {
      const t = i / (total - 1);
      const a = -Math.PI + t * Math.PI;
      const r1 = 88, r2 = 100;
      const x1 = Math.cos(a) * r1, y1 = Math.sin(a) * r1;
      const x2 = Math.cos(a) * r2, y2 = Math.sin(a) * r2;
      const isActive = t < .7;
      const color = isActive ? '#0057ff' : '#e5e7ee';
      const op = isActive ? (.45 + t * .8) : 1;
      html += `<line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" stroke="${color}" stroke-width="2.6" stroke-linecap="round" opacity="${Math.min(1, op)}"/>`;
    }
    const needleA = -Math.PI + 0.66 * Math.PI;
    const nx = Math.cos(needleA) * 82, ny = Math.sin(needleA) * 82;
    html += `<line x1="0" y1="0" x2="${nx}" y2="${ny}" stroke="#0a0a0f" stroke-width="2.2" stroke-linecap="round"/>`;
    html += `<circle cx="0" cy="0" r="6" fill="#0a0a0f"/><circle cx="0" cy="0" r="2.5" fill="#fff"/>`;
    tickG.innerHTML = html;
  })();

  // ---- reveal on scroll
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('in');
        io.unobserve(e.target);
      }
    });
  }, { threshold: .12, rootMargin: '0px 0px -40px 0px' });
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));

  // ---- animated counters (supports decimals + commas)
  const fmt = (n, dec) => {
    if (dec > 0) return n.toFixed(dec);
    return Math.round(n).toLocaleString('en-US');
  };
  const counterIO = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (!e.isIntersecting) return;
      const el = e.target;
      const target = parseFloat(el.dataset.target);
      const suffix = el.dataset.suffix || '';
      const dec = parseInt(el.dataset.decimals || '0', 10);
      const dur = 1500;
      const t0 = performance.now();
      const tick = (t) => {
        const k = Math.min(1, (t - t0) / dur);
        const eased = 1 - Math.pow(1 - k, 3);
        el.textContent = fmt(target * eased, dec) + suffix;
        if (k < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
      counterIO.unobserve(el);
    });
  }, { threshold: .4 });
  document.querySelectorAll('.counter').forEach(el => counterIO.observe(el));

  // ---- meter (bento)
  const meterIO = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (!e.isIntersecting) return;
      const ring = document.getElementById('meterRing');
      const num = document.getElementById('meterNum');
      if (!ring || !num) return;
      const target = 47;
      const dur = 1500;
      const t0 = performance.now();
      const tick = (t) => {
        const k = Math.min(1, (t - t0) / dur);
        const eased = 1 - Math.pow(1 - k, 3);
        const v = target * eased;
        ring.setAttribute('stroke-dasharray', `${v.toFixed(2)} 100`);
        num.textContent = Math.round(v) + '%';
        if (k < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
      meterIO.unobserve(e.target);
    });
  }, { threshold: .4 });
  const mw = document.querySelector('.b6');
  if (mw) meterIO.observe(mw);

  // ---- generic scroll-driven SVG line draw
  const drawIO = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (!e.isIntersecting) return;
      const el = e.target;
      try {
        const len = el.getTotalLength ? el.getTotalLength() : 800;
        el.style.setProperty('--len', len.toFixed(1));
        el.getBoundingClientRect();
      } catch (_) { /* noop */ }
      el.classList.add('in');
      drawIO.unobserve(el);
    });
  }, { threshold: .25, rootMargin: '0px 0px -20px 0px' });
  document.querySelectorAll('.drawline').forEach(el => drawIO.observe(el));

  // ---- ops revenue counter (looped subtle increment)
  const opsRev = document.getElementById('opsRev');
  let baseRev = 153420113;
  function paintRev(n) {
    if (!opsRev) return;
    opsRev.textContent = Math.round(n).toLocaleString('en-US');
  }
  paintRev(baseRev);
  setInterval(() => {
    baseRev += Math.floor(Math.random() * 400) + 80;
    paintRev(baseRev);
  }, 1700);

  // ---- ops row subtle live blink
  setInterval(() => {
    const rows = document.querySelectorAll('.ops-row .met');
    if (!rows.length) return;
    const target = rows[Math.floor(Math.random() * rows.length)];
    target.style.transition = 'background .25s';
    target.style.background = 'rgba(0,87,255,.06)';
    setTimeout(() => target.style.background = '', 500);
  }, 2200);

  // ---- FAQ accordion
  document.querySelectorAll('#faqList .qa').forEach(qa => {
    qa.querySelector('button').addEventListener('click', () => qa.classList.toggle('open'));
  });

  // ---- subtle ops parallax on mouse
  const ops = document.getElementById('ops');
  if (ops) {
    document.addEventListener('mousemove', (e) => {
      const w = window.innerWidth, h = window.innerHeight;
      const x = (e.clientX / w - .5);
      const y = (e.clientY / h - .5);
      ops.style.transform = `translate3d(${x * -8}px, ${y * -6}px, 0) rotateX(${y * -1.2}deg) rotateY(${x * 1.2}deg)`;
    });
    document.addEventListener('mouseleave', () => ops.style.transform = '');
  }
</script>

</body>
</html>

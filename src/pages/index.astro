---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>AdBoost Health — Growth Marketing for Health & Telehealth Brands</title>
<meta name="description" content="Growth marketing built exclusively for GLP-1, telehealth, supplement & wellness brands. Lower CAC, scale spend profitably — without compliance landmines." />
<meta name="theme-color" content="#0057ff" />
<meta property="og:type" content="website" />
<meta property="og:title" content="AdBoost Health — Growth Marketing for Health Brands" />
<meta property="og:description" content="Lower CAC, improve LTV, and scale paid — without compliance landmines. 71+ founders served. $153M+ tracked." />
<meta property="og:site_name" content="AdBoost Health" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="AdBoost Health — Growth Marketing for Health Brands" />
<meta name="twitter:description" content="Lower CAC, scale paid profitably. 71+ founders served. $153M+ tracked." />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>

<!-- NAV -->
<nav class="nav" id="nav">
  <div class="container nav-inner">
    <a class="brand" href="#">
      <span class="brand-mark">+</span>
      <span>AdBoost <span style="color:var(--mute);font-weight:400">Health</span></span>
    </a>
    <div class="nav-links">
      <a href="#why">Why us</a>
      <a href="#results">Results</a>
      <a href="#process">Process</a>
      <a href="#faq">FAQ</a>
    </div>
    <a class="btn btn-primary" href="#cta">
      Book a call
      <span class="chev">
        <svg width="9" height="9" viewBox="0 0 9 9" fill="none"><path d="M1 4.5h7M5 1l3.5 3.5L5 8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
    </a>
  </div>
</nav>

<!-- HERO -->
<header class="hero">
  <span class="grid-bg"></span>
  <div class="container hero-grid">
    <div>
      <div class="reveal">
        <span class="pill">
          <span class="pdot">
            <svg width="9" height="9" viewBox="0 0 9 9" fill="none"><path d="M2 4.5l2 2 4-4.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <span>Set up in <b>5 days</b> · Results in <b>31</b></span>
        </span>
      </div>
      <h1 class="reveal d1">
        Growth marketing<br />
        for <span class="serif">fast-growing</span><br />
        <span class="underline">health</span> brands.
      </h1>
      <p class="lede reveal d2">We help GLP-1, telehealth, supplement, and health-app brands lower CAC, improve LTV, and scale paid — without the compliance landmines.</p>
      <div class="ctas reveal d3">
        <a class="btn btn-primary btn-lg" href="#cta">
          Book a free strategy call
          <span class="chev"><svg width="9" height="9" viewBox="0 0 9 9" fill="none"><path d="M1 4.5h7M5 1l3.5 3.5L5 8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </a>
        <a class="btn btn-ghost btn-lg" href="#process">See the process</a>
      </div>
      <div class="hero-perks reveal d3">
        <span>No pitch deck</span>
        <span>Free 48h written audit</span>
        <span>Plan you keep either way</span>
      </div>
      <div class="meta reveal d3">
        <div class="avatars"><span></span><span></span><span></span><span></span></div>
        <span>Trusted by <b style="color:var(--ink)">71+ founders</b> · 4.9 / 5 average rating · <b style="color:var(--ink)">4 spots left</b> this month</span>
      </div>
    </div>

    <div class="reveal d2">
      <div class="ops" id="ops">
        <div class="ops-shelf s1"><span class="av">+</span><span><b>+$2.4M</b> tracked this week</span></div>
        <div class="ops-shelf s2"><span class="av" style="background:linear-gradient(135deg,#16a34a,#0d6b32)">↓</span><span>CAC <b>↓ 18%</b> · last 7d</span></div>

        <div class="ops-head">
          <div class="title">
            <span class="live-dot"></span>
            <span>Partner operations · <span class="mono" style="color:var(--mute);font-size:12px">live</span></span>
          </div>
          <span class="time" id="opsTime">10:47:21 AM</span>
        </div>
        <div class="ops-tabs">
          <span class="active">Overview</span>
          <span>Spend</span>
          <span>Creative</span>
          <span>Channels</span>
        </div>

        <div class="ops-row">
          <div class="opclient">
            <div class="av a1">NC</div>
            <div><div class="nm">NutriCore</div><div class="cat">GLP-1 SUPPORT</div></div>
          </div>
          <div class="met"><span>CAC</span>$32.10 <span class="delta down">↓ 28%</span></div>
          <div class="met"><span>ROAS</span>3.4× <span class="delta up">↑ 12%</span></div>
          <div class="spark">
            <svg viewBox="0 0 120 36" preserveAspectRatio="none"><path class="drawline" d="M0,28 C12,26 24,22 36,20 S60,18 72,14 96,8 120,6" stroke="#0057ff" stroke-width="1.6" fill="none"/></svg>
          </div>
        </div>

        <div class="ops-row">
          <div class="opclient">
            <div class="av a2">VT</div>
            <div><div class="nm">Vitaly</div><div class="cat">DAILY SUPPLEMENTS</div></div>
          </div>
          <div class="met"><span>CAC</span>$24.80 <span class="delta down">↓ 41%</span></div>
          <div class="met"><span>ROAS</span>4.1× <span class="delta up">↑ 26%</span></div>
          <div class="spark">
            <svg viewBox="0 0 120 36" preserveAspectRatio="none"><path class="drawline" d="M0,30 C18,28 30,18 50,16 S78,8 100,4 120,3 120,3" stroke="#16a34a" stroke-width="1.6" fill="none"/></svg>
          </div>
        </div>

        <div class="ops-row">
          <div class="opclient">
            <div class="av a3">LH</div>
            <div><div class="nm">Lumen Health</div><div class="cat">TELEHEALTH</div></div>
          </div>
          <div class="met"><span>CAC</span>$58.20 <span class="delta down">↓ 14%</span></div>
          <div class="met"><span>ROAS</span>2.6× <span class="delta up">↑ 8%</span></div>
          <div class="spark">
            <svg viewBox="0 0 120 36" preserveAspectRatio="none"><path class="drawline" d="M0,26 C16,22 30,28 50,20 S74,18 90,12 120,10 120,10" stroke="#0057ff" stroke-width="1.6" fill="none"/></svg>
          </div>
        </div>

        <div class="ops-row">
          <div class="opclient">
            <div class="av a4">PR</div>
            <div><div class="nm">Pulse Rx</div><div class="cat">HEALTH APP</div></div>
          </div>
          <div class="met"><span>CAC</span>$19.50 <span class="delta down">↓ 33%</span></div>
          <div class="met"><span>ROAS</span>5.2× <span class="delta up">↑ 31%</span></div>
          <div class="spark">
            <svg viewBox="0 0 120 36" preserveAspectRatio="none"><path class="drawline" d="M0,30 C20,30 36,22 56,16 S84,4 120,2" stroke="#16a34a" stroke-width="1.6" fill="none"/></svg>
          </div>
        </div>

        <div class="ops-foot">
          <span>4 of 71 partners</span>
          <div class="total">Tracked rev. <b>$<span id="opsRev">0</span></b></div>
        </div>
      </div>
    </div>
  </div>
</header>

<!-- TRUST -->
<section class="trust reveal">
  <div class="container trust-inner">
    <div class="trust-label">
      <div class="big">Trusted by <b>50+ health brands</b></div>
      <div class="sub">FROM PRE-SEED TO PE-BACKED</div>
    </div>
    <div class="marquee-wrap">
      <div class="marquee" id="marquee">
        <span class="logo"><span class="lm">N</span> NutriCore</span>
        <span class="logo serif-l">Vitaly</span>
        <span class="logo"><span class="lm">L</span> Lumen Health</span>
        <span class="logo serif-l">Pulse&nbsp;Rx</span>
        <span class="logo"><span class="lm">W</span> WellBound</span>
        <span class="logo serif-l">Hum&nbsp;&amp;&nbsp;Co</span>
        <span class="logo"><span class="lm">K</span> Korelab</span>
        <span class="logo serif-l">Bioluxe</span>
        <span class="logo"><span class="lm">A</span> Alveos</span>
        <span class="logo serif-l">Florae</span>
        <span class="logo"><span class="lm">B</span> Brightline</span>
        <span class="logo serif-l">Plantam</span>
      </div>
    </div>
  </div>
</section>

<!-- CREATIVE STRIP -->
<section class="creative-strip">
  <div class="container">
    <div class="strip-head reveal">
      <h3>Creative built for the <span class="serif" style="color:var(--blue)">scroll</span> — and the rules of every health platform.</h3>
      <div class="right">2,400+ static & motion creatives shipped this year. Every asset reviewed against Meta, Google & TikTok health policies before launch.</div>
    </div>
  </div>
  <div class="phone-rail-wrap reveal d1">
    <div class="phone-rail" id="phoneRail">
      <div class="ph"><div class="scr"><span class="notch"></span><div class="ad ad-c1"></div><div class="meta-tag">META · STATIC</div><div class="ad-title"><span class="serif" style="display:block;font-size:18px">No more</span><b>BLOAT.</b></div><div class="ad-cta">SHOP</div></div></div>
      <div class="ph"><div class="scr"><span class="notch"></span><div class="ad ad-c2"></div><div class="meta-tag">TIKTOK · UGC</div><div class="ad-title"><span class="serif" style="display:block;font-size:18px">40, juicy</span><b>& fully booked.</b></div><div class="ad-badge">CAC ↓ 32%</div></div></div>
      <div class="ph"><div class="scr"><span class="notch"></span><div class="ad ad-c3"></div><div class="meta-tag">META · MOTION</div><div class="ad-title"><span class="serif" style="display:block;font-size:18px">This is</span><b>NOT<br />Ozempic.</b></div><div class="ad-badge">ROAS ↑ 2.4×</div></div></div>
      <div class="ph"><div class="scr"><span class="notch"></span><div class="ad ad-c4"></div><div class="meta-tag">GOOGLE · DEMAND</div><div class="ad-title"><span class="serif" style="display:block;font-size:18px">Marathoners,</span><b style="font-size:22px">Bonus drop.</b></div><div class="ad-cta">JOIN</div></div></div>
      <div class="ph"><div class="scr"><span class="notch"></span><div class="ad ad-c5"></div><div class="meta-tag">META · STATIC</div><div class="ad-title" style="color:#3a2510"><span class="serif" style="display:block;font-size:18px">It's like</span><b style="color:#3a2510">honey<br />in a bottle.</b></div></div></div>
      <div class="ph"><div class="scr"><span class="notch"></span><div class="ad ad-c6"></div><div class="meta-tag">TIKTOK · STATIC</div><div class="ad-title"><span class="serif" style="display:block;font-size:18px">Sleep,</span><b>then everything.</b></div><div class="ad-badge">CTR 2.8%</div></div></div>
      <div class="ph"><div class="scr"><span class="notch"></span><div class="ad ad-c7"></div><div class="meta-tag" style="background:rgba(10,10,15,.6)">META · MOTION</div><div class="ad-title" style="color:#0a0a0f"><span class="serif" style="display:block;font-size:18px;color:#0a0a0f">Clinically</span><b style="color:#0a0a0f">studied.</b></div><div class="ad-cta" style="color:#0a0a0f;border-color:rgba(0,0,0,.5)">LEARN MORE</div></div></div>
      <div class="ph"><div class="scr"><span class="notch"></span><div class="ad ad-c8"></div><div class="meta-tag">SNAP · UGC</div><div class="ad-title"><span class="serif" style="display:block;font-size:18px">Mood meets</span><b>magnesium.</b></div><div class="ad-badge">+18k orders</div></div></div>
      <div class="ph"><div class="scr"><span class="notch"></span><div class="ad ad-c1"></div><div class="meta-tag">META · STATIC</div><div class="ad-title"><span class="serif" style="display:block;font-size:18px">No more</span><b>BLOAT.</b></div><div class="ad-cta">SHOP</div></div></div>
      <div class="ph"><div class="scr"><span class="notch"></span><div class="ad ad-c2"></div><div class="meta-tag">TIKTOK · UGC</div><div class="ad-title"><span class="serif" style="display:block;font-size:18px">40, juicy</span><b>& fully booked.</b></div><div class="ad-badge">CAC ↓ 32%</div></div></div>
      <div class="ph"><div class="scr"><span class="notch"></span><div class="ad ad-c3"></div><div class="meta-tag">META · MOTION</div><div class="ad-title"><span class="serif" style="display:block;font-size:18px">This is</span><b>NOT<br />Ozempic.</b></div><div class="ad-badge">ROAS ↑ 2.4×</div></div></div>
      <div class="ph"><div class="scr"><span class="notch"></span><div class="ad ad-c4"></div><div class="meta-tag">GOOGLE · DEMAND</div><div class="ad-title"><span class="serif" style="display:block;font-size:18px">Marathoners,</span><b style="font-size:22px">Bonus drop.</b></div><div class="ad-cta">JOIN</div></div></div>
      <div class="ph"><div class="scr"><span class="notch"></span><div class="ad ad-c5"></div><div class="meta-tag">META · STATIC</div><div class="ad-title" style="color:#3a2510"><span class="serif" style="display:block;font-size:18px">It's like</span><b style="color:#3a2510">honey<br />in a bottle.</b></div></div></div>
      <div class="ph"><div class="scr"><span class="notch"></span><div class="ad ad-c6"></div><div class="meta-tag">TIKTOK · STATIC</div><div class="ad-title"><span class="serif" style="display:block;font-size:18px">Sleep,</span><b>then everything.</b></div><div class="ad-badge">CTR 2.8%</div></div></div>
      <div class="ph"><div class="scr"><span class="notch"></span><div class="ad ad-c7"></div><div class="meta-tag" style="background:rgba(10,10,15,.6)">META · MOTION</div><div class="ad-title" style="color:#0a0a0f"><span class="serif" style="display:block;font-size:18px;color:#0a0a0f">Clinically</span><b style="color:#0a0a0f">studied.</b></div><div class="ad-cta" style="color:#0a0a0f;border-color:rgba(0,0,0,.5)">LEARN MORE</div></div></div>
      <div class="ph"><div class="scr"><span class="notch"></span><div class="ad ad-c8"></div><div class="meta-tag">SNAP · UGC</div><div class="ad-title"><span class="serif" style="display:block;font-size:18px">Mood meets</span><b>magnesium.</b></div><div class="ad-badge">+18k orders</div></div></div>
    </div>
  </div>
</section>

<!-- BENTO -->
<section id="why" class="bento">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow"><span class="dot"></span>WHY PARTNERS LOVE US</span>
      <h2>Built for health brands. <span class="serif">Designed to scale.</span></h2>
      <p>Five things every founder gets from day one — and the reason our partners average <b style="color:var(--ink)">24% lower CAC</b> in the first 30 days.</p>
    </div>

    <div class="bento-grid">
      <!-- B1 specialized -->
      <div class="bcard b1 reveal">
        <span class="tag">01 · SPECIALIZED</span>
        <div class="vis">
          <span class="cat" style="animation-delay:.0s"><span class="ico" style="background:linear-gradient(135deg,#3b7bff,#0040c2)">G</span>GLP-1 & weight care<span class="meta">12 brands</span></span>
          <span class="cat" style="animation-delay:.1s"><span class="ico" style="background:linear-gradient(135deg,#16a34a,#0a6b34)">S</span>Supplements & DTC<span class="meta">22 brands</span></span>
          <span class="cat" style="animation-delay:.2s"><span class="ico" style="background:linear-gradient(135deg,#ec4899,#a8174a)">T</span>Telehealth<span class="meta">9 brands</span></span>
          <span class="cat" style="animation-delay:.3s"><span class="ico" style="background:linear-gradient(135deg,#f59e0b,#c47200)">A</span>Health apps<span class="meta">8 brands</span></span>
          <span class="cat" style="animation-delay:.4s"><span class="ico" style="background:linear-gradient(135deg,#8b5cf6,#5b21b6)">M</span>Mental health<span class="meta">6 brands</span></span>
          <span class="cat" style="animation-delay:.5s"><span class="ico" style="background:linear-gradient(135deg,#06b6d4,#0e7490)">F</span>Fitness & recovery<span class="meta">14 brands</span></span>
        </div>
        <div class="body">
          <h3>The only categories we work in are the ones we've already scaled.</h3>
          <p>We don't take "interesting" briefs outside health. That's why we know every Meta health policy by heart, and why we ship faster than a generalist agency ever could.</p>
        </div>
      </div>

      <!-- B2 senior partner -->
      <div class="bcard b2 reveal d1">
        <span class="tag">02 · YOUR TEAM</span>
        <div class="vis">
          <div class="partner">
            <div class="top">
              <div class="pv">BS</div>
              <div><div class="who">Brandon Scott</div><div class="role">GROWTH LEAD · 7Y</div></div>
            </div>
            <div class="msg">New angle live tonight — should pull CAC under $38 by Friday ✦</div>
            <div class="status"><span class="pulse"></span>Replies in 12m on avg.</div>
          </div>
        </div>
        <div class="body">
          <h3>A senior growth partner, not a junior pod.</h3>
          <p>Paired with a strategist who has scaled health brands past $20M.</p>
        </div>
      </div>

      <!-- B3 compliance -->
      <div class="bcard b3 reveal d2">
        <span class="tag">03 · COMPLIANT</span>
        <div class="vis">
          <div class="shield-wrap">
            <div class="ch-rules left">
              <span class="r">GLP-1 claims</span>
              <span class="r">Before/after</span>
              <span class="r">Rx language</span>
            </div>
            <div class="shield">
              <svg viewBox="0 0 24 24" fill="none"><path d="M5 5l8 14 6-9" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <div class="ch-rules right">
              <span class="r">HIPAA-aware</span>
              <span class="r">FDA-safe copy</span>
              <span class="r">FTC review</span>
            </div>
          </div>
        </div>
        <div class="body">
          <h3>Compliance-first creative.</h3>
          <p>Pre-approved against health-vertical policies — so launches don't get yanked.</p>
        </div>
      </div>

      <!-- B4 creative engine -->
      <div class="bcard b4 reveal d1">
        <div class="body">
          <span class="tag">04 · CREATIVE ENGINE</span>
          <h3>20+ new creatives shipped every month.</h3>
          <p>Static, motion, and UGC — produced in-house, tested against an indexed library of winning angles, then scaled to the highest performers.</p>
          <div style="display:flex;gap:24px;margin-top:18px;flex-wrap:wrap">
            <div><div class="mono" style="font-size:11px;color:#9aa0ac;letter-spacing:.06em">CREATIVES SHIPPED</div><div style="font-size:22px;font-weight:500;letter-spacing:-.02em;margin-top:2px">2,418</div></div>
            <div><div class="mono" style="font-size:11px;color:#9aa0ac;letter-spacing:.06em">WIN RATE</div><div style="font-size:22px;font-weight:500;letter-spacing:-.02em;margin-top:2px">18%</div></div>
            <div><div class="mono" style="font-size:11px;color:#9aa0ac;letter-spacing:.06em">UGC CREATORS</div><div style="font-size:22px;font-weight:500;letter-spacing:-.02em;margin-top:2px">340+</div></div>
          </div>
        </div>
        <div class="vis"><div class="tile"></div><div class="tile"></div><div class="tile"></div><div class="tile"></div><div class="tile"></div><div class="tile"></div><div class="tile"></div><div class="tile"></div></div>
      </div>

      <!-- B5 compounding system -->
      <div class="bcard b5 reveal">
        <span class="tag">05 · COMPOUNDING</span>
        <div class="vis">
          <svg viewBox="0 0 400 280" preserveAspectRatio="none">
            <defs>
              <linearGradient id="g5" x1="0" x2="0" y1="0" y2="1">
                <stop offset="0%" stop-color="#0057ff" stop-opacity=".24"/>
                <stop offset="100%" stop-color="#0057ff" stop-opacity="0"/>
              </linearGradient>
            </defs>
            <g stroke="#e5e7ee" stroke-width=".7">
              <line x1="0" x2="400" y1="60" y2="60"/>
              <line x1="0" x2="400" y1="120" y2="120"/>
              <line x1="0" x2="400" y1="180" y2="180"/>
              <line x1="0" x2="400" y1="240" y2="240"/>
            </g>
            <path id="b5Line" class="drawline" d="M0,220 C40,210 80,205 120,195 S200,160 250,130 320,70 400,30" fill="none" stroke="#0057ff" stroke-width="2.2" stroke-linecap="round"/>
            <path d="M0,220 C40,210 80,205 120,195 S200,160 250,130 320,70 400,30 L400,280 L0,280 Z" fill="url(#g5)"/>
            <circle cx="250" cy="130" r="4.5" fill="#0057ff" stroke="#fff" stroke-width="2.5"/>
            <g transform="translate(260 110)">
              <rect width="90" height="22" rx="6" fill="#fff" stroke="#e5e7ee"/>
              <text x="9" y="15" font-family="Geist Mono" font-size="10" fill="#0a0a0f">$182k · Day 31</text>
            </g>
          </svg>
        </div>
        <div class="body">
          <h3>A system that compounds while you sleep.</h3>
          <p>Tested creative library, optimized landers, and clean attribution — all working in lockstep, week after week.</p>
        </div>
      </div>

      <!-- B6 conversion lift -->
      <div class="bcard b6 reveal d1">
        <span class="tag">06 · CONVERSION</span>
        <div class="vis">
          <div class="meter">
            <svg viewBox="0 0 240 240" width="200" height="200">
              <circle cx="120" cy="120" r="100" stroke="#eef0f4" stroke-width="14" fill="none"/>
              <circle id="meterRing" cx="120" cy="120" r="100" stroke="#0057ff" stroke-width="14" fill="none" stroke-linecap="round" pathLength="100" stroke-dasharray="0 100"/>
            </svg>
            <div class="num"><div>
              <strong id="meterNum">0%</strong>
              <span>AVG LANDER LIFT<br />vs. baseline</span>
            </div></div>
          </div>
        </div>
        <div class="body">
          <h3>Every dollar lands somewhere it converts.</h3>
          <p>We A/B test landers and rewrite hooks weekly so traffic always finds its highest-converting offer.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CASE STUDIES -->
<section id="results" class="cases">
  <div class="container">
    <div class="cases-head reveal">
      <div>
        <span class="eyebrow"><span class="dot"></span>REAL RESULTS</span>
        <h2>Numbers from <span class="serif">real</span> partners.</h2>
      </div>
      <div class="r">Snapshots from the last 12 months. Brand names anonymized — happy to walk through the underlying account on a call.</div>
    </div>
    <div class="case-grid">

      <div class="ccard reveal">

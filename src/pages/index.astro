---
import Shell from '../layouts/Shell.astro';
import Faq from '../components/Faq.astro';
import HeatMatrix from '../kit/diagram/HeatMatrix.astro';
import { BOOK_PATH } from '../lib/site';
import { organizationNode } from '../lib/schema';
import { getPublishedPosts } from '../lib/blog';
import { AD_POLICIES, RULES_CHECKED_ON, STATUS_LABEL } from '../data/adPolicies';
import { PLATFORMS, STATUS_LEGEND, STATUS_TONE, policyHref } from '../components/adv/status';
import '../styles/home.css';

const SITE = Astro.site?.href.replace(/\/$/, '') ?? 'https://www.adboost.health';
// Latest from the blog (health plan O19): the homepage is crawled daily, so it
// is the fastest discovery route for new posts. Same publish gate as /blog/.
const latest = (await getPublishedPosts()).slice(0, 3);
const fmtDate = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

// FAQ: one source for the visible answers (with links) and the FAQPage JSON-LD (the same
// words, tags stripped), so the two can never drift apart.
const FAQ = [
  {
    q: 'How is AdBoost different from other agencies?',
    a: 'We’re a digital performance marketing agency that only works with health, <a href="/industries/telehealth/">telehealth</a>, and supplement brands, so every playbook, creative angle, and compliance check is purpose-built for your category. No generic “DTC agency” mistakes that cost you 30 days.',
  },
  {
    q: 'Do you have experience with compliant health advertising?',
    a: 'Yes. Every account is reviewed against <a href="/blog/glp1-advertising-compliance-2026/">Meta, Google, and TikTok health-vertical policies</a> before launch. We’ve shipped thousands of compliant creatives across GLP-1, supplement, and Rx-adjacent brands.',
  },
  {
    q: 'Do you create ad creatives too?',
    a: 'Absolutely. Static, motion, and UGC scripts are produced in-house weekly. Most partners get <a href="/blog/health-ad-creative-rejected-fix/">20+ new creative variants per month</a>, indexed against winning angles in our library.',
  },
  {
    q: 'When can I expect results?',
    a: 'Most partners see <a href="/blog/telehealth-cac-benchmarks-2026/">directional movement on CAC or ROAS</a> within 2 weeks. The 31-day mark is when our system compounds: tested creative library, optimized landers, and clean attribution all working in lockstep.',
  },
];
const plain = (html: string) => html.replace(/<[^>]+>/g, '');

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      ...organizationNode(SITE),
      contactPoint: { '@type': 'ContactPoint', contactType: 'sales', email: 'hello@adboost.health', areaServed: 'Worldwide' },
    },
    {
      '@type': 'WebSite',
      name: 'AdBoost Health',
      url: `${SITE}/`,
      publisher: { '@id': `${SITE}/#org` },
    },
    {
      '@type': 'FAQPage',
      mainEntity: FAQ.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: plain(f.a) },
      })),
    },
  ],
};

// Compliance by platform: the live rule sheets as a vertical x platform matrix. Status colours
// come from STATUS_TONE (components/adv/status.ts), shared with the advertising pages, the
// industry strips and the share cards.
const policyRows = [...new Set(AD_POLICIES.map((p) => p.verticalSlug))].map((vs) => {
  const ps = AD_POLICIES.filter((p) => p.verticalSlug === vs);
  return {
    label: ps[0].vertical,
    cells: PLATFORMS.map((pl) => {
      const p = ps.find((x) => x.platform === pl);
      return p ? { text: STATUS_LABEL[p.status], level: STATUS_TONE[p.status], href: policyHref(p) } : null;
    }),
  };
});
const policyLegend = STATUS_LEGEND;
const rulesChecked = new Date(`${RULES_CHECKED_ON}T00:00:00Z`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

// Process step 1 gauge, drawn at build time so it is complete without JS:
// 32 ticks, the first 70% lit, the needle agreeing with "7 of 10 active".
const GAUGE_ACTIVE = 0.7;
const gaugeTicks = Array.from({ length: 32 }, (_, i) => {
  const t = i / 31;
  const a = -Math.PI + t * Math.PI;
  const at = (r: number) => [(Math.cos(a) * r).toFixed(1), (Math.sin(a) * r).toFixed(1)];
  const [x1, y1] = at(88);
  const [x2, y2] = at(100);
  return { x1, y1, x2, y2, on: t < GAUGE_ACTIVE };
});
const needleA = -Math.PI + GAUGE_ACTIVE * Math.PI;
const needle = { x: (Math.cos(needleA) * 82).toFixed(1), y: (Math.sin(needleA) * 82).toFixed(1) };

// Bento 06 meter: the printed lift, rendered final; the page script counts it up below the fold.
const METER = 47;

const ADS = ['ozempic', 'alveos', 'nectar', 'vnella', 'limitless', 'mentaid', 'sweating', 'cabo'];
const chev = '<svg width="9" height="9" viewBox="0 0 9 9" fill="none" aria-hidden="true"><path d="M1 4.5h7M5 1l3.5 3.5L5 8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---

<Shell
  title="Healthcare Marketing Agency for GLP-1 & Telehealth | AdBoost"
  description="Performance marketing agency built only for GLP-1, telehealth, and supplement brands. Lower CAC and scale spend profitably, without compliance landmines."
  canonicalPath="/"
  ogTitle="AdBoost Health, Growth Marketing for Health Brands"
  ogDescription="Lower CAC, improve LTV, and scale paid, without compliance landmines. 71+ founders served. $153M+ tracked."
  ogImageAlt="AdBoost Health, performance marketing for health brands"
  twitterDescription="Lower CAC, scale paid profitably. 71+ founders served. $153M+ tracked."
  {jsonLd}
  bingVerify
  navTransparentTop
>

<!-- HERO: first screen, so .arrive (transform only, never hidden) instead of reveals -->
<header class="hero">
  <span class="grid-bg"></span>
  <div class="container hero-grid">
    <div class="hero-copy">
      <div class="arrive">
        <span class="pill">
          <span class="pdot">
            <svg width="9" height="9" viewBox="0 0 9 9" fill="none" aria-hidden="true"><path d="M2 4.5l2 2 4-4.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <span>Set up in <b>5 days</b> · Results in <b>31</b></span>
        </span>
      </div>
      <h1 class="arrive d1">
        Growth marketing<br />
        for <span class="serif">fast-growing</span><br />
        <span class="underline">health</span> brands.
      </h1>
      <p class="lede arrive d1">A healthcare marketing agency for health and wellness brands. We help you acquire more customers profitably and increase retention through high-converting ads, funnels, and creative strategy, without the compliance landmines.</p>
      <div class="ctas arrive d2">
        <a class="btn btn-primary btn-lg" href={BOOK_PATH} data-magnetic>
          Book a free strategy call
          <span class="chev" set:html={chev} />
        </a>
        <a class="btn btn-ghost btn-lg" href="#process">See how our 5-day process works</a>
      </div>
      <div class="hero-perks arrive d3">
        <span>Meet a senior strategist</span>
        <span>Free live audit</span>
        <span>Plan you keep either way</span>
      </div>
      <div class="meta arrive d3">
        <div class="avatars" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
        <span>Trusted by <b>71+ founders</b> · 4.9 / 5 average rating · <b>limited onboarding</b> each month</span>

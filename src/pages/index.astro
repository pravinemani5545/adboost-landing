<Fragment slot="scripts">
<script is:inline>
  // Page-only behaviour. Nav, phone menu, reveals, line draws, count-ups and the phone CTA come
  // from the kit (src/kit/scripts). Everything here is decoration over a complete server render.
  const motion = document.documentElement.classList.contains('motion');

  // ---- duplicate the logo marquee for a seamless loop (clones hidden from assistive tech)
  const m = document.getElementById('marquee');
  if (m) {
    Array.from(m.children).forEach(el => {
      const clone = el.cloneNode(true);
      clone.setAttribute('aria-hidden', 'true');
      m.appendChild(clone);
    });
  }

  // ---- ops clock
  const opsTime = document.getElementById('opsTime');
  function tickClock() {
    if (!opsTime) return;
    const d = new Date();
    const h = d.getHours() % 12 || 12;
    const mm = String(d.getMinutes()).padStart(2, '0');
    const s = String(d.getSeconds()).padStart(2, '0');
    const am = d.getHours() < 12 ? 'AM' : 'PM';
    opsTime.textContent = `${String(h).padStart(2, '0')}:${mm}:${s} ${am}`;
  }
  tickClock();
  setInterval(tickClock, 1000);

  // ---- bento meter: rendered at its printed value; below the fold it fills from 0 on arrival
  (function () {
    const meter = document.querySelector('[data-meter]');
    if (!meter || !motion || meter.getBoundingClientRect().top < innerHeight) return;
    const ring = meter.querySelector('.meter-ring');
    const num = meter.querySelector('.meter-num');
    const target = Number(meter.getAttribute('data-meter'));
    const set = (v) => { ring.setAttribute('stroke-dasharray', `${v.toFixed(2)} 100`); num.textContent = Math.round(v) + '%'; };
    set(0);
    const io = new IntersectionObserver((entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      io.disconnect();
      const t0 = performance.now();
      const tick = (t) => {
        const k = Math.min(1, (t - t0) / 1100);
        set(target * (1 - Math.pow(1 - k, 3)));
        if (k < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }, { threshold: .4 });
    io.observe(meter);
  })();

  // ---- subtle ops parallax on mouse (translate only, rAF-batched, disabled off-screen)
  const ops = document.getElementById('ops');
  if (ops && motion && !document.documentElement.classList.contains('lowpower') && window.matchMedia('(pointer: fine)').matches) {
    let mx = 0, my = 0, ticking = false, active = false;
    const apply = () => { ticking = false; ops.style.transform = `translate3d(${mx * -8}px, ${my * -6}px, 0)`; };
    const onMove = (e) => {
      mx = e.clientX / window.innerWidth - .5;
      my = e.clientY / window.innerHeight - .5;
      if (!ticking) { ticking = true; requestAnimationFrame(apply); }
    };
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting && !active) { active = true; document.addEventListener('mousemove', onMove, { passive: true }); }
      else if (!e.isIntersecting && active) { active = false; document.removeEventListener('mousemove', onMove); ops.style.transform = ''; }
    }, { threshold: 0 }).observe(ops);
  }
</script>
</Fragment>

<script is:inline>
  // ---- sticky nav
  const nav = document.getElementById('nav');
  const onScroll = () => nav.classList.toggle('scrolled', window.scrollY > 6);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // ---- mobile menu
  const burger = document.getElementById('burger');
  const mnav = document.getElementById('mnav');
  if (burger && mnav) {
    burger.addEventListener('click', () => {
      const open = mnav.classList.toggle('open');
      burger.setAttribute('aria-expanded', String(open));
    });
    mnav.addEventListener('click', (e) => { if (e.target.tagName === 'A') mnav.classList.remove('open'); });
  }

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---- duplicate marquee for seamless loop (clones hidden from assistive tech)
  const m = document.getElementById('marquee');
  if (m) {
    Array.from(m.children).forEach(el => {
      const clone = el.cloneNode(true);
      clone.setAttribute('aria-hidden', 'true');
      m.appendChild(clone);
    });
  }

  // ---- ops clock
  const opsTime = document.getElementById('opsTime');
  function tickClock() {
    if (!opsTime) return;
    const d = new Date();
    const h = d.getHours() % 12 || 12;
    const m = String(d.getMinutes()).padStart(2, '0');
    const s = String(d.getSeconds()).padStart(2, '0');
    const am = d.getHours() < 12 ? 'AM' : 'PM';
    opsTime.textContent = `${String(h).padStart(2, '0')}:${m}:${s} ${am}`;
  }
  tickClock();
  setInterval(tickClock, 1000);

  // ---- gauge (clean two-state ticks; needle + lit ticks agree with "7 of 10 active")
  (function () {
    const tickG = document.querySelector('#gaugeTicks');
    if (!tickG) return;
    const total = 32, active = 0.7;
    let html = '';
    for (let i = 0; i < total; i++) {
      const t = i / (total - 1);
      const a = -Math.PI + t * Math.PI;
      const r1 = 88, r2 = 100;
      const x1 = (Math.cos(a) * r1).toFixed(1), y1 = (Math.sin(a) * r1).toFixed(1);
      const x2 = (Math.cos(a) * r2).toFixed(1), y2 = (Math.sin(a) * r2).toFixed(1);
      const color = t < active ? '#0057ff' : '#e5e7ee';
      html += `<line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" stroke="${color}" stroke-width="2.6" stroke-linecap="round"/>`;
    }
    const needleA = -Math.PI + active * Math.PI;
    const nx = (Math.cos(needleA) * 82).toFixed(1), ny = (Math.sin(needleA) * 82).toFixed(1);
    html += `<line x1="0" y1="0" x2="${nx}" y2="${ny}" stroke="#0a0a0f" stroke-width="2.2" stroke-linecap="round"/>`;
    html += `<circle cx="0" cy="0" r="6" fill="#0a0a0f"/><circle cx="0" cy="0" r="2.5" fill="#fff"/>`;
    tickG.innerHTML = html;
  })();

  // ---- reveal on scroll
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('in');
        io.unobserve(e.target);
      }
    });
  }, { threshold: .12, rootMargin: '0px 0px -40px 0px' });
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));

  // ---- meter (bento)
  const meterIO = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (!e.isIntersecting) return;
      const ring = document.getElementById('meterRing');
      const num = document.getElementById('meterNum');
      if (!ring || !num) return;
      const target = 47;
      if (reduceMotion) {
        ring.setAttribute('stroke-dasharray', `${target} 100`);
        num.textContent = target + '%';
        meterIO.unobserve(e.target);
        return;
      }
      const dur = 1100;
      const t0 = performance.now();
      const tick = (t) => {
        const k = Math.min(1, (t - t0) / dur);
        const eased = 1 - Math.pow(1 - k, 3);
        const v = target * eased;
        ring.setAttribute('stroke-dasharray', `${v.toFixed(2)} 100`);
        num.textContent = Math.round(v) + '%';
        if (k < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
      meterIO.unobserve(e.target);
    });
  }, { threshold: .4 });
  const mw = document.querySelector('.b6');
  if (mw) meterIO.observe(mw);

  // ---- generic scroll-driven SVG line draw
  const drawIO = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (!e.isIntersecting) return;
      const el = e.target;
      try {
        const len = el.getTotalLength ? el.getTotalLength() : 800;
        el.style.setProperty('--len', len.toFixed(1));
        el.getBoundingClientRect();
      } catch (_) { /* noop */ }
      el.classList.add('in');
      el.closest('.demo')?.classList.add('drawn');
      drawIO.unobserve(el);
    });
  }, { threshold: .25, rootMargin: '0px 0px -20px 0px' });
  document.querySelectorAll('.drawline').forEach(el => drawIO.observe(el));

  // ---- FAQ accordion
  document.querySelectorAll('#faqList .qa').forEach(qa => {
    const btn = qa.querySelector('button');
    btn.addEventListener('click', () => {
      const open = qa.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(open));
    });
  });

  // ---- mobile sticky CTA: appear once the hero CTAs scroll away, hide over the big CTA section
  const mcta = document.querySelector('.mobile-cta');
  const heroCtas = document.querySelector('.hero .ctas');
  const bigCta = document.getElementById('cta');
  if (mcta && heroCtas && bigCta) {
    let pastHero = false, overBigCta = false;
    const update = () => mcta.classList.toggle('show', pastHero && !overBigCta);
    new IntersectionObserver(([e]) => {
      pastHero = !e.isIntersecting && e.boundingClientRect.top < 0;
      update();
    }, { threshold: 0 }).observe(heroCtas);
    new IntersectionObserver(([e]) => {
      overBigCta = e.isIntersecting;
      update();
    }, { threshold: .2 }).observe(bigCta);
  }

  // ---- subtle ops parallax on mouse (translate only, rAF-batched, disabled off-screen)
  const ops = document.getElementById('ops');
  if (ops && !reduceMotion && window.matchMedia('(pointer: fine)').matches) {
    let mx = 0, my = 0, ticking = false, active = false;
    const apply = () => { ticking = false; ops.style.transform = `translate3d(${mx * -8}px, ${my * -6}px, 0)`; };
    const onMove = (e) => {
      mx = e.clientX / window.innerWidth - .5;
      my = e.clientY / window.innerHeight - .5;
      if (!ticking) { ticking = true; requestAnimationFrame(apply); }
    };
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting && !active) { active = true; document.addEventListener('mousemove', onMove, { passive: true }); }
      else if (!e.isIntersecting && active) { active = false; document.removeEventListener('mousemove', onMove); ops.style.transform = ''; }
    }, { threshold: 0 }).observe(ops);
  }
</script>

</body>
</html>

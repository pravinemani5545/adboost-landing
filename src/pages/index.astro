---
// The home page. It alternates FRAME, PAPER and full-bleed media every screen or so; no paper run
// longer than one list. Every line here is the site's existing copy, re-set.
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import TrustStrip from '../components/home/TrustStrip.astro';
import Numbers from '../components/home/Numbers.astro';
import ServicesIndex from '../components/ServicesIndex.astro';
import CreativeStrip from '../components/home/CreativeStrip.astro';
import Standard from '../components/Standard.astro';
import Steps from '../components/Steps.astro';
import CaseBento from '../components/home/CaseBento.astro';
import Voices from '../components/home/Voices.astro';
import Faq from '../components/Faq.astro';
import Closing from '../components/Closing.astro';
import Btn from '../components/Btn.astro';
import { CTA } from '../lib/site';
import { organizationNode } from '../lib/schema';

const SITE = Astro.site?.href.replace(/\/$/, '') ?? 'https://www.adboost.health';

// The FAQ is written once: the rows show it (answers may link), the FAQPage schema reads the same
// words with the links taken out, so the two can never drift apart.
const faq = [
  {
    q: 'How is AdBoost different from other agencies?',
    a: 'We’re a digital performance marketing agency that only works with health, <a href="/industries/telehealth/">telehealth</a>, and supplement brands, so every playbook, creative angle, and compliance check is purpose-built for your category. No generic “DTC agency” mistakes that cost you 30 days.',
  },
  {
    q: 'Do you have experience with compliant health advertising?',
    a: 'Yes. Every account is reviewed against <a href="/blog/glp1-advertising-compliance-2026/">Meta, Google, and TikTok health-vertical policies</a> before launch. We’ve shipped thousands of compliant creatives across GLP-1, supplement, and Rx-adjacent brands.',
  },
  {
    q: 'Do you create ad creatives too?',
    a: 'Absolutely. Static, motion, and UGC scripts are produced in-house weekly. Most partners get <a href="/blog/health-ad-creative-rejected-fix/">20+ new creative variants per month</a>, indexed against winning angles in our library.',
  },
  {
    q: 'When can I expect results?',
    a: 'Most partners see <a href="/blog/telehealth-cac-benchmarks-2026/">directional movement on CAC or ROAS</a> within 2 weeks. The 31-day mark is when our system compounds: tested creative library, optimized landers, and clean attribution all working in lockstep.',
  },
];
const plain = (html: string) => html.replace(/<[^>]+>/g, '');

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      ...organizationNode(SITE),
      contactPoint: { '@type': 'ContactPoint', contactType: 'sales', email: 'hello@adboost.health', areaServed: 'Worldwide' },
    },
    {
      '@type': 'WebSite',
      name: 'AdBoost Health',
      url: `${SITE}/`,
      publisher: { '@id': `${SITE}/#org` },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: plain(f.a) } })),
    },
  ],
};

const logos = [
  { src: '/logos/adidas.webp', name: 'adidas', w: 136, h: 100 },
  { src: '/logos/jnj.webp', name: 'Johnson & Johnson', w: 307, h: 80 },
  { src: '/logos/alveos.webp', name: 'alveos', w: 290, h: 70 },
  { src: '/logos/liv.webp', name: 'Liv', w: 75, h: 90, tile: true },
  { src: '/logos/fitbiomics.webp', name: 'FITBIOMICS', w: 430, h: 70 },
  { src: '/logos/nectar.webp', name: 'Nectar', w: 180, h: 90 },
  { src: '/logos/undefined-health.webp', name: 'Undefined Health', w: 337, h: 70 },
];
const ads = ['ozempic', 'alveos', 'nectar', 'vnella', 'limitless', 'mentaid', 'sweating', 'cabo'].map((n) => `/ads/${n}.webp`);
---

<BaseLayout
  title="Healthcare Marketing Agency for GLP-1 & Telehealth | AdBoost"
  description="Performance marketing agency built only for GLP-1, telehealth, and supplement brands. Lower CAC and scale spend profitably, without compliance landmines."
  canonicalPath="/"
  ogTitle="AdBoost Health, Growth Marketing for Health Brands"
  ogDescription="Lower CAC, improve LTV, and scale paid, without compliance landmines. 71+ founders served. $153M+ tracked."
  twitterDescription="Lower CAC, scale paid profitably. 71+ founders served. $153M+ tracked."
  ogImageAlt="AdBoost Health, performance marketing for health brands"
  jsonLd={jsonLd}
  nav="media"
  system
>
  <Fragment slot="head">
    <meta name="msvalidate.01" content="3FBFCB25924FCFDB29CB3D608918D577" />
    <meta name="msvalidate.01" content="B5351106503BCB2A44F89DA49D24780C" />
  </Fragment>

  <Hero
    lines={['Growth marketing for', 'fast-growing health brands.']}
    sub="A healthcare marketing agency for health and wellness brands. We help you acquire more customers profitably and increase retention through high-converting ads, funnels, and creative strategy, without the compliance landmines."
    support="Set up in 5 days. Results in 31."
    cta={{ label: 'Book a free strategy call', href: CTA.href }}
    secondary={{ label: 'See how our 5-day process works', href: '#process' }}
  />

  <TrustStrip fact="Trusted by 71+ health founders" logos={logos} />

  <Numbers
    label="AdBoost Health in numbers"
    items={[
      { value: 71, suffix: '+', read: 'More than 71 founders served.', title: 'Founders served', body: 'Health, telehealth, GLP-1, supplement and wellness brands.' },
      { value: 153, prefix: '$', suffix: 'M+', read: 'More than 153 million dollars in tracked revenue.', title: 'Tracked revenue', body: 'Across the health and wellness brands and apps we have helped grow.' },
      { value: 24, suffix: '%', read: '24 percent lower CAC, on average, in the first 30 days.', title: 'Lower CAC', body: 'What our partners average in the first 30 days.' },
    ]}
  />

  <section class="tone-paper section svc" data-nav="paper" data-dots id="services" aria-labelledby="services-h">
    <div class="dots" aria-hidden="true"><div class="dots-clip"><div class="dots-spot"></div></div></div>
    <div class="wrap">
      <header class="sec-head">
        <p class="label muted" data-reveal>What we do</p>
        <h2 id="services-h" data-lines>One compliant acquisition system, built for health.</h2>
      </header>
      <div class="duet">
        <p data-reveal>Instead of disconnected tactics, we offer a unified performance system. By bringing together paid media, creative strategy, and CRO, we help health-adjacent brands acquire customers more efficiently and drive a higher ROAS.</p>
        <p data-reveal style="--i:1">We only grow health brands. Every vertical has its own economics, ad-policy landmines, and definition of a good CAC.</p>
      </div>
      <ServicesIndex more={{ label: 'Free strategy call', line: 'Meet a senior strategist. Free live audit. A plan you keep either way.', cta: 'Book a free strategy call' }} />
    </div>
  </section>

  <CreativeStrip
    label="Creative"
    heading="Creative built for the *scroll*, and the rules of every health platform."
    note={'2,400+ <a href="/services/creative/">static & motion creatives</a> shipped this year. Every asset reviewed against Meta, Google & TikTok health policies before launch.'}
    ads={ads}
  />

  <section class="tone-paper section" data-nav="paper" aria-label="Built for health brands">
    <div class="wrap">
      <Standard
        label="Why partners love us"
        body="The only categories we work in are the ones we’ve already scaled."
        items={[
          { title: 'Compliance-first creative.', body: 'Pre-approved against health-vertical policies, so launches don’t get yanked.' },
          { title: 'A senior growth partner, not a junior pod.', body: 'Paired with strategists who have scaled health brands past $20M.' },
          { title: '20+ new creatives shipped every month.', body: 'Static, motion, and UGC, produced in-house, tested against an indexed library of winning angles, then scaled to the highest performers.' },
        ]}
        support="Built for health brands. Designed to scale."
      />
    </div>
  </section>

  <section class="tone-frame section how" data-nav="frame" id="process" aria-labelledby="process-h">
    <div class="wrap how-grid">
      <header class="how-head">
        <p class="label muted" data-reveal>How it works</p>
        <h2 id="process-h" data-reveal>Set up in 5 days. <em>Results</em> in 31.</h2>
        <p class="lede" data-reveal style="--i:1">No 90-day onboarding. No “strategy decks.” Health brands can’t afford to lose a quarter to a slow agency, neither can we.</p>
        <div data-reveal style="--i:2"><Btn href={CTA.href}>Book a free strategy call</Btn></div>
      </header>
      <Steps
        class="how-steps"
        items={[
          { title: 'Book a free strategy call', meta: 'Day 0–1', body: 'We pull your account, audit your spend, and walk you through where the real growth lives, before you pay a dollar.' },
          { title: 'Fast audit & onboarding', meta: 'Day 2–5', body: 'We map your channels, creative library, and offer architecture in 5 days. You leave with a punch list of fixes, ranked by lift.' },
          { title: 'Build the winning system', meta: 'Day 6–31', body: 'Clean creative testing framework, <a href="/services/paid-media/">scalable spend bands</a>, weekly iteration. The system compounds, every week beats the last.' },
        ]}
      />
    </div>
  </section>

  <CaseBento
    label="Real results"
    heading="Numbers from *real* partners."
    note="Snapshots from the last 12 months. Brand names anonymized, happy to walk through the underlying account on a call."
    cases={[
      {
        brand: 'NutriCore', category: 'GLP-1 support',
        title: 'Scaled paid social 6× while halving CAC.',
        body: 'From a single-channel test to a multi-platform system shipping 25+ creatives a week.',
        stats: [{ label: 'ROAS', value: '0.8× → 3.5×' }, { label: 'CAC', value: '−64%' }, { label: 'Time', value: '60 days' }],
      },
      {
        brand: 'Vitaly', category: 'Daily supps',
        title: '40% CAC reduction inside 14 days.',
        body: 'UGC creative refactor + LP redesign + offer test on day 3. Held the new floor for 6 months.',
        stats: [{ label: 'ROAS', value: '1.2× → 2.8×' }, { label: 'CAC', value: '−40%' }, { label: 'Time', value: '14 days' }],
      },
      {
        brand: 'Pulse Rx', category: 'Health app',
        title: '$0 → $1.6M in 90 days.',
        body: 'Built the full acquisition engine from a cold start: positioning, creative system, paid social, lifecycle.',
        stats: [{ label: 'Revenue', value: '$1.6M' }, { label: 'LTV', value: '+32%' }, { label: 'CAC · 90d', value: '−80%' }],
      },
    ]}
  />

  <Voices
    label="Real stories, real results"
    spotlight={{
      quote: 'AdBoost helped us launch, scale, and expand into the right channels, driving stronger acquisition and retention as we grew. We went from 0.8 ROAS to 3.5 ROAS within 60 days, and it’s never gone back.',
      name: 'Edis Zhubi',
      role: 'CEO @ Pontem',
      photo: '/people/edis.webp',
      figure: { label: 'CAC · last 90d', value: '−64%' },
    }}
    quotes={[
      { quote: 'Instant results. We had demos within 30 days. They communicate, they ship, and they actually care about the outcome.', name: 'Vincent Siva', role: 'Co-founder @ V/X' },
      { quote: 'They reduced CAC by 40% in the first two weeks. The team is specialized for our industry in a way no one else is.', name: 'Abi J', role: 'Growth @ Boost' },
      { quote: 'Genuinely customer-first throughout. They went beyond what was strictly necessary, from email to creative to performance strategy.', name: 'Oliver Obolgogiani', role: 'Co-founder @ Alveos' },
      { quote: 'They know their stuff. Keyword strategy, ad copy, optimization, every move backed by data, every week.', name: 'Claire May Von Doelln', role: 'Director @ Rainfactory' },
    ]}
  />

  <section class="tone-paper section faq-sec" data-nav="paper" id="faq" aria-labelledby="faq-h">
    <div class="wrap faq-grid">
      <header class="faq-head">
        <p class="label muted" data-reveal>FAQ</p>
        <h2 id="faq-h" data-reveal>Answers to popular <em>questions</em>.</h2>
        <p class="faq-intro" data-reveal style="--i:1">If you’re <a href="/compare/">vetting agencies</a> right now, these are the questions we hear before every kickoff.</p>
      </header>
      <Faq items={faq} />
    </div>
  </section>

  <Closing />
</BaseLayout>

<style>
  /* the tiles carry their own weight, so this band needs less air than a full section */
  .svc { padding-block: calc(var(--section) * 0.75) calc(var(--section) * 0.62); }
  .sec-head { display: grid; gap: 20px; max-width: 760px; }
  /* the two short paragraphs under the heading, set in uneven columns beneath one hairline */
  .duet {
    display: grid; grid-template-columns: minmax(0, 600px) minmax(0, 460px); justify-content: space-between;
    gap: 24px clamp(40px, 8vw, 180px); margin: clamp(40px, 5vw, 72px) 0 56px;
    padding-top: clamp(28px, 3vw, 44px); border-top: 1px solid var(--line); color: var(--fg-2);
  }
  .duet p { font-size: clamp(16.5px, 1.2vw, 18px); line-height: 1.55; }
  @media (max-width: 760px) { .duet { grid-template-columns: 1fr; margin: 40px 0 44px; padding-top: 28px; } }
  @media (max-width: 640px) {
    .sec-head { gap: 14px; }
    .duet { gap: 14px; margin: 28px 0 36px; padding-top: 22px; }
    .duet p { font-size: 16.5px; }
  }

  /* how it works: the promise and its button on the left, the three steps on their rule beside it */
  .how-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(40px, 6vw, 120px); align-items: start; }
  .how-head { display: grid; gap: 22px; justify-items: start; position: sticky; top: calc(var(--nav-h) + 32px); }
  .how-head h2 { max-width: 12ch; }
  .how-head h2 em, .faq-head h2 em { font-style: italic; }
  .how-steps { --size: clamp(24px, 2.2vw, 32px); padding-top: 8px; }
  @media (max-width: 899px) {
    .how-grid { grid-template-columns: 1fr; }
    .how-head { position: static; }
  }

  /* FAQ: the heading holds its place on the left while the rows run beside it */
  .faq-grid { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: clamp(36px, 6vw, 120px); align-items: start; }
  .faq-head { display: grid; gap: 20px; position: sticky; top: calc(var(--nav-h) + 32px); }
  .faq-intro { color: var(--fg-2); max-width: 36ch; }
  .faq-intro a { color: var(--fg); text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 3px; }
  @media (max-width: 899px) {
    .faq-grid { grid-template-columns: 1fr; }
    .faq-head { position: static; }
  }
</style>

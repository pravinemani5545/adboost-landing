---
import '../styles/global.css';
import '../styles/interior.css';
import { NAV } from '../lib/site';
import { organizationNode } from '../lib/schema';

const CAL_LINK = 'pira-ahilan-ef2dl8/strategy-call';
const CAL_NAMESPACE = 'strategy-call';
const CAL_URL = `https://cal.com/${CAL_LINK}`;

const SITE = Astro.site?.href.replace(/\/$/, '') ?? 'https://www.adboost.health';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      ...organizationNode(SITE),
      contactPoint: { '@type': 'ContactPoint', contactType: 'sales', email: 'hello@adboost.health', areaServed: 'Worldwide' },
    },
    {
      '@type': 'WebSite',
      name: 'AdBoost Health',
      url: `${SITE}/`,
      publisher: { '@id': `${SITE}/#org` },
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'How is AdBoost different from other agencies?',
          acceptedAnswer: { '@type': 'Answer', text: 'We only work with health, telehealth, and supplement brands, so every playbook, creative angle, and compliance check is purpose-built for your category. No generic “DTC agency” mistakes that cost you 30 days.' },
        },
        {
          '@type': 'Question',
          name: 'Do you have experience with compliant health advertising?',
          acceptedAnswer: { '@type': 'Answer', text: 'Yes. Every account is reviewed against Meta, Google, and TikTok health-vertical policies before launch. We’ve shipped thousands of compliant creatives across GLP-1, supplement, and Rx-adjacent brands.' },
        },
        {
          '@type': 'Question',
          name: 'Do you create ad creatives too?',
          acceptedAnswer: { '@type': 'Answer', text: 'Absolutely. Static, motion, and UGC scripts are produced in-house weekly. Most partners get 20+ new creative variants per month, indexed against winning angles in our library.' },
        },
        {
          '@type': 'Question',
          name: 'When can I expect results?',
          acceptedAnswer: { '@type': 'Answer', text: 'Most partners see directional movement on CAC or ROAS within 2 weeks. The 31-day mark is when our system compounds: tested creative library, optimized landers, and clean attribution all working in lockstep.' },
        },
      ],
    },
  ],
};

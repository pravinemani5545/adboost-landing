---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import Brief from '../../components/doc/Brief.astro';
import Toc from '../../components/doc/Toc.astro';
import AsideLinks from '../../components/doc/AsideLinks.astro';
import AsideCta from '../../components/doc/AsideCta.astro';
import Closing from '../../components/Closing.astro';
import Faq from '../../components/Faq.astro';
import { AD_POLICIES, getAdPolicy, STATUS_LABEL } from '../../data/adPolicies';
import { getVertical } from '../../data/verticals';
import { siteBase } from '../../lib/site';
import { breadcrumb, faqPage, articleNode } from '../../lib/schema';

export function getStaticPaths() {
  return AD_POLICIES.map((p) => ({ params: { slug: p.slug } }));
}
const { slug } = Astro.params;
const p = getAdPolicy(slug!)!;
const SITE = siteBase(Astro.site);
const path = `/advertising/${p.slug}/`;
// Short vertical labels keep the title tag under Google's ~60-char limit.
const V_SHORT = {
  'Med spa & aesthetics': 'Med spa',
  'GLP-1 & weight loss': 'GLP-1',
  'Supplements & DTC': 'Supplements',
  'Telehealth & Rx': 'Telehealth',
  'TRT & hormone': 'TRT',
};
const shortVertical = V_SHORT[p.vertical] ?? p.vertical;
const title = `${shortVertical} on ${p.platform}: 2026 ad compliance | AdBoost Health`;
const description = p.answer.slice(0, 155);
const updatedLabel = new Date(`${p.updated}T00:00:00Z`).toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const related = AD_POLICIES.filter((x) => x.verticalSlug === p.verticalSlug && x.slug !== p.slug);
const industry = getVertical(p.verticalSlug);
const jsonLd = [
  articleNode(SITE, { headline: p.h1, description, path, datePublished: p.published, dateModified: p.updated, image: '/og/og-home.png' }),
  breadcrumb(SITE, [{ label: 'Home', href: '/' }, { label: 'Ad compliance', href: '/advertising/' }, { label: `${p.vertical} on ${p.platform}`, href: path }]),
  faqPage(p.faq),
];
const toc = [
  { id: 'status', label: 'Is it allowed?' },
  { id: 'cert', label: 'Certification' },
  { id: 'prohibited', label: 'Prohibited claims' },
  { id: 'requirements', label: 'Disclaimers & requirements' },
  { id: 'rejections', label: 'Top rejection reasons' },
  { id: 'enforcement', label: 'What enforcement looks like' },
  { id: 'comply', label: 'How to stay compliant' },
  { id: 'faq', label: 'FAQ' },
];
---
<BaseLayout {title} {description} canonicalPath={path} {jsonLd} ogType="article">
  <PageHead label="Ad compliance" labelHref="/advertising/" title={p.h1} dots>
    <ul class="phead-facts arrive" style="--d:160ms">
      <li class="phead-status"><span class={`status ${p.status}`}>{STATUS_LABEL[p.status]}</span></li>
      <li>{p.platform} · {p.vertical}</li>
      <li>Updated {updatedLabel}</li>
      <li>Verify against live policy</li>
    </ul>
  </PageHead>

  <section class="tone-paper page-body" data-nav="paper">
    <div class="wrap doc">
      <div class="doc-main">
        <div id="status"><Brief label="The short answer">{p.answer}</Brief></div>

        <div class="doc-sec" id="cert">
          <h2>Certification & authorization</h2>
          <p>{p.certification}</p>
        </div>

        <div class="doc-sec" id="prohibited">
          <h2>What’s prohibited</h2>
          <ul class="crosses">{p.prohibited.map((x) => <li>{x}</li>)}</ul>
        </div>

        <div class="doc-sec" id="requirements">
          <h2>Disclaimers & landing-page requirements</h2>
          <div class="note"><p class="label">Requirements</p><p>{p.requirements}</p></div>
        </div>

        <div class="doc-sec" id="rejections">
          <h2>Top reasons ads get rejected</h2>
          <ul class="crosses">{p.rejectionReasons.map((x) => <li>{x}</li>)}</ul>
        </div>

        <div class="doc-sec" id="enforcement">
          <h2>What enforcement actually looks like</h2>
          <p>{p.enforcement}</p>
        </div>

        <div class="doc-sec" id="comply">
          <h2>How compliant brands still advertise</h2>
          <div class="note ok"><p class="label">The compliant path</p><p>{p.howToComply}</p></div>
          {industry && (
            <p>This page covers {p.platform} policy only. For CAC benchmarks, funnel structure, and creative strategy across the whole vertical, see <a href={`/industries/${p.verticalSlug}/`}>{industry.short} marketing: the full vertical playbook</a>.</p>
          )}
        </div>

        <div class="doc-sec" id="faq">
          <h2>FAQ</h2>
          <Faq items={p.faq} />
        </div>

        <div class="doc-sec">
          <h3>Sources</h3>
          <p class="small">Ad policies change frequently and enforcement is tightening: treat this as a starting point and confirm current requirements against each platform’s live policy and qualified counsel before launching. This is general information, not legal advice.</p>
          <ul class="links sources">{p.sources.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.label}</a></li>)}</ul>
        </div>
      </div>

      <aside class="doc-aside">
        <AsideLinks
          label={`${p.vertical} on other platforms`}
          links={[
            ...related.map((r) => ({ href: `/advertising/${r.slug}/`, label: `${p.vertical} on ${r.platform}` })),
            { href: '/blog/glp1-advertising-compliance-2026/', label: 'Compliance guide (GLP-1)' },
            { href: '/blog/telehealth-cac-benchmarks-2026/', label: 'CAC benchmarks by vertical' },
          ]}
        />
        <AsideCta heading="We clear this before you launch" text={`Every account and asset reviewed against live ${p.platform} policy, so launches don’t get yanked.`} />
        <Toc items={toc} />
      </aside>
    </div>
  </section>

  <Closing heading={`Launching ${p.vertical.toLowerCase()} ads on ${p.platform}?`} text={`We pre-clear every account and creative against ${p.platform}'s health-vertical policy so your launch doesn't get rejected or your account disabled.`} />
</BaseLayout>

<style>
  .phead-status .status { font-size: 12.5px; }
  .phead-facts li.phead-status::before { content: none; }
  .sources a { font-size: 15.5px; }
</style>

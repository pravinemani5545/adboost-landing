---
// Not found. Above the heading, the family 404 drawing (adboost-media src/pages/404.astro): a
// page that came loose from its trail, with Health's hues as the dots along it. Decorative.
import Shell from '../layouts/Shell.astro';
import Backdrop from '../family/landing/Backdrop.astro';
import '../styles/family/landing.css';
import '../styles/pages/core.css';
const DOTS = ['var(--hue-a)', 'var(--hue-b)', 'var(--hue-c)', 'var(--hue-warm)'];
---
<Shell title="Page not found | AdBoost Health" robots="noindex" social={false} popup="none" mainClass="nf fl">
  <div class="nf-band" data-pointer>
    <Backdrop spotlight focus={['50%', '38%']} />
  </div>
  <div class="nf-art" aria-hidden="true">
    <svg class="nf-trail" viewBox="0 0 420 150" fill="none"><path d="M6 120 C 70 120, 90 40, 160 46 S 250 110, 300 74" /></svg>
    <span class="nf-page"><i class="nf-l w1"></i><i class="nf-l w2"></i><i class="nf-l w3"></i><span class="nf-code">404</span><i class="nf-l w4"></i></span>
    {DOTS.map((c, i) => <i class="nf-dot" style={`--c:${c};--i:${i}`}></i>)}
  </div>
  <p class="nf-kicker" aria-hidden="true"><span class="fl-kicker"><span class="fl-kdot"></span>404</span></p>
  <h1>404: that page doesn't <span class="serif">exist.</span></h1>
  <p>The link may be old, or the page has moved. Here's where to go instead:</p>
  <div class="nf-links">
    <a class="btn btn-primary" href="/">Back to home</a>
    <a class="btn btn-ghost" href="/blog/">Read the blog</a>
  </div>
  <script>
    import '../family/landing/landing';
  </script>
</Shell>

<style is:global>
  /* a centred message on the hero band's layers (dots, hue glows, accent dots around the pointer) */
  .nf { position: relative; isolation: isolate; overflow: clip; min-height: calc(100vh - var(--fam-h, 0px)); display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: calc(var(--k-nav-h) + 24px) 24px 72px; gap: 16px; }
  .nf-band { position: absolute; inset: 0; z-index: -1; }
  .nf-band .fl-bd { -webkit-mask-image: none; mask-image: none; }
  .nf-kicker { margin: 0; }
  .nf h1 { margin: 0; max-width: 18ch; font-size: clamp(34px, 5.4vw, 64px); line-height: 1.02; letter-spacing: -.04em; font-weight: 600; color: var(--k-ink); text-wrap: balance; }
  .nf > p { margin: 0; color: var(--text-2); max-width: 44ch; font-size: 17px; line-height: 1.55; }
  .nf-links { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; margin-top: 10px; }
</style>

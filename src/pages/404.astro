---
import Shell from '../layouts/Shell.astro';
---
<Shell title="Page not found | AdBoost Health" robots="noindex" social={false} popup="none" mainClass="nf">
  <div class="k-bg k-bg--grid" aria-hidden="true"></div>
  <div class="k-bg k-bg--aura" aria-hidden="true"></div>
  <span class="brand-mark" aria-hidden="true"></span>
  <h1>404 - that page doesn't <span class="serif">exist.</span></h1>
  <p>The link may be old, or the page has moved. Here's where to go instead:</p>
  <div class="nf-links">
    <a class="btn btn-primary" href="/">Back to home</a>
    <a class="btn btn-ghost" href="/blog/">Read the blog</a>
  </div>
</Shell>

<style is:global>
  /* the hero band's layers (grid, aura) behind a centred message */
  .nf { position: relative; isolation: isolate; overflow: clip; min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: calc(var(--k-nav-h) + 24px) 24px 64px; gap: 18px; }
  .nf .k-bg--grid { --k-grid-mask: 60% 55% at 50% 45%; }
  .nf .k-bg--aura { inset: 10% 0 auto; }
  .nf .brand-mark { width: 44px; height: 44px; }
  .nf h1 { margin: 0; font-size: clamp(28px, 5vw, 44px); letter-spacing: -.03em; font-weight: 600; color: var(--k-ink); text-wrap: balance; }
  .nf p { margin: 0; color: var(--k-ink-3); max-width: 42ch; }
  .nf-links { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
</style>

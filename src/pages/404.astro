---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Page not found | AdBoost Health</title>
<meta name="robots" content="noindex" />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Instrument+Serif:ital@1&display=swap" />
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
</head>
<body>
<main class="nf">
  <span class="brand-mark" aria-hidden="true"></span>
  <h1>404 - that page doesn't <span class="serif">exist.</span></h1>
  <p>The link may be old, or the page has moved. Here's where to go instead:</p>
  <div class="nf-links">
    <a class="btn btn-primary" href="/">Back to home</a>
    <a class="btn btn-ghost" href="/blog/">Read the blog</a>
  </div>
</main>
<style>
  .nf { min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 24px; gap: 18px; }
  .nf .brand-mark { width: 44px; height: 44px; }
  .nf h1 { font-size: clamp(28px, 5vw, 44px); letter-spacing: -.03em; font-weight: 600; color: var(--ink); }
  .nf p { color: var(--mute); max-width: 42ch; }
  .nf-links { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
</style>
</body>
</html>

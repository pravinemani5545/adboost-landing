---
import LeadLayout from '../../layouts/LeadLayout.astro';
const title = 'The Zero-Ban Protocol — Free Compliance Framework | AdBoost Health';
const description = 'Get the exact compliance protocol behind $50K/month in peptide & GLP-1 Meta ad spend, with zero bans. Free checklist for health-brand advertisers.';
const steps = [
  { code: '00', name: 'Lane', desc: 'Which of the two compliance lanes you’re in, and when LegitScript is non-negotiable.' },
  { code: '01', name: 'Warm-up', desc: 'The account warm-up that buys a clean record before your first conversion campaign.' },
  { code: '02', name: 'Copy', desc: 'The words that trip Meta’s review fastest, and what to write instead.' },
  { code: '03', name: 'Creative', desc: 'Selling the transformation without a single before-and-after image.' },
  { code: '04', name: 'Scale', desc: 'Earning the right to run aggressive angles without torching your account history.' },
];
---
<LeadLayout {title} {description} canonicalPath="/zero-ban-protocol/">
  <section class="zbp">
    <div class="zbp-glow" aria-hidden="true"></div>
    <div class="container zbp-grid">
      <div class="zbp-left">
        <span class="zbp-eyebrow"><span class="zbp-dot"></span>FREE PROTOCOL · PEPTIDE &amp; GLP-1 META ADS</span>
        <h1 class="zbp-h1">The exact compliance protocol behind <span class="zbp-num" data-count="50" data-prefix="$" data-suffix="K/mo">$50K/mo</span> in peptide &amp; GLP-1 Meta ads &mdash; with <em>zero bans</em>.</h1>
        <p class="zbp-sub">The <strong>Zero-Ban Protocol</strong> we run on every peptide and GLP-1 account before we spend a dollar. Run it against your own account before your next launch, so you stop learning where Meta&rsquo;s lines are the expensive way &mdash; by crossing them.</p>

        <div class="zbp-inside-label">The 5 checkpoints you run before launch</div>
        <ol class="zbp-steps">
          {steps.map((s) => (
            <li class="zbp-step">
              <span class="zbp-step-code">{s.code}</span>
              <div class="zbp-step-body">
                <span class="zbp-step-name">{s.name}</span>
                <span class="zbp-step-desc">{s.desc}</span>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <div class="zbp-right">
        <div class="zbp-status" role="img" aria-label="Ad account status moves from restricted to cleared">
          <div class="zst-top"><span class="zst-live"></span>META ADS MANAGER · ACCOUNT STATUS</div>
          <div class="zst-row">
            <span class="zst-pill restricted">● RESTRICTED</span>
            <span class="zst-desc">One rejection from disablement</span>
          </div>
          <div class="zst-connector"><span>run the protocol</span></div>
          <div class="zst-row after">
            <span class="zst-pill cleared">● CLEARED</span>
            <span class="zst-desc">Clean record · cleared to scale</span>
          </div>
        </div>

        <div class="zbp-card">
          <div id="formState">
            <div class="zbp-card-head">Get the protocol</div>
            <p class="zbp-card-sub">Enter your details and we&rsquo;ll email the checklist right away.</p>
            <form id="leadForm" novalidate>
              <label for="lf-name">Name</label>
              <input id="lf-name" name="name" type="text" autocomplete="name" placeholder="Your name" required />
              <label for="lf-email">Work email</label>
              <input id="lf-email" name="email" type="email" autocomplete="email" placeholder="you@brand.com" required />
              <label for="lf-phone">Phone <span class="zbp-opt">optional &mdash; for a faster reply</span></label>
              <div class="zbp-phone">
                <select id="lf-cc" name="country" aria-label="Country dialing code">
                  <option value="+1">🇺🇸 +1</option>
                  <option value="+44">🇬🇧 +44</option>
                  <option value="+61">🇦🇺 +61</option>
                  <option value="+64">🇳🇿 +64</option>
                </select>
                <input id="lf-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="(416) 567-7096" />
              </div>
              <button type="submit" class="zbp-btn" id="lf-submit">Send me the protocol <span aria-hidden="true">&rarr;</span></button>
              <p class="zbp-err" id="lf-error" hidden></p>
            </form>
            <p class="zbp-trust">No spam. Unsubscribe anytime. We only work with health-vertical brands.</p>
          </div>
          <div id="successState" hidden>
            <div class="zbp-check" aria-hidden="true">✓</div>
            <div class="zbp-card-head">Check your inbox</div>
            <p class="zbp-card-sub">The Zero-Ban Protocol is on its way to <strong id="sentTo"></strong>. Not there in a minute? Check spam or promotions.</p>
            <a class="zbp-btn" href="https://cal.com/pira-ahilan-ef2dl8/strategy-call?utm_source=lead-magnet&utm_medium=lp&utm_campaign=zero-ban-protocol" target="_blank" rel="noopener">Prefer we just handle it? Book a call <span aria-hidden="true">&rarr;</span></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    .zbp {
      --z-ink:#0a0a0f; --z-ink2:#42474f; --z-mute:#8a9099; --z-line:#e7e9ee; --z-faint:#eef0f4;
      --z-surface:#f7f8fa; --z-blue:#0057ff; --z-cleared:#16a34a; --z-restricted:#ff6b3d;
      position: relative; background: #fff; color: var(--z-ink); overflow: hidden;
      padding: 100px 0 8px;  /* clears the fixed 68px nav — matches .phero */
    }
    .zbp-glow { position: absolute; inset: 0; pointer-events: none;
      background: radial-gradient(52% 40% at 20% 2%, rgba(0,87,255,.07), transparent 66%),
                  radial-gradient(40% 36% at 96% 46%, rgba(22,163,74,.045), transparent 72%); }
    .zbp-grid { position: relative; display: grid; grid-template-columns: 1.08fr .92fr; gap: 56px; align-items: start; }

    .zbp-eyebrow { display: inline-flex; align-items: center; gap: 8px; font-family:'Geist Mono',ui-monospace,monospace; font-size: 11.5px; letter-spacing: .1em; color: var(--z-blue); }
    .zbp-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--z-blue); }
    .zbp-h1 { font-size: clamp(31px, 4.6vw, 50px); line-height: 1.06; letter-spacing: -.032em; font-weight: 600; margin: 16px 0 18px; text-wrap: balance; }
    .zbp-h1 em { font-family:'Instrument Serif',Georgia,serif; font-style: italic; font-weight: 400; letter-spacing: 0; color: var(--z-blue); }
    .zbp-num { font-family:'Geist Mono',ui-monospace,monospace; font-weight: 500; font-size: .8em; letter-spacing: -.01em; color: var(--z-blue);
      background: rgba(0,87,255,.07); border: 1px solid rgba(0,87,255,.2); border-radius: 8px; padding: .04em .3em; }
    .zbp-sub { font-size: 16.5px; line-height: 1.62; color: var(--z-ink2); max-width: 47ch; margin: 0 0 28px; }
    .zbp-sub strong { color: var(--z-ink); font-weight: 600; }

    .zbp-inside-label { font-family:'Geist Mono',ui-monospace,monospace; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--z-mute); padding-top: 22px; border-top: 1px solid var(--z-line); margin-bottom: 16px; }
    .zbp-steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
    .zbp-step { display: grid; grid-template-columns: 30px 1fr; gap: 14px; align-items: baseline; }
    .zbp-step-code { font-family:'Geist Mono',ui-monospace,monospace; font-size: 13px; font-weight: 500; color: var(--z-blue); }
    .zbp-step-name { display: block; font-size: 15px; font-weight: 600; letter-spacing: -.01em; margin-bottom: 3px; }
    .zbp-step-desc { display: block; font-size: 13px; line-height: 1.5; color: var(--z-mute); }

    /* signature: account status card */
    .zbp-right { position: sticky; top: 20px; display: grid; gap: 16px; }
    .zbp-status { background: var(--z-surface); border: 1px solid var(--z-line); border-radius: 14px; padding: 15px 17px; }
    .zst-top { font-family:'Geist Mono',ui-monospace,monospace; font-size: 10.5px; letter-spacing: .07em; color: var(--z-mute); display: flex; align-items: center; gap: 8px; padding-bottom: 11px; border-bottom: 1px solid var(--z-line); }
    .zst-live { width: 7px; height: 7px; border-radius: 50%; background: var(--z-cleared); box-shadow: 0 0 0 3px rgba(22,163,74,.14); animation: zpulse 2.4s ease-in-out infinite; }
    .zst-row { display: flex; align-items: center; gap: 12px; padding: 11px 0 3px; }
    .zst-pill { font-family:'Geist Mono',ui-monospace,monospace; font-size: 11px; letter-spacing: .04em; padding: 5px 10px; border-radius: 7px; white-space: nowrap; }
    .zst-pill.restricted { color: var(--z-restricted); background: rgba(255,107,61,.1); border: 1px solid rgba(255,107,61,.24); }
    .zst-pill.cleared { color: var(--z-cleared); background: rgba(22,163,74,.1); border: 1px solid rgba(22,163,74,.26); }
    .zst-desc { font-size: 13px; color: var(--z-mute); }
    .zst-row.after .zst-desc { color: var(--z-ink); }
    .zst-connector { position: relative; height: 20px; margin-left: 12px; }
    .zst-connector::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; border-left: 1px dashed var(--z-faint); transform-origin: top; }
    .zst-connector span { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); font-family:'Geist Mono',ui-monospace,monospace; font-size: 9.5px; letter-spacing: .08em; color: var(--z-mute); text-transform: uppercase; }

    /* form card */
    .zbp-card { background: #fff; border: 1px solid var(--z-line); border-radius: 16px; padding: 24px 24px 20px; box-shadow: 0 30px 70px -46px rgba(10,10,15,.4); }
    .zbp-card-head { font-size: 19px; font-weight: 600; letter-spacing: -.02em; }
    .zbp-card-sub { color: var(--z-mute); font-size: 13.5px; line-height: 1.5; margin: 6px 0 16px; }
    #leadForm label { display: block; font-family:'Geist Mono',ui-monospace,monospace; font-size: 10.5px; letter-spacing: .06em; text-transform: uppercase; color: var(--z-mute); margin: 13px 0 6px; }
    #leadForm input { width: 100%; padding: 12px 13px; border: 1px solid var(--z-line); border-radius: 10px; font: inherit; font-size: 15px; color: var(--z-ink); background: #fff; outline: none; transition: border-color .15s, box-shadow .15s; }
    #leadForm input::placeholder { color: #b3b8c0; }
    #leadForm input:focus { border-color: var(--z-blue); box-shadow: 0 0 0 3px rgba(0,87,255,.13); }
    .zbp-opt { font-family:'Geist',sans-serif; text-transform: none; letter-spacing: 0; font-size: 10.5px; color: #b3b8c0; font-weight: 400; }
    .zbp-phone { display: flex; gap: 8px; }
    .zbp-phone select { flex: 0 0 auto; padding: 12px 10px; border: 1px solid var(--z-line); border-radius: 10px; font: inherit; font-size: 15px; color: var(--z-ink); background: #fff; outline: none; cursor: pointer; transition: border-color .15s, box-shadow .15s; }
    .zbp-phone select:focus { border-color: var(--z-blue); box-shadow: 0 0 0 3px rgba(0,87,255,.13); }
    .zbp-phone input { flex: 1 1 auto; min-width: 0; }
    .zbp-btn { display: flex; width: 100%; justify-content: center; align-items: center; gap: 8px; margin-top: 18px;
      background: var(--z-blue); color: #fff; border: 0; border-radius: 11px; padding: 13px 18px; font: inherit; font-size: 15px; font-weight: 600;
      cursor: pointer; text-decoration: none; transition: transform .12s, box-shadow .2s, background .15s; box-shadow: 0 12px 26px -14px rgba(0,87,255,.6); }
    .zbp-btn:hover { background: #1a6bff; transform: translateY(-1px); box-shadow: 0 16px 32px -14px rgba(0,87,255,.7); }
    .zbp-btn:active { transform: translateY(0); }
    .zbp-err { color: var(--z-restricted); font-size: 13px; margin: 10px 0 0; }
    .zbp-trust { color: var(--z-mute); font-size: 11.5px; margin: 14px 0 0; text-align: center; line-height: 1.5; }
    .zbp-check { width: 44px; height: 44px; border-radius: 50%; background: rgba(22,163,74,.1); border: 1px solid rgba(22,163,74,.3); color: var(--z-cleared); font-size: 22px; display: flex; align-items: center; justify-content: center; margin-bottom: 14px; }

    /* motion */
    @keyframes zpulse { 0%,100% { box-shadow: 0 0 0 3px rgba(22,163,74,.14); } 50% { box-shadow: 0 0 0 5px rgba(22,163,74,.04); } }
    @keyframes zrise { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
    .zbp-left > *, .zbp-right { animation: zrise .55s cubic-bezier(.2,.7,.2,1) both; }
    .zbp-h1 { animation-delay: .04s; } .zbp-sub { animation-delay: .09s; } .zbp-inside-label, .zbp-steps { animation-delay: .13s; }
    .zbp-right { animation-delay: .11s; }

    /* signature: the account status resolves from RESTRICTED → CLEARED on load */
    @keyframes zdraw { from { transform: scaleY(0); } to { transform: scaleY(1); } }
    @keyframes zsettle { 0% { box-shadow: 0 0 0 0 rgba(22,163,74,.42); } 100% { box-shadow: 0 0 0 9px rgba(22,163,74,0); } }
    .zst-connector::before { animation: zdraw .5s cubic-bezier(.2,.7,.2,1) .5s both; }
    .zst-connector span { animation: zrise .4s ease .78s both; }
    .zst-row.after { animation: zrise .5s cubic-bezier(.2,.7,.2,1) .62s both; }
    .zst-pill.cleared { animation: zsettle 1.1s ease-out 1.02s both; }

    /* checkpoint list settles in with a light stagger */
    .zbp-step { animation: zrise .5s cubic-bezier(.2,.7,.2,1) both; }
    .zbp-step:nth-child(1) { animation-delay: .16s; }
    .zbp-step:nth-child(2) { animation-delay: .22s; }
    .zbp-step:nth-child(3) { animation-delay: .28s; }
    .zbp-step:nth-child(4) { animation-delay: .34s; }
    .zbp-step:nth-child(5) { animation-delay: .40s; }

    @media (max-width: 900px) {
      .zbp { padding-top: 92px; }
      .zbp-grid { grid-template-columns: 1fr; gap: 30px; }
      .zbp-right { position: static; }
    }
    @media (prefers-reduced-motion: reduce) {
      .zbp-left > *, .zbp-right, .zst-live, .zbp-step,
      .zst-connector::before, .zst-connector span, .zst-row.after, .zst-pill.cleared { animation: none; }
    }
  </style>

  <script is:inline>
    (function () {
      const form = document.getElementById('leadForm');
      const btn = document.getElementById('lf-submit');
      const err = document.getElementById('lf-error');
      const formState = document.getElementById('formState');
      const successState = document.getElementById('successState');
      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        err.hidden = true;
        const name = document.getElementById('lf-name').value.trim();
        const email = document.getElementById('lf-email').value.trim();
        const phone = document.getElementById('lf-phone').value.trim();
        const country = document.getElementById('lf-cc').value;
        if (!name || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
          err.textContent = 'Please enter your name and a valid email.'; err.hidden = false; return;
        }
        btn.disabled = true; btn.style.opacity = '.7'; btn.textContent = 'Sending…';
        try {
          const r = await fetch('/api/subscribe/', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name: name, email: email, phone: phone, country: country, source: 'zero-ban-protocol' })
          });
          if (!r.ok) throw new Error('bad status');
          document.getElementById('sentTo').textContent = email;
          formState.hidden = true; successState.hidden = false;
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } catch (_) {
          btn.disabled = false; btn.style.opacity = '1'; btn.innerHTML = 'Send me the protocol <span aria-hidden="true">&rarr;</span>';
          err.textContent = 'Something went wrong. Please try again, or email hello@adboost.health.'; err.hidden = false;
        }
      });
    })();
  </script>

  <script is:inline>
    (function () {
      var el = document.querySelector('.zbp-num[data-count]');
      if (!el) return;
      var target = parseInt(el.getAttribute('data-count'), 10) || 0;
      var pre = el.getAttribute('data-prefix') || '';
      var suf = el.getAttribute('data-suffix') || '';
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce || !('IntersectionObserver' in window)) return; /* leave the final value in the HTML */
      function run() {
        var start = null, dur = 1000;
        function tick(ts) {
          if (start === null) start = ts;
          var p = Math.min((ts - start) / dur, 1);
          var eased = 1 - Math.pow(1 - p, 3);
          el.textContent = pre + Math.round(eased * target) + suf;
          if (p < 1) requestAnimationFrame(tick);
        }
        requestAnimationFrame(tick);
      }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.isIntersecting) { run(); io.disconnect(); } });
      }, { threshold: .6 });
      io.observe(el);
    })();
  </script>
</LeadLayout>

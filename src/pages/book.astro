---
// /book - every booking CTA lands here. Embeds the Google Calendar appointment
// schedule inline (each booking gets a Google Meet link). t.js records the visit
// with any incoming utm (YouTube, email), and off-site arrivals log a
// book_call_click here so the admin booking-webhook can attribute the booking.
// Not indexed.
import BaseLayout from '../layouts/BaseLayout.astro';
import { BOOKING_EMBED_URL } from '../lib/site';

const title = 'Book a Free Strategy Call | AdBoost Health';
const description = 'Pick a time for a free 30-minute strategy call with a senior AdBoost Health strategist. Free account audit included.';
---
<BaseLayout {title} {description} canonicalPath="/book/" noindex>
  <section class="phero wide">
    <div class="container">
      <span class="eyebrow sec-eyebrow" style="display:block"><span class="dot"></span>Strategy call</span>
      <h1>Book your free <span class="serif">strategy call</span></h1>
      <p class="phero-lede">30 minutes with a senior strategist on Google Meet. Free account audit included, and a written plan you keep whether you work with us or not.</p>
    </div>
  </section>

  <section class="iwrap">
    <div class="container">
      <div class="book-frame">
        <div class="book-frame__bar" aria-hidden="true"><span class="book-dots"><i></i><i></i><i></i></span><span class="book-frame__url"></span></div>
        <iframe src={BOOKING_EMBED_URL} title="Book a free strategy call with AdBoost Health" loading="eager"></iframe>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      // On-site CTAs already logged their click; only report off-site arrivals.
      var internal = false;
      try { internal = !!document.referrer && new URL(document.referrer).host === location.host; } catch (e) {}
      if (internal) return;
      var tries = 0;
      (function fire() {
        if (window.abTrack) return window.abTrack('book_call_click', { cta_location: 'book-direct' });
        if (++tries < 20) setTimeout(fire, 250);
      })();
    })();
  </script>
</BaseLayout>

<style>
  .book-frame { position: relative; background: #fff; border: 1px solid var(--k-line); border-radius: var(--k-r-xl); overflow: hidden; box-shadow: var(--k-e3), var(--k-edge-light), 0 50px 90px -60px rgb(var(--hue-b) / .7); }
  .book-frame__bar { display: flex; align-items: center; gap: 16px; padding: 12px 18px; border-bottom: 1px solid var(--k-line); background: linear-gradient(90deg, rgb(var(--hue-a) / .05), rgb(var(--hue-b) / .04) 60%, rgb(var(--hue-c) / .05)), var(--k-paper-2); }
  .book-dots { display: inline-flex; gap: 6px; }
  .book-dots i { width: 9px; height: 9px; border-radius: 50%; background: var(--k-line-2); }
  .book-dots i:nth-child(1) { background: color-mix(in srgb, var(--k-bad) 55%, var(--k-paper)); }
  .book-dots i:nth-child(2) { background: color-mix(in srgb, var(--k-warn) 60%, var(--k-paper)); }
  .book-dots i:nth-child(3) { background: color-mix(in srgb, var(--k-ok) 55%, var(--k-paper)); }
  .book-frame__url { flex: 0 1 280px; height: 10px; border-radius: 5px; background: var(--k-paper-3); }
  .book-frame iframe { display: block; width: 100%; height: 760px; border: 0; }
  @media (max-width: 640px) { .book-frame iframe { height: 1000px; } }
</style>

---
// /book - every booking CTA lands here. Embeds the Google Calendar appointment
// schedule inline (each booking gets a Google Meet link). t.js records the visit
// with any incoming utm (YouTube, email), and off-site arrivals log a
// book_call_click here so the admin booking-webhook can attribute the booking.
// Not indexed.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import { BOOKING_EMBED_URL } from '../lib/site';

const title = 'Book a Free Strategy Call | AdBoost Health';
const description = 'Pick a time for a free 30-minute strategy call with a senior AdBoost Health strategist. Free account audit included.';
---
<BaseLayout {title} {description} canonicalPath="/book/" noindex>
  <PageHead
    label="Strategy call"
    title="Book your free strategy call"
    lede="30 minutes with a senior strategist on Google Meet. Free account audit included, and a written plan you keep whether you work with us or not."
    dots
  />

  <section class="book tone-paper" data-nav="paper">
    <div class="wrap">
      <div class="book-frame">
        <iframe src={BOOKING_EMBED_URL} title="Book a free strategy call with AdBoost Health" loading="eager"></iframe>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      // On-site CTAs already logged their click; only report off-site arrivals.
      var internal = false;
      try { internal = !!document.referrer && new URL(document.referrer).host === location.host; } catch (e) {}
      if (internal) return;
      var tries = 0;
      (function fire() {
        if (window.abTrack) return window.abTrack('book_call_click', { cta_location: 'book-direct' });
        if (++tries < 20) setTimeout(fire, 250);
      })();
    })();
  </script>
</BaseLayout>

<style>
  .book { padding: 0 0 var(--section); }
  /* the calendar is Google's own white page, so it sits on a white panel in both schemes */
  .book-frame { background: #fff; border-radius: var(--r-panel); clip-path: inset(0 round var(--r-panel)); overflow: clip; box-shadow: 0 0 0 1px var(--line); }
  .book-frame iframe { display: block; width: 100%; height: 760px; border: 0; }
  @media (max-width: 640px) { .book-frame iframe { height: 1000px; } }
</style>

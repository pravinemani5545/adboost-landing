---
// Posts without frontmatter diagrams. Posts that have them build from [id].astro instead: Astro
// bundles CSS per route file, so keeping every diagram import out of this route keeps diagram
// CSS off these pages. Shared page logic lives in _post.ts.
import BlogLayout from '../../layouts/BlogLayout.astro';
import { getPublishedPosts } from '../../lib/blog';
import { postBody, postLayoutProps } from './_post';
import '../../styles/family/content.css';
import '../../styles/family/blog-post.css';

export async function getStaticPaths() {
  const all = await getPublishedPosts();
  return all
    .filter((post) => !post.data.diagrams)
    .map((post) => ({ params: { slug: post.id }, props: { post, all } }));
}

const { post, all } = Astro.props;
const site = Astro.site?.href.replace(/\/$/, '') ?? 'https://www.adboost.health';
// With no frontmatter diagrams, any <!-- diagram: id --> marker fails the build here.
const { lead, parts } = postBody(post);
const html = parts.map((p) => (p.type === 'html' ? p.html : '')).join('');
---

<BlogLayout {...postLayoutProps(post, all, site)} {lead}>
  <div class="pg-prose post-prose"><Fragment set:html={html} /></div>
</BlogLayout>

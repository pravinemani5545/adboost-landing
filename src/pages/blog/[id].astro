---
// Posts with frontmatter diagrams. Each "<!-- diagram: id -->" line in the post becomes a figure
// between two runs of prose (the table or list it draws stays right below it). They have their
// own route so that diagram CSS ships only with them (see [slug].astro and _post.ts).
import BlogLayout from '../../layouts/BlogLayout.astro';
import PostDiagram from './_Diagram.astro';
import { getPublishedPosts } from '../../lib/blog';
import { postBody, postLayoutProps } from './_post';
import '../../styles/family/content.css';
import '../../styles/family/blog-post.css';

export async function getStaticPaths() {
  const all = await getPublishedPosts();
  return all
    .filter((post) => post.data.diagrams)
    .map((post) => ({ params: { id: post.id }, props: { post, all } }));
}

const { post, all } = Astro.props;
const site = Astro.site?.href.replace(/\/$/, '') ?? 'https://www.adboost.health';
const { lead, parts } = postBody(post);
---

<BlogLayout {...postLayoutProps(post, all, site)} {lead}>
  {parts.map((p) =>
    p.type === 'html'
      ? <div class="pg-prose post-prose"><Fragment set:html={p.html} /></div>
      : <div class="post-fig"><PostDiagram {...p.spec} id={p.spec.id ?? `fig-${p.id}`} class:list={[p.spec.class]} /></div>
  )}
</BlogLayout>

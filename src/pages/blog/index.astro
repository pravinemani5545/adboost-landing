---
import BlogLayout from '../../layouts/BlogLayout.astro';
import { getPublishedPosts } from '../../lib/blog';
import { readMinutes } from './_post';

const posts = await getPublishedPosts();

const site = Astro.site?.href.replace(/\/$/, '') ?? 'https://www.adboost.health';
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
// The first screen never waits on a reveal: the lead card and the next row stay put.
const REVEAL_FROM = 4;
---

<BlogLayout
  title="Health Brand Growth Blog | AdBoost Health"
  description="Playbooks on compliant health advertising, telehealth CAC benchmarks, and scaling paid media for GLP-1, supplement & wellness brands."
  canonical={`${site}/blog/`}
>
  <header class="blog-head">
    <span class="eyebrow arrive"><span class="dot"></span>Blog</span>
    <h1 class="arrive">Growth playbooks for <span class="serif">health</span> brands.</h1>
    <p class="arrive" style="--d:60ms">What we learn managing paid media for 71+ health, telehealth, and supplement founders - written down.</p>
  </header>
  <ol class="post-grid">
    {posts.map((post, i) => (
      <li
        class:list={['post-grid__item', i === 0 && 'is-lead']}
        data-reveal={i >= REVEAL_FROM ? '' : undefined}
        style={i >= REVEAL_FROM ? `--i:${(i - REVEAL_FROM) % 3}` : undefined}
      >
        <a class="k-card k-card--link blog-card" href={`/blog/${post.id}/`}>
          {post.data.heroImage && (
            <span class="k-card__media" data-vt-card={post.id}>
              <img src={`${post.data.heroImage}?v=2`} alt={post.data.heroAlt ?? ''} loading={i === 0 ? 'eager' : 'lazy'} decoding={i === 0 ? undefined : 'async'} fetchpriority={i === 0 ? 'high' : undefined} width="640" height="360" />
            </span>
          )}
          <span class="k-card__body">
            <span class="card-meta">
              <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
              <span aria-hidden="true">·</span>
              <span>{readMinutes(post)} min read</span>
            </span>
            <h2 class="card-title">{post.data.title}</h2>
            <span class="card-desc">{post.data.description}</span>
            <span class="read-more">Read article <span aria-hidden="true">→</span></span>
          </span>
        </a>
      </li>
    ))}
  </ol>
</BlogLayout>

---
// The blog index: a hero (H1, lede, topic filter) beside the latest post, then every other post in
// varied rows (two wide cards, three standard, four compact, repeating). The topic filter is a
// radio group from the posts' own tags and works without JavaScript: CSS hides the cards a topic
// does not cover (rules generated below). The varied rows give way to an even grid while a topic
// is chosen.
import BlogLayout from '../../layouts/BlogLayout.astro';
import PostCard from '../../components/resources/PostCard.astro';
import { getPublishedPosts } from '../../lib/blog';
import { category, readMinutes } from './_post';

const posts = await getPublishedPosts();

const site = Astro.site?.href.replace(/\/$/, '') ?? 'https://www.adboost.health';

// Topics: every tag on a published post, merged case-insensitively ("CAC" and "cac"), the spelling
// with capitals kept. Most-used first; the first ones are chips, the rest sit under "More topics".
const slugify = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const topicMap = new Map<string, { slug: string; label: string; count: number; feed: number }>();
posts.forEach((p, i) => {
  for (const tag of new Set(p.data.tags)) {
    const slug = slugify(tag);
    const t = topicMap.get(slug) ?? { slug, label: tag, count: 0, feed: 0 };
    if (tag !== tag.toLowerCase() && t.label === t.label.toLowerCase()) t.label = tag;
    t.count++;
    if (i > 0) t.feed++;
    topicMap.set(slug, t);
  }
});
const topics = [...topicMap.values()].sort((a, b) => b.count - a.count || a.label.localeCompare(b.label));
const SHOWN = 9;
const lead = topics.slice(0, SHOWN);
const more = topics.slice(SHOWN);
const topicsOf = (tags: string[]) => ` ${[...new Set(tags.map(slugify))].join(' ')} `;

// One rule per topic: hide what it does not cover, dim the latest post when it is not on the topic,
// and say so when the latest post is the only one on it.
const filterCss = topics
  .map((t) => {
    const on = `.rs-blog:has(#tp-${t.slug}:checked)`;
    const rules = [
      `${on} .rs-feed>li:not([data-topics~="${t.slug}"]){display:none}`,
      `${on} .rs-feature:not([data-topics~="${t.slug}"]){opacity:.42;filter:saturate(.2)}`,
    ];
    if (t.feed === 0) rules.push(`${on} .rs-feed__empty{display:block}`);
    return rules.join('');
  })
  .join('');

// Row pattern for the feed (the latest post leads the hero): 2 wide, 3 standard, 4 compact.
const PATTERN = ['wide', 'wide', 'std', 'std', 'std', 'row', 'row', 'row', 'row'] as const;
// The first screen never waits on a reveal: the hero and the first row stay put.
const REVEAL_FROM = 2;
const [latest, ...rest] = posts;
---

<BlogLayout
  title="Health Brand Growth Blog | AdBoost Health"
  description="Playbooks on compliant health advertising, telehealth CAC benchmarks, and scaling paid media for GLP-1, supplement & wellness brands."
  canonical={`${site}/blog/`}
>
  <style is:inline set:html={filterCss}></style>
  <div class="rs-blog">
    <section class="rs-bhero">
      <div class="rs-bhero__bg" aria-hidden="true">
        <div class="k-bg k-bg--grid"></div>
        <div class="rs-glow rs-glow--a"></div>
        <div class="rs-glow rs-glow--b"></div>
      </div>
      <div class="container rs-bhero__grid">
        <div class="rs-bhero__head">
          <header class="blog-head">
            <span class="eyebrow arrive"><span class="dot"></span>Blog</span>
            <h1 class="arrive">Growth playbooks for <span class="serif">health</span> brands.</h1>
            <p class="arrive" style="--d:60ms">What we learn managing paid media for 71+ health, telehealth, and supplement founders - written down.</p>
          </header>
          <fieldset class="rs-topics arrive" style="--d:90ms">
            <legend class="rs-topics__k">Browse by topic</legend>
            <div class="rs-topics__row">
              <input class="rs-topic-in" type="radio" name="topic" id="tp-all" value="" checked />
              <label class="rs-chip" for="tp-all">All topics</label>
              {lead.map((t) => (
                <>
                  <input class="rs-topic-in" type="radio" name="topic" id={`tp-${t.slug}`} value={t.slug} />
                  <label class="rs-chip" for={`tp-${t.slug}`}>{t.label}</label>
                </>
              ))}
            </div>
            {more.length > 0 && (
              <details class="rs-topics__more">
                <summary class="rs-chip rs-chip--more">More topics</summary>
                <div class="rs-topics__row">
                  {more.map((t) => (
                    <>
                      <input class="rs-topic-in" type="radio" name="topic" id={`tp-${t.slug}`} value={t.slug} />
                      <label class="rs-chip" for={`tp-${t.slug}`}>{t.label}</label>
                    </>
                  ))}
                </div>
              </details>
            )}
          </fieldset>
        </div>
        {latest && (
          <div class="rs-feature arrive" style="--d:120ms" data-topics={topicsOf(latest.data.tags)}>
            <PostCard
              href={`/blog/${latest.id}/`}
              title={latest.data.title}
              description={latest.data.description}
              image={latest.data.heroImage}
              alt={latest.data.heroAlt}
              date={latest.data.pubDate}
              category={category(latest)}
              minutes={readMinutes(latest)}
              size="feature"
              flag="Latest"
              eager
              vt={latest.id}
            />
          </div>
        )}
      </div>
    </section>

    <section class="container rs-feedwrap" aria-label="All articles">
      <ol class="rs-feed">
        {rest.map((post, i) => (
          <li
            class={`rs-feed__item rs-feed__item--${PATTERN[i % PATTERN.length]}`}
            data-topics={topicsOf(post.data.tags)}
            data-reveal={i >= REVEAL_FROM ? '' : undefined}
            style={i >= REVEAL_FROM ? `--i:${i % 3}` : undefined}
          >
            <PostCard
              href={`/blog/${post.id}/`}
              title={post.data.title}
              description={post.data.description}
              image={post.data.heroImage}
              alt={post.data.heroAlt}
              date={post.data.pubDate}
              category={category(post)}
              minutes={readMinutes(post)}
              size={PATTERN[i % PATTERN.length]}
              vt={post.id}
            />
          </li>
        ))}
      </ol>
      <p class="rs-feed__empty">The latest article, above, is the only one on this topic so far.</p>
    </section>
  </div>
</BlogLayout>

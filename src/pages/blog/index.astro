---
import BlogLayout from '../../layouts/BlogLayout.astro';
import PageHead from '../../components/PageHead.astro';
import { getPublishedPosts } from '../../lib/blog';

const posts = await getPublishedPosts();

const site = Astro.site?.href.replace(/\/$/, '') ?? 'https://www.adboost.health';
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<BlogLayout
  title="Health Brand Growth Blog | AdBoost Health"
  description="Playbooks on compliant health advertising, telehealth CAC benchmarks, and scaling paid media for GLP-1, supplement & wellness brands."
  canonical={`${site}/blog/`}
>
  <PageHead
    label="Blog"
    title="Growth playbooks for health brands."
    lede="What we learn managing paid media for 71+ health, telehealth, and supplement founders, written down."
    dots
  />
  <section class="posts tone-paper" data-nav="paper">
    <div class="wrap post-list">
      {posts.map((post, i) => (
        <a class="post-card card" href={`/blog/${post.id}/`} data-reveal style={`--i:${i % 3}`}>
          {post.data.heroImage && <img class="framed" src={`${post.data.heroImage}?v=2`} alt={post.data.heroAlt ?? ''} loading={i < 3 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} width="640" height="360" />}
          <time class="idx" datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
          <h2>{post.data.title}</h2>
          <p>{post.data.description}</p>
        </a>
      ))}
    </div>
  </section>
</BlogLayout>

<style>
  .posts { padding: clamp(8px, 2vw, 24px) 0 var(--section); }
  .post-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: clamp(16px, 2vw, 28px); }
  .post-card { display: grid; align-content: start; gap: 12px; padding: 14px 14px 24px; border-radius: var(--r-panel); }
  .post-card img { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; margin-bottom: 8px; }
  .post-card h2 { font-size: clamp(22px, 1.7vw, 27px); line-height: 1.18; }
  .post-card p { font-size: 15px; color: var(--fg-2); }
  @media (max-width: 640px) { .post-card p { font-size: 16px; } }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import { EMAIL, MAILING_ADDRESS, siteBase } from '../../lib/site';
import { breadcrumb } from '../../lib/schema';

const SITE = siteBase(Astro.site);
const title = 'Newsletter: Health Ad Policy & Growth Notes | AdBoost Health';
const description = 'The AdBoost Health newsletter: short notes on Meta, Google and TikTok ad policy changes and what is working for GLP-1, telehealth and supplement brands.';
const jsonLd = [breadcrumb(SITE, [{ label: 'Home', href: '/' }, { label: 'Newsletter', href: '/newsletter/' }])];
const topics = [
  { h: 'Policy changes, early', p: 'When Meta, Google or TikTok change what health brands can run, you hear what changed, who it hits and what to do about it.' },
  { h: 'What is working now', p: 'Angles, formats and funnel fixes from the GLP-1, telehealth and supplement accounts we run, with the numbers that matter.' },
  { h: 'No filler', p: 'Short, practical, and only when there is something worth saying. Every email has a one-click unsubscribe.' },
];
---
<BaseLayout {title} {description} canonicalPath="/newsletter/" {jsonLd}>
  <PageHero
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Newsletter' }]}
    eyebrow="NEWSLETTER"
    title='Know when the ad rules <span class="serif">change.</span>'
    lede="Ad policy changes and growth notes for health and wellness brands, from the team that runs their paid media."
  >
    <div class="nl-signup arrive">
      <NewsletterForm source="newsletter-page" withName button="Subscribe" />
    </div>
  </PageHero>

  <section class="iwrap">
    <div class="container">
      {/* h2: the topic cards sit directly under the h1 (heading order h1, h2) */}
      <div class="grid-cards three nl-topics">
        {topics.map((t) => (
          <div class="lcard">
            <h2>{t.h}</h2>
            <p>{t.p}</p>
          </div>
        ))}
      </div>

      <div class="prose nl-who">
        <h2>Who sends it</h2>
        <p>
          AdBoost Health{MAILING_ADDRESS && `, ${MAILING_ADDRESS}`}. Questions or requests: <a href={`mailto:${EMAIL}`}>{EMAIL}</a>.
          You can withdraw your consent at any time with the unsubscribe link at the bottom of every email, or by emailing us.
          How we handle your data is in our <a href="/privacy/">privacy policy</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nl-signup { --d: 120ms; max-width: 520px; margin-top: 26px; }
  .nl-topics .lcard h2 { margin: 0; font-size: 18px; font-weight: 600; letter-spacing: -0.015em; line-height: 1.25; text-wrap: balance; }
  .nl-who { max-width: 760px; margin-top: var(--k-sp-7); }
</style>

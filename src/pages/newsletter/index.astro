---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Backdrop from '../../family/landing/Backdrop.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import { EMAIL, MAILING_ADDRESS, siteBase } from '../../lib/site';
import { breadcrumb } from '../../lib/schema';
import '../../styles/family/landing.css';
import '../../styles/pages/core.css';

const SITE = siteBase(Astro.site);
const title = 'Newsletter: Health Ad Policy & Growth Notes | AdBoost Health';
const description = 'The AdBoost Health newsletter: short notes on Meta, Google and TikTok ad policy changes and what is working for GLP-1, telehealth and supplement brands.';
const jsonLd = [breadcrumb(SITE, [{ label: 'Home', href: '/' }, { label: 'Newsletter', href: '/newsletter/' }])];
// topic card icons (decorative): a policy page, a rising line, a clean inbox
const TOPIC_ICON = [
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 00-2 2v14a2 2 0 002 2h10a2 2 0 002-2V8l-5-5z"/><path d="M14 3v5h5M9 13h6M9 17h4"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 18l5-5 4 4 7-9"/><path d="M15 8h5v5"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M3.5 7l8.5 6 8.5-6"/></svg>',
];
const topics = [
  { h: 'Policy changes, early', p: 'When Meta, Google or TikTok change what health brands can run, you hear what changed, who it hits and what to do about it.' },
  { h: 'What is working now', p: 'Angles, formats and funnel fixes from the GLP-1, telehealth and supplement accounts we run, with the numbers that matter.' },
  { h: 'No filler', p: 'Short, practical, and only when there is something worth saying. Every email has a one-click unsubscribe.' },
];
---
<BaseLayout {title} {description} canonicalPath="/newsletter/" {jsonLd}>
<div class="fl">
  <section class="nw" data-pointer>
    <Backdrop spotlight />
    <div class="container nw-in">
      <div class="nw-hero">
        <div class="nw-copy">
          <header class="nw-head">
            <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Newsletter' }]} />
            <span class="eyebrow fl-kicker sec-eyebrow"><span class="dot"></span>NEWSLETTER</span>
            <h1 class="arrive">Know when the ad rules <span class="serif">change.</span></h1>
            <p class="phero-lede arrive" style="--d:60ms">Ad policy changes and growth notes for health and wellness brands, from the team that runs their paid media.</p>
          </header>
          <div class="nw-form arrive" style="--d:120ms">
            <NewsletterForm source="newsletter-page" withName button="Subscribe" />
          </div>
        </div>

        {/* decorative: a sample issue; its only words are the three topic headings below and the
            third topic's own "one-click unsubscribe" */}
        <div class="nw-issue arrive" style="--d:160ms" aria-hidden="true">
          <i class="nw-issue-back"></i>
          <div class="nw-mail">
            <div class="nw-mail-bar"><span class="lx-dots"><i></i><i></i><i></i></span><i class="lx-url"></i></div>
            <div class="nw-mail-from"><span class="nw-av"><span class="brand-mark"></span></span><span class="nw-from"><b>AdBoost Health</b><i></i></span><span class="nw-mail-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M3.5 7l8.5 6 8.5-6"/></svg></span></div>
            <div class="nw-sec s1">
              <span class="nw-lab">{topics[0].h}</span>
              <span class="nw-policy"><span class="lx-pill bad">Meta</span><span class="nw-arrow">→</span><span class="lx-pill">Google</span><span class="nw-arrow">→</span><span class="lx-pill c">TikTok</span></span>
              <span class="nw-lines"><i></i><i class="s"></i></span>
            </div>
            <div class="nw-sec s2">
              <span class="nw-lab">{topics[1].h}</span>
              <span class="nw-chart">{[.34, .48, .42, .62, .56, .78, .9].map((h) => <i style={`--h:${h}`}></i>)}</span>
              <span class="nw-lines"><i></i><i class="s"></i></span>
            </div>
            <div class="nw-sec s3">
              <span class="nw-lab">{topics[2].h}</span>
              <span class="nw-lines"><i class="m"></i></span>
            </div>
            <div class="nw-mail-foot">one-click unsubscribe</div>
          </div>
        </div>
      </div>

      {/* h2: the topic cards sit directly under the h1 (heading order h1, h2) */}
      <div class="nw-grid">
        {topics.map((t, i) => (
          <div class:list={['nw-card reveal', `d${i}`]}>
            <span class="nw-card-ic" aria-hidden="true" set:html={TOPIC_ICON[i]} />
            <h2>{t.h}</h2>
            <p>{t.p}</p>
          </div>
        ))}
      </div>

      <div class="nw-who reveal">
        <span class="nw-who-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M3.5 7l8.5 6 8.5-6"/></svg></span>
        <div>
          <h2>Who sends it</h2>
          <p>
            AdBoost Health{MAILING_ADDRESS && `, ${MAILING_ADDRESS}`}. Questions or requests: <a href={`mailto:${EMAIL}`}>{EMAIL}</a>.
            You can withdraw your consent at any time with the unsubscribe link at the bottom of every email, or by emailing us.
            How we handle your data is in our <a href="/privacy/">privacy policy</a>.
          </p>
        </div>
      </div>
    </div>
  </section>
</div>

<Fragment slot="scripts">
<script>
  import '../../family/landing/landing';
</script>
</Fragment>
</BaseLayout>

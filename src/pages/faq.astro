---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Toc from '../components/doc/Toc.astro';
import AsideCta from '../components/doc/AsideCta.astro';
import Closing from '../components/Closing.astro';
import Faq from '../components/Faq.astro';
import { siteBase } from '../lib/site';
import { breadcrumb, faqPage } from '../lib/schema';
import { FAQ_GROUPS } from '../data/faq';

const SITE = siteBase(Astro.site);
const groups = FAQ_GROUPS;
const all = groups.flatMap((g) => g.items);
const title = 'Frequently Asked Questions | AdBoost Health';
const description = 'Answers to the questions health founders ask before hiring a growth agency - how we work, compliance, creative, and how fast you see results.';
const jsonLd = [
  breadcrumb(SITE, [{ label: 'Home', href: '/' }, { label: 'FAQ', href: '/faq/' }]),
  faqPage(all),
];
const idOf = (t: string) => t.toLowerCase().replace(/\W+/g, '-');
const offsets = groups.map((_, i) => groups.slice(0, i).reduce((n, g) => n + g.items.length, 0));
---
<BaseLayout {title} {description} canonicalPath="/faq/" {jsonLd}>
  <PageHead
    label="FAQ"
    title="Answers to popular *questions*"
    lede="The questions we hear before every kickoff: how we work, how we handle compliance, and how fast you can expect results."
    dots
  />

  <section class="tone-paper page-body" data-nav="paper">
    <div class="wrap doc">
      <div class="doc-main faq-groups">
        {groups.map((g, i) => (
          <div class="doc-sec" id={idOf(g.title)}>
            <h2 class="faq-g">{g.title}</h2>
            <Faq items={g.items} start={offsets[i]} />
          </div>
        ))}
      </div>
      <aside class="doc-aside">
        <AsideCta heading="Still have a question?" text="Ask a senior strategist on a free 30-minute call." />
        <Toc label="Jump to" items={groups.map((g) => ({ id: idOf(g.title), label: g.title }))} />
      </aside>
    </div>
  </section>

  <Closing />
</BaseLayout>

<style>
  .faq-groups { gap: clamp(48px, 5vw, 80px); }
  .faq-g { font-size: clamp(26px, 2.4vw, 34px); }
</style>

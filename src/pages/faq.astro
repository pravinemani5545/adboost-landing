---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Backdrop from '../family/landing/Backdrop.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import '../styles/family/landing.css';
import '../styles/family/landing-pages.css';
import '../styles/pages/core.css';
import { siteBase } from '../lib/site';
import { breadcrumb, faqPage } from '../lib/schema';
import { FAQ_GROUPS } from '../data/faq';

const SITE = siteBase(Astro.site);
const groups = FAQ_GROUPS;
const all = groups.flatMap((g) => g.items);
const groupId = (title: string) => title.toLowerCase().replace(/\W+/g, '-');
// group icons (decorative): working together, compliance, creative and performance
const GROUP_ICON = [
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 11a3.5 3.5 0 100-7 3.5 3.5 0 000 7zM2.5 20a5.5 5.5 0 0111 0M16 11a3 3 0 100-6M18 20h3.5a5 5 0 00-5-5"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5.5c0 4.2-3 7.6-7 9.5-4-1.9-7-5.3-7-9.5V6l7-3z"/><path d="M9 12l2.2 2.2L15.5 10"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 18l5-5 4 4 7-9"/><path d="M15 8h5v5"/></svg>',
];
const title = 'Frequently Asked Questions | AdBoost Health';
const description = 'Answers to the questions health founders ask before hiring a growth agency: how we work, compliance, creative, and how fast you see results.';
const jsonLd = [
  breadcrumb(SITE, [{ label: 'Home', href: '/' }, { label: 'FAQ', href: '/faq/' }]),
  faqPage(all),
];
---
<BaseLayout {title} {description} canonicalPath="/faq/" {jsonLd}>
<div class="fl">
  <section class="fl-ph fq-hero" data-pointer>
    <Backdrop spotlight focus={['72%', '40%']} />
    <div class="container fl-ph-grid">
      <div>
        <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'FAQ' }]} />
        <span class="eyebrow fl-kicker sec-eyebrow"><span class="dot"></span>FAQ</span>
        <h1 class="arrive">Answers to <span class="serif">popular questions</span></h1>
        <p class="fl-ph-lede arrive" style="--d:60ms">The questions we hear before every kickoff: how we work, how we handle compliance, and how fast you can expect results.</p>
      </div>
      <div class="fl-ph-vis fl-stage arrive" style="--d:120ms">
        <i class="fl-stage-plate" aria-hidden="true"></i>
        <nav class="fq-index" aria-label="Question groups">
          <p class="fq-index__head"><span class="lx-dots" aria-hidden="true"><i></i><i></i><i></i></span>Jump to</p>
          <ul>
            {groups.map((g, i) => (
              <li><a href={`#${groupId(g.title)}`}><span class="fl-ic" aria-hidden="true" set:html={GROUP_ICON[i % GROUP_ICON.length]} /><span>{g.title}</span><span class="fq-index__go" aria-hidden="true">→</span></a></li>
            ))}
          </ul>
        </nav>
      </div>
    </div>
  </section>

  <section class="fq-body">
    <div class="container fq-grid">
      <div class="fq-groups">
        {groups.map((g, i) => (
          <div id={groupId(g.title)} class="fq-group" data-reveal={i > 0 ? '' : undefined}>
            <div class="fq-group__head">
              <span class="fl-ic" aria-hidden="true" set:html={GROUP_ICON[i % GROUP_ICON.length]} />
              <h2 class="sec-title fq-group__title">{g.title}</h2>
              <span class="fq-group__n" aria-hidden="true"></span>
            </div>
            <Faq items={g.items} idPrefix={`faq-${groupId(g.title)}`} openFirst />
          </div>
        ))}
      </div>
      <aside class="fq-aside">
        <div class="aside-toc">
          <div class="at-label">Jump to</div>
          <ul>{groups.map((g) => <li><a href={`#${groupId(g.title)}`}>{g.title}</a></li>)}</ul>
        </div>
        <div class="aside-card night">
          <h4>Still have a question?</h4>
          <p>Ask a senior strategist on a free 30-minute call.</p>
          <a class="btn btn-primary" href="/book/">Book a call →</a>
        </div>
      </aside>
    </div>
  </section>

  <CtaBand />
</div>

<Fragment slot="scripts">
<script>
  import '../family/landing/landing';
</script>
</Fragment>
</BaseLayout>

---
// "Related terms" (not a route): the entry's own related[] list, in its order, as link cards
// (term, its expansion, and its family), with the caption the hub diagram used to carry.
import type { Term } from '../../data/glossary';
import { splitTerm } from './_diagrams';

interface Props { term: Term; related: Term[] }
const { term, related } = Astro.props;
const hub = splitTerm(term.term);
const cards = related.map((r) => {
  const s = splitTerm(r.term);
  return { label: s.name, sub: s.expansion, href: `/glossary/${r.slug}/`, compliance: r.family === 'health-specific compliance and measurement', formula: Boolean(r.formula) };
});
const caption = `${hub.name} and the terms its entry lists as related.`;
---
{cards.length > 0 && (
  <div class="rs-related">
    <ul class="rs-related__grid rs-rise" data-draw>
      {cards.map((c, i) => (
        <li style={`--i:${i}`}>
          <a class="k-card k-card--link rs-rcard" href={c.href}>
            <span class="rs-rcard__mark" aria-hidden="true">{c.label.charAt(0)}</span>
            <span class="rs-rcard__text">
              <span class="rs-rcard__n">{c.label}</span>
              {c.sub && <span class="rs-rcard__x">{c.sub}</span>}
            </span>
            <span class="rs-rcard__ar" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="rs-related__cap">{caption}</p>
  </div>
)}

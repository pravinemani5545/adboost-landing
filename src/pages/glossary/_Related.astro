---
// "Related terms" (not a route): the entry's own related[] list, in its order. Four or more
// related entries draw as a small hub (kit HubSpoke), centred in the column; three or fewer are a
// row of link chips, since a hub with one to three spokes is mostly empty canvas.
import HubSpoke from '../../kit/diagram/HubSpoke.astro';
import type { Term } from '../../data/glossary';
import { splitTerm } from './_diagrams';

interface Props { term: Term; related: Term[] }
const { term, related } = Astro.props;
const hub = splitTerm(term.term);
const spokes = related.map((r) => {
  const s = splitTerm(r.term);
  return { label: s.name, sub: s.expansion, href: `/glossary/${r.slug}/` };
});
const caption = `${hub.name} and the terms its entry lists as related.`;
---
{spokes.length >= 4 ? (
  <div class="rf-related">
    <HubSpoke caption={caption} hub={{ label: hub.name, sub: hub.expansion }} spokes={spokes} />
  </div>
) : spokes.length > 0 ? (
  <ul class="rf-relchips">
    {spokes.map((s) => (
      <li>
        <a href={s.href}><span class="rf-relchips__n">{s.label}</span>{s.sub && <span class="rf-relchips__x">{s.sub}</span>}<span class="rf-relchips__ar" aria-hidden="true">→</span></a>
      </li>
    ))}
  </ul>
) : null}

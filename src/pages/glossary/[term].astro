---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import AsideLinks from '../../components/doc/AsideLinks.astro';
import AsideCta from '../../components/doc/AsideCta.astro';
import Closing from '../../components/Closing.astro';
import { GLOSSARY, getTerm } from '../../data/glossary';
import { siteBase } from '../../lib/site';
import { breadcrumb, definedTerm } from '../../lib/schema';

export function getStaticPaths() {
  return GLOSSARY.map((t) => ({ params: { term: t.slug } }));
}
const { term } = Astro.params;
const t = getTerm(term!)!;
const SITE = siteBase(Astro.site);
const path = `/glossary/${t.slug}/`;
const title = `${t.term}: Definition | AdBoost`;
const description = t.definition.slice(0, 155);
const related = (t.related ?? []).map((r) => getTerm(r)).filter(Boolean);

// Topic-aware related resources per term (fallback = default trio below).
type Resource = { href: string; label: string };
const DEFAULT_RESOURCES: Resource[] = [
  { href: '/tools/cac-calculator/', label: 'CAC calculator' },
  { href: '/tools/ltv-cac-calculator/', label: 'LTV:CAC calculator' },
  { href: '/blog/telehealth-cac-benchmarks-2026/', label: 'CAC benchmarks by vertical' },
];
const RESOURCES: Record<string, Resource[]> = {
  mer: [
    { href: '/tools/mer-calculator/', label: 'MER calculator' },
    { href: '/blog/telehealth-cac-benchmarks-2026/', label: 'CAC benchmarks by vertical' },
  ],
  roas: [
    { href: '/tools/mer-calculator/', label: 'MER calculator (the blended alternative)' },
    { href: '/blog/telehealth-cac-benchmarks-2026/', label: 'CAC benchmarks by vertical' },
  ],
  poas: [
    { href: '/tools/poas-calculator/', label: 'POAS calculator' },
    { href: '/blog/supplement-brand-lower-cac-playbook/', label: 'Supplement CAC playbook' },
  ],
  cac: [
    { href: '/tools/cac-calculator/', label: 'CAC calculator' },
    { href: '/blog/telehealth-cac-benchmarks-2026/', label: 'CAC benchmarks by vertical' },
  ],
  'blended-cac': [
    { href: '/tools/cac-calculator/', label: 'CAC calculator' },
    { href: '/blog/telehealth-cac-benchmarks-2026/', label: 'CAC benchmarks by vertical' },
  ],
  'paid-cac': [
    { href: '/tools/cac-calculator/', label: 'CAC calculator' },
    { href: '/blog/telehealth-cac-benchmarks-2026/', label: 'CAC benchmarks by vertical' },
  ],
  ltv: [
    { href: '/tools/ltv-cac-calculator/', label: 'LTV:CAC calculator' },
    { href: '/blog/telehealth-cac-benchmarks-2026/', label: 'CAC benchmarks by vertical' },
  ],
  'ltv-cac-ratio': [
    { href: '/tools/ltv-cac-calculator/', label: 'LTV:CAC calculator' },
    { href: '/blog/telehealth-cac-benchmarks-2026/', label: 'CAC benchmarks by vertical' },
  ],
  'cac-payback-period': [
    { href: '/tools/ad-budget-calculator/', label: 'Ad budget calculator' },
    { href: '/blog/supplement-brand-lower-cac-playbook/', label: 'Supplement CAC playbook' },
  ],
  'payback-period': [
    { href: '/tools/ad-budget-calculator/', label: 'Ad budget calculator' },
    { href: '/blog/supplement-brand-lower-cac-playbook/', label: 'Supplement CAC playbook' },
  ],
  'hipaa-compliant-marketing': [
    { href: '/blog/legitscript-certification-telehealth-guide/', label: 'LegitScript certification guide' },
    { href: '/services/paid-media/', label: 'Compliant paid media for health brands' },
  ],
  'legitscript-certification': [
    { href: '/blog/legitscript-certification-telehealth-guide/', label: 'LegitScript certification guide' },
    { href: '/services/paid-media/', label: 'Compliant paid media for health brands' },
  ],
  'quiz-funnel': [
    { href: '/services/cro/', label: 'CRO & quiz funnels' },
    { href: '/blog/choose-health-growth-agency/', label: 'How to choose a health growth agency' },
  ],
  'landing-page-conversion-rate': [
    { href: '/services/cro/', label: 'CRO & landing page optimization' },
    { href: '/blog/choose-health-growth-agency/', label: 'How to choose a health growth agency' },
  ],
  'creative-fatigue': [
    { href: '/blog/health-ad-creative-rejected-fix/', label: 'Fixing rejected health ad creative' },
    { href: '/services/creative/', label: 'Compliant creative production' },
  ],
  'hook-rate': [
    { href: '/blog/health-ad-creative-rejected-fix/', label: 'Fixing rejected health ad creative' },
    { href: '/services/creative/', label: 'Compliant creative production' },
  ],
  'creative-testing': [
    { href: '/blog/health-ad-creative-rejected-fix/', label: 'Fixing rejected health ad creative' },
    { href: '/services/creative/', label: 'Compliant creative production' },
  ],
  'structure-function-claim': [
    { href: '/blog/glp1-meta-ad-policy-state-ag-2026/', label: 'Meta GLP-1 policy & state-AG crackdown' },
    { href: '/advertising/supplements-on-meta/', label: 'Advertising supplements on Meta' },
  ],
  'server-side-tracking': [
    { href: '/blog/telehealth-attribution-server-side-tracking/', label: 'Server-side tracking for telehealth' },
    { href: '/services/paid-media/', label: 'Paid media with clean attribution' },
  ],
  capi: [
    { href: '/blog/telehealth-attribution-server-side-tracking/', label: 'Server-side tracking for telehealth' },
    { href: '/services/paid-media/', label: 'Paid media with clean attribution' },
  ],
  'ios-att': [
    { href: '/blog/telehealth-attribution-server-side-tracking/', label: 'Server-side tracking for telehealth' },
    { href: '/services/paid-media/', label: 'Paid media with clean attribution' },
  ],
  incrementality: [
    { href: '/blog/telehealth-attribution-server-side-tracking/', label: 'Server-side tracking for telehealth' },
    { href: '/services/paid-media/', label: 'Paid media with clean attribution' },
  ],
};
const resources = RESOURCES[t.slug] ?? DEFAULT_RESOURCES;

const jsonLd = [
  definedTerm(SITE, { term: t.term, description: t.definition, path }),
  breadcrumb(SITE, [{ label: 'Home', href: '/' }, { label: 'Glossary', href: '/glossary/' }, { label: t.term, href: path }]),
];
---
<BaseLayout {title} {description} canonicalPath={path} {jsonLd} ogType="article">
  <PageHead label="Glossary" labelHref="/glossary/" title={t.term} dots />

  <section class="tone-paper page-body" data-nav="paper">
    <div class="wrap doc">
      <div class="doc-main">
        <div class="doc-sec">
          <h2 class="term-q">What is {t.term.replace(/\s*\(.*\)/, '')}?</h2>
          <div class="brief" data-reveal><p class="label">Definition</p><p>{t.definition}</p></div>
        </div>
        {t.formula && <div class="note" data-reveal><p class="label">Formula</p><p><code>{t.formula}</code></p></div>}
        {t.body && <div class="prose" data-reveal><p set:html={t.body} /></div>}

        {related.length > 0 && (
          <div class="doc-sec">
            <h3>Related terms</h3>
            <div class="tags">{related.map((r) => <a class="tag" href={`/glossary/${r!.slug}/`}>{r!.term}</a>)}</div>
          </div>
        )}
      </div>
      <aside class="doc-aside">
        <AsideLinks label="Put the numbers to work" text="Benchmark your own metrics against your vertical in seconds." links={[...resources, { href: '/glossary/', label: 'Back to glossary' }]} />
        <AsideCta heading="Want these working in your favor?" text="We benchmark your account and map the fastest levers to move it." label="Book a free audit" />
      </aside>
    </div>
  </section>

  <Closing />
</BaseLayout>

<style>
  .term-q { font-size: clamp(24px, 2vw, 30px); }
  .note code { font-size: 16px; }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Equation from '../../kit/diagram/Equation.astro';
import Flow from '../../kit/diagram/Flow.astro';
import Compare from '../../kit/diagram/Compare.astro';
import Cycle from '../../kit/diagram/Cycle.astro';
import Funnel from '../../kit/diagram/Funnel.astro';
import Related from './_Related.astro';
import { concept, splitTerm, workedExample } from './_diagrams';
import { GLOSSARY, getTerm } from '../../data/glossary';
import { siteBase } from '../../lib/site';
import { pageDate } from '../../lib/live';
import { metaDescription, seoTitle } from '../../lib/seo';
import { breadcrumb, definedTerm } from '../../lib/schema';
import '../../styles/pages/reference.css';

export function getStaticPaths() {
  return GLOSSARY.map((t) => ({ params: { term: t.slug } }));
}
const { term } = Astro.params;
const t = getTerm(term!)!;
const SITE = siteBase(Astro.site);
const path = `/glossary/${t.slug}/`;
const title = seoTitle(path, `${t.term}: Definition | AdBoost`);
const description = metaDescription(path, t.metaDescription);
const related = (t.related ?? []).map((r) => getTerm(r)).filter((r) => r !== undefined);
// Content date: src/data/pages.json (sitemap lastmod and this label).
const updated = pageDate(path);
const updatedLabel = updated && new Date(`${updated}T00:00:00Z`).toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });

// Hero aside: the formula as an Equation card (with the body's own worked example where it
// prints one), else a concept diagram built from this entry's copy (src/pages/glossary/_diagrams.ts).
const { name } = splitTerm(t.term);
const worked = workedExample(t);
const fx = t.formula?.includes(' · ') ? 'formulas' : 'formula';
const eqCaption = worked
  ? `The ${name} ${fx} and the worked example from this page.`
  : `The ${name} ${fx}, as this page defines it.`;
const cd = t.formula ? undefined : concept(t);
const hasAside = Boolean(t.formula || cd);
// (Astro counts a slot inside an expression as filled even when it renders nothing, so the
// hero is written twice rather than with a conditional aside.)
const hero = {
  crumbs: [{ label: 'Home', href: '/' }, { label: 'Glossary', href: '/glossary/' }, { label: t.term }],
  eyebrow: 'GLOSSARY',
  title: t.term,
  meta: updatedLabel ? [`Updated ${updatedLabel}`, 'AdBoost Health'] : undefined,
  class: 'rf-hero',
};

// Topic-aware related resources per term (fallback = default trio below).
type Resource = { href: string; label: string };
const DEFAULT_RESOURCES: Resource[] = [
  { href: '/tools/cac-calculator/', label: 'CAC calculator' },
  { href: '/tools/ltv-cac-calculator/', label: 'LTV:CAC calculator' },
  { href: '/blog/telehealth-cac-benchmarks-2026/', label: 'CAC benchmarks by vertical' },
];
const RESOURCES: Record<string, Resource[]> = {
  mer: [
    { href: '/tools/mer-calculator/', label: 'MER calculator' },
    { href: '/blog/telehealth-cac-benchmarks-2026/', label: 'CAC benchmarks by vertical' },
  ],
  roas: [
    { href: '/tools/mer-calculator/', label: 'MER calculator (the blended alternative)' },
    { href: '/blog/telehealth-cac-benchmarks-2026/', label: 'CAC benchmarks by vertical' },
  ],
  poas: [
    { href: '/tools/poas-calculator/', label: 'POAS calculator' },
    { href: '/blog/supplement-brand-lower-cac-playbook/', label: 'Supplement CAC playbook' },
  ],
  cac: [
    { href: '/tools/cac-calculator/', label: 'CAC calculator' },
    { href: '/blog/telehealth-cac-benchmarks-2026/', label: 'CAC benchmarks by vertical' },
  ],
  'blended-cac': [
    { href: '/tools/cac-calculator/', label: 'CAC calculator' },
    { href: '/blog/telehealth-cac-benchmarks-2026/', label: 'CAC benchmarks by vertical' },
  ],
  'paid-cac': [
    { href: '/tools/cac-calculator/', label: 'CAC calculator' },
    { href: '/blog/telehealth-cac-benchmarks-2026/', label: 'CAC benchmarks by vertical' },
  ],
  ltv: [
    { href: '/tools/ltv-cac-calculator/', label: 'LTV:CAC calculator' },
    { href: '/blog/telehealth-cac-benchmarks-2026/', label: 'CAC benchmarks by vertical' },
  ],
  'ltv-cac-ratio': [
    { href: '/tools/ltv-cac-calculator/', label: 'LTV:CAC calculator' },
    { href: '/blog/telehealth-cac-benchmarks-2026/', label: 'CAC benchmarks by vertical' },
  ],
  'cac-payback-period': [
    { href: '/tools/ad-budget-calculator/', label: 'Ad budget calculator' },
    { href: '/blog/supplement-brand-lower-cac-playbook/', label: 'Supplement CAC playbook' },
  ],
  'hipaa-compliant-marketing': [
    { href: '/blog/legitscript-certification-telehealth-guide/', label: 'LegitScript certification guide' },
    { href: '/services/paid-media/', label: 'Compliant paid media for health brands' },
  ],
  'legitscript-certification': [
    { href: '/blog/legitscript-certification-telehealth-guide/', label: 'LegitScript certification guide' },
    { href: '/services/paid-media/', label: 'Compliant paid media for health brands' },
  ],
  'quiz-funnel': [
    { href: '/services/cro/', label: 'CRO & quiz funnels' },
    { href: '/compare/generalist-dtc-agency-alternative/#how-to-choose', label: 'How to choose a health growth agency' },
  ],
  'landing-page-conversion-rate': [
    { href: '/services/cro/', label: 'CRO & landing page optimization' },
    { href: '/compare/generalist-dtc-agency-alternative/#how-to-choose', label: 'How to choose a health growth agency' },
  ],
  'hook-rate': [
    { href: '/blog/health-ad-creative-rejected-fix/', label: 'Fixing rejected health ad creative' },
    { href: '/services/creative/', label: 'Compliant creative production' },
  ],
  'creative-testing': [
    { href: '/blog/health-ad-creative-rejected-fix/', label: 'Fixing rejected health ad creative' },
    { href: '/services/creative/', label: 'Compliant creative production' },
  ],
  'structure-function-claim': [
    { href: '/blog/glp1-meta-ad-policy-state-ag-2026/', label: 'Meta GLP-1 policy & state-AG crackdown' },
    { href: '/advertising/supplements-on-meta/', label: 'Advertising supplements on Meta' },
  ],
  capi: [
    { href: '/blog/telehealth-attribution-server-side-tracking/', label: 'Server-side tracking for telehealth' },
    { href: '/services/paid-media/', label: 'Paid media with clean attribution' },
  ],
  'ios-att': [
    { href: '/blog/telehealth-attribution-server-side-tracking/', label: 'Server-side tracking for telehealth' },
    { href: '/services/paid-media/', label: 'Paid media with clean attribution' },
  ],
  incrementality: [
    { href: '/blog/telehealth-attribution-server-side-tracking/', label: 'Server-side tracking for telehealth' },
    { href: '/services/paid-media/', label: 'Paid media with clean attribution' },
  ],
};
const resources = RESOURCES[t.slug] ?? DEFAULT_RESOURCES;

const jsonLd = [
  definedTerm(SITE, { term: t.term, description: t.definition, path }),
  breadcrumb(SITE, [{ label: 'Home', href: '/' }, { label: 'Glossary', href: '/glossary/' }, { label: t.term, href: path }]),
];
---
<BaseLayout {title} {description} canonicalPath={path} {jsonLd} ogType="article">
  {hasAside ? (
    <PageHero {...hero}>
      <div slot="aside" class="rf-hero-card k-card k-card--float">
        {t.formula && <p class="rf-hero-card__label">Formula</p>}
        {t.formula && <Equation arrive formula={t.formula} example={worked?.example} illustrative={worked?.illustrative} caption={eqCaption} />}
        {cd?.kind === 'flow' && <Flow arrive {...cd} />}
        {cd?.kind === 'compare' && <Compare arrive {...cd} />}
        {cd?.kind === 'cycle' && <Cycle arrive {...cd} />}
        {cd?.kind === 'funnel' && <Funnel arrive {...cd} />}
      </div>
    </PageHero>
  ) : <PageHero {...hero} />}

  <section class="iwrap-sm">
    <div class="container">
      <div class="doc-grid">
        <div class="doc-main">
          <div class="prose">
            <h2 class="rf-term-q">What is {name}?</h2>
            <div class="answer-box"><span class="al">Definition</span>{t.definition}</div>
            {t.guide && <p class="rf-term-guide"><a href={t.guide.href}>{t.guide.label} →</a></p>}
            {t.body && <div class="rf-term-body" set:html={t.body} />}

            {related.length > 0 && (
              <>
                <h2 class="rf-term-q">Related terms</h2>
                <Related term={t} related={related} />
              </>
            )}
          </div>
        </div>
        <aside class="doc-aside">
          <div class="aside-card">
            <h2 class="rf-aside-h">Put the numbers to work</h2>
            <p>Benchmark your own metrics against your vertical in seconds.</p>
            <div class="link-list">
              {resources.map((r) => <a href={r.href}>{r.label}</a>)}
              <a href="/glossary/">Back to glossary</a>
            </div>
          </div>
          <div class="aside-card dark">
            <h2 class="rf-aside-h">Want these working in your favor?</h2>
            <p>We benchmark your account and map the fastest levers to move it.</p>
            <a class="btn btn-primary" href="/book/">Book a free audit →</a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

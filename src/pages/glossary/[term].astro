---
// /glossary/<term>/ on the family layer (src/family/FamilyPage.astro; src/family/README.md). Every
// word, heading, link and JSON-LD node is the one this page had on the old interior layout.
//   hero   the term's formula (with the body's own worked example) or its concept diagram as a
//          product-UI figure with its caption (src/family/resources/TermFigure.astro)
//   body   chapter 01 "What is ...?": the definition as a spec card, the guide link, the body
//          (the formula paragraph as a callout, tables as cards); chapter 02 the related terms as
//          link cards with their caption
//   rail   "Put the numbers to work" and the night card, then "On this page" (the body's h3s)
//   end    the closing card (CtaBand's copy)
import FamilyPage from '../../family/FamilyPage.astro';
import LinkCard from '../../family/LinkCard.astro';
import TermFigure from '../../family/resources/TermFigure.astro';
import ButtonLink from '../../components/site/ButtonLink.astro';
import { concept, splitTerm } from './_diagrams';
import { GLOSSARY, getTerm } from '../../data/glossary';
import { siteBase } from '../../lib/site';
import { updatedLabel } from '../../family/dates';
import { metaDescription, seoTitle } from '../../lib/seo';
import { breadcrumb, definedTerm } from '../../lib/schema';
import '../../styles/family/resources.css';
import '../../styles/family/glossary.css';
import '../../styles/family/grain.css';

export function getStaticPaths() {
  return GLOSSARY.map((t) => ({ params: { term: t.slug } }));
}
const { term } = Astro.params;
const t = getTerm(term!)!;
const SITE = siteBase(Astro.site);
const path = `/glossary/${t.slug}/`;
const title = seoTitle(path, `${t.term}: Definition | AdBoost`);
const description = metaDescription(path, t.metaDescription);
const related = (t.related ?? []).map((r) => getTerm(r)).filter((r) => r !== undefined);
// Content date: src/data/pages.json (sitemap lastmod and this label).
const updated = updatedLabel(path);
const { name, expansion } = splitTerm(t.term);
const hasFigure = Boolean(t.formula || concept(t) || t.slug === 'ios-att');

// Topic-aware related resources per term (fallback = default trio below).
type Resource = { href: string; label: string };
const DEFAULT_RESOURCES: Resource[] = [
  { href: '/tools/cac-calculator/', label: 'CAC calculator' },
  { href: '/tools/ltv-cac-calculator/', label: 'LTV:CAC calculator' },
  { href: '/blog/telehealth-cac-benchmarks-2026/', label: 'CAC benchmarks by vertical' },
];
const RESOURCES: Record<string, Resource[]> = {
  mer: [
    { href: '/tools/mer-calculator/', label: 'MER calculator' },
    { href: '/blog/telehealth-cac-benchmarks-2026/', label: 'CAC benchmarks by vertical' },
  ],
  roas: [
    { href: '/tools/mer-calculator/', label: 'MER calculator (the blended alternative)' },
    { href: '/blog/telehealth-cac-benchmarks-2026/', label: 'CAC benchmarks by vertical' },
  ],
  poas: [
    { href: '/tools/poas-calculator/', label: 'POAS calculator' },
    { href: '/blog/supplement-brand-lower-cac-playbook/', label: 'Supplement CAC playbook' },
  ],
  cac: [
    { href: '/tools/cac-calculator/', label: 'CAC calculator' },
    { href: '/blog/telehealth-cac-benchmarks-2026/', label: 'CAC benchmarks by vertical' },
  ],
  'blended-cac': [
    { href: '/tools/cac-calculator/', label: 'CAC calculator' },
    { href: '/blog/telehealth-cac-benchmarks-2026/', label: 'CAC benchmarks by vertical' },
  ],
  'paid-cac': [
    { href: '/tools/cac-calculator/', label: 'CAC calculator' },
    { href: '/blog/telehealth-cac-benchmarks-2026/', label: 'CAC benchmarks by vertical' },
  ],
  ltv: [
    { href: '/tools/ltv-cac-calculator/', label: 'LTV:CAC calculator' },
    { href: '/blog/telehealth-cac-benchmarks-2026/', label: 'CAC benchmarks by vertical' },
  ],
  'ltv-cac-ratio': [
    { href: '/tools/ltv-cac-calculator/', label: 'LTV:CAC calculator' },
    { href: '/blog/telehealth-cac-benchmarks-2026/', label: 'CAC benchmarks by vertical' },
  ],
  'cac-payback-period': [
    { href: '/tools/ad-budget-calculator/', label: 'Ad budget calculator' },
    { href: '/blog/supplement-brand-lower-cac-playbook/', label: 'Supplement CAC playbook' },
  ],
  'hipaa-compliant-marketing': [
    { href: '/blog/legitscript-certification-telehealth-guide/', label: 'LegitScript certification guide' },
    { href: '/services/paid-media/', label: 'Compliant paid media for health brands' },
  ],
  'legitscript-certification': [
    { href: '/blog/legitscript-certification-telehealth-guide/', label: 'LegitScript certification guide' },
    { href: '/services/paid-media/', label: 'Compliant paid media for health brands' },
  ],
  'quiz-funnel': [
    { href: '/services/cro/', label: 'CRO & quiz funnels' },
    { href: '/compare/generalist-dtc-agency-alternative/#how-to-choose', label: 'How to choose a health growth agency' },
  ],
  'landing-page-conversion-rate': [
    { href: '/services/cro/', label: 'CRO & landing page optimization' },
    { href: '/compare/generalist-dtc-agency-alternative/#how-to-choose', label: 'How to choose a health growth agency' },
  ],
  'hook-rate': [
    { href: '/blog/health-ad-creative-rejected-fix/', label: 'Fixing rejected health ad creative' },
    { href: '/services/creative/', label: 'Compliant creative production' },
  ],
  'creative-testing': [
    { href: '/blog/health-ad-creative-rejected-fix/', label: 'Fixing rejected health ad creative' },
    { href: '/services/creative/', label: 'Compliant creative production' },
  ],
  'structure-function-claim': [
    { href: '/blog/glp1-meta-ad-policy-state-ag-2026/', label: 'Meta GLP-1 policy & state-AG crackdown' },
    { href: '/advertising/supplements-on-meta/', label: 'Advertising supplements on Meta' },
  ],
  capi: [
    { href: '/blog/telehealth-attribution-server-side-tracking/', label: 'Server-side tracking for telehealth' },
    { href: '/services/paid-media/', label: 'Paid media with clean attribution' },
  ],
  'ios-att': [
    { href: '/blog/telehealth-attribution-server-side-tracking/', label: 'Server-side tracking for telehealth' },
    { href: '/services/paid-media/', label: 'Paid media with clean attribution' },
  ],
  incrementality: [
    { href: '/blog/telehealth-attribution-server-side-tracking/', label: 'Server-side tracking for telehealth' },
    { href: '/services/paid-media/', label: 'Paid media with clean attribution' },
  ],
};
const resources = RESOURCES[t.slug] ?? DEFAULT_RESOURCES;

const jsonLd = [
  definedTerm(SITE, { term: t.term, description: t.definition, path }),
  breadcrumb(SITE, [{ label: 'Home', href: '/' }, { label: 'Glossary', href: '/glossary/' }, { label: t.term, href: path }]),
];

const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const slugify = (s: string) => s.toLowerCase().replace(/&[a-z]+;/g, '').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
// The body as written, with hooks for the family styles: its opening sentence (bare text before the
// first heading) as a paragraph, the paragraph under "The formula and a worked example" as a formula
// callout, and an id on each h3 that has none (for "On this page"). Tables in .tablewrap become card
// tables in chapterize. No word changes.
const h3s: { id: string; label: string }[] = [];
const termBody = (html: string) => {
  let out = html.replace(/^([^<][\s\S]*?)(?=<h3\b|$)/, '<p class="gl-open">$1</p>');
  out = out.replace(/(<h3>The formula and a worked example<\/h3>)\s*(<p>[\s\S]*?<\/p>)/, '$1<div class="cp-callout gl-fx"><span class="cp-callout-ic" aria-hidden="true"></span><div class="cp-callout-body">$2</div></div>');
  out = out.replace(/<h3( id="([^"]+)")?>([\s\S]*?)<\/h3>/g, (_m, _a, id: string | undefined, inner: string) => {
    const hid = id ?? `s-${slugify(inner.replace(/<[^>]+>/g, ''))}`;
    h3s.push({ id: hid, label: inner.replace(/<[^>]+>/g, '').replace(/&amp;/g, '&').replace(/&#39;/g, "'") });
    return `<h3 id="${hid}">${inner}</h3>`;
  });
  return out;
};
const body = t.body ? termBody(t.body) : '';
const isCompliance = t.family === 'health-specific compliance and measurement';
const famLabel = isCompliance ? 'Compliance' : 'Unit economics';
const toc = [
  { id: 'definition', label: `What is ${name}?` },
  ...h3s,
  ...(related.length ? [{ id: 'related-terms', label: 'Related terms' }] : []),
];
const caption = `${name} and the terms its entry lists as related.`;
const data = {
  seoTitle: title,
  metaDescription: description,
  ogType: 'article',
  h1: t.term,
  h1Html: expansion ? `${esc(name)} <span class="serif">(${esc(expansion)})</span>` : undefined,
};
const byline = updated ? [{ text: `Updated ${updated}`, icon: 'date' as const }, { text: 'AdBoost Health', icon: 'org' as const }] : [];
---
<FamilyPage
  path={path}
  data={data}
  crumbs={[{ label: 'Home', href: '/' }, { label: 'Glossary', href: '/glossary/' }, { label: t.term }]}
  eyebrow="GLOSSARY"
  schema={jsonLd}
  byline={byline}
  toc={toc}
>
  {hasFigure && <TermFigure slot="hero" term={t} />}

  <div slot="aside" class="pg-card gl-tools">
    <h2>Put the numbers to work</h2>
    <p>Benchmark your own metrics against your vertical in seconds.</p>
    <ul class="gl-links">
      {resources.map((r) => <li><LinkCard href={r.href} label={r.label} /></li>)}
      <li><LinkCard href="/glossary/" label="Back to glossary" kind="term" /></li>
    </ul>
  </div>
  <div slot="aside" class="pg-card is-night">
    <h2>Want these working in your favor?</h2>
    <p>We benchmark your account and map the fastest levers to move it.</p>
    <ButtonLink href="/book/" class="pg-card-go">Book a free audit <span aria-hidden="true">→</span></ButtonLink>
  </div>

  <div class="pg-prose"><h2 id="definition">What is {name}?</h2></div>
  <div class="gl-def reveal">
    <div class="gl-def-bar">
      <span class="cp-dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="gl-def-k">Definition</span>
      <span class:list={['gl-fam', isCompliance && 'is-c']} aria-hidden="true">{famLabel}</span>
    </div>
    <p class="gl-def-text">{t.definition}</p>
  </div>
  {t.guide && <p class="gl-guide reveal"><a href={t.guide.href}><span>{t.guide.label}</span> <span aria-hidden="true">→</span></a></p>}
  {body && <div class="pg-prose gl-body" set:html={body} />}

  {related.length > 0 && (
    <section class="gl-related">
      <h2 id="related-terms" class="reveal">Related terms</h2>
      <ul class="gl-related-list" data-n={related.length}>
        {related.map((r, i) => {
          const s = splitTerm(r.term);
          return <li class:list={['reveal', i % 3 && `d${i % 3}`]}><LinkCard href={`/glossary/${r.slug}/`} label={s.name} note={s.expansion} kind="term" /></li>;
        })}
      </ul>
      <p class="gl-related-cap">{caption}</p>
    </section>
  )}
</FamilyPage>

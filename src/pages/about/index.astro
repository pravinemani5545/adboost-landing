---
import fs from 'node:fs';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import Count from '../../kit/components/Count.astro';
import HubSpoke from '../../kit/diagram/HubSpoke.astro';
import { siteBase } from '../../lib/site';
import { PREVIEW_ALL } from '../../lib/live';
import { versioned } from '../../lib/assets';
import { breadcrumb, organizationNode, personNode } from '../../lib/schema';
import Backdrop from '../../family/landing/Backdrop.astro';
import Hub from '../../family/landing/Hub.astro';
import Win from '../../family/landing/Win.astro';
import Glyph from '../../family/landing/Glyph.astro';
import '../../styles/family/landing.css';
import '../../styles/pages/about.css';

const SITE = siteBase(Astro.site);
const path = '/about/';
const title = 'About AdBoost Health | Healthcare Marketing Services';
const description = 'AdBoost Health is a health and wellness marketing agency in Toronto, remote-first, serving telehealth, GLP-1 and supplement brands. 71+ founders served.';
// Health plan X1: link the media sister brand's /about/ once that page is live.
// It is held on owner sign-off (adboost-media src/data/pages.json, g2), so it has
// no go-live date yet. Set this to its go-live date (YYYY-MM-DD) once it has one;
// until then the link stays off so a scheduled rebuild cannot ship a 404.
const SISTER_ABOUT_FROM: string | null = null;
const showSisterAbout = PREVIEW_ALL || (SISTER_ABOUT_FROM !== null && Date.now() >= Date.parse(`${SISTER_ABOUT_FROM}T00:00:00Z`));

// Founders. Photo renders when the webp exists in public/people/, else initials.
const team = [
  {
    name: 'Amir Salihovic',
    role: 'Co-Founder & CEO',
    initials: 'AS',
    photo: '/people/amir.webp',
    linkedin: 'https://www.linkedin.com/in/amir-salihovic-7b2844157/',
    bio: 'Amir leads performance marketing for AdBoost Health’s partners and runs the Meta side of the house - creative-led acquisition that finds the right person mid-scroll. He’s scaled health and wellness brands to 7–8 figures and writes the agency’s benchmark and compliance guides.',
  },
  {
    name: 'Pira Ahilan',
    role: 'Co-Founder',
    initials: 'PA',
    photo: '/people/pira.webp',
    linkedin: 'https://www.linkedin.com/in/piraahilan/',
    bio: 'Pira owns the Google side (Google Ads for healthcare and telehealth) and the full funnel - the account strategy, offer architecture for health DTC, and upsell/retention systems that take a health brand from a 1.5 ROAS to 6+. A Schulich School of Business (York) grad, he’s helped generate $150M+ in tracked revenue across health and wellness brands and apps.',
  },
  {
    name: 'Pravine Manivannan',
    role: 'CTO',
    initials: 'PM',
    photo: '/people/pravine.webp',
    linkedin: 'https://www.linkedin.com/in/pravinemani',
    bio: 'Pravine runs the technology and AI side of the agency: search and AI-engine visibility, attribution infrastructure, and the automation that lets a lean senior team operate like a much bigger one. He\'s a Computer Engineering & Management grad from McMaster.',
  },
];
// stat card icons (decorative): people, revenue, rating, creatives
const STAT_ICON = [
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 20a7 7 0 0114 0M12 12a4 4 0 100-8 4 4 0 000 8z"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 18l5-5 4 4 7-9"/><path d="M15 8h5v5"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M12 3.5l2.6 5.3 5.8.8-4.2 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.2-4.1 5.8-.8L12 3.5z"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><rect x="4" y="4" width="7" height="9" rx="1.5"/><rect x="13" y="4" width="7" height="6" rx="1.5"/><rect x="13" y="12" width="7" height="8" rx="1.5"/><rect x="4" y="15" width="7" height="5" rx="1.5"/></svg>',
];
// The platform each founder covers, as the system diagram on this page names it (a chip on each card).
const LANE = ['Meta', 'Google', 'Technology'];
const LANE_GLYPH = ['feed', 'search', 'pulse'] as const;
// The policy areas the "Why health-only" chapter names, as rows of a review card.
const RULES = ['Meta health policy', 'LegitScript requirement', 'rejection trigger', 'FTC and FDA'];
const CHECK = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>';
const teamR = team.map((t) => ({ ...t, hasPhoto: fs.existsSync(`./public${t.photo}`), photo: versioned(t.photo) }));
const jsonLd = [
  organizationNode(SITE),
  ...teamR.map((t) => personNode(SITE, { name: t.name, jobTitle: t.role, path, bio: t.bio, image: t.hasPhoto ? t.photo : undefined, sameAs: [t.linkedin] })),
  breadcrumb(SITE, [{ label: 'Home', href: '/' }, { label: 'About', href: path }]),
];
---
<BaseLayout {title} {description} canonicalPath={path} {jsonLd}>
<div class="fl ab">
  <!-- HERO: the band every family page opens on; the founders wired to the agency beside the copy -->
  <section class="fl-ph ab-hero" data-pointer>
    <Backdrop spotlight focus={['74%', '34%']} />
    <div class="container fl-ph-grid">
      <div>
        <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'About' }]} />
        <span class="eyebrow fl-kicker sec-eyebrow"><span class="dot"></span>ABOUT</span>
        <h1 class="arrive">The growth agency that only works in <span class="serif">health</span>.</h1>
        <p class="fl-ph-lede arrive" style="--d:60ms">AdBoost Health exists because generalist agencies keep costing health founders 30 days to a rejected launch. We built the opposite: a team that only knows health, so compliance, creative, and CAC are handled from day one.</p>
      </div>
      {/* decorative: the three founders this page introduces, wired to the agency (names and roles as below) */}
      <div class="fl-ph-vis fl-stage ab-hero-vis arrive" style="--d:120ms" data-parallax>
        <i class="fl-stage-plate" aria-hidden="true" data-depth="0.5"></i>
        <i class="fl-stage-ring" aria-hidden="true" data-depth="1.5"></i>
        <div data-depth="1"><Hub core="mark" label="AdBoost Health" nodes={teamR.map((t, i) => ({ label: t.name, sub: t.role.toUpperCase(), img: t.hasPhoto ? t.photo : undefined, hue: (['a', 'b', 'c'] as const)[i] }))} /></div>
        <span class="ab-pin fl-float" aria-hidden="true" data-depth="2.2"><i></i>Toronto-based and remote-first</span>
      </div>
    </div>
  </section>

  <!-- THE NUMBERS: four cards; below the fold they count up to the printed figure (kit count.ts) -->
  <section class="ab-stats-band">
    <div class="container">
      <div class="ab-stats">
        <div class="ab-stat reveal"><span class="fl-ic" aria-hidden="true" set:html={STAT_ICON[0]} /><div class="sv fl-grad-num"><Count value="71+" /></div><div class="sl">Founders served</div><span class="ab-stat-art" aria-hidden="true"><i style="--h:.38"></i><i style="--h:.52"></i><i style="--h:.48"></i><i style="--h:.7"></i><i style="--h:.86"></i></span></div>
        <div class="ab-stat reveal d1"><span class="fl-ic" aria-hidden="true" set:html={STAT_ICON[1]} /><div class="sv fl-grad-num"><Count value="$153M+" /></div><div class="sl">Tracked revenue</div><span class="ab-stat-art" aria-hidden="true"><i style="--h:.3"></i><i style="--h:.42"></i><i style="--h:.58"></i><i style="--h:.74"></i><i style="--h:.94"></i></span></div>
        <div class="ab-stat reveal d2"><span class="fl-ic" aria-hidden="true" set:html={STAT_ICON[2]} /><div class="sv"><span class="fl-grad-num"><Count value="4.9" class="sv-n" /></span><span class="sv-of"> / 5</span></div><div class="sl">Average partner rating</div><span class="ab-stars" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span></div>
        <div class="ab-stat reveal d3"><span class="fl-ic" aria-hidden="true" set:html={STAT_ICON[3]} /><div class="sv fl-grad-num"><Count value="8,400+" /></div><div class="sl">Creatives shipped</div><span class="ab-tiles" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></span></div>
      </div>
    </div>
  </section>

  <!-- CHAPTER 01: why health-only, beside a policy review card naming the rules the text names -->
  <section class="fl-ch ab-ch1">
    <div class="container fl-ch-grid">
      <div class="reveal">
        <span class="fl-ch-n" aria-hidden="true">01</span>
        <h2 class="fl-words">Why health-only</h2>
        <p>Health is the hardest category in paid media. Ad accounts get disabled overnight, every platform has its own health-vertical policy, and the FTC and FDA are watching the claims. A generalist agency learns those rules on your budget. We already know them - every Meta health policy, every LegitScript requirement, every rejection trigger - because health is the only thing we do.</p>
        <p>That focus is why our partners average 24% lower CAC in the first 30 days and why their accounts stay live through scale. We pair senior strategists with an in-house creative studio and clean, server-side attribution - the full acquisition system, built for the one category we specialize in.</p>
        {showSisterAbout && <p><a href="https://www.adboost.media/about/">AdBoost Media</a> (www.adboost.media) is our ecommerce sister brand for DTC brands outside health.</p>}
      </div>
      <div class="fl-ch-vis fl-stage reveal d1">
        <i class="fl-stage-plate" aria-hidden="true"></i>
        <Win title="Why health-only" class="ab-rules">
          {RULES.map((r, i) => (
            <div class="lx-row lx-in" style={`--i:${i}`}>
              <span class:list={['lx-ic', ['', 'b', 'c', ''][i]]}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5.5c0 4.2-3 7.6-7 9.5-4-1.9-7-5.3-7-9.5V6l7-3z"/></svg></span>
              <span class="lx-tx"><span class="lx-t">{r}</span><span class="lx-sk" style={`--w:${[62, 48, 56, 40][i]}%`}></span></span>
              <span class="lx-check" set:html={CHECK}></span>
            </div>
          ))}
          <Fragment slot="foot"><span class="lx-dot ok live"></span>health is the only thing we do</Fragment>
        </Win>
      </div>
    </div>
  </section>

  <!-- CHAPTER 02: the founders and the engine; both halves of the auction beside the text, then the
       system diagram on its own card -->
  <section class="fl-ch tint ab-ch2">
    <div class="container">
      <div class="fl-ch-grid flip">
        <div class="reveal">
          <span class="fl-ch-n" aria-hidden="true">02</span>
          <h2 class="fl-words">Two founders, two platforms - and the engine underneath</h2>
          <p>Amir, our Meta ads expert for health brands, focuses on health-vertical creative strategy that stops the scroll and finds the right person; Pira, our Google Ads expert for telehealth, believes in being there the moment they start searching and in developing robust offer architecture for health DTC. We argue, we test, we grow - and health brands get both halves of the auction covered by a founder, not a junior pod. Between us, we’ve helped generate <strong>$150M+</strong> in tracked revenue for health and wellness brands and apps.</p>
          <p>Underneath both platforms sits the technology layer Pravine owns as CTO: search and AI-engine visibility, server-side attribution, and the AI automation that keeps senior strategists on strategy instead of spreadsheets. When an AI assistant recommends a health brand or a dashboard attributes a booked call to its true source, that’s the part of the agency you’re seeing, powered by our advanced attribution infrastructure.</p>
        </div>
        {/* decorative: the two halves of the auction (scroll and search) over the engine, labelled as the diagram below labels them */}
        <div class="fl-ch-vis fl-stage reveal d1">
          <i class="fl-stage-ring" aria-hidden="true"></i>
          <Win title="both halves of the auction" class="ab-auction">
            <div class="ab-halves">
              <div class="ab-half lx-in" style="--i:0"><span class="ab-half-art"><Glyph kind="feed" /></span><span class="lx-pill">Meta · Amir</span></div>
              <div class="ab-half lx-in" style="--i:1"><span class="ab-half-art c"><Glyph kind="search" /></span><span class="lx-pill b">Google · Pira</span></div>
            </div>
            <div class="ab-engine lx-in" style="--i:2"><span class="lx-ic solid"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l2-5 4 10 2-5h6"/></svg></span><span class="lx-t">Technology · Pravine</span><span class="ab-engine-bar"><i></i></span></div>
          </Win>
        </div>
      </div>
      <div class="ab-map reveal">
        <div class="lx-win ab-map-win">
          <div class="lx-bar" aria-hidden="true"><span class="lx-dots"><i></i><i></i><i></i></span><i class="lx-url"></i><span class="lx-dot live"></span></div>
          <div class="lx-body">
            <HubSpoke
              arrive
              caption="Two founders, two platforms, and the engine underneath: Amir on Meta, Pira on Google, and the technology layer Pravine owns as CTO."
              hub={{ label: 'AdBoost Health', sub: 'The full acquisition system' }}
              spokes={[
                { label: 'Meta · Amir', sub: 'Creative strategy that stops the scroll' },
                { label: 'Google · Pira', sub: 'There the moment they start searching' },
                { label: 'Technology · Pravine', sub: 'Search and AI-engine visibility, server-side attribution, AI automation' },
              ]}
            />
          </div>
        </div>
      </div>

      <aside class="ab-where reveal">
        <div class="ab-where-art" aria-hidden="true">
          <span class="ab-where-grid"></span>
          <span class="ab-where-pin"><i></i></span>
          <span class="ab-where-ring"></span><span class="ab-where-ring b"></span>
        </div>
        <div class="ab-where-txt">
          <h3>Where we work</h3>
          <p>Toronto-based and remote-first, serving health and telehealth brands across the US and Canada. Whether you want a digital marketing agency in Toronto or a fully remote marketing agency, you work with the same senior team.</p>
          <div class="ab-links">
            <a href="mailto:hello@adboost.health">hello@adboost.health</a>
            <a href="/advertising/">Ad compliance by vertical</a>
            <a href="/blog/telehealth-cac-benchmarks-2026/">CAC benchmarks</a>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <!-- THE TEAM: rich cards, each with the platform it covers -->
  <section class="fl-ch ab-team-sec">
    <div class="container">
      <div class="fl-shead center reveal">
        <span class="fl-kicker" aria-hidden="true"><span class="fl-kdot"></span>03</span>
        <h2 class="fl-words">Meet the team</h2>
      </div>
      <div class="ab-team">
        {teamR.map((t, i) => (
          <div class="ab-bio" data-reveal style={`--i:${i}`}>
            <div class="ab-bio-top" aria-hidden="true">
              <span class="ab-bio-glyph"><Glyph kind={LANE_GLYPH[i]} /></span>
              <span class:list={['lx-pill', ['', 'b', 'c'][i]]}>{LANE[i]}</span>
            </div>
            <div class="avatar">{t.hasPhoto ? <img src={t.photo} width="96" height="96" alt={`${t.name}, ${t.role}`} loading="lazy" /> : t.initials}</div>
            <h3>{t.name}</h3>
            <div class="role">{t.role.toUpperCase()}</div>
            <p>{t.bio}</p>
            <div class="bio-links">
              <a href={t.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</div>

<Fragment slot="scripts">
<script>
  import '../../family/landing/landing';
</script>
</Fragment>
</BaseLayout>

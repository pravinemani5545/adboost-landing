---
import fs from 'node:fs';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Count from '../../kit/components/Count.astro';
import HubSpoke from '../../kit/diagram/HubSpoke.astro';
import { siteBase } from '../../lib/site';
import { PREVIEW_ALL } from '../../lib/live';
import { versioned } from '../../lib/assets';
import { breadcrumb, organizationNode, personNode } from '../../lib/schema';
import '../../styles/pages/chapters.css';

const SITE = siteBase(Astro.site);
const path = '/about/';
const title = 'About AdBoost Health | Healthcare Marketing Services';
const description = 'AdBoost Health is a health and wellness marketing agency in Toronto, remote-first, serving telehealth, GLP-1 and supplement brands. 71+ founders served.';
// Health plan X1: link the media sister brand's /about/ once that page is live.
// It is held on owner sign-off (adboost-media src/data/pages.json, g2), so it has
// no go-live date yet. Set this to its go-live date (YYYY-MM-DD) once it has one;
// until then the link stays off so a scheduled rebuild cannot ship a 404.
const SISTER_ABOUT_FROM: string | null = null;
const showSisterAbout = PREVIEW_ALL || (SISTER_ABOUT_FROM !== null && Date.now() >= Date.parse(`${SISTER_ABOUT_FROM}T00:00:00Z`));

// Founders. Photo renders when the webp exists in public/people/, else initials.
const team = [
  {
    name: 'Amir Salihovic',
    role: 'Co-Founder & CEO',
    initials: 'AS',
    photo: '/people/amir.webp',
    linkedin: 'https://www.linkedin.com/in/amir-salihovic-7b2844157/',
    bio: 'Amir leads performance marketing for AdBoost Health’s partners and runs the Meta side of the house - creative-led acquisition that finds the right person mid-scroll. He’s scaled health and wellness brands to 7–8 figures and writes the agency’s benchmark and compliance guides.',
  },
  {
    name: 'Pira Ahilan',
    role: 'Co-Founder',
    initials: 'PA',
    photo: '/people/pira.webp',
    linkedin: 'https://www.linkedin.com/in/piraahilan/',
    bio: 'Pira owns the Google side (Google Ads for healthcare and telehealth) and the full funnel - the account strategy, offer architecture for health DTC, and upsell/retention systems that take a health brand from a 1.5 ROAS to 6+. A Schulich School of Business (York) grad, he’s helped generate $150M+ in tracked revenue across health and wellness brands and apps.',
  },
  {
    name: 'Pravine Manivannan',
    role: 'CTO',
    initials: 'PM',
    photo: '/people/pravine.webp',
    linkedin: 'https://www.linkedin.com/in/pravinemani',
    bio: 'Pravine runs the technology and AI side of the agency: search and AI-engine visibility, attribution infrastructure, and the automation that lets a lean senior team operate like a much bigger one. He\'s a Computer Engineering & Management grad from McMaster.',
  },
];
// stat card icons (decorative): people, revenue, rating, creatives
const STAT_ICON = [
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 20a7 7 0 0114 0M12 12a4 4 0 100-8 4 4 0 000 8z"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 18l5-5 4 4 7-9"/><path d="M15 8h5v5"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M12 3.5l2.6 5.3 5.8.8-4.2 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.2-4.1 5.8-.8L12 3.5z"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><rect x="4" y="4" width="7" height="9" rx="1.5"/><rect x="13" y="4" width="7" height="6" rx="1.5"/><rect x="13" y="12" width="7" height="8" rx="1.5"/><rect x="4" y="15" width="7" height="5" rx="1.5"/></svg>',
];
const teamR = team.map((t) => ({ ...t, hasPhoto: fs.existsSync(`./public${t.photo}`), photo: versioned(t.photo) }));
const jsonLd = [
  organizationNode(SITE),
  ...teamR.map((t) => personNode(SITE, { name: t.name, jobTitle: t.role, path, bio: t.bio, image: t.hasPhoto ? t.photo : undefined, sameAs: [t.linkedin] })),
  breadcrumb(SITE, [{ label: 'Home', href: '/' }, { label: 'About', href: path }]),
];
---
<BaseLayout {title} {description} canonicalPath={path} {jsonLd}>
  <PageHero
    crumbs={[{ label: 'Home', href: '/' }, { label: 'About' }]}
    eyebrow="ABOUT"
    title='The growth agency that only works in <span class="serif">health</span>.'
    lede="AdBoost Health exists because generalist agencies keep costing health founders 30 days to a rejected launch. We built the opposite: a team that only knows health, so compliance, creative, and CAC are handled from day one."
    art="/art/about/hub"
  >
    {/* decorative: the team this page introduces, as a roster card (names and roles as below) */}
    <div slot="aside" class="k-card k-card--float k-card--glass about-crew" aria-hidden="true">
      <p class="about-crew__head"><span class="ch-dots"><i></i><i></i><i></i></span><span>Meet the team</span></p>
      <ul class="about-crew__rows">
        {teamR.map((t) => (
          <li>
            <span class="about-crew__av">{t.hasPhoto ? <img src={t.photo} width="44" height="44" alt="" decoding="async" /> : t.initials}</span>
            <span class="about-crew__who"><b>{t.name}</b><span>{t.role.toUpperCase()}</span></span>
            <span class="about-crew__on"></span>
          </li>
        ))}
      </ul>
      <p class="about-crew__foot"><span class="about-crew__pin"></span>Toronto-based and remote-first</p>
    </div>
  </PageHero>

  <section class="iwrap-sm">
    <div class="container">
      {/* Usually in the first viewport, so .arrive (never hidden); the numbers count up only
          when the row starts below the fold (kit count.ts). */}
      <div class="stat-row about-stats arrive">
        <div class="stat"><span class="ch-ico" aria-hidden="true" set:html={STAT_ICON[0]} /><div class="sv"><Count value="71+" /></div><div class="sl">Founders served</div></div>
        <div class="stat"><span class="ch-ico" aria-hidden="true" set:html={STAT_ICON[1]} /><div class="sv"><Count value="$153M+" /></div><div class="sl">Tracked revenue</div></div>
        <div class="stat"><span class="ch-ico" aria-hidden="true" set:html={STAT_ICON[2]} /><div class="sv"><Count value="4.9" class="sv-n" /><span class="sv-of"> / 5</span></div><div class="sl">Average partner rating</div></div>
        <div class="stat"><span class="ch-ico" aria-hidden="true" set:html={STAT_ICON[3]} /><div class="sv"><Count value="8,400+" /></div><div class="sl">Creatives shipped</div></div>
      </div>
    </div>
  </section>

  <section class="iwrap-sm">
    <div class="container">
      <div class="doc-grid">
        <div class="doc-main">
          <div class="prose">
            <h2>Why health-only</h2>
            <p>Health is the hardest category in paid media. Ad accounts get disabled overnight, every platform has its own health-vertical policy, and the FTC and FDA are watching the claims. A generalist agency learns those rules on your budget. We already know them - every Meta health policy, every LegitScript requirement, every rejection trigger - because health is the only thing we do.</p>
            <p>That focus is why our partners average 24% lower CAC in the first 30 days and why their accounts stay live through scale. We pair senior strategists with an in-house creative studio and clean, server-side attribution - the full acquisition system, built for the one category we specialize in.</p>
            {showSisterAbout && <p><a href="https://www.adboost.media/about/">AdBoost Media</a> (www.adboost.media) is our ecommerce sister brand for DTC brands outside health.</p>}
            <h2>Two founders, two platforms - and the engine underneath</h2>
            <p>Amir, our Meta ads expert for health brands, focuses on health-vertical creative strategy that stops the scroll and finds the right person; Pira, our Google Ads expert for telehealth, believes in being there the moment they start searching and in developing robust offer architecture for health DTC. We argue, we test, we grow - and health brands get both halves of the auction covered by a founder, not a junior pod. Between us, we’ve helped generate <strong>$150M+</strong> in tracked revenue for health and wellness brands and apps.</p>
            <p>Underneath both platforms sits the technology layer Pravine owns as CTO: search and AI-engine visibility, server-side attribution, and the AI automation that keeps senior strategists on strategy instead of spreadsheets. When an AI assistant recommends a health brand or a dashboard attributes a booked call to its true source, that’s the part of the agency you’re seeing, powered by our advanced attribution infrastructure.</p>
            <div class="about-map ch-card ch-edge" data-reveal>
            <HubSpoke
              arrive
              caption="Two founders, two platforms, and the engine underneath: Amir on Meta, Pira on Google, and the technology layer Pravine owns as CTO."
              hub={{ label: 'AdBoost Health', sub: 'The full acquisition system' }}
              spokes={[
                { label: 'Meta · Amir', sub: 'Creative strategy that stops the scroll' },
                { label: 'Google · Pira', sub: 'There the moment they start searching' },
                { label: 'Technology · Pravine', sub: 'Search and AI-engine visibility, server-side attribution, AI automation' },
              ]}
            />
            </div>
          </div>
        </div>
        <aside class="doc-aside">
          <div class="aside-card">
            <h3>Where we work</h3>
            <p>Toronto-based and remote-first, serving health and telehealth brands across the US and Canada. Whether you want a digital marketing agency in Toronto or a fully remote marketing agency, you work with the same senior team.</p>
            <div class="link-list">
              <a href="mailto:hello@adboost.health">hello@adboost.health</a>
              <a href="/advertising/">Ad compliance by vertical</a>
              <a href="/blog/telehealth-cac-benchmarks-2026/">CAC benchmarks</a>
            </div>
          </div>
        </aside>
      </div>

      <h2 class="sec-title about-team-title">Meet the team</h2>
      <div class="team-grid about-team">
        {teamR.map((t, i) => (
          <div class="bio about-bio" data-reveal style={`--i:${i}`}>
            <span class="about-bio__band" aria-hidden="true"></span>
            <div class="avatar">{t.hasPhoto ? <img src={t.photo} width="96" height="96" alt={`${t.name}, ${t.role}`} loading="lazy" /> : t.initials}</div>
            <h3>{t.name}</h3>
            <div class="role">{t.role.toUpperCase()}</div>
            <p>{t.bio}</p>
            <div class="bio-links">
              <a href={t.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .about-stats { --d: 160ms; gap: 14px; }
  .about-stats .stat { position: relative; overflow: clip; display: grid; gap: 4px; padding: 20px 20px 18px; border-radius: var(--k-r-lg); }
  .about-stats .stat::after { content: ""; position: absolute; inset: auto -30% -60% 30%; height: 120px; background: radial-gradient(closest-side, rgb(var(--hue-b) / .14), transparent); pointer-events: none; }
  .about-stats .ch-ico { margin-bottom: 10px; }
  .about-stats .stat:nth-child(2) .ch-ico { --ta: var(--hue-b); --tb: var(--hue-c); }
  .about-stats .stat:nth-child(3) .ch-ico { --ta: var(--hue-c); --tb: var(--hue-a); }
  .about-stats .sv { font-size: clamp(28px, 3.4vw, 40px); }
  .sv-of { font-size: 18px; color: var(--k-ink-3); }
  /* "4.9" is narrower than its 3ch reservation; the "/ 5" sits right after it */
  .sv :global(.sv-n) { min-width: 0; }
  /* the team map: a compact triangle on a card, centred in the column */
  .about-map { width: 100%; max-width: 620px; margin: 28px auto 8px; padding: clamp(14px, 3vw, 26px); }
  /* h3 (was h4): the heading order runs h2, h3 here */
  .aside-card h3 { margin: 0 0 8px; font-size: 15px; font-weight: 600; letter-spacing: -0.01em; }
  .about-team-title { margin-top: var(--k-sp-8); }
  .about-team { margin-top: 24px; gap: 18px; }

  /* the hero roster card */
  .about-crew { display: grid; gap: 14px; padding: var(--k-sp-5); }
  .about-crew__head { margin: 0; display: flex; align-items: center; gap: 12px; padding-bottom: 12px; border-bottom: 1px solid var(--k-line); font-family: var(--k-font-mono); font-size: var(--k-fs-micro); font-weight: 500; letter-spacing: var(--k-ls-mono); text-transform: uppercase; color: var(--k-ink); }
  .about-crew__rows { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .about-crew__rows li { display: grid; grid-template-columns: 44px minmax(0, 1fr) auto; align-items: center; gap: 14px; padding: 10px 14px 10px 10px; border-radius: var(--k-r-md); background: var(--k-paper); border: 1px solid var(--k-line); box-shadow: var(--k-e1); }
  .about-crew__rows li:nth-child(2) { margin-left: 22px; }
  .about-crew__rows li:nth-child(3) { margin-left: 44px; }
  .about-crew__av { width: 44px; height: 44px; border-radius: 12px; overflow: clip; display: grid; place-items: center; background: var(--grad-vivid); color: #fff; font-weight: 600; box-shadow: 0 0 0 2px var(--k-paper), 0 0 0 3px rgb(var(--hue-b) / .35); }
  .about-crew__av img { width: 100%; height: 100%; object-fit: cover; }
  .about-crew__who { display: grid; gap: 2px; min-width: 0; }
  .about-crew__who b { font-size: 14.5px; font-weight: 600; color: var(--k-ink); }
  .about-crew__who span { font-family: var(--k-font-mono); font-size: 11px; letter-spacing: .04em; color: var(--k-accent-ink); }
  .about-crew__on { width: 8px; height: 8px; border-radius: 50%; background: var(--k-ok); box-shadow: 0 0 0 4px color-mix(in srgb, var(--k-ok) 18%, transparent); }
  .about-crew__foot { margin: 0; display: flex; align-items: center; gap: 10px; padding-top: 12px; border-top: 1px solid var(--k-line); font-size: 13px; color: var(--k-ink-3); }
  .about-crew__pin { width: 8px; height: 8px; border-radius: 50%; background: var(--grad-brand); }
  @media (max-width: 1023px) { :global(.phero-aside):has(.about-crew) { display: none; } }

  /* founder cards: a hue band, the photo overlapping it, then the story */
  .about-bio { position: relative; overflow: clip; padding: 0 24px 24px; }
  .about-bio__band { display: block; height: 86px; margin: 0 -24px; background: radial-gradient(80% 120% at 0% 0%, rgb(var(--hue-a) / .5), transparent 60%), radial-gradient(80% 120% at 100% 100%, rgb(var(--hue-c) / .45), transparent 60%), linear-gradient(120deg, rgb(var(--hue-b) / .35), rgb(var(--hue-a) / .2)); border-bottom: 1px solid var(--k-line); }
  .about-bio:nth-child(2) .about-bio__band { background: radial-gradient(80% 120% at 0% 0%, rgb(var(--hue-b) / .5), transparent 60%), radial-gradient(80% 120% at 100% 100%, rgb(var(--hue-a) / .45), transparent 60%), linear-gradient(120deg, rgb(var(--hue-c) / .3), rgb(var(--hue-b) / .2)); }
  .about-bio:nth-child(3) .about-bio__band { background: radial-gradient(80% 120% at 0% 0%, rgb(var(--hue-c) / .5), transparent 60%), radial-gradient(80% 120% at 100% 100%, rgb(var(--hue-b) / .45), transparent 60%), linear-gradient(120deg, rgb(var(--hue-a) / .3), rgb(var(--hue-c) / .2)); }
  .about-bio .avatar { width: 96px; height: 96px; margin-top: -48px; border-radius: 24px; position: relative; box-shadow: 0 0 0 4px var(--k-paper), 0 18px 30px -16px rgb(var(--hue-b) / .7); }
  .about-bio .avatar img { border-radius: 24px; }
  .about-bio h3 { margin-top: 18px; font-size: 19px; }
  .about-bio .role { display: inline-block; margin-top: 4px; padding: 3px 9px; border-radius: var(--k-r-pill); background: var(--k-accent-soft); }
  .about-bio p { font-size: 14px; }
</style>

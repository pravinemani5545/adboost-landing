---
import LeadLayout from '../../../layouts/LeadLayout.astro';
const title = 'The Zero-Ban Protocol — Free Compliance Framework | AdBoost Health';
const description = 'Get the exact 4-part compliance framework behind $50K/month in peptide & GLP-1 Meta ad spend, with zero bans. Free checklist for health-brand advertisers.';
---
<LeadLayout {title} {description} canonicalPath="/free/zero-ban-protocol/">
  <section class="container lead-wrap">
    <div class="lead-copy">
      <span class="eyebrow"><span class="dot"></span>FREE FRAMEWORK · PEPTIDE &amp; GLP-1 META ADS</span>
      <h1>Get the exact <span class="serif">4-part compliance framework</span> behind $50K/month in peptide &amp; GLP-1 Meta ad spend — with zero bans.</h1>
      <p class="lead-sub">The <strong>Zero-Ban Protocol</strong> we run on every peptide and GLP-1 account before we spend a dollar. It's a checklist you can run against your own account before your next launch, so you stop learning where Meta's lines are the expensive way: by crossing them.</p>
      <ul class="lead-benefits">
        <li><span class="ck">✓</span> Which of the two compliance lanes you're actually in (and when LegitScript is non-negotiable)</li>
        <li><span class="ck">✓</span> The account warm-up that buys a clean record before you ever run a conversion campaign</li>
        <li><span class="ck">✓</span> The copy &amp; creative kill-list that trips Meta's review fastest — and what to run instead</li>
        <li><span class="ck">✓</span> How to earn the right to run aggressive angles without torching your account history</li>
      </ul>
    </div>

    <div class="lead-form-card">
      <div id="formState">
        <h2>Send me the protocol</h2>
        <p class="lfc-sub">Enter your details and we'll email you the checklist right away.</p>
        <form id="leadForm" novalidate>
          <label for="lf-name">Name</label>
          <input id="lf-name" name="name" type="text" autocomplete="name" placeholder="Your name" required />
          <label for="lf-email">Work email</label>
          <input id="lf-email" name="email" type="email" autocomplete="email" placeholder="you@brand.com" required />
          <button type="submit" class="btn btn-primary lf-btn" id="lf-submit">Send me the protocol →</button>
          <p class="lf-error" id="lf-error" hidden></p>
        </form>
        <p class="lf-trust">No spam. Unsubscribe anytime. We only work with health-vertical brands.</p>
      </div>
      <div id="successState" hidden>
        <div class="lf-check" aria-hidden="true">✓</div>
        <h2>Check your inbox</h2>
        <p class="lfc-sub">The Zero-Ban Protocol is on its way to <strong id="sentTo"></strong>. If it's not there in a minute, check spam/promotions.</p>
        <a class="btn btn-primary lf-btn" href="https://cal.com/pira-ahilan-ef2dl8/strategy-call" target="_blank" rel="noopener">Prefer we just handle it? Book a call →</a>
      </div>
    </div>
  </section>

  <style is:global>
    .lead-wrap { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 56px; align-items: start; padding-top: 24px; }
    .lead-copy h1 { font-size: clamp(30px, 4.6vw, 46px); line-height: 1.08; letter-spacing: -.03em; font-weight: 600; margin: 16px 0 18px; }
    .lead-sub { font-size: 17px; line-height: 1.6; color: var(--ink-2); margin-bottom: 22px; }
    .lead-benefits { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; }
    .lead-benefits li { display: flex; gap: 10px; font-size: 15.5px; line-height: 1.5; color: var(--ink-2); }
    .lead-benefits .ck { color: var(--green, #16a34a); font-weight: 700; }
    .lead-form-card { background: var(--surface, #f6f7f9); border: 1px solid var(--line, #eceef3); border-radius: 16px; padding: 28px; position: sticky; top: 24px; }
    .lead-form-card h2 { font-size: 21px; letter-spacing: -.02em; margin: 0 0 6px; }
    .lfc-sub { color: var(--mute); font-size: 14px; margin: 0 0 18px; }
    #leadForm label { display: block; font-size: 13px; font-weight: 500; color: var(--ink-2); margin: 12px 0 6px; }
    #leadForm input { width: 100%; padding: 12px 14px; border: 1px solid var(--line, #dfe2e8); border-radius: 10px; font: inherit; font-size: 15px; background: #fff; outline: none; }
    #leadForm input:focus { border-color: var(--blue, #0057ff); }
    .lf-btn { width: 100%; justify-content: center; margin-top: 18px; }
    .lf-error { color: var(--coral, #ff6b3d); font-size: 13.5px; margin: 10px 0 0; }
    .lf-trust { color: var(--mute); font-size: 12.5px; margin: 14px 0 0; text-align: center; }
    .lf-check { width: 46px; height: 46px; border-radius: 50%; background: var(--green, #16a34a); color: #fff; font-size: 24px; display: flex; align-items: center; justify-content: center; margin-bottom: 14px; }
    @media (max-width: 820px) { .lead-wrap { grid-template-columns: 1fr; gap: 32px; } .lead-form-card { position: static; } }
  </style>

  <script is:inline>
    (function () {
      const form = document.getElementById('leadForm');
      const btn = document.getElementById('lf-submit');
      const err = document.getElementById('lf-error');
      const formState = document.getElementById('formState');
      const successState = document.getElementById('successState');
      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        err.hidden = true;
        const name = document.getElementById('lf-name').value.trim();
        const email = document.getElementById('lf-email').value.trim();
        if (!name || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
          err.textContent = 'Please enter your name and a valid email.'; err.hidden = false; return;
        }
        btn.disabled = true; btn.textContent = 'Sending…';
        try {
          const r = await fetch('/api/subscribe/', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name: name, email: email, source: 'compliance-framework' })
          });
          if (!r.ok) throw new Error('bad status');
          document.getElementById('sentTo').textContent = email;
          formState.hidden = true; successState.hidden = false;
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } catch (_) {
          btn.disabled = false; btn.textContent = 'Send me the protocol →';
          err.textContent = 'Something went wrong. Please try again, or email hello@adboost.health.'; err.hidden = false;
        }
      });
    })();
  </script>
</LeadLayout>

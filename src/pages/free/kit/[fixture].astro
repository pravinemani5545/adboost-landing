---
// Diagram kit fixtures route: /free/kit/diagrams/ and /free/kit/diagrams-night/.
// Never ships. A normal build has no paths here, and the fixture page is imported only
// when PREVIEW_ALL=1 or in dev, so production output carries none of its HTML, CSS or JS.
// It lives under /free/ because the sitemap and the content-date guard skip that prefix.
import { PREVIEW_ALL } from '../../../lib/live';

export function getStaticPaths() {
  if (!import.meta.env.DEV && !PREVIEW_ALL) return [];
  return [
    { params: { fixture: 'diagrams' }, props: { night: false } },
    { params: { fixture: 'diagrams-night' }, props: { night: true } },
  ];
}

const { night } = Astro.props as { night: boolean };
// import.meta.env.PREVIEW_ALL is inlined at build time ("1" becomes 1); when it is unset the
// branch is dead code, so the fixture page and its styles never enter a production bundle.
const Fixtures = import.meta.env.DEV || import.meta.env.PREVIEW_ALL == 1
  ? (await import('./_Fixtures.astro')).default
  : null;
---
{Fixtures && <Fixtures night={night} />}

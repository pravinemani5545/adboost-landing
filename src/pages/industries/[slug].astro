---
// /industries/<slug>/ on the AdBoost family design: the port of adboost-media's vertical page
// (src/components/page/IndustryPage.astro and src/components/industry/*) onto Health's family
// layer (src/family, class="family", tokens.css + content.css), in Health's blue, indigo and cyan.
// Every heading, sentence, FAQ, link and JSON-LD node is the one this page had on the old
// interior layout, in the same order; only the layout and the graphics are new.
//
//   hero     H1 with its serif accent, lede, buttons, trust line; the short answer and the
//            segments on a raised card; the vertical snapshot window with a phone (a matching
//            ad creative, the intake or a booking calendar) and chips (src/family/industry/Hero)
//   guide    the buyer questions as chapters beside the sticky "On this page" rail
//   band     the market paragraph as the dark band, its own moments on a numbered rail
//   body     the growth playbook as a step track with a drawing per step, the ad rules (callout,
//            review panel, platform status cards), mistakes and what good looks like as two cards
//   end      services bento, FAQ cards, related posts, sources, the old sidebar as rail cards,
//            the closing card (.cta-band)
// Layout decisions per vertical (creative, chips, timeline, step drawings, flags) live in
// src/family/industry/plan.ts, every label checked against this page's copy at build time.
import '../../styles/family/tokens.css';
import '../../styles/family/content.css';
import '../../styles/family/industry.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Toc from '../../family/Toc.astro';
import InlineCta from '../../family/InlineCta.astro';
import Hero from '../../family/industry/Hero.astro';
import Snapshot from '../../family/industry/Snapshot.astro';
import Phone from '../../family/industry/Phone.astro';
import Chapter from '../../family/industry/Chapter.astro';
import MarketBand from '../../family/industry/MarketBand.astro';
import Playbook from '../../family/industry/Playbook.astro';
import Rules from '../../family/industry/Rules.astro';
import Contrast from '../../family/industry/Contrast.astro';
import Services from '../../family/industry/Services.astro';
import Faq from '../../family/industry/Faq.astro';
import Reading from '../../family/industry/Reading.astro';
import { PLANS, checkPlan } from '../../family/industry/plan';
import { VERTICALS, getVertical } from '../../data/verticals';
import { getPlaybook, type Source } from '../../data/vertical-playbooks';
import { AD_POLICIES, RULES_CHECKED_ON, STATUS_LABEL } from '../../data/adPolicies';
import { PLATFORMS, STATUS_TONE, policyHref } from '../../components/adv/status';
import { cacNotes, miniScale } from './_cac';
import { siteBase } from '../../lib/site';
import { pageDate } from '../../lib/live';
import { getPublishedPosts } from '../../lib/blog';
import { metaDescription, seoTitle } from '../../lib/seo';
import { breadcrumb, faqPage, serviceNode } from '../../lib/schema';
import vercel from '../../../vercel.json';

export function getStaticPaths() {
  return VERTICALS.map((v) => ({ params: { slug: v.slug } }));
}

const { slug } = Astro.params;
const v = getVertical(slug!)!;
const pb = getPlaybook(v.slug)!;
const plan = PLANS[v.slug];
if (!plan) throw new Error(`[industries/${v.slug}] no layout plan in src/family/industry/plan.ts`);
checkPlan(v, pb, plan);
const SITE = siteBase(Astro.site);
const path = `/industries/${v.slug}/`;
const title = seoTitle(path, v.seoTitle ?? `${v.short} Marketing Agency | AdBoost Health`);
const description = metaDescription(path, v.metaDescription);
const faqAll = [...v.faq, ...pb.extraFaq];
const jsonLd = [
  serviceNode(SITE, { name: `Growth marketing for ${v.inline} brands`, description: v.serviceDesc, path }),
  breadcrumb(SITE, [{ label: 'Home', href: '/' }, { label: 'Industries', href: '/industries/' }, { label: v.short, href: path }]),
  faqPage(faqAll),
];

// Content date from src/data/pages.json: the visible "Updated" label.
const updated = pageDate(path);
const updatedLabel = updated
  ? new Date(`${updated}T00:00:00Z`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })
  : undefined;

const posts = await getPublishedPosts();
const publishedPaths = new Set(posts.map((p) => `/blog/${p.id}/`));

const platformGuides = AD_POLICIES.filter((p) => p.verticalSlug === v.slug);
const VERTICAL_BLOG: Record<string, { href: string; label: string }> = {
  'glp-1-weight-loss': { href: '/blog/glp1-advertising-compliance-2026/', label: 'How to run compliant GLP-1 ads without getting banned →' },
  'telehealth': { href: '/blog/legitscript-certification-telehealth-guide/', label: 'LegitScript certification for telehealth: cost, timeline and which ads need it →' },
  'supplements-dtc': { href: '/blog/supplement-brand-lower-cac-playbook/', label: 'The supplement playbook for lowering CAC while scaling →' },
  'trt-hormone': { href: '/advertising/trt-on-meta/', label: 'TRT and testosterone ads on Meta: the 2026 rules →' },
  'med-spa': { href: '/advertising/med-spa-on-meta/', label: 'Med spa ads on Meta after the July 2026 before-and-after change →' },
  'mental-health': { href: '/advertising/telehealth-on-meta/', label: 'Telehealth ads on Meta: LegitScript and prescription rules →' },
  'longevity': { href: '/blog/telehealth-cac-benchmarks-2026/', label: 'Telehealth CAC benchmarks: what top brands pay per patient →' },
  'peptides': { href: '/blog/glp1-meta-ad-policy-state-ag-2026/', label: 'GLP-1 on Meta after the 35-state-AG action: what changed →' },
  'fertility-ivf': { href: '/blog/health-ad-creative-rejected-fix/', label: 'Why health ads get rejected, and how to fix it →' },
};
const verticalBlog = VERTICAL_BLOG[v.slug] ?? { href: '/blog/health-ad-creative-rejected-fix/', label: 'Why health ads get rejected, and how to fix it →' };

// "Comparing agencies?" line in the answer box (health plan O10). Shown only once
// the post is published, so the supplements line appears with its post.
const VERTICAL_LISTICLE: Record<string, { href: string; lead: string; anchor: string }> = {
  'glp-1-weight-loss': { href: '/blog/best-glp1-marketing-agencies-2026/', lead: 'Comparing agencies? Read', anchor: 'how to choose a GLP-1 marketing agency' },
  'telehealth': { href: '/blog/best-telehealth-marketing-agencies-2026/', lead: 'Comparing agencies? Read', anchor: 'how to choose a telehealth marketing agency' },
  'supplements-dtc': { href: '/blog/best-supplement-marketing-agencies/', lead: 'Comparing agencies? See', anchor: 'our list of supplement marketing agencies' },
};
const listicleEntry = VERTICAL_LISTICLE[v.slug];
const listicle = listicleEntry && publishedPaths.has(listicleEntry.href) ? listicleEntry : undefined;

// Related posts (health plan O17): the 3 published posts sharing the most tags
// with the vertical, newest first on ties, skipping posts already linked above
// and posts that now redirect.
const RELATED_TAGS: Record<string, string[]> = {
  'glp-1-weight-loss': ['glp-1', 'weight loss', 'compliance', 'meta ads', 'retention'],
  'telehealth': ['telehealth', 'intake funnels', 'landing pages', 'attribution', 'google ads', 'patient acquisition'],
  'supplements-dtc': ['supplements', 'dtc', 'scaling', 'ad creative', 'creative testing', 'retention', 'subscriptions'],
  'trt-hormone': ['seo', 'ai search', 'content strategy', 'retention', 'lifecycle', 'google ads'],
  'peptides': ['seo', 'ai search', 'content strategy', 'retention', 'email marketing', 'brand trust'],
  'med-spa': ['creative testing', 'ad creative', 'ugc', 'lead generation', 'media buying'],
  'mental-health': ['intake funnels', 'cro', 'attribution', 'analytics', 'landing pages'],
  'longevity': ['retention', 'ltv', 'subscriptions', 'brand trust', 'ai search', 'patient trust', 'scaling'],
  'fertility-ivf': ['lead generation', 'patient trust', 'conversion', 'cro', 'measurement', 'patient acquisition'],
};
const redirected = new Set((vercel.redirects ?? []).map((r) => r.source));
const linkedAbove = new Set([verticalBlog.href, listicle?.href]);
const wanted = new Set((RELATED_TAGS[v.slug] ?? []).map((t) => t.toLowerCase()));
const relatedPosts = posts
  .map((p) => ({ p, href: `/blog/${p.id}/`, score: p.data.tags.filter((t) => wanted.has(t.toLowerCase())).length }))
  .filter((x) => x.score > 0 && !linkedAbove.has(x.href) && !redirected.has(x.href))
  .sort((a, b) => b.score - a.score)
  .slice(0, 3);

const sources: Source[] = [...pb.questions.flatMap((q) => q.sources), ...v.sources]
  .filter((s, i, all) => all.findIndex((x) => x.url === s.url) === i);

const services = [
  { t: 'Compliant paid media', d: 'Meta, Google & TikTok, structured for this vertical’s auction.', href: '/services/paid-media/', art: 'paid-media' },
  { t: 'In-house creative', d: '20+ compliant variants a month, built around winning angles.', href: '/services/creative/', art: 'creative' },
  { t: 'CRO & funnels', d: 'Quiz funnels and landers tuned to LTV and payback.', href: '/services/cro/', art: 'cro' },
];
// Every string and number below comes from verticals.ts, vertical-playbooks.ts or adPolicies.ts
// as printed on the site.
const guides = [...platformGuides].sort((a, b) => PLATFORMS.indexOf(a.platform) - PLATFORMS.indexOf(b.platform));
const strip = guides.map((p) => ({ label: p.platform, status: STATUS_LABEL[p.status], level: STATUS_TONE[p.status] }));
const checkedLabel = new Date(`${RULES_CHECKED_ON}T00:00:00Z`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
// The platform status cards: every rule sheet; the one the callout already links keeps its
// status and drops its own link (the old page skipped that card for the same reason).
const ruleCards = guides.map((p) => ({
  platform: p.platform,
  status: p.status,
  label: `${p.vertical} ads on ${p.platform}: what is allowed`,
  href: policyHref(p) !== verticalBlog.href ? policyHref(p) : undefined,
}));
const PILL_TONE: Record<string, string> = { allowed: 'ok', restricted: 'warn', cert: '', prohibited: 'bad' };

// The funnel path: only a chain the copy already prints with arrows (see Playbook.pathway).
const pathway = pb.pathway?.length ? pb.pathway : undefined;
const pathStep = pathway
  ? pb.growthPlaybook.findIndex((s) => s.h.includes(pathway.join(' → ')) || s.p.includes(pathway.join(' → ')))
  : -1;
if (pathway && pathStep < 0) {
  throw new Error(`[industries/${v.slug}] pathway "${pathway.join(' → ')}" is not printed in any growth playbook step`);
}
const flowAt = plan.steps.findIndex((s) => s.kind === 'flow' && s.stages.length === 0);
if (flowAt !== pathStep) throw new Error(`[industries/${v.slug}] plan.ts draws the pathway at step ${flowAt + 1}, the copy prints it at step ${pathStep + 1}`);

// The hero chips: one of the page's segments, and the first platform status (or the trust
// line's typical CAC where the vertical has no rule sheets).
const chips = [
  { title: plan.segment, label: 'Segments we work in', icon: 'users', tone: 'b' as const },
  strip[0]
    ? { title: strip[0].label, label: strip[0].status, icon: 'shield', tone: 'g' as const }
    : { title: v.cacDisplay, label: 'Typical CAC', icon: 'gauge', tone: 'g' as const },
];

// The at-a-glance card draws this vertical's CAC on the same axis as the snapshot.
const scale = miniScale(VERTICALS);
const glanceSegs = scale.segs(v.cacLow, v.cacHigh);

// Headings split for their serif accents (text unchanged).
const marketH = `What is changing in the ${v.inline} market in 2026?`;
const servicesLead = 'What does AdBoost Health do for';
const servicesAccent = `${v.inline} brands?`;

const toc = [
  ...pb.questions.map((q) => ({ id: q.id, label: q.nav })),
  { id: 'market', label: 'Market context' },
  { id: 'playbook', label: 'The growth playbook' },
  { id: 'landmine', label: 'Ad rules to watch' },
  { id: 'mistakes', label: 'Common mistakes' },
  { id: 'good', label: 'What good looks like' },
  { id: 'services', label: 'What we do' },
  { id: 'faq', label: 'FAQ' },
];
---
<BaseLayout {title} {description} canonicalPath={path} {jsonLd}>
  <div class="family ix" data-ind={v.slug}>
    <div class="read-bar" aria-hidden="true"></div>

    <Hero
      crumbs={[{ label: 'Home', href: '/' }, { label: 'Industries', href: '/industries/' }, { label: v.short }]}
      eyebrow={v.category}
      h1={v.h1}
      lede={v.lede}
      meta={[`Typical CAC ${v.cacDisplay}`, 'Compliance-first', 'Setup in 5 days']}
      updated={updated && updatedLabel ? { iso: updated, label: updatedLabel } : undefined}
      segments={pb.subSegments}
      chips={chips}
    >
      <Fragment slot="answer">
        <span class="pg-answer-lab">The short answer</span>
        {`${v.summary} ${v.proofLine} We only work in health, so the playbook, creative and policy review are built for ${v.inline} brands.`}
        {listicle && <span class="ix-listicle">{listicle.lead} <a href={listicle.href}>{listicle.anchor}</a>.</span>}
      </Fragment>
      <Phone slot="phone" creative={plan.creative} stages={plan.phone?.kind === 'intake' ? pathway : undefined} booking={plan.phone?.kind === 'booking' ? plan.phone.label : undefined} />
      <Snapshot
        slot="stage"
        current={v.slug}
        title="Vertical snapshot"
        pill="Typical CAC"
        caption={`Typical CAC by vertical, as each industry page quotes it, with ${v.short} lit. ${cacNotes(VERTICALS)}`}
        strip={strip}
        stripCaption={`${v.short} ad rules on each platform, from our rule sheets (checked ${checkedLabel}).`}
      />
    </Hero>

    <section class="ix-guide">
      <div class="container ix-guide-grid">
        <div class="ix-guide-rail"><div class="ix-rail-box"><Toc items={toc} /></div></div>
        <div class="ix-guide-main">
          {pb.questions.map((q) => <Chapter id={q.id} q={q.q} html={q.html} sources={q.sources} art={plan.questions?.[q.id]} />)}
        </div>
      </div>
    </section>

    <MarketBand
      id="market"
      lead={marketH.replace(/ in 2026\?$/, '')}
      accent="in 2026?"
      text={pb.marketContext}
      timeline={plan.timeline}
    />

    <section class="ix-guide ix-guide-b">
      <div class="container ix-wide">
        <Playbook
          id="playbook"
          heading={`How do ${v.inline} brands grow profitably?`}
          intro={v.painPoint}
          steps={pb.growthPlaybook}
          arts={plan.steps}
          pathway={pathway}
          pathStep={pathStep}
        />
        <Rules
          id="landmine"
          heading={`Which ad rules and claims trip up ${v.inline} brands?`}
          landmine={v.adLandmine}
          guide={verticalBlog}
          flags={plan.flags}
          cards={ruleCards}
        />
        <Contrast
          mistakes={{ id: 'mistakes', heading: `What are the most common ${v.inline} marketing mistakes?`, items: pb.commonMistakes }}
          good={{ id: 'good', heading: `What does good performance look like for ${v.inline} brands?`, items: pb.whatGoodLooksLike }}
          caption={`The ${v.inline} mistakes we see most, set against what good performance looks like.`}
        />
      </div>
    </section>

    <Services id="services" lead={servicesLead} accent={servicesAccent} items={services} creatives={['/ads/nectar.webp', '/ads/cabo.webp', '/ads/limitless.webp']} />

    <Faq id="faq" lead={`${v.short} marketing`} accent="FAQ" items={faqAll} idPrefix={`ind-${v.slug}`} />

    <Reading
      posts={relatedPosts.map(({ p, href }) => ({ href, title: p.data.title, description: p.data.description }))}
      sourcesNote="Platform policies checked against each platform’s live policy on Oct 30, 2026. Ad policies change; confirm current requirements with the platform and qualified counsel before launching. This is general information, not legal advice."
      sources={sources}
      glance={{
        heading: `${v.short} at a glance`,
        cac: v.cacDisplay,
        segs: glanceSegs,
        approx: v.cacDisplay.trim().startsWith('~'),
        open: v.cacDisplay.trim().endsWith('+'),
        links: [
          { href: '/glossary/cac/', label: `Typical CAC ${v.cacDisplay} →` },
          { href: '/tools/cac-calculator/', label: 'Benchmark your CAC' },
          { href: '/tools/ltv-cac-calculator/', label: 'Check your LTV:CAC' },
        ],
      }}
      guides={{
        heading: 'Platform compliance guides',
        links: platformGuides.map((p) => ({ href: `/advertising/${p.slug}/`, label: `${p.vertical} ads on ${p.platform}: what is allowed`, status: STATUS_LABEL[p.status], tone: PILL_TONE[p.status] })),
      }}
      night={{ heading: `Lower CAC on your ${v.inline} brand`, text: 'Free audit with a senior strategist: a written plan you keep either way.' }}
    />

    <section class="ix-end">
      <div class="container"><InlineCta heading={`Ready to lower CAC on your ${v.inline} brand?`} /></div>
    </section>
  </div>
</BaseLayout>

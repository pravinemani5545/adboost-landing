---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import Closing from '../../components/Closing.astro';
import Faq from '../../components/Faq.astro';
import Steps from '../../components/Steps.astro';
import Brief from '../../components/doc/Brief.astro';
import Toc from '../../components/doc/Toc.astro';
import AsideLinks from '../../components/doc/AsideLinks.astro';
import AsideCta from '../../components/doc/AsideCta.astro';
import { VERTICALS, getVertical } from '../../data/verticals';
import { getPlaybook } from '../../data/vertical-playbooks';
import { AD_POLICIES } from '../../data/adPolicies';
import { siteBase } from '../../lib/site';
import { breadcrumb, faqPage, serviceNode } from '../../lib/schema';

export function getStaticPaths() {
  return VERTICALS.map((v) => ({ params: { slug: v.slug } }));
}

const { slug } = Astro.params;
const v = getVertical(slug!)!;
const pb = getPlaybook(v.slug)!;
const SITE = siteBase(Astro.site);
const path = `/industries/${v.slug}/`;
const title = `${v.short} Marketing Agency | AdBoost Health`;
const description = v.lede.slice(0, 155);
const faqAll = [...v.faq, ...pb.extraFaq];
const jsonLd = [
  serviceNode(SITE, { name: `Growth marketing for ${v.short} brands`, description: v.serviceDesc, path }),
  breadcrumb(SITE, [{ label: 'Home', href: '/' }, { label: 'Industries', href: '/industries/' }, { label: v.short, href: path }]),
  faqPage(faqAll),
];
const platformGuides = AD_POLICIES.filter((p) => p.verticalSlug === v.slug);
const VERTICAL_BLOG: Record<string, { href: string; label: string }> = {
  'glp-1-weight-loss': { href: '/blog/glp1-advertising-compliance-2026/', label: 'How to run compliant GLP-1 ads without getting banned →' },
  'telehealth': { href: '/blog/telehealth-cac-benchmarks-2026/', label: 'Telehealth CAC benchmarks: what top brands pay per patient →' },
  'supplements-dtc': { href: '/blog/supplement-brand-lower-cac-playbook/', label: 'The supplement playbook for lowering CAC while scaling →' },
  'trt-hormone': { href: '/blog/telehealth-cac-benchmarks-2026/', label: 'Telehealth CAC benchmarks: what top brands pay per patient →' },
  'med-spa': { href: '/blog/health-ad-creative-rejected-fix/', label: 'Why health ads get rejected, and how to fix it →' },
  'mental-health': { href: '/blog/telehealth-cac-benchmarks-2026/', label: 'Telehealth CAC benchmarks: what top brands pay per patient →' },
  'longevity': { href: '/blog/telehealth-cac-benchmarks-2026/', label: 'Telehealth CAC benchmarks: what top brands pay per patient →' },
  'peptides': { href: '/blog/glp1-meta-ad-policy-state-ag-2026/', label: 'GLP-1 on Meta after the 35-state-AG action: what changed →' },
  'fertility-ivf': { href: '/blog/best-telehealth-marketing-agencies-2026/', label: 'The best telehealth marketing agencies, ranked →' },
};
const verticalBlog = VERTICAL_BLOG[v.slug] ?? { href: '/blog/health-ad-creative-rejected-fix/', label: 'Why health ads get rejected, and how to fix it →' };
const services = [
  { t: 'Compliant paid media', d: 'Meta, Google & TikTok, structured for this vertical’s auction.', href: '/services/paid-media/' },
  { t: 'In-house creative', d: '20+ compliant variants a month, built around winning angles.', href: '/services/creative/' },
  { t: 'CRO & funnels', d: 'Quiz funnels and landers tuned to LTV and payback.', href: '/services/cro/' },
];
const toc = [
  { id: 'market', label: 'Market context' },
  { id: 'playbook', label: 'The growth playbook' },
  { id: 'landmine', label: 'Compliance landmines' },
  { id: 'mistakes', label: 'Common mistakes' },
  { id: 'good', label: 'What good looks like' },
  { id: 'services', label: 'What we do' },
  { id: 'faq', label: 'FAQ' },
];
const arrow = '<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 7h10M8 3l4 4-4 4"/></svg>';
---
<BaseLayout {title} {description} canonicalPath={path} {jsonLd}>
  <PageHead label="Industries" labelHref="/industries/" title={v.h1} lede={v.lede} dots>
    <ul class="phead-facts arrive" style="--d:240ms">
      <li>Typical CAC {v.cacDisplay}</li><li>Compliance-first</li><li>Setup in 5 days</li>
    </ul>
  </PageHead>

  <section class="tone-paper page-body" data-nav="paper">
    <div class="wrap doc">
      <div class="doc-main">
        <Brief label="The short answer">{v.proofLine} We only work in health, so the playbook, creative, and compliance are purpose-built for {v.short.toLowerCase()}, not adapted from a generic DTC template.</Brief>

        <div class="doc-sec" id="market">
          <h2>Market context</h2>
          <p>{pb.marketContext}</p>
        </div>

        <div class="doc-sec" id="playbook">
          <h2>The {v.short.toLowerCase()} growth playbook</h2>
          <p>{v.painPoint}</p>
          <Steps items={pb.growthPlaybook.map((s) => ({ title: s.h, body: s.p }))} />
        </div>

        <div class="doc-sec" id="landmine">
          <h2>Compliance landmines</h2>
          <div class="note warn">
            <p class="label">Watch for this</p>
            <p>{v.adLandmine} <a href={verticalBlog.href}>{verticalBlog.label}</a></p>
          </div>
        </div>

        <div class="doc-sec" id="mistakes">
          <h2>Common mistakes in {v.short.toLowerCase()}</h2>
          <ul class="crosses">{pb.commonMistakes.map((m) => <li>{m}</li>)}</ul>
        </div>

        <div class="doc-sec" id="good">
          <h2>What good looks like</h2>
          <ul class="ticks">{pb.whatGoodLooksLike.map((k) => <li>{k}</li>)}</ul>
          <h3>Segments we work in</h3>
          <div class="tags">{pb.subSegments.map((s) => <span class="tag">{s}</span>)}</div>
        </div>

        <div class="doc-sec" id="services">
          <h2>What we do for {v.short.toLowerCase()} brands</h2>
          <div class="cards" style="--cols:3">
            {services.map((s, i) => (
              <a class="icard card" href={s.href} data-reveal style={`--i:${i}`}>
                <span class="idx">{String(i + 1).padStart(2, '0')}</span>
                <h3>{s.t}</h3>
                <p>{s.d}</p>
                <span class="more">Learn more <Fragment set:html={arrow} /></span>
              </a>
            ))}
          </div>
        </div>

        <div class="doc-sec" id="faq">
          <h2>{v.short} marketing FAQ</h2>
          <Faq items={faqAll} />
        </div>
      </div>

      <aside class="doc-aside">
        <AsideLinks
          label={`${v.short} at a glance`}
          links={[
            { href: '/glossary/cac/', label: `Typical CAC ${v.cacDisplay}` },
            { href: '/tools/cac-calculator/', label: 'Benchmark your CAC' },
            { href: '/tools/ltv-cac-calculator/', label: 'Check your LTV:CAC' },
          ]}
        />
        {platformGuides.length > 0 && (
          <AsideLinks label="Platform compliance guides" links={platformGuides.map((p) => ({ href: `/advertising/${p.slug}/`, label: `${p.vertical} ads on ${p.platform}: what is allowed` }))} />
        )}
        <AsideCta heading={`Lower CAC on your ${v.short.toLowerCase()} brand`} text="Free audit with a senior strategist, a written plan you keep either way." />
        <Toc items={toc} />
      </aside>
    </div>
  </section>

  <Closing heading={`Ready to lower CAC on your ${v.short.toLowerCase()} brand?`} />
</BaseLayout>


---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Faq from '../../components/Faq.astro';
import Snapshot from './_Snapshot.astro';
import Flow from '../../kit/diagram/Flow.astro';
import Compare from '../../kit/diagram/Compare.astro';
import { VERTICALS, getVertical } from '../../data/verticals';
import { getPlaybook, type Source } from '../../data/vertical-playbooks';
import { AD_POLICIES, RULES_CHECKED_ON, STATUS_LABEL } from '../../data/adPolicies';
import { PLATFORMS, STATUS_TONE, policyHref } from '../../components/adv/status';
import '../../styles/pages/industries.css';
import { siteBase } from '../../lib/site';
import { pageDate } from '../../lib/live';
import { getPublishedPosts } from '../../lib/blog';
import { metaDescription, seoTitle } from '../../lib/seo';
import { breadcrumb, faqPage, serviceNode } from '../../lib/schema';
import vercel from '../../../vercel.json';

export function getStaticPaths() {
  return VERTICALS.map((v) => ({ params: { slug: v.slug } }));
}

const { slug } = Astro.params;
const v = getVertical(slug!)!;
const pb = getPlaybook(v.slug)!;
const SITE = siteBase(Astro.site);
const path = `/industries/${v.slug}/`;
const title = seoTitle(path, v.seoTitle ?? `${v.short} Marketing Agency | AdBoost Health`);
const description = metaDescription(path, v.metaDescription);
const faqAll = [...v.faq, ...pb.extraFaq];
const jsonLd = [
  serviceNode(SITE, { name: `Growth marketing for ${v.inline} brands`, description: v.serviceDesc, path }),
  breadcrumb(SITE, [{ label: 'Home', href: '/' }, { label: 'Industries', href: '/industries/' }, { label: v.short, href: path }]),
  faqPage(faqAll),
];

// Content date from src/data/pages.json: the visible "Updated" label.
const updated = pageDate(path);
const updatedLabel = updated
  ? new Date(`${updated}T00:00:00Z`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })
  : undefined;

const posts = await getPublishedPosts();
const publishedPaths = new Set(posts.map((p) => `/blog/${p.id}/`));

const platformGuides = AD_POLICIES.filter((p) => p.verticalSlug === v.slug);
const VERTICAL_BLOG: Record<string, { href: string; label: string }> = {
  'glp-1-weight-loss': { href: '/blog/glp1-advertising-compliance-2026/', label: 'How to run compliant GLP-1 ads without getting banned →' },
  'telehealth': { href: '/blog/legitscript-certification-telehealth-guide/', label: 'LegitScript certification for telehealth: cost, timeline and which ads need it →' },
  'supplements-dtc': { href: '/blog/supplement-brand-lower-cac-playbook/', label: 'The supplement playbook for lowering CAC while scaling →' },
  'trt-hormone': { href: '/advertising/trt-on-meta/', label: 'TRT and testosterone ads on Meta: the 2026 rules →' },
  'med-spa': { href: '/advertising/med-spa-on-meta/', label: 'Med spa ads on Meta after the July 2026 before-and-after change →' },
  'mental-health': { href: '/advertising/telehealth-on-meta/', label: 'Telehealth ads on Meta: LegitScript and prescription rules →' },
  'longevity': { href: '/blog/telehealth-cac-benchmarks-2026/', label: 'Telehealth CAC benchmarks: what top brands pay per patient →' },
  'peptides': { href: '/blog/glp1-meta-ad-policy-state-ag-2026/', label: 'GLP-1 on Meta after the 35-state-AG action: what changed →' },
  'fertility-ivf': { href: '/blog/health-ad-creative-rejected-fix/', label: 'Why health ads get rejected, and how to fix it →' },
};
const verticalBlog = VERTICAL_BLOG[v.slug] ?? { href: '/blog/health-ad-creative-rejected-fix/', label: 'Why health ads get rejected, and how to fix it →' };

// "Comparing agencies?" line in the answer box (health plan O10). Shown only once
// the post is published, so the supplements line appears with its post.
const VERTICAL_LISTICLE: Record<string, { href: string; lead: string; anchor: string }> = {
  'glp-1-weight-loss': { href: '/blog/best-glp1-marketing-agencies-2026/', lead: 'Comparing agencies? Read', anchor: 'how to choose a GLP-1 marketing agency' },
  'telehealth': { href: '/blog/best-telehealth-marketing-agencies-2026/', lead: 'Comparing agencies? Read', anchor: 'how to choose a telehealth marketing agency' },
  'supplements-dtc': { href: '/blog/best-supplement-marketing-agencies/', lead: 'Comparing agencies? See', anchor: 'our list of supplement marketing agencies' },
};
const listicleEntry = VERTICAL_LISTICLE[v.slug];
const listicle = listicleEntry && publishedPaths.has(listicleEntry.href) ? listicleEntry : undefined;

// Related posts (health plan O17): the 3 published posts sharing the most tags
// with the vertical, newest first on ties, skipping posts already linked above
// and posts that now redirect.
const RELATED_TAGS: Record<string, string[]> = {
  'glp-1-weight-loss': ['glp-1', 'weight loss', 'compliance', 'meta ads', 'retention'],
  'telehealth': ['telehealth', 'intake funnels', 'landing pages', 'attribution', 'google ads', 'patient acquisition'],
  'supplements-dtc': ['supplements', 'dtc', 'scaling', 'ad creative', 'creative testing', 'retention', 'subscriptions'],
  'trt-hormone': ['seo', 'ai search', 'content strategy', 'retention', 'lifecycle', 'google ads'],
  'peptides': ['seo', 'ai search', 'content strategy', 'retention', 'email marketing', 'brand trust'],
  'med-spa': ['creative testing', 'ad creative', 'ugc', 'lead generation', 'media buying'],
  'mental-health': ['intake funnels', 'cro', 'attribution', 'analytics', 'landing pages'],
  'longevity': ['retention', 'ltv', 'subscriptions', 'brand trust', 'ai search', 'patient trust', 'scaling'],
  'fertility-ivf': ['lead generation', 'patient trust', 'conversion', 'cro', 'measurement', 'patient acquisition'],
};
const redirected = new Set((vercel.redirects ?? []).map((r) => r.source));
const linkedAbove = new Set([verticalBlog.href, listicle?.href]);
const wanted = new Set((RELATED_TAGS[v.slug] ?? []).map((t) => t.toLowerCase()));
const relatedPosts = posts
  .map((p) => ({ p, href: `/blog/${p.id}/`, score: p.data.tags.filter((t) => wanted.has(t.toLowerCase())).length }))
  .filter((x) => x.score > 0 && !linkedAbove.has(x.href) && !redirected.has(x.href))
  .sort((a, b) => b.score - a.score)
  .slice(0, 3);

const sources: Source[] = [...pb.questions.flatMap((q) => q.sources), ...v.sources]
  .filter((s, i, all) => all.findIndex((x) => x.url === s.url) === i);

const services = [
  { t: 'Compliant paid media', d: 'Meta, Google & TikTok, structured for this vertical’s auction.', href: '/services/paid-media/' },
  { t: 'In-house creative', d: '20+ compliant variants a month, built around winning angles.', href: '/services/creative/' },
  { t: 'CRO & funnels', d: 'Quiz funnels and landers tuned to LTV and payback.', href: '/services/cro/' },
];
// Vertical snapshot (hero aside) and the body diagrams. Every string and number below comes
// from verticals.ts, vertical-playbooks.ts or adPolicies.ts as printed on the site.
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const guides = [...platformGuides].sort((a, b) => PLATFORMS.indexOf(a.platform) - PLATFORMS.indexOf(b.platform));
const strip = guides.map((p) => ({ label: p.platform, status: STATUS_LABEL[p.status], level: STATUS_TONE[p.status], href: policyHref(p) }));
// The hero strip shows each platform's status; the body links each rule sheet under the callout,
// skipping one the callout already links.
const ruleLinks = guides.filter((p) => policyHref(p) !== verticalBlog.href);
const checkedLabel = new Date(`${RULES_CHECKED_ON}T00:00:00Z`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

// The funnel path: only a chain the copy already prints with arrows (see Playbook.pathway).
// It is drawn under the step that prints it.
const pathway = pb.pathway?.length ? pb.pathway : undefined;
const pathStep = pathway
  ? pb.growthPlaybook.findIndex((s) => s.h.includes(pathway.join(' → ')) || s.p.includes(pathway.join(' → ')))
  : -1;
if (pathway && pathStep < 0) {
  throw new Error(`[industries/${v.slug}] pathway "${pathway.join(' → ')}" is not printed in any growth playbook step`);
}

const toc = [
  ...pb.questions.map((q) => ({ id: q.id, label: q.nav })),
  { id: 'market', label: 'Market context' },
  { id: 'playbook', label: 'The growth playbook' },
  { id: 'landmine', label: 'Ad rules to watch' },
  { id: 'mistakes', label: 'Common mistakes' },
  { id: 'good', label: 'What good looks like' },
  { id: 'services', label: 'What we do' },
  { id: 'faq', label: 'FAQ' },
];
---
<BaseLayout {title} {description} canonicalPath={path} {jsonLd}>
  <PageHero
    class="ind-hero"
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Industries', href: '/industries/' }, { label: v.short }]}
    eyebrow={v.category}
    title={esc(v.h1)}
    lede={esc(v.lede)}
    art="/art/industries/hub"
  >
    <div class="phero-meta">
      <span>Typical CAC {v.cacDisplay}</span>
      <span>Compliance-first</span>
      <span>Setup in 5 days</span>
      {updatedLabel && <span>Updated <time datetime={updated}>{updatedLabel}</time></span>}
    </div>
    <div slot="aside" class="k-card k-card--float k-card--glass ind-snap ind-snap--hero">
      <Snapshot slug={v.slug} short={v.short} strip={strip} checkedLabel={checkedLabel} />
    </div>
  </PageHero>

  <section class="iwrap ind-doc">
    <div class="container">
      <div class="doc-grid">
        <div class="doc-main">
          <div class="answer-box">
            <span class="al">The short answer</span>
            {v.summary} {v.proofLine} We only work in health, so the playbook, creative and policy review are built for {v.inline} brands.
            {listicle && <span class="ind-listicle">{listicle.lead} <a href={listicle.href}>{listicle.anchor}</a>.</span>}
          </div>
          {/* below 1024px the hero has no aside: the snapshot follows the short answer instead */}
          <div class="k-card k-card--raised ind-snap ind-snap--body">
            <Snapshot slug={v.slug} short={v.short} strip={strip} checkedLabel={checkedLabel} />
          </div>
          <div class="ind-segs">
            <p class="ind-snap__label">Segments we work in</p>
            <ul class="ind-chips">{pb.subSegments.map((s) => <li class="k-chip">{s}</li>)}</ul>
          </div>
          <div class="prose">
            {pb.questions.map((q) => (
              <>
                <h2 id={q.id}>{q.q}</h2>
                <Fragment set:html={q.html} />
              </>
            ))}

            <h2 id="market">What is changing in the {v.inline} market in 2026?</h2>
            <p>{pb.marketContext}</p>

            <h2 id="playbook">How do {v.inline} brands grow profitably?</h2>
            <p>{v.painPoint}</p>
            <ol class="ind-steps" data-draw>
              {pb.growthPlaybook.map((s, i) => (
                <li class="ind-step" style={`--i:${i}`}>
                  <span class="ind-step__n" aria-hidden="true">{i + 1}</span>
                  <div class="ind-step__body">
                    <h3>{s.h}</h3>
                    <p>{s.p}</p>
                    {i === pathStep && pathway && (
                      <Flow
                        class="ind-path"
                        numbered={false}
                        pulse
                        caption={`Step ${i + 1} as a path, each stage in the playbook’s own words.`}
                        nodes={pathway.map((label) => ({ label: label.charAt(0).toUpperCase() + label.slice(1) }))}
                      />
                    )}
                  </div>
                </li>
              ))}
            </ol>

            <h2 id="landmine">Which ad rules and claims trip up {v.inline} brands?</h2>
            <div class="callout warn"><span class="cl-label">Watch for this</span>{v.adLandmine} <a href={verticalBlog.href}>{verticalBlog.label}</a></div>
            {ruleLinks.length > 0 && (
              <ul class="ind-rulelinks">
                {ruleLinks.map((p) => <li><a href={policyHref(p)}>{p.vertical} ads on {p.platform}: what is allowed<span aria-hidden="true"> →</span></a></li>)}
              </ul>
            )}

            <div class="ind-cmp">
              <div class="ind-cmp__heads">
                <h2 id="mistakes">What are the most common {v.inline} marketing mistakes?</h2>
                <h2 id="good">What does good performance look like for {v.inline} brands?</h2>
              </div>
              <Compare
                variant="split"
                caption={`The ${v.inline} mistakes we see most, set against what good performance looks like.`}
                left={{ label: 'Common mistakes', items: pb.commonMistakes }}
                right={{ label: 'What good looks like', items: pb.whatGoodLooksLike }}
              />
            </div>

            <h2 id="services">What does AdBoost Health do for {v.inline} brands?</h2>
            <div class="related-grid ind-cards">
              {services.map((s) => (
                <a class="lcard" href={s.href}><h3>{s.t}</h3><p>{s.d}</p><span class="lc-more">Learn more →</span></a>
              ))}
            </div>

            <h2 id="faq">{v.short} marketing FAQ</h2>
            <Faq items={faqAll} idPrefix={`ind-${v.slug}`} />

            {relatedPosts.length > 0 && (
              <>
                <h3 id="related">Related posts</h3>
                <div class="related-grid ind-cards">
                  {relatedPosts.map(({ p, href }) => (
                    <a class="lcard" href={href}><h3>{p.data.title}</h3><p>{p.data.description}</p><span class="lc-more">Read the post →</span></a>
                  ))}
                </div>
              </>
            )}

            <h3>Sources</h3>
            <p class="ind-src-note">Platform policies checked against each platform’s live policy on Oct 30, 2026. Ad policies change; confirm current requirements with the platform and qualified counsel before launching. This is general information, not legal advice.</p>
            <ul class="ind-src-list">
              {sources.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.label}</a></li>)}
            </ul>
          </div>
        </div>

        <aside class="doc-aside">
          <div class="aside-toc">
            <div class="at-label">On this page</div>
            <ul>{toc.map((t) => <li><a href={`#${t.id}`}>{t.label}</a></li>)}</ul>
          </div>
          <div class="aside-card">
            <h4>{v.short} at a glance</h4>
            <div class="link-list">
              <a href="/glossary/cac/">Typical CAC {v.cacDisplay} →</a>
              <a href="/tools/cac-calculator/">Benchmark your CAC</a>
              <a href="/tools/ltv-cac-calculator/">Check your LTV:CAC</a>
            </div>
          </div>
          {platformGuides.length > 0 && (
            <div class="aside-card">
              <h4>Platform compliance guides</h4>
              <div class="link-list">
                {platformGuides.map((p) => <a href={`/advertising/${p.slug}/`}>{p.vertical} ads on {p.platform}: what is allowed</a>)}
              </div>
            </div>
          )}
          <div class="aside-card dark">
            <h4>Lower CAC on your {v.inline} brand</h4>
            <p>Free audit with a senior strategist: a written plan you keep either way.</p>
            <a class="btn btn-primary" href="/book/">Book a call →</a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <CtaBand heading={`Ready to lower CAC on your ${v.inline} brand?`} />
</BaseLayout>

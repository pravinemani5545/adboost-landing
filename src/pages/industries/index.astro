---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import { VERTICALS } from '../../data/verticals';
import { siteBase } from '../../lib/site';
import { breadcrumb } from '../../lib/schema';

const SITE = siteBase(Astro.site);
const title = 'Health Verticals We Grow | Industries | AdBoost Health';
const description = 'Specialist paid acquisition for GLP-1, telehealth, supplements, TRT, peptides, med spa, mental health, longevity, and fertility brands. See the playbook for your vertical.';
const jsonLd = [
  breadcrumb(SITE, [{ label: 'Home', href: '/' }, { label: 'Industries', href: '/industries/' }]),
  {
    '@type': 'CollectionPage',
    name: 'Health industries AdBoost Health serves',
    url: `${SITE}/industries/`,
    hasPart: VERTICALS.map((v) => ({ '@type': 'WebPage', name: v.name, url: `${SITE}/industries/${v.slug}/` })),
  },
];
---
<BaseLayout {title} {description} canonicalPath="/industries/" {jsonLd}>
  <section class="phero">
    <div class="container">
      <div class="phero-grid">
        <div>
          <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Industries' }]} />
          <span class="eyebrow sec-eyebrow" style="display:block;margin-top:16px"><span class="dot"></span>INDUSTRIES</span>
          <h1>We only grow <span class="serif">health</span> brands.</h1>
          <p class="phero-lede">Every vertical has its own economics, ad-policy landmines, and definition of a good CAC. Pick yours for the specific playbook, benchmarks, and compliance rules that apply.</p>
          <div class="phero-meta"><span>{VERTICALS.length} verticals</span><span>Compliance-first</span><span>Setup in 5 days</span></div>
        </div>
        <div class="reveal d1">
          <div class="hero-panel">
            <div class="hp-head">
              <span class="t"><span class="live-dot"></span>Verticals we scale</span>
              <span class="m">TYPICAL CAC</span>
            </div>
            {VERTICALS.slice(0, 6).map((v, i) => (
              <a class="hp-row" href={`/industries/${v.slug}/`}>
                <span class="nm"><span class="ic" style={`background:linear-gradient(135deg,${['#3b7bff','#16a34a','#f59e0b','#8b5cf6','#06b6d4','#ec4899'][i]},#0040c2)`}>{v.short[0]}</span>{v.short}</span>
                <span class="v">{v.cacDisplay}</span>
              </a>
            ))}
            <div class="hp-foot">
              <div class="kv"><span class="k">VERTICALS</span><div class="val">{VERTICALS.length}</div></div>
              <div class="kv"><span class="k">FOUNDERS SERVED</span><div class="val">71+</div></div>
              <div class="kv"><span class="k">TRACKED</span><div class="val">$153M+</div></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="iwrap">
    <div class="container">
      <div class="grid-cards">
        {VERTICALS.map((v) => (
          <a class="lcard reveal" href={`/industries/${v.slug}/`}>
            <span class="lc-tag">{v.category}</span>
            <h3>{v.short}</h3>
            <p>{v.painPoint}</p>
            <span class="badge blue" style="align-self:flex-start">Typical CAC {v.cacDisplay}</span>
            <span class="lc-more">See the playbook
              <svg width="12" height="12" viewBox="0 0 9 9" fill="none"><path d="M1 4.5h7M5 1l3.5 3.5L5 8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Bars from '../../kit/diagram/Bars.astro';
import { VERTICALS } from '../../data/verticals';
import { CAC_BREAK, cacItem, cacNotes, miniScale } from './_cac';
import '../../styles/pages/industries.css';
import { siteBase } from '../../lib/site';
import { breadcrumb } from '../../lib/schema';

const SITE = siteBase(Astro.site);
const title = 'Health Verticals We Grow | Industries | AdBoost Health';
const description = 'Specialist paid acquisition for GLP-1, telehealth, supplements, TRT, peptides, med spa, mental health, longevity, and fertility brands. Find your vertical.';
const jsonLd = [
  breadcrumb(SITE, [{ label: 'Home', href: '/' }, { label: 'Industries', href: '/industries/' }]),
  {
    '@type': 'CollectionPage',
    name: 'Health industries AdBoost Health serves',
    url: `${SITE}/industries/`,
    hasPart: VERTICALS.map((v) => ({ '@type': 'WebPage', name: v.name, url: `${SITE}/industries/${v.slug}/` })),
  },
];

// Mini range bars on the cards share the hero chart's axis (same break, same scale).
const mini = miniScale(VERTICALS);
// The first row of cards can sit in the first viewport on desktop: it is never hidden
// ([data-draw] only grows its mini bar); later rows reveal.
const FIRST_ROW = 3;
---
<BaseLayout {title} {description} canonicalPath="/industries/" {jsonLd}>
  <PageHero
    class="ind-hero"
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Industries' }]}
    eyebrow="INDUSTRIES"
    title='We only grow <span class="serif">health</span> brands.'
    lede="Every vertical has its own economics, ad-policy landmines, and definition of a good CAC. Pick yours for the specific playbook, benchmarks, and compliance rules that apply."
    meta={[`${VERTICALS.length} verticals`, 'Compliance-first', 'Setup in 5 days']}
    art="/art/industries/hub"
  >
    <div slot="aside" class="hero-panel ind-panel">
      <div class="hp-head">
        <span class="t"><span class="live-dot"></span>Verticals we scale</span>
        <span class="m">TYPICAL CAC</span>
      </div>
      <div class="ind-panel__bars">
        <Bars
          arrive
          variant="range"
          prefix="$"
          axisBreakAbove={CAC_BREAK}
          caption={`Typical CAC by vertical, as each industry page quotes it. ${cacNotes(VERTICALS)}`}
          items={VERTICALS.map((v) => cacItem(v))}
        />
      </div>
      <div class="hp-foot">
        <div class="kv"><span class="k">VERTICALS</span><div class="val">{VERTICALS.length}</div></div>
        <div class="kv"><span class="k">FOUNDERS SERVED</span><div class="val">71+</div></div>
        <div class="kv"><span class="k">TRACKED</span><div class="val">$153M+</div></div>
      </div>
    </div>
  </PageHero>

  <section class="iwrap">
    <div class="container">
      <div class="grid-cards ind-grid">
        {VERTICALS.map((v, i) => {
          const segs = mini.segs(v.cacLow, v.cacHigh);
          const approx = v.cacDisplay.trim().startsWith('~');
          const open = v.cacDisplay.trim().endsWith('+');
          return (
            <a
              class="lcard"
              href={`/industries/${v.slug}/`}
              data-reveal={i < FIRST_ROW ? undefined : ''}
              data-draw={i < FIRST_ROW ? '' : undefined}
              style={`--i:${i % 3};--dd:${(i % 3) * 90 + 200}ms`}
            >
              <span class="ind-card__top">
                <span class={`ind-ic ind-ic--${(i % 6) + 1}`} aria-hidden="true">{v.short[0]}</span>
                <span class="lc-tag">{v.category}</span>
              </span>
              <h3>{v.short}</h3>
              <p>{v.painPoint}</p>
              <span class="ind-cac">
                <span class="badge blue">Typical CAC {v.cacDisplay}</span>
                <span class="ind-mini" aria-hidden="true">
                  {segs.map((s, k) => (
                    <span
                      class:list={['ind-mini__seg', 'k-draw-x', k === 0 && approx && 'is-approx', k === segs.length - 1 && open && 'is-open']}
                      style={`--l:${s.l}%;--w:${s.w}%`}
                    ></span>
                  ))}
                  {mini.breakAt !== undefined && <span class="ind-mini__brk" style={`--x:${mini.breakAt}%`}></span>}
                </span>
              </span>
              <span class="lc-more">See the playbook
                <svg width="12" height="12" viewBox="0 0 9 9" fill="none" aria-hidden="true"><path d="M1 4.5h7M5 1l3.5 3.5L5 8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import ServicesIndex from '../../components/ServicesIndex.astro';
import Closing from '../../components/Closing.astro';
import { VERTICALS } from '../../data/verticals';
import { siteBase } from '../../lib/site';
import { breadcrumb } from '../../lib/schema';

const SITE = siteBase(Astro.site);
const title = 'Health Verticals We Grow | Industries | AdBoost Health';
const description = 'Specialist paid acquisition for GLP-1, telehealth, supplements, TRT, peptides, med spa, mental health, longevity, and fertility brands. Find your vertical.';
const jsonLd = [
  breadcrumb(SITE, [{ label: 'Home', href: '/' }, { label: 'Industries', href: '/industries/' }]),
  {
    '@type': 'CollectionPage',
    name: 'Health industries AdBoost Health serves',
    url: `${SITE}/industries/`,
    hasPart: VERTICALS.map((v) => ({ '@type': 'WebPage', name: v.name, url: `${SITE}/industries/${v.slug}/` })),
  },
];
---
<BaseLayout {title} {description} canonicalPath="/industries/" {jsonLd}>
  <PageHead
    label="Industries"
    title="We only grow *health* brands."
    lede="Every vertical has its own economics, ad-policy landmines, and definition of a good CAC. Pick yours for the specific playbook, benchmarks, and compliance rules that apply."
    dots
  >
    <ul class="phead-facts arrive" style="--d:240ms">
      <li>{VERTICALS.length} verticals</li><li>Compliance-first</li><li>Setup in 5 days</li>
    </ul>
  </PageHead>

  <section class="tone-paper page-body" data-nav="paper" aria-label="The verticals">
    <div class="wrap">
      <ServicesIndex only="industries" />
    </div>
  </section>

  <section class="tone-frame section" data-nav="frame" aria-labelledby="cac-h">
    <div class="wrap">
      <div class="sec-top">
        <p class="label muted" data-reveal>Typical CAC</p>
        <h2 id="cac-h" class="sec-h" data-reveal>Verticals we scale</h2>
      </div>
      <div class="rows">
        {VERTICALS.map((v, i) => (
          <a class="row" href={`/industries/${v.slug}/`} data-reveal="side">
            <span class="idx">{String(i + 1).padStart(2, '0')}</span>
            <span class="row-name">{v.short}</span>
            <span class="row-meta num">{v.cacDisplay}</span>
            <span class="row-text small">{v.category}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Closing />
</BaseLayout>


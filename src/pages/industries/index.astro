---
// /industries/ on the AdBoost family design (the hub of adboost-media's /industries/, in Health's
// hues). Same title, description, JSON-LD, H1, lede, figures and cards as before; only the layout
// and the drawings are new.
//   hero   the H1 with its serif accent, the lede and the trust line beside a stack of the
//          verticals: the "Verticals we scale" window (every vertical's typical CAC on one axis,
//          linked, with the three figures under it) in front of four of the real ad creatives,
//          one per vertical they match, fanned behind it (decorative, nothing attached to them;
//          in the first frame from 1080px, and not downloaded below it, where they are hidden)
//   cards  the nine verticals as a bento: a drawing (the vertical's glyph, its creative or an
//          intake sketch) over the category, name, pain point, typical CAC with its range on the
//          shared axis and the link to the playbook
//   end    the closing card (.cta-band), CtaBand's copy
import '../../styles/family/tokens.css';
import '../../styles/family/content.css';
import '../../styles/family/industry.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Backdrop from '../../family/Backdrop.astro';
import Chip from '../../family/graphics/Chip.astro';
import InlineCta from '../../family/InlineCta.astro';
import Icon from '../../family/industry/Icon.astro';
import Snapshot from '../../family/industry/Snapshot.astro';
import { PLANS } from '../../family/industry/plan';
import { VERTICALS } from '../../data/verticals';
import { CAC_BREAK, cacNotes, miniScale } from './_cac';
import { siteBase } from '../../lib/site';
import { breadcrumb } from '../../lib/schema';

const SITE = siteBase(Astro.site);
const title = 'Health Verticals We Grow | Industries | AdBoost Health';
const description = 'Specialist paid acquisition for GLP-1, telehealth, supplements, TRT, peptides, med spa, mental health, longevity, and fertility brands. Find your vertical.';
const jsonLd = [
  breadcrumb(SITE, [{ label: 'Home', href: '/' }, { label: 'Industries', href: '/industries/' }]),
  {
    '@type': 'CollectionPage',
    name: 'Health industries AdBoost Health serves',
    url: `${SITE}/industries/`,
    hasPart: VERTICALS.map((v) => ({ '@type': 'WebPage', name: v.name, url: `${SITE}/industries/${v.slug}/` })),
  },
];

// Mini range bars on the cards share the hero chart's axis (same break, same scale).
const mini = miniScale(VERTICALS);
// The bento: wide cards (art beside the text) and regular ones, on a 6-column grid.
const SPAN = [4, 2, 2, 2, 2, 2, 4, 3, 3];
// The creatives fanned behind the hero window, each from the vertical it matches (plan.ts).
const fan = VERTICALS.map((v) => PLANS[v.slug]?.creative).filter((c): c is string => Boolean(c)).slice(0, 3);
---
<BaseLayout {title} {description} canonicalPath="/industries/" {jsonLd}>
  <div class="family ix ixhub">
    <header class="cp-hero ix-hero ixhub-hero" data-spot>
      <Backdrop texture={['dots', 'grid']} spotlight focus={['74%', '30%']} />
      <div class="container ixhub-grid">
        <div class="cp-head ix-head">
          <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Industries' }]} />
          <span class="kicker arrive"><span class="k-dot" aria-hidden="true"></span>INDUSTRIES</span>
          <h1 class="arrive">We only grow <span class="serif">health</span> brands.</h1>
          <p class="ix-lede arrive" style="--d:60ms">Every vertical has its own economics, ad-policy landmines, and definition of a good CAC. Pick yours for the specific playbook, benchmarks, and compliance rules that apply.</p>
          <p class="ix-trust arrive" style="--d:110ms">{[`${VERTICALS.length} verticals`, 'Compliance-first', 'Setup in 5 days'].map((m) => <span>{m}</span>)}</p>
        </div>
        <div class="ixhub-stage stage arrive" style="--d:140ms">
          <span class="stage-plate" aria-hidden="true"></span>
          <span class="stage-ring" aria-hidden="true"></span>
          <div class="ixhub-fan" aria-hidden="true">
            {fan.map((src, k) => (
              <span class="ixhub-ph" style={`--k:${k}`}><picture><source media="(max-width: 1079.98px)" srcset="data:image/gif;base64,R0lGODlhAQABAAAAACw=" /><img src={src} alt="" width="634" height="1136" decoding="async" fetchpriority="low" /></picture></span>
            ))}
          </div>
          <Snapshot
            class="ixhub-snap"
            title="Verticals we scale"
            pill="TYPICAL CAC"
            caption={`Typical CAC by vertical, as each industry page quotes it. ${cacNotes(VERTICALS)}`}
            foot={[{ k: 'VERTICALS', v: String(VERTICALS.length) }, { k: 'FOUNDERS SERVED', v: '71+' }, { k: 'TRACKED', v: '$153M+' }]}
          />
          <div aria-hidden="true"><Chip title="Compliance-first" label="Setup in 5 days" icon="shield" tone="g" style="left:-66px;bottom:52px" /></div>
        </div>
      </div>
    </header>

    <section class="ixhub-cards">
      <div class="container">
        <div class="ixhub-bento">
          {VERTICALS.map((v, i) => {
            const plan = PLANS[v.slug];
            const segs = mini.segs(v.cacLow, v.cacHigh);
            const approx = v.cacDisplay.trim().startsWith('~');
            const open = v.cacDisplay.trim().endsWith('+');
            const wide = SPAN[i] >= 3;
            return (
              <a
                class:list={['ixhub-card', `s${SPAN[i] ?? 2}`, wide && 'is-wide', i > 1 && 'reveal', i > 1 && i % 3 && `d${i % 3}`]}
                href={`/industries/${v.slug}/`}
                style={`--i:${i}`}
              >
                <span class="ixhub-art" aria-hidden="true">
                  <i class="ix-orbit"></i>
                  <span class="ixhub-glyph"><Icon name={plan?.glyph ?? 'target'} /></span>
                  {plan?.creative ? (
                    <span class="ixhub-thumb"><img src={plan.creative} alt="" width="634" height="1136" loading="lazy" decoding="async" /></span>
                  ) : (
                    <span class="ixhub-sketch"><i class="bar"></i><i></i><i></i><i class="on"></i><i class="go"></i></span>
                  )}
                </span>
                <span class="ixhub-body">
                  <span class="ixhub-tag">{v.category}</span>
                  <h2>{v.short}</h2>
                  <p>{v.painPoint}</p>
                  <span class="ixhub-cac">
                    <span class="ui-pill b">Typical CAC {v.cacDisplay}</span>
                    <span class="ixhub-mini" aria-hidden="true">
                      {segs.map((s, k) => (
                        <i class:list={[k === 0 && approx && 'is-approx', k === segs.length - 1 && open && 'is-open']} style={`--l:${s.l}%;--w:${s.w}%`}></i>
                      ))}
                      {mini.breakAt !== undefined && v.cacHigh > CAC_BREAK && <b style={`--x:${mini.breakAt}%`}></b>}
                    </span>
                  </span>
                  <span class="ix-more">See the playbook
                    <svg width="12" height="12" viewBox="0 0 9 9" fill="none" aria-hidden="true"><path d="M1 4.5h7M5 1l3.5 3.5L5 8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  </span>
                </span>
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <section class="ix-end">
      <div class="container"><InlineCta /></div>
    </section>
  </div>
</BaseLayout>

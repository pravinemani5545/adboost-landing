---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import { siteBase } from '../../lib/site';
import { breadcrumb } from '../../lib/schema';
import { getPublishedPosts } from '../../lib/blog';
import { AD_POLICIES, STATUS_LABEL } from '../../data/adPolicies';

const SITE = siteBase(Astro.site);
const posts = await getPublishedPosts();
const badgeClass = (s: string) => s === 'allowed' ? 'green' : s === 'prohibited' ? 'red' : 'amber';
const pillar = {
  href: '/guides/health-ad-compliance/',
  name: 'The complete guide to compliant health advertising (2026)',
  desc: 'What’s allowed on Meta, Google, and TikTok for GLP-1, supplements, telehealth, TRT, and med spa — plus the FTC/FDA rules underneath. The definitive reference.',
};
const featured = posts.slice(0, 6);
const title = 'Guides: Health Marketing, Compliance & CAC | AdBoost Health';
const description = 'In-depth guides on compliant health advertising, lowering CAC, telehealth benchmarks, and scaling health brands — the operator-grade reference library.';
const jsonLd = [breadcrumb(SITE, [{ label: 'Home', href: '/' }, { label: 'Guides', href: '/guides/' }])];
---
<BaseLayout {title} {description} canonicalPath="/guides/" {jsonLd}>
  <section class="phero wide">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Guides' }]} />
      <span class="eyebrow sec-eyebrow" style="display:block;margin-top:16px"><span class="dot"></span>GUIDES</span>
      <h1>Operator-grade <span class="serif">guides</span> for health growth</h1>
      <p class="phero-lede">The references we wish existed when we started — compliance, CAC, and creative, written for founders and heads of growth who need the real playbook, not the surface.</p>
    </div>
  </section>

  <section class="iwrap">
    <div class="container">
      <a class="lcard reveal" href={pillar.href} style="border-color:var(--blue-soft);background:linear-gradient(180deg,rgba(0,87,255,.03),#fff)">
        <span class="badge blue" style="align-self:flex-start">FLAGSHIP GUIDE</span>
        <h3 style="font-size:22px">{pillar.name}</h3>
        <p style="font-size:15px">{pillar.desc}</p>
        <span class="lc-more">Read the guide →</span>
      </a>

      <h2 class="sec-title" style="margin-top:44px">Ad compliance by platform</h2>
      <p class="sec-intro">The exact rules for advertising each vertical on each platform — certification, prohibited claims, rejection triggers, and the compliant path.</p>
      <div class="grid-cards three" style="margin-top:16px">
        {AD_POLICIES.map((p) => (
          <a class="lcard reveal" href={`/advertising/${p.slug}/`}>
            <div style="display:flex;justify-content:space-between;align-items:center;gap:8px">
              <span class="lc-tag">{p.platform.toUpperCase()}</span>
              <span class={`badge ${badgeClass(p.status)}`}>{STATUS_LABEL[p.status]}</span>
            </div>
            <h3 style="font-size:16px">{p.vertical} on {p.platform}</h3>
            <span class="lc-more">Read the rules →</span>
          </a>
        ))}
      </div>

      <h2 class="sec-title" style="margin-top:44px">From the blog</h2>
      <div class="grid-cards three" style="margin-top:16px">
        {featured.map((p) => (
          <a class="lcard reveal" href={`/blog/${p.id}/`}>
            <span class="lc-tag">GUIDE</span>
            <h3 style="font-size:16px">{p.data.title}</h3>
            <p>{p.data.description}</p>
            <span class="lc-more">Read →</span>
          </a>
        ))}
      </div>
      <div style="margin-top:24px"><a class="btn btn-ghost" href="/blog/">See all articles →</a></div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

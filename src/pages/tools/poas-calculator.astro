---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import Faq from '../../components/Faq.astro';
import { siteBase } from '../../lib/site';
import { breadcrumb, faqPage, calculatorNode } from '../../lib/schema';

const SITE = siteBase(Astro.site);
const path = '/tools/poas-calculator/';
const title = 'Free POAS Calculator (Profit on Ad Spend) | AdBoost';
const description = 'Calculate POAS (profit on ad spend) from your revenue, margin, and ad spend, and see how it differs from ROAS. Free calculator for health and DTC brands.';
const faq = [
  { q: 'What is POAS?', a: 'POAS (profit on ad spend) is the gross profit generated per dollar of ad spend: gross profit divided by ad spend. Unlike ROAS, which uses revenue, POAS reflects what you actually keep after cost of goods.' },
  { q: 'What is a good POAS?', a: 'POAS of 1.0 is break-even on ad spend (before overhead). Most brands target a POAS above 1.5-2.0 to cover fixed costs and profit, but the right number depends on your margin and payback tolerance.' },
  { q: 'POAS vs ROAS - what is the difference?', a: 'ROAS is revenue per ad dollar; POAS is profit per ad dollar. Two campaigns with identical ROAS can have very different POAS if their margins differ, so POAS keeps spend pointed at what is actually profitable.' },
];
const jsonLd = [
  calculatorNode(SITE, { name: 'POAS Calculator', description, path }),
  breadcrumb(SITE, [{ label: 'Home', href: '/' }, { label: 'Tools', href: '/tools/' }, { label: 'POAS Calculator', href: path }]),
  faqPage(faq),
];
---
<BaseLayout {title} {description} canonicalPath={path} {jsonLd}>
  <section class="phero">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Tools', href: '/tools/' }, { label: 'POAS Calculator' }]} />
      <span class="eyebrow sec-eyebrow" style="display:block;margin-top:16px"><span class="dot"></span>FREE TOOL</span>
      <h1>POAS calculator</h1>
      <p class="phero-lede">Work out your profit on ad spend, the version of ROAS that accounts for margin, so you scale what is actually profitable, not just what looks efficient.</p>
    </div>
  </section>

  <section class="iwrap-sm">
    <div class="container">
     <div class="doc-grid">
      <div class="doc-main">
      <div class="calc reveal">
        <div class="calc-fields">
          <div class="calc-field">
            <label for="rev">Revenue from ads <span class="hint">(per period)</span></label>
            <div class="calc-input"><span class="pfx">$</span><input id="rev" type="number" inputmode="decimal" value="40000" min="0" /></div>
          </div>
          <div class="calc-field">
            <label for="margin">Gross margin <span class="hint">(%)</span></label>
            <div class="calc-input"><input id="margin" type="number" inputmode="decimal" value="70" min="0" max="100" style="padding-left:14px" /><span class="sfx">%</span></div>
          </div>
          <div class="calc-field">
            <label for="spend">Ad spend <span class="hint">(same period)</span></label>
            <div class="calc-input"><span class="pfx">$</span><input id="spend" type="number" inputmode="decimal" value="10000" min="0" /></div>
          </div>
        </div>
        <div class="calc-result">
          <div class="cr-main">
            <div class="cr-label">POAS</div>
            <div class="cr-value" id="poasOut">2.8×</div>
          </div>
          <div class="cr-sub">
            <div><div class="k">GROSS PROFIT</div><div class="v" id="gpOut">$28,000</div></div>
            <div><div class="k">ROAS (for contrast)</div><div class="v" id="roasOut">4.0×</div></div>
          </div>
          <div class="cr-note" id="poasNote">Above break-even - each ad dollar returns more than a dollar of profit.</div>
        </div>
      </div>
      <p style="color:var(--mute);font-size:13px;margin-top:14px">Runs in your browser. POAS uses gross profit (revenue × margin), so it falls below ROAS by exactly your cost of goods. Break-even on ad spend is a POAS of 1.0, before overhead.</p>

      <h2 class="sec-title" style="margin-top:40px">How POAS is calculated</h2>
      <p style="color:var(--ink-2);line-height:1.72">Profit on ad spend answers the question ROAS can't: after cost of goods, did these ads make money? It is gross profit per ad dollar, not revenue per ad dollar.</p>
      <ol style="margin-top:12px;padding-left:20px;line-height:1.72;color:var(--ink-2)">
        <li style="margin-bottom:8px"><strong>Enter revenue from ads.</strong> The revenue attributable to the spend you are measuring.</li>
        <li style="margin-bottom:8px"><strong>Enter your gross margin.</strong> Your margin after cost of goods sold, as a percentage.</li>
        <li style="margin-bottom:8px"><strong>Divide gross profit by ad spend.</strong> POAS = (revenue × margin) ÷ ad spend. $40,000 at 70% margin on $10,000 spend is a POAS of 2.8.</li>
      </ol>

      <h2 class="sec-title" style="margin-top:36px">POAS vs ROAS</h2>
      <p style="color:var(--ink-2);line-height:1.72">ROAS is revenue per ad dollar; POAS is profit per ad dollar. Two campaigns with the same ROAS can have very different POAS if their margins differ, which is why optimizing to ROAS quietly scales low-margin products at a loss. For the full definitions, see <a href="/glossary/poas/" style="color:var(--blue)">POAS</a> and <a href="/glossary/roas/" style="color:var(--blue)">ROAS</a> in the glossary, and check whole-account efficiency with the <a href="/tools/mer-calculator/" style="color:var(--blue)">MER calculator</a>.</p>

      <h2 class="sec-title" style="margin-top:36px">FAQ</h2>
      <div style="margin-top:16px"><Faq items={faq} idPrefix="poas" /></div>
      </div>
      <aside class="doc-aside">
        <div class="aside-card">
          <h4>More free tools</h4>
          <div class="link-list">
            <a href="/tools/mer-calculator/">MER calculator</a>
            <a href="/tools/cac-calculator/">CAC calculator</a>
            <a href="/tools/ltv-cac-calculator/">LTV:CAC calculator</a>
          </div>
        </div>
        <div class="aside-card dark">
          <h4 style="color:#fff">Scaling the wrong campaigns?</h4>
          <p>We optimize health accounts to POAS and payback, not vanity ROAS. Free audit, written plan you keep either way.</p>
          <a class="btn btn-primary" href="https://cal.com/pira-ahilan-ef2dl8/strategy-call" target="_blank" rel="noopener">Book a call →</a>
        </div>
      </aside>
     </div>
    </div>
  </section>

  <CtaBand />

  <script is:inline>
    (function () {
      const rev = document.getElementById('rev');
      const margin = document.getElementById('margin');
      const spend = document.getElementById('spend');
      const poasOut = document.getElementById('poasOut');
      const gpOut = document.getElementById('gpOut');
      const roasOut = document.getElementById('roasOut');
      const note = document.getElementById('poasNote');
      const money = (n) => '$' + Math.round(n).toLocaleString('en-US');
      function calc() {
        const r = parseFloat(rev.value) || 0;
        const m = (parseFloat(margin.value) || 0) / 100;
        const s = parseFloat(spend.value) || 0;
        const gp = r * m;
        gpOut.textContent = money(gp);
        roasOut.textContent = s > 0 ? (r / s).toFixed(1) + '×' : '-';
        if (s <= 0) { poasOut.textContent = '-'; poasOut.className = 'cr-value'; note.textContent = 'Enter your ad spend.'; return; }
        const poas = gp / s;
        poasOut.textContent = poas.toFixed(1) + '×';
        if (poas >= 1.5) { poasOut.className = 'cr-value good'; note.textContent = 'Healthy - each ad dollar returns well over a dollar of profit.'; }
        else if (poas >= 1) { poasOut.className = 'cr-value'; note.textContent = 'Above break-even, but thin once overhead is included.'; }
        else { poasOut.className = 'cr-value bad'; note.textContent = 'Below break-even - these ads lose money after cost of goods.'; }
      }
      [rev, margin, spend].forEach((el) => el.addEventListener('input', calc));
      calc();
    })();
  </script>
</BaseLayout>

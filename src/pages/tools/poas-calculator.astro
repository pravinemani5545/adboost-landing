---
import Gauge from '../../kit/diagram/Gauge.astro';
import { siteBase } from '../../lib/site';
import { pageDate } from '../../lib/live';
import { breadcrumb, faqPage } from '../../lib/schema';
import { money, poasCalc, valueClass } from './_calc';
import '../../styles/pages/tools.css';
import '../../styles/family/resources.css';
import FamilyPage from '../../family/FamilyPage.astro';
import LinkCard from '../../family/LinkCard.astro';
import CalcHero from '../../family/resources/CalcHero.astro';
import ButtonLink from '../../components/site/ButtonLink.astro';

const SITE = siteBase(Astro.site);
const path = '/tools/poas-calculator/';
const title = 'Free POAS Calculator (Profit on Ad Spend) | AdBoost';
// Content date: src/data/pages.json (sitemap lastmod and this label).
const updated = pageDate(path);
const updatedLabel = updated && new Date(`${updated}T00:00:00Z`).toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const description = 'Calculate POAS (profit on ad spend) from your revenue, margin, and ad spend, and see how it differs from ROAS. Free calculator for health and DTC brands.';
const faq = [
  { q: 'What is POAS?', a: 'POAS (profit on ad spend) is the gross profit generated per dollar of ad spend: gross profit divided by ad spend. Unlike ROAS, which uses revenue, POAS reflects what you actually keep after cost of goods.' },
  { q: 'What is a good POAS?', a: 'POAS of 1.0 is break-even on ad spend (before overhead). Most brands target a POAS above 1.5-2.0 to cover fixed costs and profit, but the right number depends on your margin and payback tolerance.' },
  { q: 'POAS vs ROAS: what is the difference?', a: 'ROAS is revenue per ad dollar; POAS is profit per ad dollar. Two campaigns with identical ROAS can have very different POAS if their margins differ, so POAS keeps spend pointed at what is actually profitable.' },
];
const jsonLd = [
  breadcrumb(SITE, [{ label: 'Home', href: '/' }, { label: 'Tools', href: '/tools/' }, { label: 'POAS Calculator', href: path }]),
  faqPage(faq),
];

// Default inputs, run through the same function the page script uses.
const REV = 40000;
const MARGIN = 70;
const SPEND = 10000;
const r = poasCalc(REV, MARGIN, SPEND);
const spoken = (x: number | null) => (x === null ? 'Not calculated: enter your ad spend' : `${x.toFixed(1)} times ad spend`);

// FamilyPage (src/family/FamilyPage.astro): the head and JSON-LD exactly as before; the FAQ as cards
// (the same q/a the FAQPage JSON-LD carries); the closing card with this page's CtaBand copy.
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const data = {
  seoTitle: title,
  metaDescription: description,
  h1: "POAS calculator",
  summary: esc("Work out your profit on ad spend, the version of ROAS that accounts for margin, so you scale what is actually profitable, not just what looks efficient."),
  faqs: faq.map((f) => ({ q: f.q, a: esc(f.a) })),
};
const byline = updatedLabel ? [{ text: 'Free tool by AdBoost Health', icon: 'org' as const }, { text: `Updated ${updatedLabel}`, icon: 'date' as const }] : [];
// The hero: this calculator's formula as a chain, with the values it shows on load
const hero = {
  name: 'POAS calculator',
  op: '÷' as const,
  rows: [
    { label: 'Revenue from ads', sub: 'per period', value: money(REV), icon: 'chart', op: '×' as const },
    { label: 'Gross margin', value: `${MARGIN}%`, icon: 'tag', op: '÷' as const },
    { label: 'Ad spend', sub: 'same period', value: money(SPEND), icon: 'layers' },
  ],
  result: { label: 'POAS', value: r.value, tone: r.verdict },
  gauge: { bands: [{ to: 1, tone: 'bad' as const }, { to: 1.5, tone: 'warn' as const }, { to: 4, tone: 'ok' as const }], value: r.poas ?? 0 },
  subs: [{ label: 'Gross profit', value: r.gpText }, { label: 'ROAS (for contrast)', value: r.roasText }],
  formula: 'POAS = (revenue from ads × gross margin) ÷ ad spend',
  chip: { title: 'POAS of 1.0×', label: 'break-even on ad spend', icon: 'gauge' },
};
---
<FamilyPage
  path={path}
  data={data}
  crumbs={[{ label: 'Home', href: '/' }, { label: 'Tools', href: '/tools/' }, { label: "POAS Calculator" }]}
  eyebrow="FREE TOOL"
  schema={jsonLd}
  byline={byline}
  faqHeading="FAQ"
>
  <CalcHero slot="hero" {...hero} />

  <div slot="aside" class="pg-card gl-tools">
    <h4>More free tools</h4>
    <ul class="gl-links">
      <li><LinkCard href="/tools/mer-calculator/" label="MER calculator" /></li>
      <li><LinkCard href="/tools/cac-calculator/" label="CAC calculator" /></li>
      <li><LinkCard href="/tools/ltv-cac-calculator/" label="LTV:CAC calculator" /></li>
    </ul>
  </div>
  <div slot="aside" class="pg-card is-night">
    <h4>Scaling the wrong campaigns?</h4>
    <p>We optimize health accounts to POAS and payback, not vanity ROAS. Free audit, written plan you keep either way.</p>
    <ButtonLink href="/book/" class="pg-card-go">Book a call <span aria-hidden="true">→</span></ButtonLink>
  </div>

  
  <div class="pg-prose"><h2 id="formula">POAS calculator formula: profit on ad spend = gross profit ÷ ad spend</h2>
      <p class="poas-formula"><code>POAS = (revenue from ads × gross margin) ÷ ad spend</code> A POAS of 1.0 is break-even on ad spend, before overhead. Enter your numbers and the calculator below updates as you type.</p></div>
  <div class="calc tc-calc reveal">
        <div class="tc-bar" aria-hidden="true"><span class="cp-dots"><i></i><i></i><i></i></span><span class="tc-name">POAS calculator</span><span class="tc-live"><i></i>Live</span></div>
        <div class="calc-fields">
          <div class="calc-field">
            <label for="rev">Revenue from ads <span class="hint">(per period)</span></label>
            <div class="calc-input"><span class="pfx">$</span><input id="rev" type="number" inputmode="decimal" value={REV} min="0" /></div>
          </div>
          <div class="calc-field">
            <label for="margin">Gross margin <span class="hint">(%)</span></label>
            <div class="calc-input"><input id="margin" type="number" inputmode="decimal" value={MARGIN} min="0" max="100" /><span class="sfx">%</span></div>
          </div>
          <div class="calc-field">
            <label for="spend">Ad spend <span class="hint">(same period)</span></label>
            <div class="calc-input"><span class="pfx">$</span><input id="spend" type="number" inputmode="decimal" value={SPEND} min="0" /></div>
          </div>
        </div>
        <div class="calc-result" data-tone="night">
          <div class="cr-main">
            <div class="cr-label">POAS</div>
            <div class={valueClass(r.verdict)} id="poasOut">{r.value}</div>
          </div>
          <Gauge
            arrive
            live="poas-gauge"
            label="POAS"
            min={0}
            max={4}
            value={r.poas ?? 0}
            display={r.value}
            valueText={spoken(r.poas)}
            caption="Your POAS against 1.0 break-even and the 1.5-2.0 most brands target above."
            bands={[
              { to: 1, tone: 'bad', label: 'Below break-even' },
              { to: 1.5, tone: 'warn', label: 'Above break-even, but thin' },
              { to: 2, tone: 'ok', label: '1.5-2.0: most brands target above this' },
            ]}
            ticks={[{ at: 1, label: '1.0' }, { at: 1.5, label: '1.5' }, { at: 2, label: '2.0' }]}
          />
          <div class="cr-sub">
            <div><div class="k">GROSS PROFIT</div><div class="v" id="gpOut">{r.gpText}</div></div>
            <div><div class="k">ROAS (for contrast)</div><div class="v" id="roasOut">{r.roasText}</div></div>
          </div>
          <div class="rs-fxline">
            <p class="rs-fxline__sym">POAS = (revenue from ads × gross margin) ÷ ad spend</p>
            <p class="rs-fxline__live" id="fxLive">({money(REV)} × {MARGIN}%) ÷ {money(SPEND)} = {r.value}</p>
          </div>
          <div class="cr-note" id="poasNote">{r.note}</div>
        </div>
      </div>
  <p class="tool-fine tc-fine">Runs in your browser. POAS uses gross profit (revenue × margin), so it falls below ROAS by exactly your cost of goods. Break-even on ad spend is a POAS of 1.0, before overhead.</p>
  
  <div class="pg-prose"><h2 id="how-it-works">How POAS is calculated</h2>
      <p>Profit on ad spend answers the question ROAS can't: after cost of goods, did these ads make money? It is gross profit per ad dollar, not revenue per ad dollar.</p>
      </div>
  <ol class="cp-steps tc-steps">
    <li class="cp-step reveal" style="--i:0"><span class="cp-step-node" aria-hidden="true"></span><div class="cp-step-card tc-step"><p><strong>Enter revenue from ads.</strong> The revenue attributable to the spend you are measuring.</p></div></li>
    <li class="cp-step reveal" style="--i:1"><span class="cp-step-node" aria-hidden="true"></span><div class="cp-step-card tc-step"><p><strong>Enter your gross margin.</strong> Your margin after cost of goods sold, as a percentage.</p></div></li>
    <li class="cp-step reveal" style="--i:2"><span class="cp-step-node" aria-hidden="true"></span><div class="cp-step-card tc-step"><p><strong>Divide gross profit by ad spend.</strong> POAS = (revenue × margin) ÷ ad spend. $40,000 at 70% margin on $10,000 spend is a POAS of 2.8.</p></div></li>
  </ol>
  
  <div class="pg-prose"><h2 id="poas-vs-roas">POAS vs ROAS: how do your numbers compare?</h2>
      <p>The same inputs, read both ways. This table updates with the calculator above (the starting values are an illustrative example, not a benchmark).</p>
      <div class="cp-table reveal tc-vs" data-cols="3">
        <table class="dtable">
          <thead><tr><th></th><th>ROAS</th><th>POAS</th></tr></thead>
          <tbody>
            <tr><th scope="row" class="row-h">Formula</th><td data-label="ROAS">Revenue from ads ÷ ad spend</td><td data-label="POAS">Gross profit from ads ÷ ad spend</td></tr>
            <tr><th scope="row" class="row-h">Your result</th><td id="tRoas" data-label="ROAS">{r.roasText}</td><td id="tPoas" data-label="POAS">{r.value}</td></tr>
            <tr><th scope="row" class="row-h">Break-even on ad spend</th><td data-label="ROAS">ROAS of <span id="tBe">{r.breakEvenText}</span> at your margin</td><td data-label="POAS">POAS of 1.0×</td></tr>
            <tr><th scope="row" class="row-h">What it ignores</th><td data-label="ROAS">Cost of goods, so it overstates profit by your COGS</td><td data-label="POAS">Overhead and fixed costs</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  <div class="cp-callout reveal tc-example"><span class="cp-callout-ic" aria-hidden="true"></span><div class="cp-callout-body">
      <p><strong>Same ROAS, different POAS (illustrative example).</strong> Two campaigns each spend $10,000 and drive $40,000 in revenue, so both report a 4.0× ROAS. Their margins differ:</p>
      <div class="cp-table" data-cols="6">
        <table class="dtable">
          <thead><tr><th>Illustrative campaign</th><th>Revenue</th><th>Gross margin</th><th>Ad spend</th><th>ROAS</th><th>POAS</th></tr></thead>
          <tbody>
            <tr><th scope="row" class="row-h" data-label="Illustrative campaign">A</th><td data-label="Revenue">$40,000</td><td data-label="Gross margin">70%</td><td data-label="Ad spend">$10,000</td><td data-label="ROAS">4.0×</td><td data-label="POAS">2.8×</td></tr>
            <tr><th scope="row" class="row-h" data-label="Illustrative campaign">B</th><td data-label="Revenue">$40,000</td><td data-label="Gross margin">25%</td><td data-label="Ad spend">$10,000</td><td data-label="ROAS">4.0×</td><td data-label="POAS">1.0× (break-even)</td></tr>
          </tbody>
        </table>
      </div>
  </div></div>
  <div class="pg-prose">
      <p>ROAS is revenue per ad dollar; POAS is profit per ad dollar. Two campaigns with the same ROAS can have very different POAS if their margins differ, which is why optimizing to ROAS quietly scales low-margin products at a loss. For the full definitions, see <a href="/glossary/poas/">POAS</a> and <a href="/glossary/roas/">ROAS</a> in the glossary, and check whole-account efficiency with the <a href="/tools/mer-calculator/">MER calculator</a>.</p></div>
</FamilyPage>

<script>
  import { setLive } from '../../kit/diagram/live';
  import { money, num, poasCalc, valueClass } from './_calc';

  const rev = document.getElementById('rev') as HTMLInputElement;
  const margin = document.getElementById('margin') as HTMLInputElement;
  const spend = document.getElementById('spend') as HTMLInputElement;
  const poasOut = document.getElementById('poasOut')!;
  const gpOut = document.getElementById('gpOut')!;
  const roasOut = document.getElementById('roasOut')!;
  const note = document.getElementById('poasNote')!;
  const tRoas = document.getElementById('tRoas')!;
  const tPoas = document.getElementById('tPoas')!;
  const tBe = document.getElementById('tBe')!;
  const fx = document.getElementById('fxLive')!;
  function calc() {
    const r = poasCalc(num(rev), num(margin), num(spend));
    gpOut.textContent = r.gpText;
    roasOut.textContent = r.roasText;
    tRoas.textContent = r.roasText;
    tBe.textContent = r.breakEvenText;
    poasOut.textContent = r.value;
    tPoas.textContent = r.value;
    poasOut.className = valueClass(r.verdict);
    note.textContent = r.note;
    fx.textContent = `(${money(num(rev))} × ${num(margin)}%) ÷ ${money(num(spend))} = ${r.value}`;
    setLive('poas-gauge', r.poas ?? 0, r.value, r.poas === null ? 'Not calculated: enter your ad spend' : `${r.poas.toFixed(1)} times ad spend`);
  }
  [rev, margin, spend].forEach((el) => el.addEventListener('input', calc));
  calc();
</script>

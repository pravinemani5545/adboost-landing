---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Faq from '../../components/Faq.astro';
import Gauge from '../../kit/diagram/Gauge.astro';
import { siteBase } from '../../lib/site';
import { pageDate } from '../../lib/live';
import { breadcrumb, faqPage } from '../../lib/schema';
import { poasCalc, valueClass } from './_calc';
import '../../styles/pages/tools.css';

const SITE = siteBase(Astro.site);
const path = '/tools/poas-calculator/';
const title = 'Free POAS Calculator (Profit on Ad Spend) | AdBoost';
// Content date: src/data/pages.json (sitemap lastmod and this label).
const updated = pageDate(path);
const updatedLabel = updated && new Date(`${updated}T00:00:00Z`).toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const description = 'Calculate POAS (profit on ad spend) from your revenue, margin, and ad spend, and see how it differs from ROAS. Free calculator for health and DTC brands.';
const faq = [
  { q: 'What is POAS?', a: 'POAS (profit on ad spend) is the gross profit generated per dollar of ad spend: gross profit divided by ad spend. Unlike ROAS, which uses revenue, POAS reflects what you actually keep after cost of goods.' },
  { q: 'What is a good POAS?', a: 'POAS of 1.0 is break-even on ad spend (before overhead). Most brands target a POAS above 1.5-2.0 to cover fixed costs and profit, but the right number depends on your margin and payback tolerance.' },
  { q: 'POAS vs ROAS: what is the difference?', a: 'ROAS is revenue per ad dollar; POAS is profit per ad dollar. Two campaigns with identical ROAS can have very different POAS if their margins differ, so POAS keeps spend pointed at what is actually profitable.' },
];
const jsonLd = [
  breadcrumb(SITE, [{ label: 'Home', href: '/' }, { label: 'Tools', href: '/tools/' }, { label: 'POAS Calculator', href: path }]),
  faqPage(faq),
];

// Default inputs, run through the same function the page script uses.
const REV = 40000;
const MARGIN = 70;
const SPEND = 10000;
const r = poasCalc(REV, MARGIN, SPEND);
const spoken = (x: number | null) => (x === null ? 'Not calculated: enter your ad spend' : `${x.toFixed(1)} times ad spend`);
---
<BaseLayout {title} {description} canonicalPath={path} {jsonLd}>
  <PageHero
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Tools', href: '/tools/' }, { label: 'POAS Calculator' }]}
    eyebrow="FREE TOOL"
    title="POAS calculator"
    lede="Work out your profit on ad spend, the version of ROAS that accounts for margin, so you scale what is actually profitable, not just what looks efficient."
  >
    {updatedLabel && <div class="metabar tool-meta"><span>Free tool by AdBoost Health</span><span class="dot"></span><span>Updated {updatedLabel}</span></div>}
  </PageHero>

  <section class="iwrap-sm">
    <div class="container">
     <div class="doc-grid">
      <div class="doc-main tool-doc">
      <h2 class="sec-title poas-formula-h">POAS calculator formula: profit on ad spend = gross profit ÷ ad spend</h2>
      <p class="poas-formula"><code>POAS = (revenue from ads × gross margin) ÷ ad spend</code> A POAS of 1.0 is break-even on ad spend, before overhead. Enter your numbers and the calculator below updates as you type.</p>
      <div class="calc k-card k-card--float arrive">
        <div class="calc-fields">
          <div class="calc-field">
            <label for="rev">Revenue from ads <span class="hint">(per period)</span></label>
            <div class="calc-input"><span class="pfx">$</span><input id="rev" type="number" inputmode="decimal" value={REV} min="0" /></div>
          </div>
          <div class="calc-field">
            <label for="margin">Gross margin <span class="hint">(%)</span></label>
            <div class="calc-input"><input id="margin" type="number" inputmode="decimal" value={MARGIN} min="0" max="100" /><span class="sfx">%</span></div>
          </div>
          <div class="calc-field">
            <label for="spend">Ad spend <span class="hint">(same period)</span></label>
            <div class="calc-input"><span class="pfx">$</span><input id="spend" type="number" inputmode="decimal" value={SPEND} min="0" /></div>
          </div>
        </div>
        <div class="calc-result" data-tone="night">
          <div class="cr-main">
            <div class="cr-label">POAS</div>
            <div class={valueClass(r.verdict)} id="poasOut">{r.value}</div>
          </div>
          <Gauge
            arrive
            live="poas-gauge"
            label="POAS"
            min={0}
            max={4}
            value={r.poas ?? 0}
            display={r.value}
            valueText={spoken(r.poas)}
            caption="Your POAS against 1.0 break-even and the 1.5-2.0 most brands target above."
            bands={[
              { to: 1, tone: 'bad', label: 'Below break-even' },
              { to: 1.5, tone: 'warn', label: 'Above break-even, but thin' },
              { to: 2, tone: 'ok', label: '1.5-2.0: most brands target above this' },
            ]}
            ticks={[{ at: 1, label: '1.0' }, { at: 1.5, label: '1.5' }, { at: 2, label: '2.0' }]}
          />
          <div class="cr-sub">
            <div><div class="k">GROSS PROFIT</div><div class="v" id="gpOut">{r.gpText}</div></div>
            <div><div class="k">ROAS (for contrast)</div><div class="v" id="roasOut">{r.roasText}</div></div>
          </div>
          <div class="cr-note" id="poasNote">{r.note}</div>
        </div>
      </div>
      <p class="tool-fine">Runs in your browser. POAS uses gross profit (revenue × margin), so it falls below ROAS by exactly your cost of goods. Break-even on ad spend is a POAS of 1.0, before overhead.</p>

      <h2 class="sec-title">How POAS is calculated</h2>
      <p>Profit on ad spend answers the question ROAS can't: after cost of goods, did these ads make money? It is gross profit per ad dollar, not revenue per ad dollar.</p>
      <ol class="tool-steps">
        <li class="k-card k-card--flat" data-reveal><span><strong>Enter revenue from ads.</strong> The revenue attributable to the spend you are measuring.</span></li>
        <li class="k-card k-card--flat" data-reveal><span><strong>Enter your gross margin.</strong> Your margin after cost of goods sold, as a percentage.</span></li>
        <li class="k-card k-card--flat" data-reveal><span><strong>Divide gross profit by ad spend.</strong> POAS = (revenue × margin) ÷ ad spend. $40,000 at 70% margin on $10,000 spend is a POAS of 2.8.</span></li>
      </ol>

      <h2 class="sec-title">POAS vs ROAS: how do your numbers compare?</h2>
      <p>The same inputs, read both ways. This table updates with the calculator above (the starting values are an illustrative example, not a benchmark).</p>
      <div class="tablewrap">
        <table class="dtable">
          <thead><tr><th></th><th>ROAS</th><th>POAS</th></tr></thead>
          <tbody>
            <tr><th scope="row" class="row-h">Formula</th><td>Revenue from ads ÷ ad spend</td><td>Gross profit from ads ÷ ad spend</td></tr>
            <tr><th scope="row" class="row-h">Your result</th><td id="tRoas">{r.roasText}</td><td id="tPoas">{r.value}</td></tr>
            <tr><th scope="row" class="row-h">Break-even on ad spend</th><td>ROAS of <span id="tBe">{r.breakEvenText}</span> at your margin</td><td>POAS of 1.0×</td></tr>
            <tr><th scope="row" class="row-h">What it ignores</th><td>Cost of goods, so it overstates profit by your COGS</td><td>Overhead and fixed costs</td></tr>
          </tbody>
        </table>
      </div>
      <p><strong>Same ROAS, different POAS (illustrative example).</strong> Two campaigns each spend $10,000 and drive $40,000 in revenue, so both report a 4.0× ROAS. Their margins differ:</p>
      <div class="tablewrap">
        <table class="dtable">
          <thead><tr><th>Illustrative campaign</th><th>Revenue</th><th>Gross margin</th><th>Ad spend</th><th>ROAS</th><th>POAS</th></tr></thead>
          <tbody>
            <tr><th scope="row" class="row-h">A</th><td>$40,000</td><td>70%</td><td>$10,000</td><td>4.0×</td><td>2.8×</td></tr>
            <tr><th scope="row" class="row-h">B</th><td>$40,000</td><td>25%</td><td>$10,000</td><td>4.0×</td><td>1.0× (break-even)</td></tr>
          </tbody>
        </table>
      </div>
      <p>ROAS is revenue per ad dollar; POAS is profit per ad dollar. Two campaigns with the same ROAS can have very different POAS if their margins differ, which is why optimizing to ROAS quietly scales low-margin products at a loss. For the full definitions, see <a href="/glossary/poas/">POAS</a> and <a href="/glossary/roas/">ROAS</a> in the glossary, and check whole-account efficiency with the <a href="/tools/mer-calculator/">MER calculator</a>.</p>

      <h2 class="sec-title">FAQ</h2>
      <div class="tool-faq"><Faq items={faq} idPrefix="poas" /></div>
      </div>
      <aside class="doc-aside">
        <div class="aside-card">
          <h4>More free tools</h4>
          <div class="link-list">
            <a href="/tools/mer-calculator/">MER calculator</a>
            <a href="/tools/cac-calculator/">CAC calculator</a>
            <a href="/tools/ltv-cac-calculator/">LTV:CAC calculator</a>
          </div>
        </div>
        <div class="aside-card dark">
          <h4>Scaling the wrong campaigns?</h4>
          <p>We optimize health accounts to POAS and payback, not vanity ROAS. Free audit, written plan you keep either way.</p>
          <a class="btn btn-primary" href="/book/">Book a call →</a>
        </div>
      </aside>
     </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<script>
  import { setLive } from '../../kit/diagram/live';
  import { num, poasCalc, valueClass } from './_calc';

  const rev = document.getElementById('rev') as HTMLInputElement;
  const margin = document.getElementById('margin') as HTMLInputElement;
  const spend = document.getElementById('spend') as HTMLInputElement;
  const poasOut = document.getElementById('poasOut')!;
  const gpOut = document.getElementById('gpOut')!;
  const roasOut = document.getElementById('roasOut')!;
  const note = document.getElementById('poasNote')!;
  const tRoas = document.getElementById('tRoas')!;
  const tPoas = document.getElementById('tPoas')!;
  const tBe = document.getElementById('tBe')!;
  function calc() {
    const r = poasCalc(num(rev), num(margin), num(spend));
    gpOut.textContent = r.gpText;
    roasOut.textContent = r.roasText;
    tRoas.textContent = r.roasText;
    tBe.textContent = r.breakEvenText;
    poasOut.textContent = r.value;
    tPoas.textContent = r.value;
    poasOut.className = valueClass(r.verdict);
    note.textContent = r.note;
    setLive('poas-gauge', r.poas ?? 0, r.value, r.poas === null ? 'Not calculated: enter your ad spend' : `${r.poas.toFixed(1)} times ad spend`);
  }
  [rev, margin, spend].forEach((el) => el.addEventListener('input', calc));
  calc();
</script>

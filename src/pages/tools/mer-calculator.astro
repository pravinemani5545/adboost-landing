---
import Gauge from '../../kit/diagram/Gauge.astro';
import { siteBase } from '../../lib/site';
import { breadcrumb, faqPage } from '../../lib/schema';
import { merCalc, money, valueClass } from './_calc';
import '../../styles/pages/tools.css';
import '../../styles/family/resources.css';
import '../../styles/family/tools.css';
import '../../styles/family/grain.css';
import FamilyPage from '../../family/FamilyPage.astro';
import LinkCard from '../../family/LinkCard.astro';
import CalcHero from '../../family/resources/CalcHero.astro';
import ButtonLink from '../../components/site/ButtonLink.astro';

const SITE = siteBase(Astro.site);
const path = '/tools/mer-calculator/';
const title = 'Free MER Calculator (Marketing Efficiency Ratio) | AdBoost';
const description = 'Calculate MER (marketing efficiency ratio): total revenue divided by total marketing spend. The blended, un-inflatable efficiency number for health brands.';
const faq = [
  { q: 'What is MER (marketing efficiency ratio)?', a: 'MER, also called media efficiency ratio, is total revenue divided by total marketing spend across every channel. Because it is blended, it cannot be inflated by multiple platforms each claiming the same conversion, unlike platform-reported ROAS.' },
  { q: 'What is a good MER?', a: 'It depends on margin and channel mix, but many DTC and health brands aim for a MER of 3-4+ (revenue three to four times total spend) to stay profitable after cost of goods and overhead. Track the trend more than the absolute number.' },
  { q: 'MER vs ROAS: which should I use?', a: 'Use MER to judge whole-business efficiency (what the bank account shows) and platform ROAS only as an in-channel optimization signal. When platform ROAS looks great but MER is flat, platforms are over-claiming shared conversions.' },
];
const jsonLd = [
  breadcrumb(SITE, [{ label: 'Home', href: '/' }, { label: 'Tools', href: '/tools/' }, { label: 'MER Calculator', href: path }]),
  faqPage(faq),
];

// Default inputs, run through the same function the page script uses.
const REV = 300000;
const SPEND = 75000;
const r = merCalc(REV, SPEND);

// FamilyPage (src/family/FamilyPage.astro): the head and JSON-LD exactly as before; the FAQ as cards
// (the same q/a the FAQPage JSON-LD carries); the closing card with this page's CtaBand copy.
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const data = {
  seoTitle: title,
  metaDescription: description,
  h1: "MER calculator",
  summary: esc("Marketing efficiency ratio (also called media efficiency ratio) is total revenue over total spend, the blended number platforms can't inflate. See what your whole account is really returning."),
  faqs: faq.map((f) => ({ q: f.q, a: esc(f.a) })),
};
const byline = [{ text: 'AdBoost Health', icon: 'org' as const }, { text: 'Runs in your browser', icon: 'check' as const }];
// The hero: this calculator's formula as a chain, with the values it shows on load
const hero = {
  name: 'MER calculator',
  op: '÷' as const,
  rows: [
    { label: 'Total revenue', sub: 'all channels, per period', value: money(REV), icon: 'chart' },
    { label: 'Total marketing spend', sub: 'same period', value: money(SPEND), icon: 'layers' },
  ],
  result: { label: 'MER', value: r.value, tone: r.verdict },
  gauge: { bands: [{ to: 2, tone: 'bad' as const }, { to: 3, tone: 'warn' as const }, { to: 6, tone: 'ok' as const }], value: r.mer ?? 0 },
  formula: 'MER = total revenue ÷ total marketing spend',
  chip: { title: "Can't be double-counted", label: "the blended number platforms can't inflate", icon: 'shield' },
};
---
<FamilyPage
  path={path}
  data={data}
  crumbs={[{ label: 'Home', href: '/' }, { label: 'Tools', href: '/tools/' }, { label: "MER Calculator" }]}
  eyebrow="FREE TOOL"
  schema={jsonLd}
  byline={byline}
  faqHeading="FAQ"
>
  <CalcHero slot="hero" {...hero} />

  <div slot="aside" class="pg-card gl-tools">
    <h4>More free tools</h4>
    <ul class="gl-links">
      <li><LinkCard href="/tools/poas-calculator/" label="POAS calculator" /></li>
      <li><LinkCard href="/tools/cac-calculator/" label="CAC calculator" /></li>
      <li><LinkCard href="/tools/ltv-cac-calculator/" label="LTV:CAC calculator" /></li>
    </ul>
  </div>
  <div slot="aside" class="pg-card is-night">
    <h4>Platform ROAS lying to you?</h4>
    <p>We rebuild attribution to blended MER and payback so you scale on real numbers. Free audit, plan you keep either way.</p>
    <ButtonLink href="/book/" class="pg-card-go">Book a call <span aria-hidden="true">→</span></ButtonLink>
  </div>

  
  <div class="calc tc-calc reveal">
        <div class="tc-bar" aria-hidden="true"><span class="cp-dots"><i></i><i></i><i></i></span><span class="tc-name">MER calculator</span><span class="tc-live"><i></i>Live</span></div>
        <div class="calc-fields">
          <div class="calc-field">
            <label for="rev">Total revenue <span class="hint">(all channels, per period)</span></label>
            <div class="calc-input"><span class="pfx">$</span><input id="rev" type="number" inputmode="decimal" value={REV} min="0" /></div>
          </div>
          <div class="calc-field">
            <label for="spend">Total marketing spend <span class="hint">(same period)</span></label>
            <div class="calc-input"><span class="pfx">$</span><input id="spend" type="number" inputmode="decimal" value={SPEND} min="0" /></div>
          </div>
        </div>
        <div class="calc-result" data-tone="night">
          <div class="cr-main">
            <div class="cr-label">MER</div>
            <div class={valueClass(r.verdict)} id="merOut">{r.value}</div>
          </div>
          <Gauge
            arrive
            live="mer-gauge"
            label="MER"
            min={0}
            max={6}
            value={r.mer ?? 0}
            display={r.value}
            valueText={r.mer === null ? 'Not calculated: enter your total marketing spend' : `${r.mer.toFixed(1)} times total spend`}
            caption="Your MER against the 2× and 3× marks the result note uses."
            bands={[
              { to: 2, tone: 'bad', label: 'Below 2×: likely unprofitable' },
              { to: 3, tone: 'warn', label: '2× to 3×: workable' },
              { to: 6, tone: 'ok', label: '3× and up: efficient' },
            ]}
            ticks={[{ at: 2, label: '2×' }, { at: 3, label: '3×' }]}
          />
          <div class="rs-fxline">
            <p class="rs-fxline__sym">MER = total revenue ÷ total marketing spend</p>
            <p class="rs-fxline__live" id="fxLive">{money(REV)} ÷ {money(SPEND)} = {r.value}</p>
          </div>
          <div class="cr-note" id="merNote">{r.note}</div>
        </div>
      </div>
  <p class="tool-fine tc-fine">Runs in your browser. MER is deliberately blended: it uses total revenue and total spend, so it reflects the whole business rather than any one platform's self-reported numbers.</p>
  
  <div class="pg-prose"><h2 id="how-mer-is-calculated">How MER is calculated</h2>
      <p>Marketing efficiency ratio is the simplest honest read on efficiency: everything you made over everything you spent to make it.</p>
      </div>
  <ol class="cp-steps tc-steps">
    <li class="cp-step reveal" style="--i:0"><span class="cp-step-node" aria-hidden="true"></span><div class="cp-step-card tc-step"><p><strong>Total your revenue.</strong> All revenue for the period, not just ad-attributed revenue.</p></div></li>
    <li class="cp-step reveal" style="--i:1"><span class="cp-step-node" aria-hidden="true"></span><div class="cp-step-card tc-step"><p><strong>Total your marketing spend.</strong> Every marketing and ad dollar for that same period.</p></div></li>
    <li class="cp-step reveal" style="--i:2"><span class="cp-step-node" aria-hidden="true"></span><div class="cp-step-card tc-step"><p><strong>Divide revenue by spend.</strong> MER = total revenue ÷ total marketing spend. $300,000 on $75,000 is a MER of 4.0.</p></div></li>
  </ol>
  
  <div class="pg-prose"><h2 id="why-mer-beats-platform-roas">Why MER beats platform ROAS</h2>
      <p>When a patient sees a Meta ad, a Google ad, and an email before subscribing, each platform can claim the same conversion, so summed platform ROAS over-counts revenue by 30-100%. MER can't be double-counted. Use it as your north star and platform ROAS only for in-channel optimization. See <a href="/glossary/mer/">marketing efficiency ratio (MER)</a> and <a href="/glossary/roas/">ROAS</a> in the glossary, or add margin with the <a href="/tools/poas-calculator/">POAS calculator</a>.</p></div>
</FamilyPage>

<script>
  import { setLive } from '../../kit/diagram/live';
  import { merCalc, money, num, valueClass } from './_calc';

  const rev = document.getElementById('rev') as HTMLInputElement;
  const spend = document.getElementById('spend') as HTMLInputElement;
  const out = document.getElementById('merOut')!;
  const note = document.getElementById('merNote')!;
  const fx = document.getElementById('fxLive')!;
  function calc() {
    const r = merCalc(num(rev), num(spend));
    out.textContent = r.value;
    out.className = valueClass(r.verdict);
    note.textContent = r.note;
    fx.textContent = `${money(num(rev))} ÷ ${money(num(spend))} = ${r.value}`;
    setLive('mer-gauge', r.mer ?? 0, r.value, r.mer === null ? 'Not calculated: enter your total marketing spend' : `${r.mer.toFixed(1)} times total spend`);
  }
  [rev, spend].forEach((el) => el.addEventListener('input', calc));
  calc();
</script>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import AsideLinks from '../../components/doc/AsideLinks.astro';
import AsideCta from '../../components/doc/AsideCta.astro';
import Closing from '../../components/Closing.astro';
import Faq from '../../components/Faq.astro';
import { siteBase } from '../../lib/site';
import { breadcrumb, faqPage } from '../../lib/schema';

const SITE = siteBase(Astro.site);
const path = '/tools/mer-calculator/';
const title = 'Free MER Calculator (Marketing Efficiency Ratio) | AdBoost';
const description = 'Calculate MER (marketing efficiency ratio): total revenue divided by total marketing spend. The blended, un-inflatable efficiency number for health brands.';
const faq = [
  { q: 'What is MER (marketing efficiency ratio)?', a: 'MER, also called media efficiency ratio, is total revenue divided by total marketing spend across every channel. Because it is blended, it cannot be inflated by multiple platforms each claiming the same conversion, unlike platform-reported ROAS.' },
  { q: 'What is a good MER?', a: 'It depends on margin and channel mix, but many DTC and health brands aim for a MER of 3-4+ (revenue three to four times total spend) to stay profitable after cost of goods and overhead. Track the trend more than the absolute number.' },
  { q: 'MER vs ROAS - which should I use?', a: 'Use MER to judge whole-business efficiency (what the bank account shows) and platform ROAS only as an in-channel optimization signal. When platform ROAS looks great but MER is flat, platforms are over-claiming shared conversions.' },
];
const jsonLd = [
  breadcrumb(SITE, [{ label: 'Home', href: '/' }, { label: 'Tools', href: '/tools/' }, { label: 'MER Calculator', href: path }]),
  faqPage(faq),
];
---
<BaseLayout {title} {description} canonicalPath={path} {jsonLd}>
  <PageHead label="Free tools" labelHref="/tools/" title="MER calculator" lede="Marketing efficiency ratio (also called media efficiency ratio) is total revenue over total spend, the blended number platforms can't inflate. See what your whole account is really returning." dots />

  <section class="tone-paper page-body" data-nav="paper">
    <div class="wrap doc">
      <div class="doc-main">
      <div class="calc" data-reveal>
        <div class="calc-fields">
          <div class="calc-field">
            <label for="rev">Total revenue <span class="hint">(all channels, per period)</span></label>
            <div class="calc-input"><span class="pfx">$</span><input id="rev" type="number" inputmode="decimal" value="300000" min="0" /></div>
          </div>
          <div class="calc-field">
            <label for="spend">Total marketing spend <span class="hint">(same period)</span></label>
            <div class="calc-input"><span class="pfx">$</span><input id="spend" type="number" inputmode="decimal" value="75000" min="0" /></div>
          </div>
        </div>
        <div class="calc-result gcard">
          <div class="cr-main">
            <div class="cr-label">MER</div>
            <div class="cr-value" id="merOut">4.0×</div>
          </div>
          <div class="cr-note" id="merNote">Total revenue is 4× total marketing spend.</div>
        </div>
      </div>
      <p class="calc-foot">Runs in your browser. MER is deliberately blended: it uses total revenue and total spend, so it reflects the whole business rather than any one platform's self-reported numbers.</p>
        <div class="prose">
        <h2>How MER is calculated</h2>
      <p>Marketing efficiency ratio is the simplest honest read on efficiency: everything you made over everything you spent to make it.</p>
      <ol>
        <li><strong>Total your revenue.</strong> All revenue for the period, not just ad-attributed revenue.</li>
        <li><strong>Total your marketing spend.</strong> Every marketing and ad dollar for that same period.</li>
        <li><strong>Divide revenue by spend.</strong> MER = total revenue ÷ total marketing spend. $300,000 on $75,000 is a MER of 4.0.</li>
      </ol>

      <h2>Why MER beats platform ROAS</h2>
      <p>When a patient sees a Meta ad, a Google ad, and an email before subscribing, each platform can claim the same conversion, so summed platform ROAS over-counts revenue by 30-100%. MER can't be double-counted. Use it as your north star and platform ROAS only for in-channel optimization. See <a href="/glossary/mer/">marketing efficiency ratio (MER)</a> and <a href="/glossary/roas/">ROAS</a> in the glossary, or add margin with the <a href="/tools/poas-calculator/">POAS calculator</a>.</p>
        </div>

        <div class="doc-sec" id="faq">
          <h2>FAQ</h2>
          <Faq items={faq} />
        </div>
      </div>
      <aside class="doc-aside">
        <AsideLinks label="More free tools" links={[{ href: '/tools/poas-calculator/', label: 'POAS calculator' }, { href: '/tools/cac-calculator/', label: 'CAC calculator' }, { href: '/tools/ltv-cac-calculator/', label: 'LTV:CAC calculator' }]} />
        <AsideCta heading="Platform ROAS lying to you?" text="We rebuild attribution to blended MER and payback so you scale on real numbers. Free audit, plan you keep either way." />
      </aside>
    </div>
  </section>

  <Closing />

  <script is:inline>
    (function () {
      const rev = document.getElementById('rev');
      const spend = document.getElementById('spend');
      const out = document.getElementById('merOut');
      const note = document.getElementById('merNote');
      function calc() {
        const r = parseFloat(rev.value) || 0;
        const s = parseFloat(spend.value) || 0;
        if (s <= 0) { out.textContent = '-'; out.className = 'cr-value'; note.textContent = 'Enter your total marketing spend.'; return; }
        const mer = r / s;
        out.textContent = mer.toFixed(1) + '×';
        const x = mer.toFixed(1);
        if (mer >= 3) { out.className = 'cr-value good'; note.textContent = 'Total revenue is ' + x + '× total spend - efficient for most health/DTC models.'; }
        else if (mer >= 2) { out.className = 'cr-value'; note.textContent = 'Total revenue is ' + x + '× total spend - workable, watch margin and overhead.'; }
        else { out.className = 'cr-value bad'; note.textContent = 'Total revenue is only ' + x + '× total spend - likely unprofitable after costs.'; }
      }
      [rev, spend].forEach((el) => el.addEventListener('input', calc));
      calc();
    })();
  </script>
</BaseLayout>

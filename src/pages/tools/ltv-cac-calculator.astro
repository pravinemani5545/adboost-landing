---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Faq from '../../components/Faq.astro';
import Gauge from '../../kit/diagram/Gauge.astro';
import Figure from '../../kit/diagram/Figure.astro';
import { siteBase } from '../../lib/site';
import { breadcrumb, faqPage } from '../../lib/schema';
import { ltvCalc, money, valueClass } from './_calc';
import { monthLabel, monthTicks, paths, shape } from './_payback';
import '../../styles/pages/tools.css';

const SITE = siteBase(Astro.site);
const path = '/tools/ltv-cac-calculator/';
const title = 'Free LTV:CAC Ratio & Payback Calculator | AdBoost Health';
const description = 'Calculate lifetime value, your LTV:CAC ratio, and payback period for a subscription health or DTC brand. Free, with the 3:1 benchmark built in.';
const faq = [
  { q: 'What is a good LTV:CAC ratio?', a: '3:1 or higher is the standard benchmark for a healthy, scalable model. Below 3:1 usually means you’re buying revenue at a loss after overhead; far above 5:1 can mean you’re under-investing in growth.' },
  { q: 'How is payback period calculated?', a: 'Payback (months) = CAC ÷ monthly gross profit per customer. It tells you how long until a customer repays their acquisition cost - critical for cash-efficient scaling in subscription health.' },
  { q: 'How do I estimate lifetime value?', a: 'LTV ≈ monthly revenue × gross margin × average months retained. Retention is the biggest lever in subscription health - small changes in months-retained move LTV dramatically.' },
];
const jsonLd = [
  breadcrumb(SITE, [{ label: 'Home', href: '/' }, { label: 'Tools', href: '/tools/' }, { label: 'LTV:CAC Calculator', href: path }]),
  faqPage(faq),
];

// Default inputs, run through the same functions the page script uses.
const MREV = 199;
const MARGIN = 75;
const MONTHS = 12;
const CAC = 250;
const r = ltvCalc(MREV, MARGIN, MONTHS, CAC);
const s = shape(r.gp, MONTHS, CAC);
const pp = paths(s);
const ratioSpoken = (x: number | null) => (x === null ? 'Not calculated: enter your CAC' : `${x.toFixed(1)} to 1`);
---
<BaseLayout {title} {description} canonicalPath={path} {jsonLd}>
  <PageHero
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Tools', href: '/tools/' }, { label: 'LTV:CAC Calculator' }]}
    eyebrow="FREE TOOL"
    title="LTV:CAC &amp; payback calculator"
    lede="The single most important unit-economics check for a subscription health brand - lifetime value, LTV:CAC ratio, and how many months until a customer pays you back."
  />

  <section class="iwrap-sm">
    <div class="container">
     <div class="doc-grid">
      <div class="doc-main tool-doc">
      <div class="calc k-card k-card--float arrive">
        <div class="calc-fields">
          <div class="calc-field">
            <label for="mrev">Monthly revenue per customer</label>
            <div class="calc-input"><span class="pfx">$</span><input id="mrev" type="number" inputmode="decimal" value={MREV} min="0" /></div>
          </div>
          <div class="calc-field">
            <label for="margin">Gross margin <span class="hint">(%)</span></label>
            <div class="calc-input"><input id="margin" type="number" inputmode="decimal" value={MARGIN} min="0" max="100" /><span class="sfx">%</span></div>
          </div>
          <div class="calc-field">
            <label for="months">Avg. months retained</label>
            <div class="calc-input"><input id="months" type="number" inputmode="decimal" value={MONTHS} min="0" /><span class="sfx">months</span></div>
          </div>
          <div class="calc-field">
            <label for="cac2">CAC <span class="hint">(cost to acquire one customer)</span></label>
            <div class="calc-input"><span class="pfx">$</span><input id="cac2" type="number" inputmode="decimal" value={CAC} min="0" /></div>
          </div>
        </div>
        <div class="calc-result" data-tone="night">
          <div class="cr-main">
            <div class="cr-label">LTV:CAC ratio</div>
            <div class={valueClass(r.verdict)} id="ratioOut">{r.ratioText}</div>
          </div>
          <Gauge
            arrive
            live="ltv-gauge"
            label="LTV:CAC ratio"
            min={0}
            max={8}
            value={r.ratio ?? 0}
            display={r.ratioText}
            valueText={ratioSpoken(r.ratio)}
            caption="Your ratio against the 3:1 benchmark; far above 5:1 can mean under-investing in growth."
            bands={[
              { to: 3, tone: 'bad', label: 'Below 3:1' },
              { to: 5, tone: 'ok', label: '3:1 or higher' },
              { to: 8, tone: 'warn', label: 'Far above 5:1' },
            ]}
            ticks={[{ at: 3, label: '3:1' }, { at: 5, label: '5:1' }]}
          />
          <div class="cr-sub">
            <div><div class="k">LIFETIME VALUE</div><div class="v" id="ltvOut">{r.ltvText}</div></div>
            <div><div class="k">PAYBACK</div><div class="v" id="pbOut">{r.paybackText}</div></div>
          </div>
          <div class="cr-note" id="ratioNote">{r.note}</div>
        </div>
        <div class="calc-wide">
          <Figure
            kind="payback"
            arrive
            class="tool-pb"
            caption="Payback: cumulative gross profit per customer (monthly revenue × gross margin, each month) against your CAC, out to your average months retained."
          >
            <ul class="pb-key">
              <li><span class="pb-sw" aria-hidden="true"></span>Cumulative gross profit, LTV <strong id="pbKeyLtv">{r.ltvText}</strong></li>
              <li><span class="pb-sw pb-sw--cac" aria-hidden="true"></span>CAC <strong id="pbKeyCac">{money(CAC)}</strong></li>
              <li><span class="pb-sw pb-sw--pay" aria-hidden="true"></span>Payback <strong id="pbKeyPay">{r.paybackText}</strong></li>
            </ul>
            <div class="pb-plot" id="pbPlot" data-pay={pp.p === null ? 'no' : 'yes'} style={`--a:${s.a};--c:${s.c};--p:${pp.p ?? 1}`}>
              <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                <path class="pb-owed" d={pp.owed} />
                <path class="pb-ahead" d={pp.ahead} />
                <path class="pb-ticks" d={monthTicks(MONTHS)} />
                <path class="pb-base" d="M0 100H100" />
                <path class="pb-guide" d={pp.guide} />
                <path class="pb-cacline" d={pp.cac} />
                <path class="pb-line" d={pp.line} />
              </svg>
              <span class="pb-dot pb-dot--pay" aria-hidden="true"></span>
              <span class="pb-dot pb-dot--ltv" aria-hidden="true"></span>
            </div>
            <p class="pb-axis" aria-hidden="true"><span>Month 0</span><span>Month <span id="pbEnd">{monthLabel(MONTHS)}</span></span></p>
          </Figure>
        </div>
      </div>
      <p class="tool-fine">Runs in your browser; nothing is stored. LTV here is gross-profit LTV (revenue × margin × months). The 3:1 benchmark and vertical context come from our <a href="/blog/telehealth-cac-benchmarks-2026/">2026 health-vertical benchmarks</a>.</p>

      <h2 class="sec-title">How to calculate LTV:CAC</h2>
      <p>Three inputs decide whether your model scales: what a customer is worth, what they cost, and how fast they pay you back.</p>
      <ol class="tool-steps">
        <li class="k-card k-card--flat" data-reveal><span><strong>Estimate lifetime value.</strong> LTV ≈ monthly revenue × gross margin × average months retained.</span></li>
        <li class="k-card k-card--flat" data-reveal><span><strong>Divide LTV by CAC.</strong> The ratio is lifetime value ÷ acquisition cost - aim for at least 3:1.</span></li>
        <li class="k-card k-card--flat" data-reveal><span><strong>Calculate payback.</strong> Payback (months) = CAC ÷ monthly gross profit per customer.</span></li>
      </ol>

      <h2 class="sec-title">What the numbers mean</h2>
      <p>A ratio at or above <strong>3:1</strong> is the benchmark for a scalable model, and payback under 12 months keeps growth cash-efficient. In subscription health, the biggest lever isn’t CAC - it’s <a href="/glossary/churn-rate/#retention-rate">retention</a>: adding a few months to average lifespan moves LTV more than most CAC cuts. For the full definition and where the 3:1 rule comes from, see <a href="/glossary/ltv-cac-ratio/">LTV:CAC ratio</a> in the glossary, and <a href="/blog/telehealth-cac-benchmarks-2026/">benchmarks by vertical</a> for context.</p>

      <h2 class="sec-title">FAQ</h2>
      <div class="tool-faq"><Faq items={faq} idPrefix="ltv" /></div>
      </div>
      <aside class="doc-aside">
        <div class="aside-card">
          <h4>More free tools</h4>
          <div class="link-list">
            <a href="/tools/cac-calculator/">CAC calculator</a>
            <a href="/tools/ad-budget-calculator/">Ad budget calculator</a>
            <a href="/blog/telehealth-cac-benchmarks-2026/">CAC benchmarks by vertical</a>
          </div>
        </div>
        <div class="aside-card dark">
          <h4>Fix your unit economics</h4>
          <p>We map the fastest levers to move CAC, retention, and payback.</p>
          <a class="btn btn-primary" href="/book/">Book a call →</a>
        </div>
      </aside>
     </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<script>
  import { setLive } from '../../kit/diagram/live';
  import { ltvCalc, money, num, valueClass } from './_calc';
  import { monthLabel, monthTicks, paths, shape, type Shape } from './_payback';

  const ids = ['mrev', 'margin', 'months', 'cac2'].map((i) => document.getElementById(i) as HTMLInputElement);
  const ratioOut = document.getElementById('ratioOut')!;
  const ltvOut = document.getElementById('ltvOut')!;
  const pbOut = document.getElementById('pbOut')!;
  const note = document.getElementById('ratioNote')!;

  // payback chart
  const plot = document.getElementById('pbPlot')!;
  const svgPath = (cls: string) => plot.querySelector<SVGPathElement>(`.${cls}`)!;
  const [pOwed, pAhead, pTicks, pGuide, pCac, pLine] = ['pb-owed', 'pb-ahead', 'pb-ticks', 'pb-guide', 'pb-cacline', 'pb-line'].map(svgPath);
  const keyLtv = document.getElementById('pbKeyLtv')!;
  const keyCac = document.getElementById('pbKeyCac')!;
  const keyPay = document.getElementById('pbKeyPay')!;
  const axisEnd = document.getElementById('pbEnd')!;
  let shown: Shape = { a: Number(plot.style.getPropertyValue('--a')) || 0, c: Number(plot.style.getPropertyValue('--c')) || 0 };
  let raf = 0;

  function drawShape(sh: Shape) {
    const p = paths(sh);
    pOwed.setAttribute('d', p.owed);
    pAhead.setAttribute('d', p.ahead);
    pGuide.setAttribute('d', p.guide);
    pCac.setAttribute('d', p.cac);
    pLine.setAttribute('d', p.line);
    plot.style.setProperty('--a', String(sh.a));
    plot.style.setProperty('--c', String(sh.c));
    plot.style.setProperty('--p', String(p.p ?? 1));
    plot.dataset.pay = p.p === null ? 'no' : 'yes';
  }

  // The new shape eases in from the one on screen (instant with reduced motion).
  function morphTo(target: Shape) {
    cancelAnimationFrame(raf);
    if (!document.documentElement.classList.contains('motion')) {
      shown = target;
      drawShape(target);
      return;
    }
    const from = shown;
    const t0 = performance.now();
    const DUR = 460;
    const step = (t: number) => {
      const k = Math.min(1, (t - t0) / DUR);
      const e = 1 - Math.pow(1 - k, 3);
      shown = { a: from.a + (target.a - from.a) * e, c: from.c + (target.c - from.c) * e };
      drawShape(shown);
      if (k < 1) raf = requestAnimationFrame(step);
    };
    raf = requestAnimationFrame(step);
  }

  function calc() {
    const [mrev, margin, months, cac] = ids.map(num);
    const r = ltvCalc(mrev, margin, months, cac);
    ltvOut.textContent = r.ltvText;
    pbOut.textContent = r.paybackText;
    ratioOut.textContent = r.ratioText;
    ratioOut.className = valueClass(r.verdict);
    note.textContent = r.note;

    setLive('ltv-gauge', r.ratio ?? 0, r.ratioText, r.ratio === null ? 'Not calculated: enter your CAC' : `${r.ratio.toFixed(1)} to 1`);

    keyLtv.textContent = r.ltvText;
    keyCac.textContent = money(cac);
    keyPay.textContent = r.paybackText;
    axisEnd.textContent = monthLabel(months);
    pTicks.setAttribute('d', monthTicks(months));
    morphTo(shape(r.gp, months, cac));
  }
  ids.forEach((el) => el.addEventListener('input', calc));
  calc();
</script>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import Faq from '../../components/Faq.astro';
import { siteBase } from '../../lib/site';
import { breadcrumb, faqPage, calculatorNode } from '../../lib/schema';

const SITE = siteBase(Astro.site);
const path = '/tools/ltv-cac-calculator/';
const title = 'Free LTV:CAC Ratio & Payback Calculator | AdBoost Health';
const description = 'Calculate lifetime value, your LTV:CAC ratio, and payback period for a subscription health or DTC brand. Free, with the 3:1 benchmark built in.';
const faq = [
  { q: 'What is a good LTV:CAC ratio?', a: '3:1 or higher is the standard benchmark for a healthy, scalable model. Below 3:1 usually means you’re buying revenue at a loss after overhead; far above 5:1 can mean you’re under-investing in growth.' },
  { q: 'How is payback period calculated?', a: 'Payback (months) = CAC ÷ monthly gross profit per customer. It tells you how long until a customer repays their acquisition cost - critical for cash-efficient scaling in subscription health.' },
  { q: 'How do I estimate lifetime value?', a: 'LTV ≈ monthly revenue × gross margin × average months retained. Retention is the biggest lever in subscription health - small changes in months-retained move LTV dramatically.' },
];
const jsonLd = [
  calculatorNode(SITE, { name: 'LTV:CAC Calculator', description, path }),
  breadcrumb(SITE, [{ label: 'Home', href: '/' }, { label: 'Tools', href: '/tools/' }, { label: 'LTV:CAC Calculator', href: path }]),
  faqPage(faq),
];
---
<BaseLayout {title} {description} canonicalPath={path} {jsonLd}>
  <section class="phero">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Tools', href: '/tools/' }, { label: 'LTV:CAC Calculator' }]} />
      <span class="eyebrow sec-eyebrow" style="display:block;margin-top:16px"><span class="dot"></span>FREE TOOL</span>
      <h1>LTV:CAC & payback calculator</h1>
      <p class="phero-lede">The single most important unit-economics check for a subscription health brand - lifetime value, LTV:CAC ratio, and how many months until a customer pays you back.</p>
    </div>
  </section>

  <section class="iwrap-sm">
    <div class="container">
     <div class="doc-grid">
      <div class="doc-main">
      <div class="calc reveal">
        <div class="calc-fields">
          <div class="calc-field">
            <label for="mrev">Monthly revenue per customer</label>
            <div class="calc-input"><span class="pfx">$</span><input id="mrev" type="number" inputmode="decimal" value="199" min="0" /></div>
          </div>
          <div class="calc-field">
            <label for="margin">Gross margin <span class="hint">(%)</span></label>
            <div class="calc-input"><input id="margin" type="number" inputmode="decimal" value="75" min="0" max="100" style="padding-left:14px" /><span class="sfx">%</span></div>
          </div>
          <div class="calc-field">
            <label for="months">Avg. months retained</label>
            <div class="calc-input"><input id="months" type="number" inputmode="decimal" value="12" min="0" style="padding-left:14px" /><span class="sfx">months</span></div>
          </div>
          <div class="calc-field">
            <label for="cac2">CAC <span class="hint">(cost to acquire one customer)</span></label>
            <div class="calc-input"><span class="pfx">$</span><input id="cac2" type="number" inputmode="decimal" value="250" min="0" /></div>
          </div>
        </div>
        <div class="calc-result">
          <div class="cr-main">
            <div class="cr-label">LTV:CAC ratio</div>
            <div class="cr-value" id="ratioOut">6.0×</div>
          </div>
          <div class="cr-sub">
            <div><div class="k">LIFETIME VALUE</div><div class="v" id="ltvOut">$1,493</div></div>
            <div><div class="k">PAYBACK</div><div class="v" id="pbOut">1.7 mo</div></div>
          </div>
          <div class="cr-note" id="ratioNote">Healthy - at or above the 3:1 benchmark.</div>
        </div>
      </div>
      <p style="color:var(--mute);font-size:13px;margin-top:14px">Runs in your browser; nothing is stored. LTV here is gross-profit LTV (revenue × margin × months). The 3:1 benchmark and vertical context come from our <a href="/blog/telehealth-cac-benchmarks-2026/" style="color:var(--blue)">2026 health-vertical benchmarks</a>.</p>

      <h2 class="sec-title" style="margin-top:40px">How to calculate LTV:CAC</h2>
      <p style="color:var(--ink-2);line-height:1.7">Three inputs decide whether your model scales: what a customer is worth, what they cost, and how fast they pay you back.</p>
      <ol style="margin-top:12px;padding-left:20px;line-height:1.7;color:var(--ink-2)">
        <li style="margin-bottom:8px"><strong>Estimate lifetime value.</strong> LTV ≈ monthly revenue × gross margin × average months retained.</li>
        <li style="margin-bottom:8px"><strong>Divide LTV by CAC.</strong> The ratio is lifetime value ÷ acquisition cost - aim for at least 3:1.</li>
        <li style="margin-bottom:8px"><strong>Calculate payback.</strong> Payback (months) = CAC ÷ monthly gross profit per customer.</li>
      </ol>

      <h2 class="sec-title" style="margin-top:36px">What the numbers mean</h2>
      <p style="color:var(--ink-2);line-height:1.7">A ratio at or above <strong>3:1</strong> is the benchmark for a scalable model, and payback under 12 months keeps growth cash-efficient. In subscription health, the biggest lever isn’t CAC - it’s <a href="/glossary/retention-rate/" style="color:var(--blue)">retention</a>: adding a few months to average lifespan moves LTV more than most CAC cuts. For the full definition and where the 3:1 rule comes from, see <a href="/glossary/ltv-cac-ratio/" style="color:var(--blue)">LTV:CAC ratio</a> in the glossary, and <a href="/blog/telehealth-cac-benchmarks-2026/" style="color:var(--blue)">benchmarks by vertical</a> for context.</p>

      <h2 class="sec-title" style="margin-top:36px">FAQ</h2>
      <div style="margin-top:16px"><Faq items={faq} idPrefix="ltv" /></div>
      </div>
      <aside class="doc-aside">
        <div class="aside-card">
          <h4>More free tools</h4>
          <div class="link-list">
            <a href="/tools/cac-calculator/">CAC calculator</a>
            <a href="/tools/ad-budget-calculator/">Ad budget calculator</a>
            <a href="/blog/telehealth-cac-benchmarks-2026/">CAC benchmarks by vertical</a>
          </div>
        </div>
        <div class="aside-card dark">
          <h4 style="color:#fff">Fix your unit economics</h4>
          <p>We map the fastest levers to move CAC, retention, and payback.</p>
          <a class="btn btn-primary" href="https://cal.com/pira-ahilan-ef2dl8/strategy-call" target="_blank" rel="noopener">Book a call →</a>
        </div>
      </aside>
     </div>
    </div>
  </section>

  <CtaBand />

  <script is:inline>
    (function () {
      const ids = ['mrev', 'margin', 'months', 'cac2'].map((i) => document.getElementById(i));
      const ratioOut = document.getElementById('ratioOut');
      const ltvOut = document.getElementById('ltvOut');
      const pbOut = document.getElementById('pbOut');
      const note = document.getElementById('ratioNote');
      const money = (n) => '$' + Math.round(n).toLocaleString('en-US');
      function calc() {
        const [mrev, margin, months, cac] = ids.map((el) => parseFloat(el.value) || 0);
        const gp = mrev * (margin / 100);
        const ltv = gp * months;
        ltvOut.textContent = money(ltv);
        pbOut.textContent = gp > 0 ? (cac / gp).toFixed(1) + ' mo' : '-';
        if (cac <= 0) { ratioOut.textContent = '-'; ratioOut.className = 'cr-value'; note.textContent = 'Enter your CAC to see the ratio.'; return; }
        const ratio = ltv / cac;
        ratioOut.textContent = ratio.toFixed(1) + '×';
        if (ratio >= 3) { ratioOut.className = 'cr-value good'; note.textContent = 'Healthy - at or above the 3:1 benchmark.' + (ratio > 6 ? ' Very high - you may be under-investing in growth.' : ''); }
        else { ratioOut.className = 'cr-value bad'; note.textContent = 'Below the 3:1 benchmark - you’re likely buying revenue at a loss after overhead.'; }
      }
      ids.forEach((el) => el.addEventListener('input', calc));
      calc();
    })();
  </script>
</BaseLayout>

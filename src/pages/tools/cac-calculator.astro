---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Faq from '../../components/Faq.astro';
import Bars from '../../kit/diagram/Bars.astro';
import { getVertical } from '../../data/verticals';
import { siteBase } from '../../lib/site';
import { breadcrumb, faqPage } from '../../lib/schema';
import { cacCalc, valueClass } from './_calc';
import '../../styles/pages/tools.css';

const SITE = siteBase(Astro.site);
const path = '/tools/cac-calculator/';
const title = 'Free CAC Calculator for Health & DTC Brands | AdBoost Health';
const description = 'Calculate your customer acquisition cost (CAC) in seconds and see how it compares to 2026 health-vertical benchmarks. Free, no signup.';
const faq = [
  { q: 'How is CAC calculated?', a: 'CAC = total acquisition spend ÷ new customers acquired in the same period. Include ad spend, agency/creative fees, and tools - not just media - for a fully-loaded number.' },
  { q: 'What should I include in acquisition spend?', a: 'For a fully-loaded CAC, include paid media, creative production, agency or team cost attributable to acquisition, and martech. A media-only CAC understates what a customer really costs.' },
  { q: 'What’s a good CAC for a health brand?', a: 'It depends on your vertical and LTV: supplements target sub-$40–$200, telehealth $150–$500, GLP-1 $180–$400. The number only matters against LTV - aim for an LTV:CAC of at least 3:1.' },
];
const jsonLd = [
  breadcrumb(SITE, [{ label: 'Home', href: '/' }, { label: 'Tools', href: '/tools/' }, { label: 'CAC Calculator', href: path }]),
  faqPage(faq),
];

// Benchmark ranges come from the industry data (cacLow/cacHigh, printed as cacDisplay), in the
// order and with the option labels the calculator has always used.
const OPTIONS = [
  { slug: 'supplements-dtc', label: 'Supplements / DTC' },
  { slug: 'glp-1-weight-loss', label: 'GLP-1 / weight loss' },
  { slug: 'telehealth', label: 'Telehealth' },
  { slug: 'trt-hormone', label: 'TRT / hormone' },
  { slug: 'med-spa', label: 'Med spa' },
  { slug: 'mental-health', label: 'Mental health' },
];
const DEFAULT_SLUG = 'glp-1-weight-loss';
const verticals = OPTIONS.map((o) => {
  const v = getVertical(o.slug);
  if (!v) throw new Error(`[tools/cac] vertical "${o.slug}" is not live, so its benchmark range is missing`);
  return { ...o, value: `${v.cacLow},${v.cacHigh}`, lo: v.cacLow, hi: v.cacHigh, display: v.cacDisplay };
});

// Default inputs, run through the same function the page script uses.
const SPEND = 50000;
const CUSTOMERS = 220;
const def = verticals.find((v) => v.slug === DEFAULT_SLUG)!;
const initial = cacCalc(SPEND, CUSTOMERS, def.lo, def.hi);
// One axis for every vertical, so switching verticals moves the bar, not the scale.
const AXIS_MAX = 600;
---
<BaseLayout {title} {description} canonicalPath={path} {jsonLd}>
  <PageHero
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Tools', href: '/tools/' }, { label: 'CAC Calculator' }]}
    eyebrow="FREE TOOL"
    title="CAC calculator"
    lede="Work out your true customer acquisition cost, then see how it stacks up against 2026 health-vertical benchmarks."
  />

  <section class="iwrap-sm">
    <div class="container">
     <div class="doc-grid">
      <div class="doc-main tool-doc">
      <div class="calc k-card k-card--float arrive">
        <div class="calc-fields">
          <div class="calc-field">
            <label for="spend">Total acquisition spend <span class="hint">(media + creative + fees, per period)</span></label>
            <div class="calc-input"><span class="pfx">$</span><input id="spend" type="number" inputmode="decimal" value={SPEND} min="0" /></div>
          </div>
          <div class="calc-field">
            <label for="customers">New customers acquired <span class="hint">(same period)</span></label>
            <div class="calc-input"><input id="customers" type="number" inputmode="decimal" value={CUSTOMERS} min="0" /></div>
          </div>
          <div class="calc-field">
            <label for="vertical">Your vertical <span class="hint">(for benchmark context)</span></label>
            <div class="calc-input">
              <select id="vertical">
                {verticals.map((v) => <option value={v.value} selected={v.slug === DEFAULT_SLUG}>{v.label} ({v.display})</option>)}
              </select>
            </div>
          </div>
        </div>
        <div class="calc-result" data-tone="night">
          <div class="cr-main">
            <div class="cr-label">Your CAC</div>
            <div class={valueClass(initial.verdict)} id="cacOut">{initial.value}</div>
          </div>
          {verticals.map((v) => (
            <div class="calc-viz" data-range={v.value} hidden={v.slug !== DEFAULT_SLUG}>
              <Bars
                variant="range"
                arrive
                min={0}
                max={AXIS_MAX}
                ticks={[0, 200, 400, 600]}
                prefix="$"
                caption={`Your CAC against the typical ${v.label} range.`}
                items={[{ label: v.label, display: v.display, range: [v.lo, v.hi], highlight: true }]}
                marker={{ value: initial.cac ?? 0, display: initial.value, label: 'You', live: `cac-mk-${v.slug}` }}
              />
            </div>
          ))}
          <div class="cr-note" id="cacNote">{initial.note}</div>
        </div>
      </div>
      <p class="tool-fine">Runs entirely in your browser - nothing is stored or sent. Benchmark ranges come from our <a href="/blog/telehealth-cac-benchmarks-2026/">2026 health-vertical benchmarks</a> (methodology and sources there); they’re directional - verify against your own account.</p>

      <h2 class="sec-title">How CAC is calculated</h2>
      <p><a href="/glossary/cac/">Customer acquisition cost</a> is fully-loaded spend divided by the customers that spend bought. The trap is counting media only: creative and fees are part of what a customer really costs.</p>
      <ol class="tool-steps">
        <li class="k-card k-card--flat" data-reveal><span><strong>Total your acquisition spend.</strong> Add media, creative production, and the agency or team cost attributable to acquisition for one period.</span></li>
        <li class="k-card k-card--flat" data-reveal><span><strong>Count new customers.</strong> Count the new customers or patients acquired in that same period.</span></li>
        <li class="k-card k-card--flat" data-reveal><span><strong>Divide spend by customers.</strong> CAC = total acquisition spend ÷ new customers. $50,000 across 220 customers is about $227.</span></li>
      </ol>

      <h2 class="sec-title">How to read your CAC</h2>
      <p>CAC only means something against lifetime value. A $250 CAC is excellent for a GLP-1 program at $299/month and fatal for a $29 supplement. Once you have your CAC, check your <a href="/tools/ltv-cac-calculator/">LTV:CAC ratio</a> - aim for at least 3:1 - and see the full <a href="/blog/telehealth-cac-benchmarks-2026/">benchmarks by vertical</a>.</p>

      <h2 class="sec-title">FAQ</h2>
      <div class="tool-faq"><Faq items={faq} idPrefix="cac" /></div>
      </div>
      <aside class="doc-aside">
        <div class="aside-card">
          <h4>More free tools</h4>
          <div class="link-list">
            <a href="/tools/ltv-cac-calculator/">LTV:CAC calculator</a>
            <a href="/tools/ad-budget-calculator/">Ad budget calculator</a>
            <a href="/blog/telehealth-cac-benchmarks-2026/">CAC benchmarks by vertical</a>
          </div>
        </div>
        <div class="aside-card dark">
          <h4>Think your CAC is too high?</h4>
          <p>Free audit - we benchmark your account and map the fastest levers to bring it down.</p>
          <a class="btn btn-primary" href="/book/">Book a call →</a>
        </div>
      </aside>
     </div>
    </div>
  </section>

  <CtaBand heading="Think your CAC is too high?" text="Book a free audit - we’ll benchmark your account and show you the fastest levers to bring CAC down." />
</BaseLayout>

<script>
  import { setLive } from '../../kit/diagram/live';
  import { cacCalc, num, valueClass } from './_calc';

  const spend = document.getElementById('spend') as HTMLInputElement;
  const customers = document.getElementById('customers') as HTMLInputElement;
  const vertical = document.getElementById('vertical') as HTMLSelectElement;
  const out = document.getElementById('cacOut')!;
  const note = document.getElementById('cacNote')!;
  const views = [...document.querySelectorAll<HTMLElement>('.calc-viz[data-range]')];

  function calc() {
    const [lo, hi] = vertical.value.split(',').map(Number);
    const r = cacCalc(num(spend), num(customers), lo, hi);
    out.textContent = r.value;
    out.className = valueClass(r.verdict);
    note.textContent = r.note;
    // live visual: the selected vertical's range, with the visitor's CAC as the marker
    for (const v of views) {
      v.hidden = v.dataset.range !== vertical.value;
      const mk = v.querySelector<HTMLElement>('[data-marker]');
      if (mk) setLive(mk, r.cac ?? 0, r.value);
    }
  }
  [spend, customers, vertical].forEach((el) => el.addEventListener('input', calc));
  calc();
</script>

---
import Bars from '../../kit/diagram/Bars.astro';
import { getVertical } from '../../data/verticals';
import { siteBase } from '../../lib/site';
import { breadcrumb, faqPage } from '../../lib/schema';
import { cacCalc, money, valueClass } from './_calc';
import '../../styles/pages/tools.css';
import '../../styles/family/resources.css';
import '../../styles/family/tools.css';
import '../../styles/family/grain.css';
import FamilyPage from '../../family/FamilyPage.astro';
import LinkCard from '../../family/LinkCard.astro';
import CalcHero from '../../family/resources/CalcHero.astro';
import ButtonLink from '../../components/site/ButtonLink.astro';

const SITE = siteBase(Astro.site);
const path = '/tools/cac-calculator/';
const title = 'Free CAC Calculator for Health & DTC Brands | AdBoost Health';
const description = 'Calculate your customer acquisition cost (CAC) in seconds and see how it compares to 2026 health-vertical benchmarks. Free, no signup.';
const faq = [
  { q: 'How is CAC calculated?', a: 'CAC = total acquisition spend ÷ new customers acquired in the same period. Include ad spend, agency/creative fees, and tools - not just media - for a fully-loaded number.' },
  { q: 'What should I include in acquisition spend?', a: 'For a fully-loaded CAC, include paid media, creative production, agency or team cost attributable to acquisition, and martech. A media-only CAC understates what a customer really costs.' },
  { q: 'What’s a good CAC for a health brand?', a: 'It depends on your vertical and LTV: supplements target sub-$40–$200, telehealth $150–$500, GLP-1 $180–$400. The number only matters against LTV - aim for an LTV:CAC of at least 3:1.' },
];
const jsonLd = [
  breadcrumb(SITE, [{ label: 'Home', href: '/' }, { label: 'Tools', href: '/tools/' }, { label: 'CAC Calculator', href: path }]),
  faqPage(faq),
];

// Benchmark ranges come from the industry data (cacLow/cacHigh, printed as cacDisplay), in the
// order and with the option labels the calculator has always used.
const OPTIONS = [
  { slug: 'supplements-dtc', label: 'Supplements / DTC' },
  { slug: 'glp-1-weight-loss', label: 'GLP-1 / weight loss' },
  { slug: 'telehealth', label: 'Telehealth' },
  { slug: 'trt-hormone', label: 'TRT / hormone' },
  { slug: 'med-spa', label: 'Med spa' },
  { slug: 'mental-health', label: 'Mental health' },
];
const DEFAULT_SLUG = 'glp-1-weight-loss';
const verticals = OPTIONS.map((o) => {
  const v = getVertical(o.slug);
  if (!v) throw new Error(`[tools/cac] vertical "${o.slug}" is not live, so its benchmark range is missing`);
  return { ...o, value: `${v.cacLow},${v.cacHigh}`, lo: v.cacLow, hi: v.cacHigh, display: v.cacDisplay };
});

// Default inputs, run through the same function the page script uses.
const SPEND = 50000;
const CUSTOMERS = 220;
const def = verticals.find((v) => v.slug === DEFAULT_SLUG)!;
const initial = cacCalc(SPEND, CUSTOMERS, def.lo, def.hi);
// One axis for every vertical, so switching verticals moves the bar, not the scale.
const AXIS_MAX = 600;

// FamilyPage (src/family/FamilyPage.astro): the head and JSON-LD exactly as before; the FAQ as cards
// (the same q/a the FAQPage JSON-LD carries); the closing card with this page's CtaBand copy.
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const data = {
  seoTitle: title,
  metaDescription: description,
  h1: "CAC calculator",
  summary: esc("Work out your true customer acquisition cost, then see how it stacks up against 2026 health-vertical benchmarks."),
  faqs: faq.map((f) => ({ q: f.q, a: esc(f.a) })),
  ctaHeading: "Think your CAC is too high?",
  ctaText: "Book a free audit - we’ll benchmark your account and show you the fastest levers to bring CAC down.",
};
const byline = [{ text: 'AdBoost Health', icon: 'org' as const }, { text: 'Runs entirely in your browser', icon: 'check' as const }];
// The hero: this calculator's formula as a chain, with the values it shows on load
const hero = {
  name: 'CAC calculator',
  op: '÷' as const,
  rows: [
    { label: 'Total acquisition spend', sub: 'media + creative + fees, per period', value: money(SPEND), icon: 'layers' },
    { label: 'New customers acquired', sub: 'same period', value: CUSTOMERS.toLocaleString('en-US'), icon: 'users' },
  ],
  result: { label: 'Your CAC', value: initial.value, tone: initial.verdict },
  range: { lo: def.lo, hi: def.hi, max: AXIS_MAX, value: initial.cac ?? 0, label: `${def.label} (${def.display})` },
  formula: 'CAC = total acquisition spend ÷ new customers',
  chip: { title: 'Runs entirely in your browser', label: 'nothing is stored or sent', icon: 'lock' },
};
---
<FamilyPage
  path={path}
  data={data}
  crumbs={[{ label: 'Home', href: '/' }, { label: 'Tools', href: '/tools/' }, { label: "CAC Calculator" }]}
  eyebrow="FREE TOOL"
  schema={jsonLd}
  byline={byline}
  faqHeading="FAQ"
>
  <CalcHero slot="hero" {...hero} />

  <div slot="aside" class="pg-card gl-tools">
    <h4>More free tools</h4>
    <ul class="gl-links">
      <li><LinkCard href="/tools/ltv-cac-calculator/" label="LTV:CAC calculator" /></li>
      <li><LinkCard href="/tools/ad-budget-calculator/" label="Ad budget calculator" /></li>
      <li><LinkCard href="/blog/telehealth-cac-benchmarks-2026/" label="CAC benchmarks by vertical" /></li>
    </ul>
  </div>
  <div slot="aside" class="pg-card is-night">
    <h4>Think your CAC is too high?</h4>
    <p>Free audit - we benchmark your account and map the fastest levers to bring it down.</p>
    <ButtonLink href="/book/" class="pg-card-go">Book a call <span aria-hidden="true">→</span></ButtonLink>
  </div>

  
  <div class="calc tc-calc reveal">
        <div class="tc-bar" aria-hidden="true"><span class="cp-dots"><i></i><i></i><i></i></span><span class="tc-name">CAC calculator</span><span class="tc-live"><i></i>Live</span></div>
        <div class="calc-fields">
          <div class="calc-field">
            <label for="spend">Total acquisition spend <span class="hint">(media + creative + fees, per period)</span></label>
            <div class="calc-input"><span class="pfx">$</span><input id="spend" type="number" inputmode="decimal" value={SPEND} min="0" /></div>
          </div>
          <div class="calc-field">
            <label for="customers">New customers acquired <span class="hint">(same period)</span></label>
            <div class="calc-input"><input id="customers" type="number" inputmode="decimal" value={CUSTOMERS} min="0" /></div>
          </div>
          <div class="calc-field">
            <label for="vertical">Your vertical <span class="hint">(for benchmark context)</span></label>
            <div class="calc-input">
              <select id="vertical">
                {verticals.map((v) => <option value={v.value} selected={v.slug === DEFAULT_SLUG}>{v.label} ({v.display})</option>)}
              </select>
            </div>
          </div>
        </div>
        <div class="calc-result" data-tone="night">
          <div class="cr-main">
            <div class="cr-label">Your CAC</div>
            <div class={valueClass(initial.verdict)} id="cacOut">{initial.value}</div>
          </div>
          {verticals.map((v) => (
            <div class="calc-viz" data-range={v.value} hidden={v.slug !== DEFAULT_SLUG}>
              <Bars
                variant="range"
                arrive
                min={0}
                max={AXIS_MAX}
                ticks={[0, 200, 400, 600]}
                prefix="$"
                caption={`Your CAC against the typical ${v.label} range.`}
                items={[{ label: v.label, display: v.display, range: [v.lo, v.hi], highlight: true }]}
                marker={{ value: initial.cac ?? 0, display: initial.value, label: 'You', live: `cac-mk-${v.slug}` }}
              />
            </div>
          ))}
          <div class="rs-fxline">
            <p class="rs-fxline__sym"><span>CAC</span> = <span>total acquisition spend ÷ new customers</span></p>
            <p class="rs-fxline__live" id="fxLive">{money(SPEND)} ÷ {CUSTOMERS.toLocaleString('en-US')} = {initial.value}</p>
          </div>
          <div class="cr-note" id="cacNote">{initial.note}</div>
        </div>
      </div>
  <p class="tool-fine tc-fine">Runs entirely in your browser - nothing is stored or sent. Benchmark ranges come from our <a href="/blog/telehealth-cac-benchmarks-2026/">2026 health-vertical benchmarks</a> (methodology and sources there); they’re directional - verify against your own account.</p>
  
  <div class="pg-prose"><h2 id="how-cac-is-calculated">How CAC is calculated</h2>
      <p><a href="/glossary/cac/">Customer acquisition cost</a> is fully-loaded spend divided by the customers that spend bought. The trap is counting media only: creative and fees are part of what a customer really costs.</p>
      </div>
  <ol class="cp-steps tc-steps">
    <li class="cp-step reveal" style="--i:0"><span class="cp-step-node" aria-hidden="true"></span><div class="cp-step-card tc-step"><p><strong>Total your acquisition spend.</strong> Add media, creative production, and the agency or team cost attributable to acquisition for one period.</p></div></li>
    <li class="cp-step reveal" style="--i:1"><span class="cp-step-node" aria-hidden="true"></span><div class="cp-step-card tc-step"><p><strong>Count new customers.</strong> Count the new customers or patients acquired in that same period.</p></div></li>
    <li class="cp-step reveal" style="--i:2"><span class="cp-step-node" aria-hidden="true"></span><div class="cp-step-card tc-step"><p><strong>Divide spend by customers.</strong> CAC = total acquisition spend ÷ new customers. $50,000 across 220 customers is about $227.</p></div></li>
  </ol>
  
  <div class="pg-prose"><h2 id="how-to-read-your-cac">How to read your CAC</h2>
      <p>CAC only means something against lifetime value. A $250 CAC is excellent for a GLP-1 program at $299/month and fatal for a $29 supplement. Once you have your CAC, check your <a href="/tools/ltv-cac-calculator/">LTV:CAC ratio</a> - aim for at least 3:1 - and see the full <a href="/blog/telehealth-cac-benchmarks-2026/">benchmarks by vertical</a>.</p></div>
</FamilyPage>

<script>
  import { setLive } from '../../kit/diagram/live';
  import { cacCalc, money, num, valueClass } from './_calc';

  const spend = document.getElementById('spend') as HTMLInputElement;
  const customers = document.getElementById('customers') as HTMLInputElement;
  const vertical = document.getElementById('vertical') as HTMLSelectElement;
  const out = document.getElementById('cacOut')!;
  const note = document.getElementById('cacNote')!;
  const views = [...document.querySelectorAll<HTMLElement>('.calc-viz[data-range]')];
  const fx = document.getElementById('fxLive')!;

  function calc() {
    const [lo, hi] = vertical.value.split(',').map(Number);
    const r = cacCalc(num(spend), num(customers), lo, hi);
    out.textContent = r.value;
    out.className = valueClass(r.verdict);
    note.textContent = r.note;
    fx.textContent = `${money(num(spend))} ÷ ${num(customers).toLocaleString('en-US')} = ${r.value}`;
    // live visual: the selected vertical's range, with the visitor's CAC as the marker
    for (const v of views) {
      v.hidden = v.dataset.range !== vertical.value;
      const mk = v.querySelector<HTMLElement>('[data-marker]');
      if (mk) setLive(mk, r.cac ?? 0, r.value);
    }
  }
  [spend, customers, vertical].forEach((el) => el.addEventListener('input', calc));
  calc();
</script>

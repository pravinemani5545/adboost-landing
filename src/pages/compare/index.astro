---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import HubSpoke from '../../kit/diagram/HubSpoke.astro';
import { COMPARES } from '../../data/compare';
import { siteBase } from '../../lib/site';
import { breadcrumb } from '../../lib/schema';
import '../../styles/pages/reference.css';

const SITE = siteBase(Astro.site);
const title = 'AdBoost Health vs. Agencies, In-House & DTC Shops';
const description = 'How a health-specialist paid-acquisition partner compares to a full-service healthcare agency, an in-house team, or a generalist DTC agency.';
const jsonLd = [
  breadcrumb(SITE, [{ label: 'Home', href: '/' }, { label: 'Compare', href: '/compare/' }]),
  {
    '@type': 'CollectionPage',
    name: 'AdBoost Health compared to the alternatives',
    url: `${SITE}/compare/`,
    hasPart: COMPARES.map((c) => ({ '@type': 'WebPage', name: c.h1, url: `${SITE}/compare/${c.slug}/` })),
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: COMPARES.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.h1, url: `${SITE}/compare/${c.slug}/` })),
    },
  },
];

const inShort = 'A health-specialist paid-acquisition partner like AdBoost Health is usually the better fit than a full-service healthcare agency, an in-house team, or a generalist DTC shop when growth is bottlenecked by ad-platform compliance and CAC, because it pairs health-vertical policy expertise with performance media in one team. A full-service agency wins when you need brand, PR, and web under one roof; an in-house team wins at large, stable spend where dedicated headcount pays for itself; a generalist DTC agency can be cheaper when your category carries no compliance risk. The three breakdowns below go dimension by dimension.';

// The hub's sub-labels are the "In short" answer's own words for when each alternative wins.
const WINS: Record<string, string> = {
  'full-service-healthcare-agency-alternative': 'wins when you need brand, PR, and web under one roof',
  'in-house-growth-team-alternative': 'wins at large, stable spend',
  'generalist-dtc-agency-alternative': 'can be cheaper when your category carries no compliance risk',
};
for (const phrase of Object.values(WINS)) {
  if (!inShort.includes(phrase)) throw new Error(`[compare index] "${phrase}" is not in the "In short" answer`);
}
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const spokes = COMPARES.map((c) => ({
  label: c.themLabel,
  sub: WINS[c.slug] ? cap(WINS[c.slug]) : undefined,
  href: `/compare/${c.slug}/`,
}));
// HubSpoke needs three spokes; with fewer live comparisons the hero has no aside. (A slot inside
// an expression always counts as filled, so the hero is written twice.)
const hero = {
  crumbs: [{ label: 'Home', href: '/' }, { label: 'Compare' }],
  eyebrow: 'COMPARE',
  title: 'Weighing your <span class="serif">options?</span>',
  lede: 'An honest look at how a health-specialist acquisition partner compares to the alternatives, including when the alternative is the better call.',
  art: '/art/compare/hub',
  class: 'rf-hero rf-hero--hub',
};
---
<BaseLayout {title} {description} canonicalPath="/compare/" {jsonLd}>
  {spokes.length >= 3 ? (
    <PageHero {...hero}>
      <div slot="aside" class="rf-hero-hub k-card k-card--float">
        <HubSpoke
          arrive
          caption="The alternatives these breakdowns weigh against AdBoost Health, and when each one wins, in the words of the summary below."
          hub={{ label: 'AdBoost Health' }}
          spokes={spokes}
        />
      </div>
    </PageHero>
  ) : <PageHero {...hero} />}

  <section class="iwrap-sm">
    <div class="container">
      <div class="doc-main rf-inshort">
        <div class="answer-box"><span class="al">In short</span>{inShort}</div>
      </div>
    </div>
  </section>

  <section class="iwrap">
    <div class="container">
      <div class="grid-cards">
        {COMPARES.map((c) => (
          <a class="lcard" href={`/compare/${c.slug}/`}>
            <h2 class="rf-lcard-h">{c.h1}</h2>
            <p>{c.intent}</p>
            <span class="lc-more">See the comparison →</span>
          </a>
        ))}
      </div>

      <div class="prose rf-readme">
        <h2>How to read these comparisons</h2>
        <p>Each breakdown is written at the category level and kept honest: it names where the alternative is genuinely the better choice, not just where we win. The deciding factors are almost always the same three. First, compliance risk: regulated health, telehealth, GLP-1, and supplement brands live or die by ad-platform policy, which is where a <a href="/advertising/">health-specialist</a> earns its keep. Second, stage and spend: a dedicated in-house team pays off at large, stable budgets, while an agency de-risks the ramp. Third, scope: if you need brand, PR, and a website rebuild alongside media, a full-service shop consolidates that, whereas if the bottleneck is <a href="/glossary/cac/">CAC</a> and rejected ads, that is the specialist lane. See real outcomes by <a href="/industries/telehealth/">vertical</a>, or start with the <a href="/services/">services</a> that drive them.</p>
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

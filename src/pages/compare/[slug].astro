---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import Faq from '../../components/Faq.astro';
import { COMPARES, getCompare } from '../../data/compare';
import { siteBase } from '../../lib/site';
import { breadcrumb, faqPage } from '../../lib/schema';

export function getStaticPaths() {
  return COMPARES.map((c) => ({ params: { slug: c.slug } }));
}
const { slug } = Astro.params;
const c = getCompare(slug!)!;
const SITE = siteBase(Astro.site);
const path = `/compare/${c.slug}/`;
const title = c.h1.includes('AdBoost') ? c.h1 : `${c.h1} | AdBoost Health`;
const description = c.answer.slice(0, 155);
const jsonLd = [
  breadcrumb(SITE, [{ label: 'Home', href: '/' }, { label: 'Compare', href: '/compare/' }, { label: c.competitor, href: path }]),
  faqPage(c.faq),
];
---
<BaseLayout {title} {description} canonicalPath={path} {jsonLd} ogType="article">
  <section class="phero">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Compare', href: '/compare/' }, { label: c.competitor }]} />
      <h1 style="margin-top:16px">{c.h1}</h1>
      <p class="phero-lede">{c.intent}</p>
    </div>
  </section>

  <section class="iwrap-sm">
    <div class="container">
     <div class="doc-grid">
      <div class="doc-main">
      <div class="answer-box reveal"><span class="al">The short answer</span>{c.answer}</div>

      <div class="tablewrap reveal">
        <table class="dtable">
          <thead><tr><th></th><th>{c.competitor.replace(/^a /, '').replace(/^an /, '')}</th><th>AdBoost Health</th></tr></thead>
          <tbody>
            {c.rows.map((r) => (
              <tr><td class="row-h">{r.dimension}</td><td style="color:var(--mute)">{r.them}</td><td>{r.us}</td></tr>
            ))}
          </tbody>
        </table>
      </div>

      <h2 class="sec-title" style="margin-top:36px">Where each one focuses</h2>
      <p style="color:var(--ink-2);line-height:1.7"><strong>Them:</strong> {c.theirFocus}</p>
      <p style="color:var(--ink-2);line-height:1.7"><strong>Us:</strong> {c.ourDifference}</p>

      <div class="callout reveal">
        <span class="cl-label">When the other option is the better fit</span>
        {c.bestWhen}
      </div>

      <h2 class="sec-title" style="margin-top:36px">FAQ</h2>
      <div style="margin-top:16px"><Faq items={c.faq} idPrefix={`cmp-${c.slug}`} /></div>
      </div>
      <aside class="doc-aside">
        <div class="aside-card">
          <h4>Other comparisons</h4>
          <div class="link-list">
            {COMPARES.filter((x) => x.slug !== c.slug).map((x) => <a href={`/compare/${x.slug}/`}>{x.h1.replace('AdBoost Health vs. ', 'vs. ')}</a>)}
            <a href="/about/">Why health-only</a>
          </div>
        </div>
        <div class="aside-card dark">
          <h4 style="color:#fff">See if we’re the right fit</h4>
          <p>Free 30-minute call with a senior strategist - no pitch, just a plan.</p>
          <a class="btn btn-primary" href="https://cal.com/pira-ahilan-ef2dl8/strategy-call" target="_blank" rel="noopener">Book a call →</a>
        </div>
      </aside>
     </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

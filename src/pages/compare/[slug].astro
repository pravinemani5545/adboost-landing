---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Faq from '../../components/Faq.astro';
import Compare from '../../kit/diagram/Compare.astro';
import Timeline from '../../kit/diagram/Timeline.astro';
import Versus from './_Versus.astro';
import { COMPARES, getCompare } from '../../data/compare';
import { siteBase } from '../../lib/site';
import { pageDate } from '../../lib/live';
import { metaDescription, seoTitle } from '../../lib/seo';
import { breadcrumb, faqPage } from '../../lib/schema';
import '../../styles/pages/reference.css';

export function getStaticPaths() {
  return COMPARES.map((c) => ({ params: { slug: c.slug } }));
}
const { slug } = Astro.params;
const c = getCompare(slug!)!;
const SITE = siteBase(Astro.site);
const path = `/compare/${c.slug}/`;
const title = seoTitle(path, c.metaTitle);
const description = metaDescription(path, c.metaDescription);
// Content date: src/data/pages.json (sitemap lastmod, this label and dateModified).
const updated = pageDate(path);
const updatedLabel = updated && new Date(`${updated}T00:00:00Z`).toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const them = c.themLabel;
const themLower = them.charAt(0).toLowerCase() + them.slice(1);
const plain = (html: string) => html.replace(/<[^>]+>/g, '');
const jsonLd = [
  {
    '@type': 'WebPage',
    name: c.h1,
    description,
    url: `${SITE}${path}`,
    ...(updated ? { dateModified: updated } : {}),
    publisher: { '@id': `${SITE}/#org` },
  },
  breadcrumb(SITE, [{ label: 'Home', href: '/' }, { label: 'Compare', href: '/compare/' }, { label: c.competitor, href: path }]),
  faqPage([
    ...(c.questions ? c.questions.items.map((it) => ({ q: it.q, a: plain(it.a) })) : []),
    ...c.faq,
  ]),
  {
    '@type': 'ItemList',
    name: `${c.h1}: comparison dimensions`,
    url: `${SITE}${path}`,
    itemListElement: c.rows.map((r, i) => ({ '@type': 'ListItem', position: i + 1, name: r.dimension })),
  },
];
const toc = [
  { id: 'choose', label: 'Which to choose' },
  { id: 'compare', label: 'Side by side' },
  ...c.tradeoffs.map((t) => ({ id: t.id, label: t.q })),
  ...(c.questions ? [{ id: 'how-to-choose', label: 'Nine questions to ask' }] : []),
  { id: 'not-fit', label: 'When we are not the right fit' },
  { id: 'faq', label: 'FAQ' },
];

// Full-service page only (brief 5.5): the speed answer's three milestones on a day scale. The
// labels are that answer's own words; the build stops if the answer no longer says them.
let speedRail: { phases: { meta: string; label: string; start: number }[] } | undefined;
if (c.slug === 'full-service-healthcare-agency-alternative') {
  const speed = plain(c.tradeoffs.find((t) => t.id === 'speed')?.html ?? '');
  for (const phrase of ['setup takes 5 days', 'Most partners see directional movement on CAC or ROAS within two weeks', 'the full system compounds by day 31']) {
    if (!speed.includes(phrase)) throw new Error(`[compare] the speed answer no longer says "${phrase}"`);
  }
  speedRail = {
    phases: [
      { meta: '5 days', label: 'Setup', start: 5 },
      { meta: 'Within two weeks', label: 'Most partners see directional movement on CAC or ROAS', start: 14 },
      { meta: 'Day 31', label: 'The full system compounds', start: 31 },
    ],
  };
}
---
<BaseLayout {title} {description} canonicalPath={path} {jsonLd} ogType="article">
  <PageHero
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Compare', href: '/compare/' }, { label: c.competitor }]}
    title={c.h1}
    answer={c.answer}
    meta={['Published by AdBoost Health', ...(updatedLabel ? [`Updated ${updatedLabel}`] : [])]}
    class="rf-hero rf-hero--compare"
  >
    <div slot="aside" class="rf-hero-card k-card k-card--float">
      <Versus them={them} dimensions={c.rows.map((r) => r.dimension)} />
    </div>
  </PageHero>

  <section class="iwrap-sm">
    <div class="container">
     <div class="doc-grid">
      <div class="doc-main">
      <p class="rf-intent"><strong>Who this page is for:</strong> {c.intent}</p>

      <div class="prose">
        <h2 id="choose">Should you choose {themLower} or AdBoost Health?</h2>
        <div class="tablewrap">
          <table class="dtable rf-choose">
            <thead><tr><th>Choose {themLower} if</th><th>Choose AdBoost Health if</th></tr></thead>
            <tbody>
              <tr>
                <td><ul>{c.chooseThem.map((x) => <li>{x}</li>)}</ul></td>
                <td><ul>{c.chooseUs.map((x) => <li>{x}</li>)}</ul></td>
              </tr>
            </tbody>
          </table>
        </div>

        <h2 id="compare">How do they compare, side by side?</h2>
        <div class="rf-figure">
          <Compare
            variant="vs"
            caption={`${them} against AdBoost Health on each dimension. The table below holds the same rows.`}
            left={{ label: them, items: [] }}
            right={{ label: 'AdBoost Health', items: [] }}
            rows={c.rows.map((r) => ({ label: r.dimension, left: r.them, right: r.us }))}
          />
        </div>
        <div class="k-disclosure rf-tablemore">
          <details>
            <summary><span class="rf-tablemore__chev" aria-hidden="true"></span>Side by side as a table</summary>
            <div class="tablewrap">
              <table class="dtable">
                <thead><tr><th></th><th>{them}</th><th>AdBoost Health</th></tr></thead>
                <tbody>
                  {c.rows.map((r) => (
                    <tr><td class="row-h">{r.dimension}</td><td class="rf-them">{r.them}</td><td>{r.us}</td></tr>
                  ))}
                </tbody>
              </table>
            </div>
          </details>
        </div>
        <p><strong>Their focus:</strong> {c.theirFocus}</p>
        <p><strong>Ours:</strong> {c.ourDifference}</p>

        {c.tradeoffs.map((t) => (
          <>
            <h2 id={t.id}>{t.q}</h2>
            <Fragment set:html={t.html} />
            {t.id === 'speed' && speedRail && (
              <div class="rf-figure">
                <Timeline
                  variant="rail"
                  total={31}
                  caption="AdBoost Health’s first 31 days on a day scale, from the answer above: setup takes 5 days, most partners see directional movement within two weeks, and the full system compounds by day 31."
                  phases={speedRail.phases}
                />
              </div>
            )}
          </>
        ))}

        {c.questions && (
          <>
            <h2 id="how-to-choose">How do you choose a health growth agency? Nine questions to ask</h2>
            <p>{c.questions.intro}</p>
            {c.questions.items.map((it, i) => (
              <>
                <h3>{i + 1}. {it.q}</h3>
                <p set:html={it.a} />
                <div class="rf-qa" data-reveal>
                  <p class="rf-qa__card rf-qa__card--ok">
                    <span class="rf-qa__k"><span class="rf-qa__m" aria-hidden="true">✓</span>A strong answer</span>
                    <span class="rf-qa__v">{it.strong}</span>
                  </p>
                  <p class="rf-qa__card rf-qa__card--bad">
                    <span class="rf-qa__k"><span class="rf-qa__m" aria-hidden="true">✕</span>Red flag</span>
                    <span class="rf-qa__v">{it.flag}</span>
                  </p>
                </div>
              </>
            ))}
            <h3>The nine questions at a glance</h3>
            <div class="tablewrap">
              <table class="dtable">
                <thead><tr><th>#</th><th>Question</th><th>A strong answer</th><th>Red flag</th></tr></thead>
                <tbody>
                  {c.questions.items.map((it, i) => (
                    <tr><td>{i + 1}</td><td class="row-h">{it.q}</td><td>{it.strong}</td><td class="rf-them">{it.flag}</td></tr>
                  ))}
                </tbody>
              </table>
            </div>
          </>
        )}

        <h2 id="not-fit">When is AdBoost Health not the right fit?</h2>
        <p>{c.bestWhen}</p>
        <ul>{c.notFit.map((x) => <li>{x}</li>)}</ul>

        <h2 id="faq">Frequently asked questions</h2>
      </div>
      <div class="rf-faq"><Faq items={c.faq} idPrefix={`cmp-${c.slug}`} /></div>
      </div>
      <aside class="doc-aside">
        <div class="aside-toc">
          <div class="at-label">On this page</div>
          <ul>{toc.map((t) => <li><a href={`#${t.id}`}>{t.label}</a></li>)}</ul>
        </div>
        <div class="aside-card">
          <h2 class="rf-aside-h">Other comparisons</h2>
          <div class="link-list">
            {COMPARES.filter((x) => x.slug !== c.slug).map((x) => <a href={`/compare/${x.slug}/`}>{x.h1.replace('AdBoost Health vs. ', 'vs. ')}</a>)}
            {c.slug !== 'generalist-dtc-agency-alternative' && <a href="/compare/generalist-dtc-agency-alternative/#how-to-choose">How to choose a health growth agency</a>}
            <a href="/about/">Why health-only</a>
          </div>
        </div>
        <div class="aside-card dark">
          <h2 class="rf-aside-h">See if we’re the right fit</h2>
          <p>Free 30-minute call with a senior strategist: no pitch, just a plan.</p>
          <a class="btn btn-primary" href="/book/">Book a call →</a>
        </div>
      </aside>
     </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

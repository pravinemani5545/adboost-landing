---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import Brief from '../../components/doc/Brief.astro';
import AsideLinks from '../../components/doc/AsideLinks.astro';
import AsideCta from '../../components/doc/AsideCta.astro';
import Closing from '../../components/Closing.astro';
import Faq from '../../components/Faq.astro';
import { COMPARES, getCompare } from '../../data/compare';
import { siteBase } from '../../lib/site';
import { breadcrumb, faqPage } from '../../lib/schema';

export function getStaticPaths() {
  return COMPARES.map((c) => ({ params: { slug: c.slug } }));
}
const { slug } = Astro.params;
const c = getCompare(slug!)!;
const SITE = siteBase(Astro.site);
const path = `/compare/${c.slug}/`;
const title = c.metaTitle;
const description = c.answer.slice(0, 155);
const jsonLd = [
  breadcrumb(SITE, [{ label: 'Home', href: '/' }, { label: 'Compare', href: '/compare/' }, { label: c.competitor, href: path }]),
  faqPage(c.faq),
  {
    '@type': 'ItemList',
    name: `${c.h1}: comparison dimensions`,
    url: `${SITE}${path}`,
    itemListElement: c.rows.map((r, i) => ({ '@type': 'ListItem', position: i + 1, name: r.dimension })),
  },
];
---
<BaseLayout {title} {description} canonicalPath={path} {jsonLd} ogType="article">
  <PageHead label="Compare" labelHref="/compare/" title={c.h1} lede={c.intent} dots />

  <section class="tone-paper page-body" data-nav="paper">
    <div class="wrap doc">
      <div class="doc-main">
        <Brief label="The short answer">{c.answer}</Brief>

        <div class="table-wrap" data-reveal>
          <table class="table">
            <thead><tr><th><span class="sr-only">Dimension</span></th><th>{c.competitor.replace(/^a /, '').replace(/^an /, '')}</th><th class="us">AdBoost Health</th></tr></thead>
            <tbody>
              {c.rows.map((r) => (
                <tr><td class="row-h">{r.dimension}</td><td>{r.them}</td><td class="us">{r.us}</td></tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="doc-sec">
          <h2>Where each one focuses</h2>
          <p><strong>Them:</strong> {c.theirFocus}</p>
          <p><strong>Us:</strong> {c.ourDifference}</p>
          <div class="note" data-reveal>
            <p class="label">When the other option is the better fit</p>
            <p>{c.bestWhen}</p>
          </div>
        </div>

        <div class="doc-sec" id="faq">
          <h2>FAQ</h2>
          <Faq items={c.faq} />
        </div>
      </div>
      <aside class="doc-aside">
        <AsideLinks
          label="Other comparisons"
          links={[...COMPARES.filter((x) => x.slug !== c.slug).map((x) => ({ href: `/compare/${x.slug}/`, label: x.h1.replace('AdBoost Health vs. ', 'vs. ') })), { href: '/about/', label: 'Why health-only' }]}
        />
        <AsideCta heading="See if we’re the right fit" text="Free 30-minute call with a senior strategist: no pitch, just a plan." />
      </aside>
    </div>
  </section>

  <Closing />
</BaseLayout>

<style>
  .doc-sec strong { color: var(--fg); font-weight: 500; }
</style>

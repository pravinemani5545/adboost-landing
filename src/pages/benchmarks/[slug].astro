---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import Faq from '../../components/Faq.astro';
import { VERTICALS, getVertical } from '../../data/verticals';
import { getPlaybook } from '../../data/vertical-playbooks';
import { siteBase } from '../../lib/site';
import { breadcrumb, faqPage, datasetNode } from '../../lib/schema';

export function getStaticPaths() {
  return VERTICALS.map((v) => ({ params: { slug: v.slug } }));
}

const { slug } = Astro.params;
const v = getVertical(slug!)!;
const pb = getPlaybook(v.slug);
const SITE = siteBase(Astro.site);
const path = `/benchmarks/${v.slug}/`;
const title = `${v.short} CAC Benchmarks 2026: What Brands Really Pay | AdBoost Health`;
const description = `${v.short} CAC benchmarks for 2026 — typical acquisition cost ${v.cacDisplay}, with ROAS, LTV and payback context. ${v.costDriver.slice(0, 70)}`;
const updated = '2026-07-01';
const jsonLd = [
  datasetNode(SITE, { name: `${v.short} CAC benchmarks 2026`, description: v.benchLede, path, dateModified: updated }),
  breadcrumb(SITE, [{ label: 'Home', href: '/' }, { label: 'Benchmarks', href: '/benchmarks/' }, { label: v.short, href: path }]),
  faqPage(v.faq),
];
---
<BaseLayout {title} {description} canonicalPath={path} {jsonLd} ogType="article">
  <section class="phero">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Benchmarks', href: '/benchmarks/' }, { label: v.short }]} />
      <span class="eyebrow sec-eyebrow" style="display:block;margin-top:16px"><span class="dot"></span>{v.category} · 2026</span>
      <h1>{v.short} CAC benchmarks</h1>
      <p class="phero-lede">{v.benchLede}</p>
      <div class="metabar"><span>Updated July 2026</span><span class="dot"></span><span>Fully-loaded CAC · USD</span></div>
    </div>
  </section>

  <section class="iwrap">
    <div class="container">
      <div class="doc-grid">
        <div class="doc-main">
          <div class="answer-box reveal">
            <span class="al">What’s a good CAC for {v.short.toLowerCase()}?</span>
            Typical fully-loaded CAC runs <strong>{v.cacDisplay}</strong>. {v.goodVsConcerning}
          </div>
          <div class="prose">
            <h2 id="table">The benchmark table</h2>
            <div class="tablewrap">
              <table class="dtable">
                <thead><tr><th>Metric</th><th class="num">2026 benchmark</th><th>Notes</th></tr></thead>
                <tbody>
                  {v.rows.map((r) => (
                    <tr><td class="row-h">{r.label}</td><td class="num">{r.value}</td><td style="color:var(--mute)">{r.note ?? ''}</td></tr>
                  ))}
                </tbody>
              </table>
            </div>

            <h2 id="why">Why {v.short.toLowerCase()} CAC lands where it does</h2>
            <p>{v.costDriver}</p>

            {pb && (
              <>
                <h2 id="improve">What good looks like — and how to get there</h2>
                <ul class="checks">
                  {pb.whatGoodLooksLike.map((k) => (
                    <li><span class="ck"><svg width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M5 12l4.5 4.5L19 7" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>{k}</li>
                  ))}
                </ul>
                <p>The fastest levers to close the gap in {v.short.toLowerCase()}: <a href={`/industries/${v.slug}/`}>see the full growth playbook →</a></p>
              </>
            )}

            <div class="callout"><span class="cl-label">The compliance angle</span>{v.adLandmine} <a href="/guides/health-ad-compliance/">See the full compliance guide →</a></div>

            <h2 id="faq">Frequently asked</h2>
            <Faq items={v.faq} idPrefix={`bench-${v.slug}`} />

            <h3>Sources & methodology</h3>
            <p style="font-size:14px;color:var(--mute)">Figures are triangulated across public 2025–2026 sources and blended agency data; they reflect fully-loaded CAC (cost per paying customer/patient), not cost-per-lead. Ranges are directional — verify against your own account before planning spend.</p>
            <ul style="font-size:14px">
              {v.sources.map((s) => <li><a href={s.url} target="_blank" rel="noopener nofollow">{s.label}</a></li>)}
            </ul>
          </div>
        </div>

        <aside class="doc-aside">
          <div class="aside-card">
            <h4>Benchmark your own numbers</h4>
            <div class="link-list">
              <a href="/tools/cac-calculator/">CAC calculator</a>
              <a href="/tools/ltv-cac-calculator/">LTV:CAC calculator</a>
              <a href="/tools/ad-budget-calculator/">Ad budget calculator</a>
              <a href={`/industries/${v.slug}/`}>{v.short} playbook</a>
              <a href="/benchmarks/">All benchmarks</a>
            </div>
          </div>
          <div class="aside-card dark">
            <h4 style="color:#fff">How does your CAC compare?</h4>
            <p>Free audit — we benchmark your account against this vertical and map the fastest levers.</p>
            <a class="btn btn-primary" href="https://cal.com/pira-ahilan-ef2dl8/strategy-call" target="_blank" rel="noopener">Book a call →</a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <CtaBand heading={`See how your ${v.short.toLowerCase()} CAC really compares`} text="Book a free audit — we’ll benchmark your account against your vertical and map the fastest levers to close the gap." />
</BaseLayout>

---
// Gauge: a half dial with role="meter". Bands and ticks come from the page's own copy.
// The value is the CSS custom property --k-v on the meter element, so a calculator can
// move the needle and fill without re-rendering: setLive(id, value, display) from
// ./live.ts sets --k-v, the readout text, aria-valuenow and aria-valuetext.
// Tick labels and the band legend sit outside the meter (its children are presentational).
import Figure from './Figure.astro';
import type { GaugeProps } from './types';
import { fail, r4 } from './util';

type Props = GaugeProps;
const { value, min, max, display, valueText, bands = [], ticks = [], live, label, ...base } = Astro.props;
if (!(max > min)) fail('gauge', base.caption, 'max must be greater than min');

const CX = 130;
const CY = 122;
const R = 96;
const norm = (v: number) => Math.min(1, Math.max(0, (v - min) / (max - min)));
const pt = (p: number, r = R) => ({ x: r4(CX - r * Math.cos(Math.PI * p)), y: r4(CY - r * Math.sin(Math.PI * p)) });
const arc = (p1: number, p2: number, r = R) => {
  const a = pt(p1, r);
  const b = pt(p2, r);
  return `M ${a.x} ${a.y} A ${r} ${r} 0 0 1 ${b.x} ${b.y}`;
};
let from = min;
const bandArcs = bands.map((b) => {
  const d = arc(norm(from), norm(b.to), R + 15);
  from = b.to;
  return { ...b, d };
});
const tickMarks = ticks.map((t) => {
  const p = norm(t.at);
  const a = pt(p, R - 11);
  const b = pt(p, R + 9);
  const l = pt(p, R + 30);
  return { ...t, a, b, x: r4((l.x / 260) * 100), y: r4((l.y / 140) * 100), side: p < 0.4 ? 'l' : p > 0.6 ? 'r' : 'c' };
});
const pExpr = `clamp(0, (var(--k-v) - ${min}) / ${max - min}, 1)`;
---
<Figure {...base} kind="gauge">
  <div class="dg-gauge">
    <div class="dg-dial">
      <div
        class="dg-meter"
        id={live}
        role="meter"
        aria-valuemin={min}
        aria-valuemax={max}
        aria-valuenow={value}
        aria-valuetext={valueText ?? display}
        aria-label={label ?? base.caption}
        style={`--k-v:${value};--p:${pExpr}`}
      >
        <svg viewBox="0 0 260 140" aria-hidden="true" focusable="false">
          {bandArcs.map((b) => <path class="dg-band" data-level={b.tone} d={b.d} />)}
          <path class="dg-track" d={arc(0, 1)} />
          <path class="dg-fill" d={arc(0, 1)} pathLength="1" />
          {tickMarks.map((t) => <line class="dg-tickline" x1={t.a.x} y1={t.a.y} x2={t.b.x} y2={t.b.y} />)}
          <g class="dg-needle">
            <line x1={CX} y1={CY} x2={CX - R + 22} y2={CY} />
          </g>
          <circle class="dg-hub" cx={CX} cy={CY} r="7" />
        </svg>
        <p class="dg-read">
          {label && <span class="dg-rlabel">{label}</span>}
          <span class="dg-rval" data-live-text>{display}</span>
        </p>
      </div>
      {tickMarks.length > 0 && (
        <ul class="dg-ticks">
          {tickMarks.map((t) => <li class="dg-tick" data-side={t.side} style={`--x:${t.x}%;--y:${t.y}%`}>{t.label}</li>)}
        </ul>
      )}
    </div>
    {bandArcs.length > 0 && (
      <ul class="dg-legend">
        {bandArcs.map((b) => <li data-level={b.tone}><span class="dg-sw" aria-hidden="true"></span>{b.label}</li>)}
      </ul>
    )}
  </div>
</Figure>

<style>
  .dg-gauge { display: grid; gap: 14px; justify-items: center; }
  .dg-dial { position: relative; width: 100%; max-width: 420px; padding-inline: 8%; box-sizing: border-box; }
  .dg-meter { display: grid; justify-items: center; gap: 4px; }
  svg { width: 100%; height: auto; aspect-ratio: 260 / 140; overflow: visible; display: block; }
  [data-level] { --tone-fill: var(--dg-accent-fill); --tone-ink: var(--dg-accent); }
  [data-level="ok"] { --tone-fill: var(--dg-ok-fill); --tone-ink: var(--dg-ok); }
  [data-level="warn"] { --tone-fill: var(--dg-warn-fill); --tone-ink: var(--dg-warn); }
  [data-level="bad"] { --tone-fill: var(--dg-bad-fill); --tone-ink: var(--dg-bad); }
  [data-level="muted"] { --tone-fill: var(--dg-muted-fill); --tone-ink: var(--dg-muted); }
  .dg-band { fill: none; stroke: var(--tone-fill); stroke-width: 6; opacity: 0.85; }
  .dg-track { fill: none; stroke: var(--dg-muted-soft); stroke-width: 16; stroke-linecap: round; }
  .dg-fill {
    fill: none;
    stroke: var(--dg-accent-fill);
    stroke-width: 16;
    stroke-linecap: round;
    stroke-dasharray: 1 1;
    stroke-dashoffset: calc(1 - var(--p));
    filter: drop-shadow(0 4px 10px var(--dg-glow));
    transition: stroke-dashoffset var(--k-t-snap) var(--k-spring-snap);
  }
  .dg-tickline { stroke: var(--dg-fg-3); stroke-width: 2; stroke-linecap: round; }
  .dg-needle {
    transform-box: view-box;
    transform-origin: 50% 87.1429%;
    transform: rotate(calc(var(--p) * 180deg));
    transition: transform var(--k-t-snap) var(--k-spring-snap);
  }
  .dg-needle line { stroke: var(--dg-fg); stroke-width: 3.5; stroke-linecap: round; }
  .dg-hub { fill: var(--dg-fg); stroke: var(--dg-card); stroke-width: 3; }
  .dg-read {
    margin: 0;
    display: grid;
    justify-items: center;
    gap: 0;
    text-align: center;
    white-space: nowrap;
  }
  .dg-rlabel { font-family: var(--k-font-mono); font-size: var(--k-fs-micro); letter-spacing: var(--k-ls-mono); text-transform: uppercase; color: var(--dg-fg-3); }
  .dg-rval { font-size: clamp(22px, 8cqi, 34px); font-weight: var(--k-fw-display); letter-spacing: -0.02em; line-height: 1.1; color: var(--dg-fg); font-variant-numeric: tabular-nums; }
  .dg-ticks { list-style: none; margin: 0; padding: 0; position: absolute; top: 0; left: 8%; right: 8%; aspect-ratio: 260 / 140; pointer-events: none; }
  .dg-tick {
    position: absolute;
    left: var(--x);
    top: var(--y);
    translate: -50% -50%;
    font-family: var(--k-font-mono);
    font-size: var(--k-fs-micro);
    font-weight: 500;
    color: var(--dg-fg-2);
    white-space: nowrap;
  }
  .dg-tick[data-side="l"] { translate: -80% -50%; }
  .dg-tick[data-side="r"] { translate: -20% -50%; }
  .dg-legend { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 14px; font-size: var(--k-fs-small); color: var(--dg-fg-2); }
  .dg-legend li { display: inline-flex; align-items: center; gap: 6px; }
  .dg-sw { width: 14px; height: 6px; border-radius: 3px; background: var(--tone-fill); }

  :global(html.js.motion [data-dg-anim]) .dg-fill { animation: k-dg-g-fill var(--k-d-draw) var(--k-ease-out) backwards; animation-delay: calc(var(--dg-base) + 200ms); }
  :global(html.js.motion [data-dg-anim]) .dg-needle { animation: k-dg-g-needle var(--k-d-draw) var(--k-spring-soft) backwards; animation-delay: calc(var(--dg-base) + 200ms); }
  :global(html.js.motion [data-dg-anim]) .dg-band { animation: k-dg-g-band var(--k-d-slow) var(--k-ease-out) backwards; animation-delay: var(--dg-base); }
  :global(html.js.motion [data-dg-anim]:not(.in)) :is(.dg-fill, .dg-needle, .dg-band) { animation-play-state: paused; }

  @keyframes k-dg-g-fill { from { stroke-dashoffset: 1; } }
  @keyframes k-dg-g-needle { from { transform: rotate(0deg); } }
  @keyframes k-dg-g-band { from { opacity: 0; } }
</style>

---
// Matrix2: a 2x2 on two named axes. Quadrants are a list; each carries its axis
// position as hidden text, so it reads without the drawing.
// cells order: [high y + low x, high y + high x, low y + low x, low y + high x].
import Figure from './Figure.astro';
import type { Matrix2Props } from './types';
import { fail, internal } from './util';

type Props = Matrix2Props;
const { x, y, cells, ...base } = Astro.props;
if (cells?.length !== 4) fail('matrix2', base.caption, 'needs exactly 4 cells');
cells.forEach((c) => internal(c.href, `matrix2 "${c.label}"`));
const pos = [
  [y.high, x.low],
  [y.high, x.high],
  [y.low, x.low],
  [y.low, x.high],
];
const order = [2, 0, 3, 1]; // draw from the origin outwards
---
<Figure {...base} kind="matrix2">
  <div class="dg-m2">
    <p class="dg-ylab"><span class="dg-arrow" aria-hidden="true"></span>{y.label}</p>
    <div class="dg-plot">
      <span class="dg-yaxis" aria-hidden="true"></span>
      <span class="dg-xaxis" aria-hidden="true"></span>
      <ul class="dg-quads">
        {cells.map((c, i) => {
          const Tag = c.href && !c.current ? 'a' : 'div';
          return (
            <li class="dg-q" data-level={c.tone} aria-current={c.current ? 'true' : undefined} style={`--i:${order.indexOf(i)}`}>
              <Tag class="dg-qcard" href={Tag === 'a' ? c.href : undefined}>
                <span class="k-vh">{y.label}: {pos[i][0]}. {x.label}: {pos[i][1]}.</span>
                <span class="dg-ql">{c.label}</span>
                {c.detail && <span class="dg-qd">{c.detail}</span>}
              </Tag>
            </li>
          );
        })}
      </ul>
      <span class="dg-tick dg-yhi" aria-hidden="true">{y.high}</span>
      <span class="dg-tick dg-ylo" aria-hidden="true">{y.low}</span>
      <span class="dg-tick dg-xlo" aria-hidden="true">{x.low}</span>
      <span class="dg-tick dg-xhi" aria-hidden="true">{x.high}</span>
    </div>
    <p class="dg-xlab">{x.label}<span class="dg-arrow" aria-hidden="true"></span></p>
  </div>
</Figure>

<style>
  .dg-m2 { display: grid; gap: 8px; }
  .dg-ylab, .dg-xlab {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--k-font-mono);
    font-size: var(--k-fs-micro);
    font-weight: 500;
    letter-spacing: var(--k-ls-mono);
    text-transform: uppercase;
    color: var(--dg-fg-2);
  }
  .dg-xlab { justify-content: flex-end; }
  .dg-arrow { width: 7px; height: 7px; border-top: 2px solid currentColor; border-right: 2px solid currentColor; }
  .dg-ylab .dg-arrow { transform: rotate(-45deg) translate(-1px, 2px); }
  .dg-xlab .dg-arrow { transform: rotate(45deg); }

  .dg-plot {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr) auto;
    grid-template-areas: 'ticks-y quads' '. ticks-x';
    column-gap: 8px;
    row-gap: 6px;
  }
  .dg-quads {
    grid-area: quads;
    list-style: none;
    margin: 0;
    padding: 10px 0 0 10px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    position: relative;
  }
  .dg-yaxis, .dg-xaxis { position: absolute; background: var(--dg-line-2); border-radius: 2px; }
  .dg-yaxis { grid-area: quads; left: 0; top: 0; bottom: 0; width: 2px; transform-origin: bottom; position: relative; justify-self: start; }
  .dg-xaxis { grid-area: quads; left: 0; right: 0; bottom: 0; height: 2px; transform-origin: left; position: relative; align-self: end; }
  .dg-tick { font-size: var(--k-fs-micro); font-family: var(--k-font-mono); letter-spacing: 0.04em; color: var(--dg-fg-3); }
  .dg-yhi, .dg-ylo { grid-area: ticks-y; writing-mode: vertical-rl; transform: rotate(180deg); text-align: center; }
  .dg-yhi { align-self: start; margin-top: 10px; }
  .dg-ylo { align-self: end; }
  .dg-xlo, .dg-xhi { grid-area: ticks-x; }
  .dg-xlo { justify-self: start; margin-left: 10px; }
  .dg-xhi { justify-self: end; }

  .dg-q {
    --tone-ink: var(--dg-accent);
    --tone-fill: var(--dg-accent-fill);
    --tone-soft: var(--dg-card);
    min-width: 0;
  }
  .dg-q[data-level="accent"] { --tone-soft: var(--dg-accent-soft); }
  .dg-q[data-level="ok"] { --tone-ink: var(--dg-ok); --tone-fill: var(--dg-ok-fill); --tone-soft: var(--dg-ok-soft); }
  .dg-q[data-level="warn"] { --tone-ink: var(--dg-warn); --tone-fill: var(--dg-warn-fill); --tone-soft: var(--dg-warn-soft); }
  .dg-q[data-level="bad"] { --tone-ink: var(--dg-bad); --tone-fill: var(--dg-bad-fill); --tone-soft: var(--dg-bad-soft); }
  .dg-q[data-level="muted"] { --tone-ink: var(--dg-muted); --tone-fill: var(--dg-muted-fill); --tone-soft: var(--dg-muted-soft); }
  .dg-qcard {
    height: 100%;
    min-height: 92px;
    display: grid;
    align-content: start;
    gap: 4px;
    padding: 14px;
    border-radius: var(--k-r-md);
    background: var(--tone-soft);
    border: 1px solid var(--dg-card-line);
    color: inherit;
    text-decoration: none;
    box-shadow: var(--k-e1);
  }
  .dg-ql { font-weight: 600; color: var(--tone-ink); line-height: var(--k-lh-snug); }
  .dg-q:not([data-level]) .dg-ql { color: var(--dg-fg); }
  .dg-qd { font-size: var(--k-fs-small); color: var(--dg-fg-3); line-height: var(--k-lh-snug); }
  .dg-q[data-level] .dg-qd { color: var(--dg-fg-2); } /* AA on a tinted quadrant */
  a.dg-qcard[href] { color: inherit; text-decoration: none; }
  a.dg-qcard { transition: transform var(--k-t-snap) var(--k-spring-snap), box-shadow var(--k-d-base) var(--k-ease); }
  a.dg-qcard:hover { transform: translateY(-2px); box-shadow: var(--k-e2); }
  .dg-q[aria-current] .dg-qcard { box-shadow: 0 0 0 2px var(--dg-ring), var(--dg-raised); }
  @container k-dg (min-width: 520px) {
    .dg-qcard { min-height: 120px; padding: 18px; }
    .dg-quads { gap: 12px; padding: 14px 0 0 14px; }
  }

  :global(html.js.motion [data-dg-anim]) .dg-qcard {
    animation: k-dg-m2-in var(--k-t-soft) var(--k-spring-soft) backwards;
    animation-delay: calc(var(--dg-base) + 260ms + var(--i) * 2 * var(--k-stagger));
  }
  :global(html.js.motion [data-dg-anim]) .dg-yaxis { animation: k-dg-m2-y var(--k-d-slow) var(--k-ease-out) backwards; animation-delay: var(--dg-base); }
  :global(html.js.motion [data-dg-anim]) .dg-xaxis { animation: k-dg-m2-x var(--k-d-slow) var(--k-ease-out) backwards; animation-delay: var(--dg-base); }
  :global(html.js.motion [data-dg-anim]:not(.in)) :is(.dg-qcard, .dg-yaxis, .dg-xaxis) { animation-play-state: paused; }

  @keyframes k-dg-m2-in { from { transform: scale(0.9) translateY(6px); } }
  @keyframes k-dg-m2-y { from { transform: scaleY(0); } }
  @keyframes k-dg-m2-x { from { transform: scaleX(0); } }
</style>

---
// HubSpoke: a hub with 3 to 8 spokes on a ring, optional labels on the links between
// neighbouring spokes (the services triangle). Wide containers place the cards on the
// ring over an aria-hidden SVG of links; narrow ones fall back to a list with a rail.
// Edge labels carry the two spoke names as text, visible in the list layout.
import Figure from './Figure.astro';
import type { HubSpokeProps } from './types';
import { fail, internal, r4 } from './util';

type Props = HubSpokeProps;
const { hub, spokes, edges, ...base } = Astro.props;
const n = spokes?.length ?? 0;
if (n < 3 || n > 8) fail('hubspoke', base.caption, `needs 3 to 8 spokes (got ${n})`);
if (edges && edges.length !== n) fail('hubspoke', base.caption, `edges needs one label per spoke pair (${n}), got ${edges.length}`);
spokes.forEach((s) => internal(s.href, `hubspoke "${s.label}"`));

const cx = 50;
const cy = n === 3 ? 54 : 50;
const rx = n <= 4 ? 36 : 38;
const ry = n === 3 ? 42 : 40;
const pts = spokes.map((_, i) => {
  const a = (-90 + (i * 360) / n) * (Math.PI / 180);
  return { x: r4(cx + rx * Math.cos(a)), y: r4(cy + ry * Math.sin(a)) };
});
const edgePts = (edges ?? []).map((_, i) => {
  const p = pts[i];
  const q = pts[(i + 1) % n];
  const mx = (p.x + q.x) / 2;
  const my = (p.y + q.y) / 2;
  const vx = mx - cx;
  const vy = my - cy;
  const len = Math.hypot(vx, vy) || 1;
  const k = (len + 4) / len;
  return { x: r4(cx + vx * k), y: r4(cy + vy * k), mx: r4(mx), my: r4(my) };
});
const fit = n <= 4 ? 'sm' : n <= 6 ? 'md' : 'lg';
---
<Figure {...base} kind="hubspoke">
  <div class="dg-hs" data-fit={fit} data-edges={edges ? '' : undefined} style={`--n:${n};--cy:${cy}`}>
    <svg class="dg-wires" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      {pts.map((p, i) => (
        <line class="dg-spokeline" x1={cx} y1={cy} x2={p.x} y2={p.y} style={`--i:${i};transform-origin:${cx}% ${cy}%`} />
      ))}
      {edges && pts.map((p, i) => {
        const q = pts[(i + 1) % n];
        return <line class="dg-edgeline" x1={p.x} y1={p.y} x2={q.x} y2={q.y} style={`--i:${i};transform-origin:${p.x}% ${p.y}%`} />;
      })}
    </svg>
    <p class="dg-hub">
      <span class="dg-hl">{hub.label}</span>
      {hub.sub && <span class="dg-hsub">{hub.sub}</span>}
    </p>
    <ul class="dg-spokes">
      {spokes.map((s, i) => {
        const Tag = s.href ? 'a' : 'span';
        return (
          <li class="dg-spoke" style={`--i:${i};--x:${pts[i].x}%;--y:${pts[i].y}%`}>
            <Tag class="dg-scard" href={s.href}>
              <span class="dg-sl">{s.label}</span>
              {s.sub && <span class="dg-ss">{s.sub}</span>}
            </Tag>
          </li>
        );
      })}
    </ul>
    {edges && (
      <ul class="dg-edges">
        {edges.map((e, i) => (
          <li class="dg-edge" style={`--i:${i};--x:${edgePts[i].x}%;--y:${edgePts[i].y}%`}>
            <span class="dg-pair">{spokes[i].label} · {spokes[(i + 1) % n].label}</span>
            <span class="dg-el">{e}</span>
          </li>
        ))}
      </ul>
    )}
  </div>
</Figure>

<style>
  /* list layout (narrow) */
  .dg-hs { position: relative; display: grid; gap: 12px; }
  .dg-wires { display: none; }
  .dg-hub {
    margin: 0;
    display: grid;
    gap: 2px;
    justify-items: start;
    padding: 14px 16px;
    border-radius: var(--k-r-md);
    background: var(--dg-accent-fill);
    color: var(--k-accent-on);
    box-shadow: 0 14px 30px -14px var(--dg-glow), var(--k-e1);
  }
  .dg-hl { font-weight: 600; line-height: var(--k-lh-tight); }
  .dg-hsub { font-size: var(--k-fs-small); }
  .dg-spokes, .dg-edges { list-style: none; margin: 0; padding: 0 0 0 22px; display: grid; gap: 8px; position: relative; }
  .dg-spokes::before { content: ''; position: absolute; left: 8px; top: -12px; bottom: 22px; width: 2px; background: var(--dg-line-2); border-radius: 2px; transform-origin: top; }
  .dg-spoke { position: relative; }
  .dg-spoke::before { content: ''; position: absolute; left: -14px; top: 22px; width: 12px; height: 2px; background: var(--dg-line-2); }
  .dg-scard {
    display: grid;
    gap: 2px;
    padding: 11px 14px;
    border-radius: var(--k-r-md);
    background: var(--dg-card);
    border: 1px solid var(--dg-card-line);
    box-shadow: var(--k-e1);
    color: inherit;
    text-decoration: none;
  }
  .dg-sl { font-weight: 600; line-height: var(--k-lh-snug); color: var(--dg-fg); }
  .dg-ss { font-size: var(--k-fs-small); color: var(--dg-fg-3); line-height: var(--k-lh-snug); }
  a.dg-scard[href] { color: inherit; text-decoration: none; }
  a.dg-scard { transition: transform var(--k-t-snap) var(--k-spring-snap), box-shadow var(--k-d-base) var(--k-ease), border-color var(--k-d-base) var(--k-ease); }
  a.dg-scard:hover { transform: translateY(-2px); box-shadow: var(--k-e2); border-color: var(--dg-line-2); }
  a.dg-scard .dg-sl { text-decoration: underline; text-decoration-color: color-mix(in srgb, currentColor 30%, transparent); text-underline-offset: 3px; }
  .dg-edges { padding-left: 0; }
  .dg-edge {
    display: grid;
    gap: 2px;
    padding: 9px 12px;
    border-radius: var(--k-r-sm);
    border: 1px dashed var(--dg-line-2);
    font-size: var(--k-fs-small);
    line-height: var(--k-lh-snug);
    color: var(--dg-fg-2);
  }
  .dg-pair { font-family: var(--k-font-mono); font-size: var(--k-fs-micro); letter-spacing: 0.06em; color: var(--dg-accent); }

  /* ring layout (wide) */
  .dg-hs[data-fit] > * { min-width: 0; }
  @container k-dg (min-width: 500px) {
    .dg-hs[data-fit="sm"] { display: block; aspect-ratio: 10 / 7; }
    .dg-hs[data-fit="sm"][data-edges] { aspect-ratio: 10 / 7.2; }
    .dg-hs[data-fit="sm"] .dg-wires { display: block; position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
    .dg-hs[data-fit="sm"] .dg-hub { position: absolute; left: 50%; top: calc(var(--cy) * 1%); width: min(26%, 210px); translate: -50% -50%; justify-items: center; text-align: center; z-index: 2; }
    .dg-hs[data-fit="sm"] .dg-spokes, .dg-hs[data-fit="sm"] .dg-edges { position: static; padding: 0; display: block; }
    .dg-hs[data-fit="sm"] .dg-spokes::before, .dg-hs[data-fit="sm"] .dg-spoke::before { display: none; }
    .dg-hs[data-fit="sm"] :is(.dg-spoke, .dg-edge) { position: absolute; left: var(--x); top: var(--y); translate: -50% -50%; z-index: 2; }
    .dg-hs[data-fit="sm"] .dg-spoke { width: min(30%, 220px); }
    .dg-hs[data-fit="sm"] .dg-scard { text-align: center; justify-items: center; }
    .dg-hs[data-fit="sm"] .dg-edge { width: min(26%, 200px); text-align: center; background: var(--dg-card); border-style: solid; border-color: var(--dg-line); box-shadow: var(--k-e1); z-index: 1; }
    .dg-hs[data-fit="sm"] .dg-pair { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  }
  @container k-dg (min-width: 640px) {
    .dg-hs[data-fit="md"] { display: block; aspect-ratio: 10 / 7.4; }
    .dg-hs[data-fit="md"] .dg-wires { display: block; position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
    .dg-hs[data-fit="md"] .dg-hub { position: absolute; left: 50%; top: calc(var(--cy) * 1%); width: min(24%, 200px); translate: -50% -50%; justify-items: center; text-align: center; z-index: 2; }
    .dg-hs[data-fit="md"] .dg-spokes, .dg-hs[data-fit="md"] .dg-edges { position: static; padding: 0; display: block; }
    .dg-hs[data-fit="md"] .dg-spokes::before, .dg-hs[data-fit="md"] .dg-spoke::before { display: none; }
    .dg-hs[data-fit="md"] :is(.dg-spoke, .dg-edge) { position: absolute; left: var(--x); top: var(--y); translate: -50% -50%; z-index: 2; }
    .dg-hs[data-fit="md"] .dg-spoke { width: min(25%, 200px); }
    .dg-hs[data-fit="md"] .dg-scard { text-align: center; justify-items: center; }
    .dg-hs[data-fit="md"] .dg-edge { width: min(22%, 180px); text-align: center; background: var(--dg-card); border-style: solid; border-color: var(--dg-line); box-shadow: var(--k-e1); z-index: 1; }
    .dg-hs[data-fit="md"] .dg-pair { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  }
  @container k-dg (min-width: 760px) {
    .dg-hs[data-fit="lg"] { display: block; aspect-ratio: 10 / 7.4; }
    .dg-hs[data-fit="lg"] .dg-wires { display: block; position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
    .dg-hs[data-fit="lg"] .dg-hub { position: absolute; left: 50%; top: calc(var(--cy) * 1%); width: min(22%, 200px); translate: -50% -50%; justify-items: center; text-align: center; z-index: 2; }
    .dg-hs[data-fit="lg"] .dg-spokes, .dg-hs[data-fit="lg"] .dg-edges { position: static; padding: 0; display: block; }
    .dg-hs[data-fit="lg"] .dg-spokes::before, .dg-hs[data-fit="lg"] .dg-spoke::before { display: none; }
    .dg-hs[data-fit="lg"] :is(.dg-spoke, .dg-edge) { position: absolute; left: var(--x); top: var(--y); translate: -50% -50%; z-index: 2; }
    .dg-hs[data-fit="lg"] .dg-spoke { width: min(21%, 180px); }
    .dg-hs[data-fit="lg"] .dg-scard { text-align: center; justify-items: center; padding: 10px 12px; }
    .dg-hs[data-fit="lg"] .dg-edge { width: min(20%, 170px); text-align: center; background: var(--dg-card); border-style: solid; border-color: var(--dg-line); box-shadow: var(--k-e1); z-index: 1; }
    .dg-hs[data-fit="lg"] .dg-pair { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  }
  .dg-wires line { vector-effect: non-scaling-stroke; stroke-linecap: round; transform-box: view-box; }
  .dg-spokeline { stroke: var(--dg-line-2); stroke-width: 1.5; }
  .dg-edgeline { stroke: var(--dg-accent-fill); stroke-width: 1.5; stroke-dasharray: 5 5; opacity: 0.7; }

  /* motion: hub, links from the hub, spokes, then edges and their labels */
  :global(html.js.motion [data-dg-anim]) .dg-hub { animation: k-dg-hs-pop var(--k-t-bounce) var(--k-spring-bounce) backwards; animation-delay: var(--dg-base); }
  :global(html.js.motion [data-dg-anim]) .dg-spokeline { animation: k-dg-hs-draw var(--k-d-slow) var(--k-ease-out) backwards; animation-delay: calc(var(--dg-base) + 160ms + var(--i) * var(--k-stagger)); }
  :global(html.js.motion [data-dg-anim]) .dg-scard { animation: k-dg-hs-pop var(--k-t-soft) var(--k-spring-soft) backwards; animation-delay: calc(var(--dg-base) + 380ms + var(--i) * var(--k-stagger)); }
  :global(html.js.motion [data-dg-anim]) .dg-edgeline { animation: k-dg-hs-draw var(--k-d-slow) var(--k-ease-out) backwards; animation-delay: calc(var(--dg-base) + 760ms + var(--i) * 140ms); }
  :global(html.js.motion [data-dg-anim]) .dg-edge { animation: k-dg-hs-pop var(--k-t-bounce) var(--k-spring-bounce) backwards; animation-delay: calc(var(--dg-base) + 1100ms + var(--i) * 140ms); }
  :global(html.js.motion [data-dg-anim]:not(.in)) :is(.dg-hub, .dg-spokeline, .dg-scard, .dg-edgeline, .dg-edge) { animation-play-state: paused; }

  @keyframes k-dg-hs-pop { from { transform: scale(0.6); } }
  @keyframes k-dg-hs-draw { from { transform: scale(0); } }
</style>

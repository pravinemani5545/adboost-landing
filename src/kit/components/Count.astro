---
// A number that counts up when first scrolled into view (count.ts). Pass the value exactly as
// the page already prints it ("71+", "$153M+", "4.9 / 5", "24%"); the server renders it as is,
// so no-JS, reduced motion and first-screen numbers show it unchanged. Never pass a number the
// copy does not already state. The width is reserved (tabular digits, --w in ch) so the
// count never shifts the layout.
interface Props { value: string; class?: string }
const { value, class: cls } = Astro.props;
---
<span class:list={['k-count', cls]} data-count style={`--w:${value.length}`}>{value}</span>

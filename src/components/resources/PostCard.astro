---
// One post as a card: the blog index (feature, wide, standard and compact rows) and "Keep reading".
// The whole card is the link (kit .k-card--link: lift, cursor light, focus ring). Styles:
// src/styles/resources/blog.css (.rs-pcard).
interface Props {
  href: string;
  title: string;
  description: string;
  image?: string;
  alt?: string;
  date?: Date;
  category?: string;
  minutes?: number;
  /** heading level of the title: 2 on the index (cards sit under the H1), 3 under "Keep reading" */
  level?: 2 | 3;
  /** feature | wide | std | row (compact) */
  size?: 'feature' | 'wide' | 'std' | 'row';
  /** the first card on a page loads its image eagerly */
  eager?: boolean;
  /** the view-transition hook (post slug) on the index */
  vt?: string;
  /** a small flag before the category ("Latest") */
  flag?: string;
}
const { href, title, description, image, alt, date, category, minutes, level = 2, size = 'std', eager = false, vt, flag } = Astro.props;
const H = level === 2 ? 'h2' : 'h3';
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<a class:list={['k-card', 'k-card--link', 'rs-pcard', `rs-pcard--${size}`]} href={href}>
  {image && (
    <span class="k-card__media rs-pcard__media" data-vt-card={vt}>
      <img
        src={`${image}?v=2`}
        alt={alt ?? ''}
        loading={eager ? 'eager' : 'lazy'}
        decoding={eager ? undefined : 'async'}
        fetchpriority={eager ? 'high' : undefined}
        width="640"
        height="360"
      />
    </span>
  )}
  <span class="k-card__body rs-pcard__body">
    {(flag || category) && (
      <span class="rs-pcard__chips">
        {flag && <span class="rs-flag">{flag}</span>}
        {category && <span class="rs-cat">{category}</span>}
      </span>
    )}
    <H class="rs-pcard__title">{title}</H>
    <span class="rs-pcard__desc">{description}</span>
    <span class="rs-pcard__foot">
      <span class="rs-pcard__meta">
        {date && <time datetime={date.toISOString()}>{fmt(date)}</time>}
        {date && minutes && <span aria-hidden="true">·</span>}
        {minutes && <span>{minutes} min read</span>}
      </span>
      <span class="rs-pcard__go">Read article <span aria-hidden="true">→</span></span>
    </span>
  </span>
</a>

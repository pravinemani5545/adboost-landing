---
// A small line glyph for a resource link, chosen by where it goes (decorative, aria-hidden):
// a calculator for /tools/, a page for /blog/, a book for /glossary/, a spark for /services/,
// two columns for /compare/, a shield for /advertising/.
interface Props { href: string }
const { href } = Astro.props;
const kind = href.startsWith('/tools/') ? 'calc'
  : href.startsWith('/blog/') ? 'post'
  : href.startsWith('/glossary/') ? 'book'
  : href.startsWith('/services/') ? 'spark'
  : href.startsWith('/compare/') ? 'cols'
  : href.startsWith('/advertising/') ? 'shield'
  : 'post';
const PATHS: Record<string, string> = {
  calc: '<rect x="5" y="3" width="14" height="18" rx="3"/><path d="M8.5 7.5h7M8.5 12h.01M12 12h.01M15.5 12h.01M8.5 15.5h.01M12 15.5h.01M15.5 15.5h.01"/>',
  post: '<path d="M7 3h7l4 4v14H7z"/><path d="M14 3v4h4M10 12h5M10 16h5"/>',
  book: '<path d="M5 4.5A1.5 1.5 0 0 1 6.5 3H19v15H6.5A1.5 1.5 0 0 0 5 19.5z"/><path d="M5 19.5A1.5 1.5 0 0 0 6.5 21H19v-3"/>',
  spark: '<path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/><path d="M18.5 16.5l.7 1.8 1.8.7-1.8.7-.7 1.8-.7-1.8-1.8-.7 1.8-.7z"/>',
  cols: '<rect x="3.5" y="4" width="7" height="16" rx="2"/><rect x="13.5" y="4" width="7" height="16" rx="2"/>',
  shield: '<path d="M12 3l7 3v5.5c0 4.2-3 7.7-7 9.5-4-1.8-7-5.3-7-9.5V6z"/><path d="M9 12l2 2 4-4"/>',
};
---
<span class="rs-links__ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={PATHS[kind]} /></span>

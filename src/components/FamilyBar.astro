---
// Row 1 of the navigation: the AdBoost family switcher. It is the same on every
// page of every section, including the Health site (which carries a copy of this
// file), so it is self-contained: no site tokens, only its own colours.
// Each tab carries its section's colour as a dot; the current tab is underlined in it.
// It is fixed to the top; each site offsets its own header by --fam-h.
// It also opts every page into cross-page view transitions, so moving between
// sections fades instead of flashing (browsers without support just navigate).
interface Props {
  current: string;                                   // id of the active tab, or 'company'
  home: string;                                      // the AdBoost company home
  links: { id: string; tab: string; href: string; dot: string }[];
}
const { current, home, links } = Astro.props;
---

<div class="fam" role="navigation" aria-label="AdBoost family">
  <div class="container fam-in">
    <a class="fam-home" href={home} aria-label="AdBoost home" aria-current={current === 'company' ? 'page' : undefined}>
      <svg class="fam-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg>
      <span class="fam-name">AdBoost</span>
    </a>
    <div class="fam-tabs">
      {links.map((l) => (
        <a href={l.href} class={l.id === current ? 'is-on' : undefined} style={`--dot:${l.dot}`} aria-current={l.id === current ? 'true' : undefined}><i class="fam-dot" aria-hidden="true"></i>{l.tab}</a>
      ))}
    </div>
  </div>
</div>

<style>
  :global(:root) { --fam-h: 38px; }
  .fam { position: fixed; inset: 0 0 auto 0; z-index: 90; height: var(--fam-h); background: #0b0d10; color: rgba(255, 255, 255, .62); font-family: "Geist", "Geist Fallback", system-ui, sans-serif; font-size: 12.5px; line-height: 1; view-transition-name: fam-bar; }
  .fam-in { height: 100%; display: flex; align-items: stretch; gap: 18px; }
  .fam a { color: inherit; text-decoration: none; display: inline-flex; align-items: center; white-space: nowrap; transition: color .18s; }
  .fam a:hover { color: #fff; }
  .fam-home { font-weight: 700; font-size: 13px; letter-spacing: -.02em; color: #fff; padding-right: 18px; border-right: 1px solid rgba(255, 255, 255, .14); margin: 9px 0; }
  .fam-tabs { display: flex; align-items: stretch; gap: 2px; overflow-x: auto; scrollbar-width: none; }
  .fam-tabs::-webkit-scrollbar { display: none; }
  .fam-tabs a { gap: 7px; padding: 0 11px; border-bottom: 2px solid transparent; border-top: 2px solid transparent; font-weight: 500; }
  .fam-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--dot); opacity: .8; transition: transform .2s, opacity .2s; }
  .fam-tabs a:hover .fam-dot { transform: scale(1.35); opacity: 1; }
  .fam-tabs a.is-on { color: #fff; border-bottom-color: var(--dot); }
  .fam-tabs a.is-on .fam-dot { opacity: 1; box-shadow: 0 0 0 3px color-mix(in srgb, var(--dot) 28%, transparent); }
  .fam-ic { display: none; width: 15px; height: 15px; }
  /* Phones: the home link becomes an icon and only the current tab keeps its dot,
     so all four tabs fit across the screen without scrolling. */
  @media (max-width: 760px) {
    .fam-in { gap: 8px; }
    .fam-name { display: none; }
    .fam-ic { display: block; }
    .fam-home { padding-right: 10px; }
    .fam-tabs { flex: 1; justify-content: space-between; gap: 0; }
    .fam-tabs a { padding: 0 5px; gap: 5px; font-size: 12px; }
    .fam-tabs a:not(.is-on) .fam-dot { display: none; }
  }
  @media (prefers-reduced-motion: no-preference) {
    @view-transition { navigation: auto; }
  }
</style>

<script is:inline>
  // On a phone the tabs scroll sideways; keep the current one in view.
  (function () {
    var tabs = document.querySelector('.fam-tabs'), on = tabs && tabs.querySelector('.is-on');
    if (on) tabs.scrollLeft = on.offsetLeft - (tabs.clientWidth - on.offsetWidth) / 2;
  })();
</script>

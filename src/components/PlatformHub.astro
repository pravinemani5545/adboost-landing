---
// Platform policy hub template (health plan N2, N3). Data: src/data/platformHubs.ts.
// Dates: src/data/pages.json (`publish`, then `updated` once the page is edited).
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import CtaBand from './CtaBand.astro';
import Faq from './Faq.astro';
import StatusAside from './adv/StatusAside.astro';
import StatusBadge from './adv/StatusBadge.astro';
import ChangeLog from './adv/ChangeLog.astro';
import WhatChanged from './adv/WhatChanged.astro';
import Toc from './adv/Toc.astro';
import { STATUS_LEGEND, STATUS_TONE, fmtDay, policyHref } from './adv/status';
import { AD_POLICIES, STATUS_LABEL } from '../data/adPolicies';
import type { PlatformHub } from '../data/platformHubs';
import { PAGES, pageDate } from '../lib/live';
import { metaDescription, seoTitle } from '../lib/seo';
import { siteBase } from '../lib/site';
import { ogImageFor } from '../lib/og';
import { articleNode, breadcrumb, faqPage } from '../lib/schema';
import '../styles/pages/advertising.css';

interface Props { hub: PlatformHub }
const { hub } = Astro.props;
const SITE = siteBase(Astro.site);
const path = `/advertising/${hub.slug}/`;
const published = PAGES[path]?.publish;
if (!published) throw new Error(`src/data/pages.json needs a "publish" date for ${path}`);
const updated = pageDate(path) ?? published;

const title = seoTitle(path, hub.seoTitle);
const description = metaDescription(path, hub.metaDescription);
const crumb = `${hub.platform} health ad policy`;
const sheets = AD_POLICIES.filter((p) => p.platform === hub.platform);
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
const jsonLd = [
  articleNode(SITE, { headline: hub.h1, description, path, datePublished: published, dateModified: updated, authorIsOrg: true, image: ogImageFor(path) }),
  breadcrumb(SITE, [{ label: 'Home', href: '/' }, { label: 'Ad compliance', href: '/advertising/' }, { label: crumb, href: path }]),
  faqPage(hub.faq),
];
const toc = [
  ...hub.sections.map((s) => ({ id: s.id, label: s.question })),
  { id: 'verticals', label: 'Rules by vertical' },
  { id: 'changes', label: 'Change log' },
  { id: 'faq', label: 'FAQ' },
];
// changeLog is newest first and keeps the platform's precision (YYYY-MM stays a month).
const sourceLabel = (url: string) => hub.sources.find((s) => s.url === url)?.label ?? `${hub.platform} policy`;
const latestMonth = hub.changeLog[0] ? fmtDay(hub.changeLog[0].date.slice(0, 7)) : '';
---
<BaseLayout {title} {description} canonicalPath={path} {jsonLd} ogType="article">
  <PageHero
    class="adv-hero"
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Ad compliance', href: '/advertising/' }, { label: crumb }]}
    eyebrow={`${hub.platform.toUpperCase()} · HEALTH AD POLICY`}
    title={esc(hub.h1)}
    art={`/art/advertising/${hub.slug}`}
  >
    <div class="answer-box arrive" style="--d:60ms"><span class="al">The short answer</span>{hub.answer}</div>
    <StatusAside
      slot="aside"
      label={`${hub.platform} status by vertical`}
      caption={`All five verticals on ${hub.platform}. Each row opens that rule sheet.`}
      orientation="column"
      items={sheets.map((p) => ({ label: p.vertical, status: STATUS_LABEL[p.status], level: STATUS_TONE[p.status], href: policyHref(p) }))}
      legend={STATUS_LEGEND}
      platform={hub.platform}
      checkedOn={hub.checkedOn}
      {updated}
    />
  </PageHero>

  <section class="iwrap adv-doc">
    <div class="container">
      <div class="doc-grid k-scrub-scope">
        <div class="doc-main">
          <div class="prose">
            {hub.sections.map((s) => (
              <>
                <h2 id={s.id}>{s.question}</h2>
                {s.id === 'what-changed'
                  ? <WhatChanged html={s.html} platform={hub.platform} month={latestMonth} />
                  : <Fragment set:html={s.html} />}
              </>
            ))}

            <h2 id="verticals">Which {hub.platform} rule sheet covers your vertical?</h2>
            <div class="tablewrap">
              <table class="dtable">
                <thead><tr><th>Vertical</th><th>Status on {hub.platform}</th><th>Rule sheet</th></tr></thead>
                <tbody>
                  {sheets.map((p) => (
                    <tr>
                      <td class="row-h">{p.vertical}</td>
                      <td><StatusBadge status={p.status} /></td>
                      <td><a href={policyHref(p)}>{p.vertical} on {p.platform}</a></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <div class="adv-band" data-tone="tint">
              <h2 id="changes">What changed, and when?</h2>
              <ChangeLog
                caption={`${hub.platform} policy changes, newest first. Where ${hub.platform}’s date has no reliable day, only the month is given.`}
                entries={[...hub.changeLog].sort((a, b) => b.date.localeCompare(a.date)).map((c) => ({ date: c.date, text: c.change, sources: [{ label: sourceLabel(c.sourceUrl), url: c.sourceUrl }] }))}
              />
            </div>

            <h2 id="faq">FAQ</h2>
            <Faq items={hub.faq} idPrefix={`hub-${hub.slug}`} />

            <h3>Sources</h3>
            <p class="adv-fine">Ad policies change. This page reflects {hub.platform}’s published policy as checked on {fmtDay(hub.checkedOn)}; confirm current requirements against the live policy and qualified counsel before launching. This is general information, not legal advice.</p>
            <ul class="adv-sources">
              {hub.sources.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.label}</a></li>)}
            </ul>
          </div>
        </div>

        <aside class="doc-aside">
          <Toc items={toc} />
          <div class="aside-card">
            <h4>{hub.platform} rule sheets</h4>
            <div class="link-list">
              {sheets.map((p) => <a href={policyHref(p)}>{p.vertical} on {p.platform}</a>)}
              <a href="/advertising/">All platforms and verticals</a>
            </div>
          </div>
          <div class="aside-card">
            <h4>Zero-Ban Protocol</h4>
            <p>Our free pre-launch compliance checklist for health-brand advertisers.</p>
            <a href="/zero-ban-protocol/?utm_campaign=zbp-advertising">Get the checklist →</a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

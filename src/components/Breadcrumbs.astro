---
interface Props { items: { label: string; href?: string }[]; }
const { items } = Astro.props;
---
<nav class="crumbs" aria-label="Breadcrumb">
  {items.map((it, i) => (
    <>
      {i > 0 && <span class="sep" aria-hidden="true">/</span>}
      {it.href && i < items.length - 1 ? <a href={it.href}>{it.label}</a> : <span class="cur">{it.label}</span>}
    </>
  ))}
</nav>

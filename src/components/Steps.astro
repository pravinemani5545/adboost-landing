---
// Numbered steps on a connecting rule (--size sets the type, --node the ring). Each step slides in
// from the left (reveal.ts fans a batch 60ms apart); its node pops on a small bounce, and the length of
// rule down to the next node draws in as the step crosses the screen (scroll-driven where the browser
// can, on arrival otherwise). With reduced motion every step and the whole rule are simply there.
// A step is a line, or a title with a short body and a meta tag (a day range, a week span).
type Step = string | { title: string; body?: string; meta?: string };
interface Props { items: Step[]; class?: string }
const { items, class: cls } = Astro.props;
const norm = items.map((s) => (typeof s === 'string' ? { title: s } : s));
---

<ol class:list={['steps', cls]}>
  {
    norm.map((s, i) => (
      <li class="step" data-reveal="left">
        <span class="step-node idx" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <div class="step-c">
          <span class="step-t">{s.title}</span>
          {s.meta && <span class="step-meta label plain">{s.meta}</span>}
          {s.body && <p class="step-b" set:html={s.body} />}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .steps { --node: clamp(40px, 3.2vw, 46px); --size: clamp(22px, 2vw, 30px); display: grid; }
  .step {
    position: relative; display: grid; grid-template-columns: var(--node) minmax(0, 1fr); align-items: start;
    gap: clamp(16px, 2vw, 28px); padding-bottom: clamp(26px, 3vw, 44px);
    view-timeline: --step block;
  }
  .step:last-child { padding-bottom: 0; }
  /* the node: a ring with the step's number, filled with the tone's accent once the step has arrived */
  .step-node {
    position: relative; z-index: 1; display: grid; place-items: center; width: var(--node); height: var(--node);
    border-radius: 50%; letter-spacing: 0.06em; color: var(--fg); background: var(--bg);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .step-c { display: grid; gap: 10px; justify-items: start; }
  .step-t { padding-top: calc(var(--node) / 2 - 0.62em); font: 300 var(--size) / 1.25 var(--serif); letter-spacing: -0.012em; max-width: 30ch; }
  .step-meta { color: var(--fg-2); }
  .step-b { color: var(--fg-2); max-width: 58ch; }
  .step-b :global(a) { color: var(--fg); text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 3px; }
  /* the rule from this node down to the next */
  .step:not(:last-child)::after {
    content: ""; position: absolute; left: calc(var(--node) / 2 - 0.5px); top: var(--node); bottom: 0; width: 1px;
    background: var(--accent); opacity: 0.7; transform-origin: top;
  }

  :global(.js.motion) .step-node { scale: 0.55; transition: scale var(--t-bounce) var(--spring-bounce) 120ms, box-shadow 0.4s var(--spring-settle) 120ms; }
  :global(.js.motion) .step.in .step-node { scale: 1; box-shadow: inset 0 0 0 1px var(--accent); }
  /* without scroll-driven CSS: each length draws once its step has landed */
  :global(.js.motion) .step:not(:last-child)::after { transform: scaleY(0); transition: transform 0.9s var(--spring-settle) 320ms; }
  :global(.js.motion) .step.in:not(:last-child)::after { transform: none; }
  @supports (animation-timeline: view()) {
    :global(.js.motion) .step:not(:last-child)::after {
      transition: none; animation: step-draw linear both; animation-timeline: --step; animation-range: cover 22% cover 46%;
    }
    @keyframes step-draw { from { transform: scaleY(0); } to { transform: none; } }
  }
</style>

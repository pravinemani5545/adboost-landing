---
// Site nav. Tracker contract (adboost-admin t.js labels /book/ clicks by DOM ancestry): the Book
// button stays inside this <nav> ("header"); the phone sheet (#mnav) is a sibling of the nav
// and never carries a /book/ link. Groups are disclosures: the label links to the hub, the
// caret button (aria-expanded, aria-controls) opens the menu (menu.ts). Without JS the menus
// open on hover and focus.
import { BOOK_PATH, NAV } from '../../lib/site';

interface Props {
  /** clear over the hero until the page scrolls (home) */
  transparentTop?: boolean;
}
const { transparentTop = false } = Astro.props;
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const here = Astro.url.pathname;
---
<nav class="nav k-nav" id="nav" aria-label="Main" data-top={transparentTop ? 'clear' : undefined}>
  <div class="container k-nav__inner">
    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true"></span>
      <span>AdBoost <span class="brand-sub">Health</span></span>
    </a>
    <ul class="k-nav__links" role="list">
      {NAV.map((item) => item.children ? (
        <li class="k-nav__group" data-menu>
          <a class="k-nav__link" href={item.href} aria-current={here === item.href ? 'page' : undefined}>{item.label}</a>
          <button class="k-nav__toggle" type="button" aria-expanded="false" aria-controls={`menu-${slug(item.label)}`} aria-label={`${item.label} menu`}>
            <svg width="9" height="9" viewBox="0 0 9 9" fill="none" aria-hidden="true"><path d="M1.5 3l3 3 3-3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="k-menu" id={`menu-${slug(item.label)}`}>
            {item.children.map((c) => <a href={c.href} aria-current={here === c.href ? 'page' : undefined}>{c.label}</a>)}
          </div>
        </li>
      ) : item.external ? (
        <li class="k-nav__ext">
          <a class="k-nav__link" href={item.href} target="_blank" rel="noopener">{item.label}<svg width="10" height="10" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3 9L9 3M4.5 3H9v4.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        </li>
      ) : (
        <li><a class="k-nav__link" href={item.href} aria-current={here === item.href ? 'page' : undefined}>{item.label}</a></li>
      ))}
    </ul>
    <div class="k-nav__actions">
      <a class="btn btn-primary k-nav__cta" href={BOOK_PATH} data-magnetic>
        Book a call
        <span class="chev"><svg width="9" height="9" viewBox="0 0 9 9" fill="none" aria-hidden="true"><path d="M1 4.5h7M5 1l3.5 3.5L5 8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
      </a>
      <button class="k-burger" id="burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mnav">
        <svg class="k-burger__open" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M2 4.5h14M2 9h14M2 13.5h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        <svg class="k-burger__close" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4 4l10 10M14 4L4 14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>
</nav>
<div class="k-sheet" id="mnav" inert>
  {NAV.map((item, i) => (
    <div class="k-sheet__item" style={`--i:${i}`}>
      <a href={item.href} class="k-sheet__top" {...(item.external ? { target: '_blank', rel: 'noopener' } : {})}>{item.label}{item.external && ' ↗'}</a>
      {item.children && <div class="k-sheet__sub">{item.children.map((c) => <a href={c.href}>{c.label}</a>)}</div>}
    </div>
  ))}
</div>
<div class="k-scrim" data-scrim aria-hidden="true"></div>

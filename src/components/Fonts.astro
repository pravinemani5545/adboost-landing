---
// Self-hosted fonts (SIL Open Font License 1.1), latin and latin-ext subsets taken from Google Fonts,
// so no third-party origin sits in front of the first paint. Bump /fonts/v1/ if the files ever change.
//   Fraunces 300 roman + italic, opsz axis kept: the display serif. Both latin faces are preloaded, so
//     an italic accent word is italic from the first paint.
//   Geist 300-700 (variable): the text sans. Geist Mono: tabular figures in the calculators only.
//   Instrument Serif: the old home page only (`legacy`), until run 2 moves it onto the system.
// The "Fallback" faces are local fonts resized to the web fonts' metrics (Fraunces against Georgia,
// measured at opsz 72), so the swap to the web font does not shift text.
interface Props { legacy?: boolean }
const { legacy = false } = Astro.props;

const LATIN = 'U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD';
const LATIN_EXT = 'U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF';
const face = (family: string, style: string, weight: string, file: string) =>
  [`${file}-latin-ext`, LATIN_EXT, `${file}-latin`, LATIN]
    .reduce<string[]>((out, v, i, a) => (i % 2 ? out : [...out, `@font-face{font-family:'${family}';font-style:${style};font-weight:${weight};font-display:swap;src:url(/fonts/v1/${v}.woff2) format('woff2');unicode-range:${a[i + 1]}}`]), [])
    .join('\n');

const css = [
  face('Geist', 'normal', '300 700', 'geist'),
  face('Geist Mono', 'normal', '400 500', 'geist-mono'),
  ...(legacy
    ? [face('Instrument Serif', 'italic', '400', 'instrument-serif-italic'), face('Instrument Serif', 'normal', '400', 'instrument-serif-normal')]
    : [face('Fraunces', 'normal', '300', 'fraunces'), face('Fraunces', 'italic', '300', 'fraunces-italic')]),
  `@font-face{font-family:'Geist Fallback';src:local('Arial'),local('ArialMT');size-adjust:103.98%;ascent-override:96.65%;descent-override:28.37%;line-gap-override:0%}`,
  legacy
    ? `@font-face{font-family:'Instrument Serif Fallback';font-style:italic;src:local('Times New Roman Italic'),local('TimesNewRomanPS-ItalicMT');size-adjust:85.59%;ascent-override:115.66%;descent-override:36.22%;line-gap-override:0%}`
    : `@font-face{font-family:'Fraunces Fallback';font-style:normal;src:local('Georgia');size-adjust:92.74%;ascent-override:105.45%;descent-override:27.5%;line-gap-override:0%}
@font-face{font-family:'Fraunces Fallback';font-style:italic;src:local('Georgia Italic'),local('Georgia-Italic');size-adjust:85.12%;ascent-override:114.9%;descent-override:29.96%;line-gap-override:0%}`,
].join('\n');
---
<link rel="preload" href="/fonts/v1/geist-latin.woff2" as="font" type="font/woff2" crossorigin />
{legacy ? (
  <link rel="preload" href="/fonts/v1/instrument-serif-italic-latin.woff2" as="font" type="font/woff2" crossorigin />
) : (
  <>
    <link rel="preload" href="/fonts/v1/fraunces-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/v1/fraunces-italic-latin.woff2" as="font" type="font/woff2" crossorigin />
  </>
)}
<style is:inline set:html={css}></style>

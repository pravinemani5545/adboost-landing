---
import { CAL_LINK, CAL_NAMESPACE, CAL_URL } from '../lib/site';
interface Props { heading?: string; text?: string; }
const {
  heading = 'Ready to lower CAC and scale spend profitably?',
  text = 'A 30-minute call with a senior strategist. Free account audit included. No pitch deck - a written plan you can keep, whether you work with us or not.',
} = Astro.props;
---
<section class="iwrap">
  <div class="container">
    <div class="cta-band reveal">
      <div class="inner">
        <h2 set:html={heading} />
        <p>{text}</p>
        <a class="btn btn-primary btn-lg" href={CAL_URL} target="_blank" rel="noopener" data-cal-namespace={CAL_NAMESPACE} data-cal-link={CAL_LINK} data-cal-config='{"layout":"month_view"}'>
          Book a free strategy call
          <span class="chev"><svg width="9" height="9" viewBox="0 0 9 9" fill="none" aria-hidden="true"><path d="M1 4.5h7M5 1l3.5 3.5L5 8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </a>
        <div class="cb-perks">
          <span>30 minutes</span>
          <span>Free account audit</span>
          <span>Written plan either way</span>
        </div>
      </div>
    </div>
  </div>
</section>

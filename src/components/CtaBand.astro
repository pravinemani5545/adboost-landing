---
// The closing CTA: a night slab with its own grid, aura and grain layers. Tracker contract: the
// .cta-band class labels its /book/ click "cta-band"; keep it. The phone CTA steps aside while
// this is on screen. heading accepts trusted inline HTML (serif accents).
import { BOOK_PATH } from '../lib/site';
interface Props { heading?: string; text?: string; }
const {
  heading = 'Ready to lower CAC and scale spend profitably?',
  text = 'A 30-minute call with a senior strategist. Free account audit included. No pitch deck - a written plan you can keep, whether you work with us or not.',
} = Astro.props;
---
<section class="iwrap">
  <div class="container">
    <div class="cta-band" data-tone="night" data-reveal>
      <div class="k-bg k-bg--grid" aria-hidden="true"></div>
      <div class="k-bg k-bg--aura" aria-hidden="true"></div>
      <div class="k-bg k-bg--noise" aria-hidden="true"></div>
      <div class="inner">
        <h2 set:html={heading} />
        <p>{text}</p>
        <a class="btn btn-primary btn-lg" href={BOOK_PATH} data-magnetic>
          Book a free strategy call
          <span class="chev"><svg width="9" height="9" viewBox="0 0 9 9" fill="none" aria-hidden="true"><path d="M1 4.5h7M5 1l3.5 3.5L5 8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </a>
        <div class="cb-perks">
          <span>30 minutes</span>
          <span>Free account audit</span>
          <span>Written plan either way</span>
        </div>
      </div>
    </div>
  </div>
</section>

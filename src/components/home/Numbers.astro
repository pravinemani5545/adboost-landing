---
// The agency in numbers: three figures the site already states, set very large.
interface Item { value: number; prefix?: string; suffix: string; read: string; title: string; body: string }
interface Props { label: string; items: Item[] }
const { label, items } = Astro.props;
---

<section class="tone-frame section-tight nums" data-nav="frame" aria-labelledby="nums-h">
  <div class="wrap">
    <h2 id="nums-h" class="label muted" data-reveal>{label}</h2>
    <ol class="nums-row">
      {
        items.map((n, i) => (
          <li class="num-col" data-reveal style={`--i:${i}`}>
            <p class="num-big">
              <span class="sr-only">{n.read}</span>
              <span class="num-fig" aria-hidden="true">
                {n.prefix && <span class="num-pre">{n.prefix}</span>}
                <span class="num-val" data-count={n.value}>{n.value}</span><span class="num-suf">{n.suffix}</span>
              </span>
            </p>
            <h3 class="num-title">{n.title}</h3>
            <p class="small num-body">{n.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .nums-row {
    /* the reference size (13.9vw, 200px) is for two-digit figures; "$153M+" needs a step down to hold three columns */
    --big: clamp(80px, 9.6vw, 140px);
    --gap: clamp(28px, 5.5vw, 80px);
    display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--gap);
    margin-top: clamp(40px, 6vw, 88px);
  }
  .num-col { position: relative; display: grid; gap: 10px; align-content: start; }
  /* a short vertical hairline in each gutter, centred on the numeral rather than the column */
  .num-col + .num-col::before {
    content: ""; position: absolute; left: calc(var(--gap) / -2); width: 1px;
    top: calc(var(--big) * 0.175); height: calc(var(--big) * 0.65); background: var(--line);
  }
  .num-fig { display: flex; align-items: flex-start; gap: 10px; font: 300 var(--big) / 1 var(--serif); letter-spacing: -0.03em; font-optical-sizing: auto; }
  .num-val { font-variant-numeric: tabular-nums; }
  /* the prefix and suffix sit small, up at the cap line */
  .num-suf, .num-pre { font-size: 0.3em; line-height: 1; padding-top: 0.12em; letter-spacing: 0; }
  .num-pre { margin-right: -4px; }
  .num-title { margin-top: 6px; text-wrap: balance; }
  .num-body { max-width: 380px; }

  /* while counting: the final figure sits hidden in the same cell, so the width is settled from the start */
  .num-val.counting { display: inline-grid; }
  .num-val.counting > :global(span) { grid-area: 1 / 1; }
  .num-val.counting > :global(.cnt-twin) { visibility: hidden; }

  /* below 1100px the columns narrow faster than the figures, so they step down again */
  @media (max-width: 1099px) { .nums-row { --big: clamp(64px, 8.6vw, 96px); } }
  @media (max-width: 760px) {
    .nums-row { grid-template-columns: 1fr; gap: 40px; --big: clamp(88px, 26vw, 120px); }
    .num-col + .num-col::before { content: none; }
    .num-col + .num-col { padding-top: 32px; border-top: 1px solid var(--line); }
  }
  @media (max-width: 640px) {
    .nums-row { margin-top: 28px; gap: 30px; }
    .num-col + .num-col { padding-top: 26px; }
  }
</style>

<script>
  // Each figure counts up from 0 once it is well in view: 2.8s, ease-out-cubic, whole numbers only,
  // neighbours starting 170ms apart. The digits are in the HTML already, so without JS or with
  // reduced motion the final figures simply show.
  import { reduceMotion, whenShown } from '../../scripts/env';

  const ease = (t: number) => 1 - (1 - t) ** 3;
  const DUR = 2800;
  const els = [...document.querySelectorAll<HTMLElement>('[data-count]')];
  if (els.length && !reduceMotion) {
    const items = els.map((el) => {
      const end = Number(el.dataset.count);
      el.innerHTML = `<span>0</span><span class="cnt-twin">${end}</span>`;
      el.classList.add('counting');
      return { el, end, v: el.firstElementChild as HTMLElement };
    });
    const run = ({ end, v }: (typeof items)[number], delay: number) => {
      const t0 = performance.now() + delay;
      const tick = (now: number) => {
        const t = Math.min(1, Math.max(0, (now - t0) / DUR));
        v.textContent = String(Math.round(ease(t) * end));
        if (t < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    const io = new IntersectionObserver(
      (entries) => {
        let k = 0;
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          run(items.find((i) => i.el === e.target)!, k++ * 170);
          io.unobserve(e.target);
        }
      },
      { threshold: 0.6 },
    );
    whenShown(() => items.forEach((i) => io.observe(i.el)));
  }
</script>

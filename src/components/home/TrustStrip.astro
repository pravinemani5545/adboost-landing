---
// One quiet line: the fact, then the brands, separated by thin rules. The marks are drawn in the
// line's own colour (each logo is a mask), so they sit as one set on FRAME. Where the line doesn't
// fit, it glides slowly.
interface Logo { src: string; name: string; w: number; h: number; tile?: boolean }
interface Props { fact: string; logos: Logo[] }
const { fact, logos } = Astro.props;
// every mark sets at the same optical height; wide wordmarks a touch lower so they don't shout
const H = 26;
const width = (l: Logo) => Math.round((l.w / l.h) * (l.w / l.h > 3.2 ? H * 0.86 : l.w / l.h < 1.5 ? H * 1.25 : H));
const row = (twin: boolean) => (
  `<li class="trust-fact">${fact}</li>` +
  logos
    .map((l) =>
      l.tile
        ? `<li><img class="trust-tile" src="${l.src}" alt="" width="${l.w}" height="${l.h}" loading="lazy" decoding="async" /></li>`
        : `<li><span class="trust-logo" style="--src:url('${l.src}');width:${width(l)}px"></span></li>`,
    )
    .join('')
);
---

<div class="trust tone-frame" data-nav="frame" data-trust>
  <p class="sr-only">{fact}, including {logos.map((l) => l.name).join(', ')}.</p>
  <div class="trust-track" aria-hidden="true">
    <ul class="trust-row" set:html={row(false)} />
    <ul class="trust-row trust-twin" set:html={row(true)} />
  </div>
</div>

<style>
  .trust { overflow: hidden; border-bottom: 1px solid var(--line); padding: 22px 0; font-size: 14.5px; color: var(--fg-2); }
  .trust-track { display: flex; width: max-content; margin-inline: auto; }
  .trust-row { display: flex; flex: none; align-items: center; }
  .trust-row :global(li) { display: flex; align-items: center; height: 34px; padding: 0 26px; border-left: 1px solid var(--line); white-space: nowrap; }
  .trust-row :global(li:first-child) { border-left: 0; }
  .trust-row :global(.trust-fact) { letter-spacing: 0.01em; }
  .trust-row :global(.trust-logo) {
    display: block; height: 26px; background: currentColor; opacity: 0.86;
    -webkit-mask: var(--src) center / contain no-repeat; mask: var(--src) center / contain no-repeat;
  }
  .trust-row :global(.trust-tile) { height: 30px; width: auto; border-radius: 6px; opacity: 0.9; }
  .trust-twin { display: none; }
  .trust.moving .trust-track { margin-inline: 0; animation: glide 58s linear infinite; animation-play-state: var(--run, running); }
  .trust.moving .trust-twin { display: flex; }
  .trust.moving .trust-row :global(li:first-child) { border-left: 1px solid var(--line); }
  .trust.moving:hover .trust-track { animation-play-state: paused; }
  @keyframes glide { to { transform: translate(-50%, 0); } }
  @media (max-width: 640px) { .trust { font-size: 16px; } }
  @media (prefers-reduced-motion: reduce) {
    .trust-track { width: auto; padding-inline: var(--pad); }
    .trust-row { flex-wrap: wrap; justify-content: center; row-gap: 10px; }
    .trust.moving .trust-twin { display: none; }
  }
</style>

<script>
  import { reduceMotion } from '../../scripts/env';
  import { onMeasure } from '../../scripts/scroll';
  const strip = document.querySelector<HTMLElement>('[data-trust]');
  if (strip && !reduceMotion) {
    const row = strip.querySelector<HTMLElement>('.trust-row')!;
    onMeasure(() => strip.classList.toggle('moving', row.scrollWidth > strip.clientWidth - 24));
    // pause the glide while it is off screen
    new IntersectionObserver(([e]) => strip.style.setProperty('--run', e.isIntersecting ? 'running' : 'paused')).observe(strip);
  }
</script>

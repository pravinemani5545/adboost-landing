---
// Privacy and terms. A thin wrapper over the Shell (full chrome: nav with the phone menu, the
// site footer); the Props API is unchanged. Never shows the newsletter popup.
import Shell from './Shell.astro';
import { breadcrumb } from '../lib/schema';
import { siteBase } from '../lib/site';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
}
const { title, description, canonicalPath } = Astro.props;
const site = siteBase(Astro.site);
const pageLabel = title.replace(/ \| AdBoost Health$/, '');
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    breadcrumb(site, [{ label: 'Home', href: '/' }, { label: pageLabel, href: canonicalPath }]),
    { '@type': 'WebPage', name: title, description, url: `${site}${canonicalPath}`, publisher: { '@type': 'Organization', name: 'AdBoost Health', url: `${site}/` } },
  ],
};
---
<Shell {title} {description} {canonicalPath} {jsonLd} preloadSerif={false} popup={false}>
  <div class="legal-main container">
    <div class="legal-prose">
      <slot />
    </div>
  </div>
</Shell>

<style is:global>
  .legal-main { padding: calc(var(--k-nav-h) + 52px) 0 80px; }
  .legal-prose { max-width: 720px; font-size: 15.5px; line-height: 1.7; color: var(--k-ink-2); }
  .legal-prose h1 { font-size: var(--k-fs-h1); line-height: var(--k-lh-tight); letter-spacing: -0.035em; font-weight: var(--k-fw-display); color: var(--k-ink); margin: 0 0 14px; text-wrap: balance; }
  .legal-prose h2 { font-size: 20px; letter-spacing: -.015em; font-weight: 600; color: var(--k-ink); margin: 32px 0 10px; }
  .legal-prose p { margin: 0 0 14px; }
  .legal-prose ul { margin: 0 0 14px; padding-left: 22px; }
  .legal-prose li { margin-bottom: 8px; }
  .legal-prose a { color: var(--k-accent-ink); text-decoration: underline; text-underline-offset: 3px; }
</style>

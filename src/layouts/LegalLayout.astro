---
// Privacy and terms: the system page head, then the policy as one long, quiet column.
import Shell from './Shell.astro';
import PageHead from '../components/PageHead.astro';
import { breadcrumb } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  /** the page's H1 */
  heading: string;
  /** "Last updated" date, as written */
  updated: string;
}
const { title, description, canonicalPath, heading, updated } = Astro.props;
const site = Astro.site?.href.replace(/\/$/, '') ?? 'https://www.adboost.health';
const ogImage = `${site}/og/og-home.png`;
const pageLabel = title.replace(/ \| AdBoost Health$/, '');
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    breadcrumb(site, [{ label: 'Home', href: '/' }, { label: pageLabel, href: canonicalPath }]),
    { '@type': 'WebPage', name: title, description, url: `${site}${canonicalPath}`, publisher: { '@type': 'Organization', name: 'AdBoost Health', url: `${site}/` } },
  ],
};
---

<Shell nav="paper">
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`${site}${canonicalPath}`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${site}${canonicalPath}`} />
    <meta property="og:site_name" content="AdBoost Health" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
  </Fragment>
  <PageHead label="Legal" title={heading} lede={`Last updated: ${updated}`} dots />
  <section class="legal-body tone-paper" data-nav="paper">
    <div class="wrap">
      <div class="legal-prose">
        <slot />
      </div>
    </div>
  </section>
</Shell>

<style is:global>
  .legal-body { padding: clamp(8px, 2vw, 24px) 0 var(--section); }
  .legal-prose { max-width: 68ch; color: var(--fg-2); }
  .legal-prose h2 { font-size: clamp(26px, 2.4vw, 34px); line-height: 1.15; color: var(--fg); margin: 2.2em 0 0.6em; }
  .legal-prose p, .legal-prose ul { margin: 0 0 1em; }
  .legal-prose ul { padding-left: 1.2em; list-style: disc; }
  .legal-prose li { margin-bottom: 0.6em; }
  .legal-prose li::marker { color: var(--accent); }
  .legal-prose strong { color: var(--fg); font-weight: 500; }
  .legal-prose a { color: var(--fg); text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 3px; }
</style>

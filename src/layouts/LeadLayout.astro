---
// Minimal, distraction-free layout for lead-magnet opt-in pages: no nav or footer chrome
// (maximizes conversion), always noindex. A thin wrapper over the Shell (chrome="lead"); the
// Props API is unchanged. Never shows the newsletter popup.
import Shell from './Shell.astro';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
}
const { title, description, canonicalPath } = Astro.props;
---
<Shell
  chrome="lead"
  {title}
  {description}
  {canonicalPath}
  robots="noindex, nofollow"
  ogImageAlt="AdBoost Health, performance marketing for health brands"
  popup={false}
  leadTag="Peptide & GLP-1 ad compliance"
  bodyClass="lead-body"
  mainClass="lead-main"
>
  <slot />
</Shell>

<style is:global>
  .lead-top { padding: 20px 0; border-bottom: 1px solid var(--k-line); }
  .lead-top .container { display: flex; align-items: center; justify-content: space-between; }
  .lead-top-tag { display: none; font-family: var(--k-font-mono); font-size: 11px; letter-spacing: .04em; text-transform: uppercase; color: var(--k-ink-3); }
  @media (min-width: 720px) { .lead-top-tag { display: inline; } }
  .lead-body { min-height: 100vh; display: flex; flex-direction: column; }
  .lead-main { padding: 0 0 56px; flex: 1 0 auto; display: flex; flex-direction: column; }
  .lead-foot { padding: 26px 0; border-top: 1px solid var(--k-line); color: var(--k-ink-3); font-size: 12.5px; }
  .lead-foot a { color: var(--k-ink-3); text-decoration: underline; text-underline-offset: 3px; }
</style>

---
import Fonts from '../components/Fonts.astro';
import NewsletterVisitMark from '../components/NewsletterVisitMark.astro';
// Minimal, distraction-free layout for lead-magnet opt-in pages.
// No nav/footer chrome (maximizes conversion); always noindex.
import '../styles/global.css';
import '../styles/interior.css';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
}
const { title, description, canonicalPath } = Astro.props;
const site = Astro.site?.href.replace(/\/$/, '') ?? 'https://www.adboost.health';
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content="noindex, nofollow" />
<link rel="canonical" href={`${site}${canonicalPath}`} />
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={`${site}${canonicalPath}`} />
<meta property="og:site_name" content="AdBoost Health" />
<meta property="og:image" content={`${site}/og/og-home.png`} />
<meta property="og:image:alt" content="AdBoost Health, performance marketing for health brands" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={`${site}/og/og-home.png`} />
<meta name="twitter:image:alt" content="AdBoost Health, performance marketing for health brands" />
<meta name="theme-color" content="#ffffff" />
<Fonts />
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<script defer src="https://admin.adboost.health/t.js"></script>
</head>
<body class="lead-body">
<header class="lead-top">
  <div class="container">
    <a class="brand" href="/"><span class="brand-mark" aria-hidden="true"></span><span>AdBoost <span style="color:var(--mute);font-weight:400">Health</span></span></a>
    <span class="lead-top-tag">Peptide &amp; GLP-1 ad compliance</span>
  </div>
</header>
<main class="lead-main">
  <slot />
</main>
<footer class="lead-foot">
  <div class="container">
    <span>© 2026 AdBoost Health · <a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a></span>
  </div>
</footer>

<style is:global>
  .lead-top { padding: 20px 0; border-bottom: 1px solid var(--line, #eceef3); }
  .lead-top .container { display: flex; align-items: center; justify-content: space-between; }
  .lead-top-tag { font-family: 'Geist Mono', ui-monospace, monospace; font-size: 11px; letter-spacing: .04em; text-transform: uppercase; color: var(--mute); }
  .lead-body { min-height: 100vh; display: flex; flex-direction: column; }
  .lead-main { padding: 0 0 56px; flex: 1 0 auto; display: flex; flex-direction: column; }
  .lead-foot { padding: 26px 0; border-top: 1px solid var(--line, #eceef3); color: var(--mute); font-size: 12.5px; }
  .lead-foot a { color: var(--mute); text-decoration: underline; text-underline-offset: 3px; }
  .lead-top-tag { display: none; }
  @media (min-width: 720px) { .lead-top-tag { display: inline; } }
</style>
<NewsletterVisitMark />
</body>
</html>

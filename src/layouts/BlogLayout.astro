---
// Blog index and posts. A thin wrapper over the Shell (skip link, nav, #main, phone CTA, footer);
// the Props API and the article markup are unchanged.
import Shell from './Shell.astro';
import { versioned } from '../lib/assets';
import { BOOK_PATH } from '../lib/site';
import Breadcrumbs from '../components/Breadcrumbs.astro';


interface RelatedPost {
  href: string;
  title: string;
  description: string;
  heroImage?: string;
  heroAlt?: string;
}

interface Props {
  title: string;
  /** Short SERP title tag (≤60 chars); falls back to title */
  pageTitle?: string;
  description: string;
  canonical: string;
  /** Present on post pages, absent on the blog index */
  post?: {
    pubDate: Date;
    updatedDate?: Date;
    author: string;
    authorTitle: string;
    tags: string[];
    heroImage?: string;
    heroAlt?: string;
    ctaHeading?: string;
    ctaText?: string;
    itemList?: { name: string; url: string }[];
  };
  readMinutes?: number;
  related?: RelatedPost[];
  /** The post's visible FAQ section (faqFromBody), emitted as FAQPage JSON-LD */
  faq?: { q: string; a: string }[];
}

const { title, pageTitle, description, canonical, post, readMinutes, related = [], faq = [] } = Astro.props;
const metaTitle = pageTitle ?? title;
const site = Astro.site?.href.replace(/\/$/, '') ?? 'https://www.adboost.health';

// Social scrapers (Facebook especially) don't render WebP - og images are JPEG copies.
const ogImage = post?.heroImage
  ? `${site}${post.heroImage.replace('/blog/', '/blog/og/').replace('.webp', '.jpg')}?v=2`
  : `${site}/og/og-home.png`;

const displayTitleEarly = title.replace(/ \| AdBoost Health$/, '');
const jsonLd = post
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'BlogPosting',
          headline: displayTitleEarly,
          description,
          url: canonical,
          datePublished: post.pubDate.toISOString(),
          dateModified: (post.updatedDate ?? post.pubDate).toISOString(),
          image: ogImage,
          keywords: post.tags.join(', '),
          // @id matches the Person node personNode() emits on /about/ (same slug algorithm),
          // so the author entity reconciles across pages. Author is always Amir Salihovic.
          author: {
            '@type': 'Person',
            '@id': `${site}/about/#${post.author.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')}`,
            name: post.author,
            jobTitle: post.authorTitle,
            url: `${site}/about/`,
            sameAs: ['https://www.linkedin.com/in/amir-salihovic-7b2844157/'],
            worksFor: { '@id': `${site}/#org` },
          },
          publisher: { '@type': 'Organization', '@id': `${site}/#org`, name: 'AdBoost Health', url: `${site}/`, logo: { '@type': 'ImageObject', url: `${site}/logos/adboost-mark.png` } },
          mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
        },
        {
          '@type': 'BreadcrumbList',
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
            { '@type': 'ListItem', position: 2, name: 'Blog', item: `${site}/blog/` },
            { '@type': 'ListItem', position: 3, name: displayTitleEarly, item: canonical },
          ],
        },
        ...(faq.length
          ? [{
              '@type': 'FAQPage',
              '@id': `${canonical}#faq`,
              mainEntity: faq.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
            }]
          : []),
        ...(post.itemList?.length
          ? [{
              '@type': 'ItemList',
              name: displayTitleEarly,
              itemListOrder: 'https://schema.org/ItemListOrderAscending',
              numberOfItems: post.itemList.length,
              itemListElement: post.itemList.map((e, i) => ({
                '@type': 'ListItem',
                position: i + 1,
                item: { '@type': 'Organization', name: e.name, url: e.url },
              })),
            }]
          : []),
      ],
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'Blog',
      name: 'AdBoost Health Blog',
      description,
      url: canonical,
      publisher: { '@type': 'Organization', '@id': `${site}/#org`, name: 'AdBoost Health', url: `${site}/` },
    };

const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const displayTitle = title.replace(/ \| AdBoost Health$/, '');
const category = post?.tags[0]?.toUpperCase();
---

<Shell
  title={metaTitle}
  {description}
  {canonical}
  ogType={post ? 'article' : 'website'}
  ogImage={post?.heroImage ? ogImage : undefined}
  ogImageAlt={post?.heroAlt ?? title}
  article={post ? { publishedTime: post.pubDate.toISOString(), author: post.author } : undefined}
  {jsonLd}
  mainClass="blog-main"
>
  {post ? (
    <article class="blog-article">
      <header class="post-head container">
        <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Blog', href: '/blog/' }, { label: displayTitle }]} />
        <div class="post-meta-top">
          <a class="all-link" href="/blog/">← All articles</a>
          {category && <span class="cat-chip">{category}</span>}
        </div>
        <h1>{displayTitle}</h1>
        <div class="byline">
          <img src={versioned('/people/amir.webp')} alt={post.author} width="40" height="40" loading="eager" />
          <div class="byline-meta">
            <b>{post.author}</b>
            <span>{post.authorTitle}</span>
          </div>
          <span class="byline-sep" aria-hidden="true"></span>
          <span class="byline-date"><time datetime={post.pubDate.toISOString()}>{fmt(post.pubDate)}</time>{readMinutes && ` · ${readMinutes} min read`}{post.updatedDate && post.updatedDate.valueOf() > post.pubDate.valueOf() && ` · Updated ${fmt(post.updatedDate)}`}</span>
        </div>
      </header>

      {post.heroImage && (
        <div class="hero-figure container" data-mcta-anchor>
          <img src={`${post.heroImage}?v=2`} alt={post.heroAlt ?? ''} width="1600" height="900" fetchpriority="high" />
        </div>
      )}

      <div class="prose prose--doc container">
        <slot />
      </div>

      <section class="cta-banner-wrap container">
        <div class="cta-banner">
          <div class="cta-banner-text">
            <h2>{post.ctaHeading ?? 'Lower CAC. Scale profitably.'}</h2>
            <p>{post.ctaText ?? 'A free 30-minute strategy call with a full account audit - you leave with a written plan, whether we work together or not.'}</p>
          </div>
          <a class="btn btn-light" href={BOOK_PATH}>
            Book a free strategy call
            <span class="chev"><svg width="9" height="9" viewBox="0 0 9 9" fill="none"><path d="M1 4.5h7M5 1l3.5 3.5L5 8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          </a>
        </div>
      </section>

      {related.length > 0 && (
        <section class="related container">
          <h2>Keep reading</h2>
          <div class="related-grid">
            {related.map((r) => (
              <a class="related-card" href={r.href}>
                {r.heroImage && <img src={`${r.heroImage}?v=2`} alt={r.heroAlt ?? ''} loading="lazy" width="640" height="360" />}
                <div class="related-body">
                  <h3>{r.title}</h3>
                  <p>{r.description}</p>
                  <span class="read-more">Read article →</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}
    </article>
  ) : (
    <div class="container">
      <slot />
    </div>
  )}
</Shell>

<style is:global>
  .blog-main { padding: calc(var(--k-nav-h) + 40px) 0 90px; }

  /* --- centered post header (reference format) --- */
  .post-head { max-width: 760px; text-align: center; }
  .post-head .crumbs { justify-content: center; margin-bottom: 14px; }
  .post-meta-top { display: flex; align-items: center; justify-content: center; gap: 12px; margin-bottom: 20px; }
  .all-link { font-size: 13px; color: var(--mute); transition: color .15s; }
  .all-link:hover { color: var(--blue); }
  .cat-chip { font-size: 11px; font-weight: 600; letter-spacing: .06em; color: var(--blue); background: var(--blue-soft); border-radius: 999px; padding: 5px 11px; }
  .post-head h1 { font-size: clamp(30px, 4.6vw, 46px); letter-spacing: -.03em; line-height: 1.1; font-weight: 600; color: var(--ink); margin-bottom: 22px; }
  .byline { display: flex; align-items: center; justify-content: center; gap: 11px; margin-bottom: 40px; }
  .byline img { border-radius: 50%; object-fit: cover; }
  .byline-meta { text-align: left; }
  .byline-meta b { display: block; font-size: 13.5px; color: var(--ink); font-weight: 600; line-height: 1.25; }
  .byline-meta span { font-size: 12px; color: var(--mute); }
  .byline-sep { width: 1px; height: 26px; background: var(--line-2); }
  .byline-date { font-size: 12.5px; color: var(--mute); }

  /* --- hero image on the post itself --- */
  .hero-figure { max-width: 980px; margin-bottom: 48px; }
  .hero-figure img { width: 100%; height: auto; border-radius: var(--radius-lg); border: 1px solid var(--line); box-shadow: var(--shadow); }

  /* --- blue gradient CTA banner (reference format) --- */
  .cta-banner-wrap { max-width: 980px; margin-top: 56px; }
  .cta-banner { display: flex; align-items: center; justify-content: space-between; gap: 26px; flex-wrap: wrap; background: linear-gradient(120deg, #0057ff 0%, #3b7bff 100%); border-radius: var(--radius-lg); padding: 34px 38px; box-shadow: 0 24px 48px -20px var(--blue-glow); }
  .cta-banner-text h2 { font-size: 22px; letter-spacing: -.02em; font-weight: 600; color: #fff; margin-bottom: 6px; }
  .cta-banner-text p { font-size: 14px; color: rgba(255,255,255,.82); max-width: 52ch; }
  .btn-light { background: #fff; color: var(--blue); font-weight: 600; box-shadow: 0 8px 20px -8px rgba(10,10,15,.35); }
  .btn-light:hover { background: #f2f6ff; }
  .btn-light .chev { width: 18px; height: 18px; border-radius: 50%; background: var(--blue-soft); display: grid; place-items: center; transition: transform .2s; }
  .btn-light:hover .chev { transform: translateX(3px); }

  /* --- related posts --- */
  .related { max-width: 980px; margin-top: 64px; }
  .related > h2 { font-size: 22px; letter-spacing: -.02em; font-weight: 600; color: var(--ink); margin-bottom: 22px; }
  .related-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 22px; }
  .related-card { display: flex; flex-direction: column; overflow: clip; }
  .related-card img { width: 100%; height: auto; aspect-ratio: 16/9; object-fit: cover; border-bottom: 1px solid var(--line); }
  .related-body { padding: 18px 20px 20px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
  .related-body h3 { font-size: 16px; letter-spacing: -.01em; line-height: 1.3; font-weight: 600; color: var(--ink); }
  .related-body p { font-size: 13px; color: var(--mute); line-height: 1.5; flex: 1; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .related-body .read-more { font-size: 13px; font-weight: 500; color: var(--blue); }

  /* --- tablet --- */
  @media (max-width: 900px) {
    .hero-figure { max-width: 100%; }
    .related-grid { gap: 18px; }
  }

  @media (max-width: 640px) {
    .blog-main { padding-top: calc(var(--k-nav-h) + 36px); }
    .post-head h1 { font-size: clamp(26px, 7.2vw, 34px); }
    .byline { flex-wrap: wrap; row-gap: 6px; }
    .byline-sep { display: none; }
    .byline-date { width: 100%; text-align: center; }
    .hero-figure img { border-radius: var(--radius); }
    .cta-banner { padding: 28px 22px; text-align: center; justify-content: center; }
    .cta-banner-text p { margin-inline: auto; }
    .related { margin-top: 48px; }
  }
</style>

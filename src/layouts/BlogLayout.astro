---
// The blog: the index and every post, on the system shell. Posts: a page head with the byline, the
// hero, one reading column, related reads and the closing band (the post's own CTA copy when it has one).
import Shell from './Shell.astro';
import Closing from '../components/Closing.astro';
import { versioned } from '../lib/assets';
import Breadcrumbs from '../components/Breadcrumbs.astro';


interface RelatedPost {
  href: string;
  title: string;
  description: string;
  heroImage?: string;
  heroAlt?: string;
}

interface Props {
  title: string;
  /** Short SERP title tag (≤60 chars); falls back to title */
  pageTitle?: string;
  description: string;
  canonical: string;
  /** Present on post pages, absent on the blog index */
  post?: {
    pubDate: Date;
    updatedDate?: Date;
    author: string;
    authorTitle: string;
    tags: string[];
    heroImage?: string;
    heroAlt?: string;
    ctaHeading?: string;
    ctaText?: string;
  };
  readMinutes?: number;
  related?: RelatedPost[];
}

const { title, pageTitle, description, canonical, post, readMinutes, related = [] } = Astro.props;
const metaTitle = pageTitle ?? title;
const site = Astro.site?.href.replace(/\/$/, '') ?? 'https://www.adboost.health';

// Social scrapers (Facebook especially) don't render WebP - og images are JPEG copies.
const ogImage = post?.heroImage
  ? `${site}${post.heroImage.replace('/blog/', '/blog/og/').replace('.webp', '.jpg')}?v=2`
  : `${site}/og/og-home.png`;

const displayTitleEarly = title.replace(/ \| AdBoost Health$/, '');
const jsonLd = post
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'BlogPosting',
          headline: displayTitleEarly,
          description,
          url: canonical,
          datePublished: post.pubDate.toISOString(),
          dateModified: (post.updatedDate ?? post.pubDate).toISOString(),
          image: ogImage,
          keywords: post.tags.join(', '),
          // @id matches the Person node personNode() emits on /about/ (same slug algorithm),
          // so the author entity reconciles across pages. Author is always Amir Salihovic.
          author: {
            '@type': 'Person',
            '@id': `${site}/about/#${post.author.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')}`,
            name: post.author,
            jobTitle: post.authorTitle,
            url: `${site}/about/`,
            sameAs: ['https://www.linkedin.com/in/amir-salihovic-7b2844157/'],
            worksFor: { '@id': `${site}/#org` },
          },
          publisher: { '@type': 'Organization', '@id': `${site}/#org`, name: 'AdBoost Health', url: `${site}/`, logo: { '@type': 'ImageObject', url: `${site}/logos/adboost-mark.png` } },
          mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
        },
        {
          '@type': 'BreadcrumbList',
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
            { '@type': 'ListItem', position: 2, name: 'Blog', item: `${site}/blog/` },
            { '@type': 'ListItem', position: 3, name: displayTitleEarly, item: canonical },
          ],
        },
      ],
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'Blog',
      name: 'AdBoost Health Blog',
      description,
      url: canonical,
      publisher: { '@type': 'Organization', '@id': `${site}/#org`, name: 'AdBoost Health', url: `${site}/` },
    };

const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const displayTitle = title.replace(/ \| AdBoost Health$/, '');
const category = post?.tags[0]?.toUpperCase();
---

<Shell nav="paper">
  <Fragment slot="head">
    <title>{metaTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={post ? 'article' : 'website'} />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="AdBoost Health" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={post?.heroAlt ?? title} />
    {post && <meta property="article:published_time" content={post.pubDate.toISOString()} />}
    {post && <meta property="article:author" content={post.author} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metaTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={post?.heroAlt ?? title} />
    <link rel="alternate" type="application/rss+xml" title="AdBoost Health Blog" href={`${site}/rss.xml`} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  {post ? (
    <article class="post tone-paper" data-nav="paper">
      <header class="post-head wrap">
        <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Blog', href: '/blog/' }, { label: displayTitle }]} />
        <div class="post-meta-top arrive">
          <a class="all-link" href="/blog/">All articles</a>
          {category && <span class="label">{category}</span>}
        </div>
        <h1 class="post-h">{displayTitle}</h1>
        <div class="byline arrive" style="--d:160ms">
          <img src={versioned('/people/amir.webp')} alt={post.author} width="44" height="44" loading="eager" />
          <div class="byline-meta">
            <b>{post.author}</b>
            <span>{post.authorTitle}</span>
          </div>
          <span class="byline-date"><time datetime={post.pubDate.toISOString()}>{fmt(post.pubDate)}</time>{readMinutes && ` · ${readMinutes} min read`}{post.updatedDate && post.updatedDate.valueOf() > post.pubDate.valueOf() && ` · Updated ${fmt(post.updatedDate)}`}</span>
        </div>
      </header>

      {post.heroImage && (
        <div class="hero-figure wrap arrive" style="--d:240ms">
          <img class="framed" src={`${post.heroImage}?v=2`} alt={post.heroAlt ?? ''} width="1600" height="900" fetchpriority="high" />
        </div>
      )}

      <div class="wrap">
        <div class="prose">
          <slot />
        </div>
      </div>

      {related.length > 0 && (
        <section class="related wrap" aria-labelledby="related-h">
          <h2 id="related-h" class="label">Keep reading</h2>
          <div class="related-grid">
            {related.map((r, i) => (
              <a class="related-card card" href={r.href} data-reveal style={`--i:${i}`}>
                {r.heroImage && <img class="framed" src={`${r.heroImage}?v=2`} alt={r.heroAlt ?? ''} loading="lazy" width="640" height="360" />}
                <h3>{r.title}</h3>
                <p>{r.description}</p>
              </a>
            ))}
          </div>
        </section>
      )}
    </article>
  ) : (
    <slot />
  )}

  {post ? <Closing heading={post.ctaHeading} text={post.ctaText} /> : <Closing />}
</Shell>

<style is:global>
  .post { --col: 760px; padding: calc(var(--nav-h) + clamp(40px, 6vw, 88px)) 0 var(--section); }

  /* --- the post head: trail, category, title, byline --- */
  .post .post-head { display: grid; gap: 18px; justify-items: start; max-width: calc(var(--col) + 2 * var(--pad)); }
  .crumbs { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--fg-2); }
  .crumbs a { transition: color 0.15s; }
  .crumbs a:hover { color: var(--fg); }
  .crumbs .sep { opacity: 0.5; }
  .crumbs .cur { display: none; }
  .crumbs .sep:nth-last-child(2) { display: none; }
  .post-meta-top { display: flex; align-items: center; gap: 20px; }
  .all-link { display: inline-flex; align-items: center; min-height: 44px; font-weight: 500; background: linear-gradient(currentColor, currentColor) 0 calc(100% - 10px) / 100% 1px no-repeat; transition: background-size 0.3s var(--ease-out); }
  .all-link:hover { background-size: 0% 1px; background-position: 100% calc(100% - 10px); }
  .post-h { font-size: clamp(40px, 4.6vw, 68px); line-height: 1.04; text-wrap: balance; }
  .js.motion .post-h { animation: arrive 1s var(--spring-settle) 60ms both; }
  .js.motion.pre .post-h { animation-play-state: paused; }
  .byline { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 14px; margin-top: 6px; }
  .byline img { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; }
  .byline-meta b { display: block; font-weight: 500; line-height: 1.3; }
  .byline-meta span, .byline-date { font-size: 15px; color: var(--fg-2); }
  .byline-date { padding-left: 14px; border-left: 1px solid var(--line); }

  /* --- the hero --- */
  .hero-figure { margin-block: clamp(36px, 4vw, 56px); }
  .hero-figure img { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; }

  /* --- the reading column --- */
  .prose { max-width: var(--col); margin-inline: auto; font-size: clamp(17px, 0.3vw + 16px, 19px); line-height: 1.7; color: var(--fg-2); }
  .prose > * + * { margin-top: 1.1em; }
  .prose h2 { font-size: clamp(28px, 2.8vw, 40px); line-height: 1.12; color: var(--fg); margin-top: 2em; }
  .prose h3 { font: 500 1.12em/1.35 var(--sans); color: var(--fg); margin-top: 1.8em; }
  .prose h2 + *, .prose h3 + * { margin-top: 0.7em; }
  .prose strong { color: var(--fg); font-weight: 500; }
  .prose ul, .prose ol { padding-left: 1.3em; }
  .prose ul { list-style: disc; }
  .prose ol { list-style: decimal; }
  .prose li + li { margin-top: 0.5em; }
  .prose li::marker { color: var(--accent); }
  .prose a { color: var(--fg); text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 1px; text-underline-offset: 3px; transition: text-decoration-color 0.2s; }
  .prose a:hover { text-decoration-color: currentColor; }
  .prose blockquote { padding-left: 1.2em; border-left: 2px solid var(--accent); font: 300 1.25em/1.4 var(--serif); color: var(--fg); }
  .prose blockquote p + p { margin-top: 0.6em; }
  .prose hr { border: 0; border-top: 1px solid var(--line); margin-block: 2.4em; }
  .prose img { border-radius: var(--r-media); }
  .prose code { font-family: var(--mono); font-size: 0.88em; padding: 2px 6px; border-radius: 6px; background: color-mix(in srgb, var(--fg) 7%, transparent); }
  .prose table { width: 100%; border-collapse: collapse; font-size: 0.88em; font-variant-numeric: tabular-nums; }
  .prose th, .prose td { text-align: left; padding: 12px 14px; border-bottom: 1px solid var(--line); vertical-align: top; }
  .prose th { font-weight: 500; color: var(--fg); border-bottom-color: var(--fg-2); }

  /* --- related reads --- */
  .related { margin-top: var(--section); }
  .related > .label { display: block; color: var(--fg-2); margin-bottom: 24px; }
  .related-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(16px, 2vw, 28px); }
  .related-card { display: grid; align-content: start; gap: 12px; padding: 14px 14px 22px; border-radius: var(--r-panel); }
  .related-card img { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; margin-bottom: 6px; }
  .related-card h3 { font-size: clamp(20px, 1.5vw, 24px); color: var(--fg); }
  .related-card p { font-size: 15px; color: var(--fg-2); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  @media (max-width: 900px) {
    .related-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 760px) {
    /* markdown tables scroll inside their own box instead of crushing */
    .prose table { display: block; overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .prose th, .prose td { min-width: 138px; }
    .prose th:first-child, .prose td:first-child { min-width: 42px; }
  }
  @media (max-width: 640px) {
    .byline-date { width: 100%; padding-left: 0; border-left: 0; }
    .related-card p { font-size: 16px; }
  }
</style>

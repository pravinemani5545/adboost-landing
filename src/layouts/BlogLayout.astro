---
import '../styles/global.css';

const CAL_LINK = 'pira-ahilan-ef2dl8/strategy-call';
const CAL_NAMESPACE = 'strategy-call';
const CAL_URL = `https://cal.com/${CAL_LINK}`;

interface RelatedPost {
  href: string;
  title: string;
  description: string;
  heroImage?: string;
  heroAlt?: string;
}

interface Props {
  title: string;
  /** Short SERP title tag (≤60 chars); falls back to title */
  pageTitle?: string;
  description: string;
  canonical: string;
  /** Present on post pages, absent on the blog index */
  post?: {
    pubDate: Date;
    updatedDate?: Date;
    author: string;
    authorTitle: string;
    tags: string[];
    heroImage?: string;
    heroAlt?: string;
    ctaHeading?: string;
    ctaText?: string;
  };
  readMinutes?: number;
  related?: RelatedPost[];
}

const { title, pageTitle, description, canonical, post, readMinutes, related = [] } = Astro.props;
const metaTitle = pageTitle ?? title;
const site = Astro.site?.href.replace(/\/$/, '') ?? 'https://www.adboost.health';

// Social scrapers (Facebook especially) don't render WebP — og images are JPEG copies.
const ogImage = post?.heroImage
  ? `${site}${post.heroImage.replace('/blog/', '/blog/og/').replace('.webp', '.jpg')}`
  : `${site}/og/og-home.png`;

const displayTitleEarly = title.replace(/ \| AdBoost Health$/, '');
const jsonLd = post
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'BlogPosting',
          headline: displayTitleEarly,
          description,
          url: canonical,
          datePublished: post.pubDate.toISOString(),
          dateModified: (post.updatedDate ?? post.pubDate).toISOString(),
          image: ogImage,
          keywords: post.tags.join(', '),
          author: { '@type': 'Person', name: post.author, jobTitle: post.authorTitle, worksFor: { '@id': `${site}/#org` } },
          publisher: { '@type': 'Organization', '@id': `${site}/#org`, name: 'AdBoost Health', url: `${site}/`, logo: { '@type': 'ImageObject', url: `${site}/logos/adboost-mark.png` } },
          mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
        },
        {
          '@type': 'BreadcrumbList',
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
            { '@type': 'ListItem', position: 2, name: 'Blog', item: `${site}/blog/` },
            { '@type': 'ListItem', position: 3, name: displayTitleEarly, item: canonical },
          ],
        },
      ],
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'Blog',
      name: 'AdBoost Health Blog',
      description,
      url: canonical,
      publisher: { '@type': 'Organization', '@id': `${site}/#org`, name: 'AdBoost Health', url: `${site}/` },
    };

const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const displayTitle = title.replace(/ \| AdBoost Health$/, '');
const category = post?.tags[0]?.toUpperCase();
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{metaTitle}</title>
<meta name="description" content={description} />
<meta name="theme-color" content="#ffffff" />
<link rel="canonical" href={canonical} />
<meta property="og:type" content={post ? 'article' : 'website'} />
<meta property="og:title" content={metaTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content="AdBoost Health" />
<meta property="og:image" content={ogImage} />
{post && <meta property="article:published_time" content={post.pubDate.toISOString()} />}
{post && <meta property="article:author" content={post.author} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={metaTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<link rel="alternate" type="application/rss+xml" title="AdBoost Health Blog" href={`${site}/rss.xml`} />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="preconnect" href="https://cal.com" />
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap" />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap" media="print" onload="this.media='all'" />
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap" /></noscript>
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
<script is:inline define:vars={{ CAL_NAMESPACE, CAL_LINK }}>
  (function () {
    let loaded = false;
    function loadCal() {
      if (loaded) return; loaded = true;
      (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if (typeof namespace === "string") { cal.ns[namespace] = cal.ns[namespace] || api; p(cal.ns[namespace], ar); p(cal, ["initNamespace", namespace]); } else p(cal, ar); return; } p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init");
      Cal("init", CAL_NAMESPACE, { origin: "https://cal.com" });
      Cal.ns[CAL_NAMESPACE]("ui", { hideEventTypeDetails: false, layout: "month_view" });
    }
    const triggers = ['pointerdown', 'scroll', 'keydown', 'touchstart'];
    function arm() { triggers.forEach(t => window.addEventListener(t, fire, { once: true, passive: true })); }
    function fire() { triggers.forEach(t => window.removeEventListener(t, fire)); loadCal(); }
    arm();
    if ('requestIdleCallback' in window) window.requestIdleCallback(loadCal, { timeout: 4000 });
    else setTimeout(loadCal, 2500);
  })();
</script>
</head>
<body>

<nav class="nav scrolled" id="nav">
  <div class="container nav-inner">
    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true"></span>
      <span>AdBoost <span style="color:var(--mute);font-weight:400">Health</span></span>
    </a>
    <div class="nav-links">
      <a href="/#why">Why us</a>
      <a href="/#results">Results</a>
      <a href="/#process">Process</a>
      <a href="/blog/">Blog</a>
    </div>
    <div style="display:flex;align-items:center;gap:10px">
      <a class="btn btn-primary" href={CAL_URL} target="_blank" rel="noopener" data-cal-namespace={CAL_NAMESPACE} data-cal-link={CAL_LINK} data-cal-config='{"layout":"month_view"}'>
        Book a call
        <span class="chev">
          <svg width="9" height="9" viewBox="0 0 9 9" fill="none"><path d="M1 4.5h7M5 1l3.5 3.5L5 8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </a>
      <button class="nav-burger" id="burger" aria-label="Open menu" aria-expanded="false" aria-controls="mnav">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M2 4.5h14M2 9h14M2 13.5h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>
</nav>
<div class="mnav" id="mnav">
  <a href="/#why">Why us</a>
  <a href="/#results">Results</a>
  <a href="/#process">Process</a>
  <a href="/#faq">FAQ</a>
  <a href="/blog/">Blog</a>
</div>

<main class="blog-main">
  {post ? (
    <article class="blog-article">
      <header class="post-head container">
        <div class="post-meta-top">
          <a class="all-link" href="/blog/">← All articles</a>
          {category && <span class="cat-chip">{category}</span>}
        </div>
        <h1>{displayTitle}</h1>
        <div class="byline">
          <img src="/people/amir.webp" alt={post.author} width="40" height="40" loading="eager" />
          <div class="byline-meta">
            <b>{post.author}</b>
            <span>{post.authorTitle}</span>
          </div>
          <span class="byline-sep" aria-hidden="true"></span>
          <span class="byline-date"><time datetime={post.pubDate.toISOString()}>{fmt(post.pubDate)}</time>{readMinutes && ` · ${readMinutes} min read`}</span>
        </div>
      </header>

      {post.heroImage && (
        <div class="hero-figure container">
          <img src={post.heroImage} alt={post.heroAlt ?? ''} width="1600" height="900" fetchpriority="high" />
        </div>
      )}

      <div class="prose container">
        <slot />
      </div>

      <section class="cta-banner-wrap container">
        <div class="cta-banner">
          <div class="cta-banner-text">
            <h2>{post.ctaHeading ?? 'Lower CAC. Scale profitably.'}</h2>
            <p>{post.ctaText ?? 'A free 30-minute strategy call with a full account audit — you leave with a written plan, whether we work together or not.'}</p>
          </div>
          <a class="btn btn-light" href={CAL_URL} target="_blank" rel="noopener" data-cal-namespace={CAL_NAMESPACE} data-cal-link={CAL_LINK} data-cal-config='{"layout":"month_view"}'>
            Book a free strategy call
            <span class="chev"><svg width="9" height="9" viewBox="0 0 9 9" fill="none"><path d="M1 4.5h7M5 1l3.5 3.5L5 8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          </a>
        </div>
      </section>

      {related.length > 0 && (
        <section class="related container">
          <h2>Keep reading</h2>
          <div class="related-grid">
            {related.map((r) => (
              <a class="related-card" href={r.href}>
                {r.heroImage && <img src={r.heroImage} alt={r.heroAlt ?? ''} loading="lazy" width="640" height="360" />}
                <div class="related-body">
                  <h3>{r.title}</h3>
                  <p>{r.description}</p>
                  <span class="read-more">Read article →</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}
    </article>
  ) : (
    <div class="container">
      <slot />
    </div>
  )}
</main>

<a class="mobile-cta" id="mcta" href={CAL_URL} target="_blank" rel="noopener" data-cal-namespace={CAL_NAMESPACE} data-cal-link={CAL_LINK} data-cal-config='{"layout":"month_view"}' aria-label="Book a free strategy call">
  <span>Book a free strategy call</span>
  <span class="m-chev"><svg width="10" height="10" viewBox="0 0 9 9" fill="none"><path d="M1 4.5h7M5 1l3.5 3.5L5 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
</a>

<footer>
  <div class="container">
    <div class="foot">
      <div class="foot-brand">
        <a class="brand" href="/"><span class="brand-mark" aria-hidden="true"></span><span>AdBoost <span style="color:rgba(255,255,255,.5);font-weight:400">Health</span></span></a>
        <p class="about">Growth marketing built exclusively for health, telehealth, supplement & wellness brands.</p>
      </div>
      <div class="foot-proof">
        <p class="foot-label">BY THE NUMBERS</p>
        <ul>
          <li><b>71+</b><span>founders served</span></li>
          <li><b>4.9 / 5</b><span>average rating</span></li>
          <li><b>$153M+</b><span>tracked revenue</span></li>
        </ul>
      </div>
      <div class="foot-contact">
        <p class="foot-label">GET IN TOUCH</p>
        <ul>
          <li><a href={CAL_URL} target="_blank" rel="noopener" data-cal-namespace={CAL_NAMESPACE} data-cal-link={CAL_LINK} data-cal-config='{"layout":"month_view"}'>Book a strategy call</a></li>
          <li><a href="mailto:hello@adboost.health">hello@adboost.health</a></li>
          <li><span class="foot-loc">Toronto · Remote-first</span></li>
        </ul>
      </div>
    </div>
    <div class="legal">
      <span>© 2026 AdBoost Health. All rights reserved.</span>
      <span><a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a></span>
    </div>
  </div>
</footer>

<style is:global>
  .blog-main { padding: 108px 0 90px; }

  /* --- centered post header (reference format) --- */
  .post-head { max-width: 760px; text-align: center; }
  .post-meta-top { display: flex; align-items: center; justify-content: center; gap: 12px; margin-bottom: 20px; }
  .all-link { font-size: 13px; color: var(--mute); transition: color .15s; }
  .all-link:hover { color: var(--blue); }
  .cat-chip { font-size: 11px; font-weight: 600; letter-spacing: .06em; color: var(--blue); background: var(--blue-soft); border-radius: 999px; padding: 5px 11px; }
  .post-head h1 { font-size: clamp(30px, 4.6vw, 46px); letter-spacing: -.03em; line-height: 1.1; font-weight: 600; color: var(--ink); margin-bottom: 22px; }
  .byline { display: flex; align-items: center; justify-content: center; gap: 11px; margin-bottom: 40px; }
  .byline img { border-radius: 50%; object-fit: cover; }
  .byline-meta { text-align: left; }
  .byline-meta b { display: block; font-size: 13.5px; color: var(--ink); font-weight: 600; line-height: 1.25; }
  .byline-meta span { font-size: 12px; color: var(--mute); }
  .byline-sep { width: 1px; height: 26px; background: var(--line-2); }
  .byline-date { font-size: 12.5px; color: var(--mute); }

  /* --- hero image on the post itself --- */
  .hero-figure { max-width: 980px; margin-bottom: 48px; }
  .hero-figure img { width: 100%; height: auto; border-radius: var(--radius-lg); border: 1px solid var(--line); box-shadow: var(--shadow); }

  /* --- article column --- */
  .prose { max-width: 720px; font-size: 16.5px; line-height: 1.72; color: var(--ink-2); }
  .prose h2 { font-size: clamp(21px, 2.6vw, 27px); letter-spacing: -.02em; line-height: 1.25; font-weight: 600; color: var(--ink); margin: 44px 0 14px; }
  .prose h3 { font-size: 18px; font-weight: 600; color: var(--ink); margin: 30px 0 10px; }
  .prose p { margin: 0 0 18px; }
  .prose ul, .prose ol { margin: 0 0 18px; padding-left: 24px; }
  .prose li { margin-bottom: 8px; }
  .prose a { color: var(--blue); text-decoration: underline; text-underline-offset: 3px; }
  .prose blockquote { background: var(--blue-soft); border: 1px solid #d8e6ff; border-radius: var(--radius); margin: 26px 0; padding: 16px 20px; color: var(--ink-2); }
  .prose blockquote p:last-child { margin-bottom: 0; }
  .prose table { width: 100%; border-collapse: collapse; margin: 26px 0; font-size: 14.5px; }
  .prose th, .prose td { text-align: left; padding: 10px 14px; border: 1px solid var(--line); }
  .prose th { background: var(--surface); font-weight: 600; color: var(--ink); }
  .prose strong { color: var(--ink); }

  /* --- blue gradient CTA banner (reference format) --- */
  .cta-banner-wrap { max-width: 980px; margin-top: 56px; }
  .cta-banner { display: flex; align-items: center; justify-content: space-between; gap: 26px; flex-wrap: wrap; background: linear-gradient(120deg, #0057ff 0%, #3b7bff 100%); border-radius: var(--radius-lg); padding: 34px 38px; box-shadow: 0 24px 48px -20px var(--blue-glow); }
  .cta-banner-text h2 { font-size: 22px; letter-spacing: -.02em; font-weight: 600; color: #fff; margin-bottom: 6px; }
  .cta-banner-text p { font-size: 14px; color: rgba(255,255,255,.82); max-width: 52ch; }
  .btn-light { background: #fff; color: var(--blue); font-weight: 600; box-shadow: 0 8px 20px -8px rgba(10,10,15,.35); }
  .btn-light:hover { background: #f2f6ff; }
  .btn-light .chev { width: 18px; height: 18px; border-radius: 50%; background: var(--blue-soft); display: grid; place-items: center; transition: transform .2s; }
  .btn-light:hover .chev { transform: translateX(3px); }

  /* --- related posts --- */
  .related { max-width: 980px; margin-top: 64px; }
  .related > h2 { font-size: 22px; letter-spacing: -.02em; font-weight: 600; color: var(--ink); margin-bottom: 22px; }
  .related-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 22px; }
  .related-card { display: flex; flex-direction: column; background: #fff; border: 1px solid var(--line); border-radius: var(--radius-lg); overflow: hidden; transition: transform .18s ease, box-shadow .22s ease, border-color .2s; }
  .related-card:hover { transform: translateY(-3px); box-shadow: var(--shadow); border-color: var(--line-2); }
  .related-card img { width: 100%; aspect-ratio: 16/9; object-fit: cover; border-bottom: 1px solid var(--line); }
  .related-body { padding: 18px 20px 20px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
  .related-body h3 { font-size: 16px; letter-spacing: -.01em; line-height: 1.3; font-weight: 600; color: var(--ink); }
  .related-body p { font-size: 13px; color: var(--mute); line-height: 1.5; flex: 1; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .related-body .read-more { font-size: 13px; font-weight: 500; color: var(--blue); }

  @media (max-width: 640px) {
    .blog-main { padding-top: 96px; }
    .byline { flex-wrap: wrap; row-gap: 6px; }
    .cta-banner { padding: 28px 24px; }
  }
</style>

<script is:inline>
  const nav = document.getElementById('nav');
  window.addEventListener('scroll', () => nav.classList.add('scrolled'), { passive: true });

  // mobile menu
  const burger = document.getElementById('burger');
  const mnav = document.getElementById('mnav');
  if (burger && mnav) {
    burger.addEventListener('click', () => {
      const open = mnav.classList.toggle('open');
      burger.setAttribute('aria-expanded', String(open));
    });
    mnav.addEventListener('click', (e) => { if (e.target.tagName === 'A') mnav.classList.remove('open'); });
  }

  // mobile sticky CTA: show once past the header area, hide over the CTA banner (if present)
  const mcta = document.getElementById('mcta');
  const heroRef = document.querySelector('.hero-figure') || document.querySelector('.byline') || document.querySelector('.blog-head') || document.querySelector('h1');
  const banner = document.querySelector('.cta-banner');
  if (mcta && heroRef) {
    let past = false, over = false;
    const update = () => mcta.classList.toggle('show', past && !over);
    new IntersectionObserver(([e]) => {
      past = !e.isIntersecting && e.boundingClientRect.top < 0; update();
    }, { threshold: 0 }).observe(heroRef);
    if (banner) new IntersectionObserver(([e]) => { over = e.isIntersecting; update(); }, { threshold: 0 }).observe(banner);
  }
</script>

</body>
</html>

---
// Blog index and posts. A thin wrapper over the Shell (skip link, nav, #main, phone CTA, footer)
// that owns the article chrome: header and byline, hero, page index, reading progress, the CTA
// banner and related reading. Styles: src/styles/pages/blog.css.
//
// Tracker contract: the CTA banner's Book link is "inline" for t.js (no nav, .mobile-cta,
// .cta-band or footer ancestor), and the page index is a <nav> that never carries a /book/ link.
import Shell from './Shell.astro';
import { versioned } from '../lib/assets';
import { BOOK_PATH } from '../lib/site';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import '../styles/pages/blog.css';

interface RelatedPost {
  href: string;
  title: string;
  description: string;
  heroImage?: string;
  heroAlt?: string;
  pubDate?: Date;
}

interface Props {
  title: string;
  /** Short SERP title tag (≤60 chars); falls back to title */
  pageTitle?: string;
  description: string;
  canonical: string;
  /** The post's id (its URL slug), on post pages */
  slug?: string;
  /** Present on post pages, absent on the blog index */
  post?: {
    pubDate: Date;
    updatedDate?: Date;
    author: string;
    authorTitle: string;
    tags: string[];
    heroImage?: string;
    heroAlt?: string;
    ctaHeading?: string;
    ctaText?: string;
    itemList?: { name: string; url: string }[];
  };
  readMinutes?: number;
  related?: RelatedPost[];
  /** The post's visible FAQ section (faqFromBody), emitted as FAQPage JSON-LD */
  faq?: { q: string; a: string }[];
  /** The post's h2s for the page index (long posts only; empty hides it) */
  toc?: { id: string; html: string }[];
}

const { title, pageTitle, description, canonical, slug, post, readMinutes, related = [], faq = [], toc = [] } = Astro.props;
const metaTitle = pageTitle ?? title;
const site = Astro.site?.href.replace(/\/$/, '') ?? 'https://www.adboost.health';

// Social scrapers (Facebook especially) don't render WebP - og images are JPEG copies.
const ogImage = post?.heroImage
  ? `${site}${post.heroImage.replace('/blog/', '/blog/og/').replace('.webp', '.jpg')}?v=2`
  : `${site}/og/og-home.png`;

const displayTitleEarly = title.replace(/ \| AdBoost Health$/, '');
const jsonLd = post
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'BlogPosting',
          headline: displayTitleEarly,
          description,
          url: canonical,
          datePublished: post.pubDate.toISOString(),
          dateModified: (post.updatedDate ?? post.pubDate).toISOString(),
          image: ogImage,
          keywords: post.tags.join(', '),
          // @id matches the Person node personNode() emits on /about/ (same slug algorithm),
          // so the author entity reconciles across pages. Author is always Amir Salihovic.
          author: {
            '@type': 'Person',
            '@id': `${site}/about/#${post.author.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')}`,
            name: post.author,
            jobTitle: post.authorTitle,
            url: `${site}/about/`,
            sameAs: ['https://www.linkedin.com/in/amir-salihovic-7b2844157/'],
            worksFor: { '@id': `${site}/#org` },
          },
          publisher: { '@type': 'Organization', '@id': `${site}/#org`, name: 'AdBoost Health', url: `${site}/`, logo: { '@type': 'ImageObject', url: `${site}/logos/adboost-mark.png` } },
          mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
        },
        {
          '@type': 'BreadcrumbList',
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
            { '@type': 'ListItem', position: 2, name: 'Blog', item: `${site}/blog/` },
            { '@type': 'ListItem', position: 3, name: displayTitleEarly, item: canonical },
          ],
        },
        ...(faq.length
          ? [{
              '@type': 'FAQPage',
              '@id': `${canonical}#faq`,
              mainEntity: faq.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
            }]
          : []),
        ...(post.itemList?.length
          ? [{
              '@type': 'ItemList',
              name: displayTitleEarly,
              itemListOrder: 'https://schema.org/ItemListOrderAscending',
              numberOfItems: post.itemList.length,
              itemListElement: post.itemList.map((e, i) => ({
                '@type': 'ListItem',
                position: i + 1,
                item: { '@type': 'Organization', name: e.name, url: e.url },
              })),
            }]
          : []),
      ],
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'Blog',
      name: 'AdBoost Health Blog',
      description,
      url: canonical,
      publisher: { '@type': 'Organization', '@id': `${site}/#org`, name: 'AdBoost Health', url: `${site}/` },
    };

const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const displayTitle = title.replace(/ \| AdBoost Health$/, '');
const category = post?.tags[0]?.toUpperCase();
const updated = post?.updatedDate && post.updatedDate.valueOf() > post.pubDate.valueOf() ? post.updatedDate : undefined;
---

<Shell
  title={metaTitle}
  {description}
  {canonical}
  ogType={post ? 'article' : 'website'}
  ogImage={post?.heroImage ? ogImage : undefined}
  ogImageAlt={post?.heroAlt ?? title}
  article={post ? { publishedTime: post.pubDate.toISOString(), author: post.author } : undefined}
  {jsonLd}
  mainClass="blog-main"
>
  <Fragment slot="head">
    <script is:inline>
      // Card image to post hero morph. A view-transition-name goes only on the one element a
      // navigation needs (the clicked card's image, the post hero) and is cleared after the
      // transition, so no page ever carries a duplicate name. pagereveal must be registered
      // before first render, hence a classic inline script in <head>.
      (() => {
        const slugOf = (u) => { try { const m = new URL(u, location.href).pathname.match(/^\/blog\/([^/]+)\/$/); return m ? m[1] : null; } catch { return null; } };
        const isIndex = (u) => { try { return new URL(u, location.href).pathname === '/blog/'; } catch { return false; } };
        const pick = (here, there) => {
          const to = slugOf(there), from = slugOf(here);
          if (isIndex(here) && to) return [document.querySelector('[data-vt-card="' + CSS.escape(to) + '"]'), to];
          if (from && isIndex(there)) return [document.querySelector('[data-vt-hero]'), from];
          return [null, null];
        };
        const name = (el, slug) => { el.style.viewTransitionName = slug ? 'post-' + slug : ''; el.style.viewTransitionClass = slug ? 'k-post' : ''; };
        addEventListener('pageswap', async (e) => {
          if (!e.viewTransition || !e.activation) return;
          const [el, slug] = pick(location.href, e.activation.entry.url);
          if (!el) return;
          name(el, slug);
          try { await e.viewTransition.finished; } catch {} finally { name(el, null); }
        });
        addEventListener('pagereveal', async (e) => {
          const from = window.navigation && navigation.activation && navigation.activation.from;
          if (!e.viewTransition || !from) return;
          const [el, slug] = pick(location.href, from.url);
          if (!el) return;
          name(el, slug);
          try { await e.viewTransition.ready; } catch {} finally { name(el, null); }
        });
      })();
    </script>
  </Fragment>

  {post ? (
    <article class="blog-article">
      <header class="post-head container">
        <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Blog', href: '/blog/' }, { label: displayTitle }]} />
        <div class="post-meta-top">
          <a class="all-link" href="/blog/">← All articles</a>
          {category && <span class="cat-chip">{category}</span>}
        </div>
        <h1 class="post-title arrive">{displayTitle}</h1>
        <div class="byline arrive" style="--d:60ms">
          <a class="byline-author" href="/about/">
            <img src={versioned('/people/amir.webp')} alt="" width="44" height="44" loading="eager" />
            <span class="byline-who">
              <b>{post.author}</b>
              <span>{post.authorTitle}</span>
            </span>
          </a>
          <dl class="byline-facts">
            <div><dt>Published</dt><dd><time datetime={post.pubDate.toISOString()}>{fmt(post.pubDate)}</time></dd></div>
            {updated && <div><dt>Updated</dt><dd><time datetime={updated.toISOString()}>{fmt(updated)}</time></dd></div>}
            {readMinutes && <div><dt>Read</dt><dd>{readMinutes} min</dd></div>}
          </dl>
        </div>
      </header>

      {post.heroImage && (
        <div class="hero-figure container arrive" style="--d:90ms" data-mcta-anchor>
          <img src={`${post.heroImage}?v=2`} alt={post.heroAlt ?? ''} width="1600" height="900" fetchpriority="high" data-vt-hero={slug} />
        </div>
      )}

      <div class:list={['post-body', 'container', toc.length > 0 && 'has-toc']}>
        <div class="post-progress" aria-hidden="true"><span></span></div>
        {toc.length > 0 && (
          <nav class="post-toc" aria-label="On this page" data-toc>
            <p class="post-toc__title">On this page</p>
            <div class="post-toc__list">
              <span class="post-toc__rail" aria-hidden="true"><span></span></span>
              <ol>
                {toc.map((t) => <li><a href={`#${t.id}`} set:html={t.html} /></li>)}
              </ol>
            </div>
          </nav>
        )}
        <div class="post-prose">
          <slot />
        </div>
      </div>

      <section class="cta-banner-wrap container">
        <div class="cta-banner">
          <div class="cta-banner-text">
            <h2>{post.ctaHeading ?? 'Lower CAC. Scale profitably.'}</h2>
            <p>{post.ctaText ?? 'A free 30-minute strategy call with a full account audit - you leave with a written plan, whether we work together or not.'}</p>
          </div>
          <a class="btn btn-light" href={BOOK_PATH}>
            Book a free strategy call
            <span class="chev"><svg width="9" height="9" viewBox="0 0 9 9" fill="none"><path d="M1 4.5h7M5 1l3.5 3.5L5 8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          </a>
        </div>
      </section>

      {related.length > 0 && (
        <section class="related container" aria-labelledby="related-h">
          <h2 id="related-h">Keep reading</h2>
          <ul class="related-grid">
            {related.map((r, i) => (
              <li data-reveal style={`--i:${i}`}>
                <a class="k-card k-card--link rel-card" href={r.href}>
                  {r.heroImage && (
                    <span class="k-card__media"><img src={`${r.heroImage}?v=2`} alt={r.heroAlt ?? ''} loading="lazy" decoding="async" width="640" height="360" /></span>
                  )}
                  <span class="k-card__body">
                    {r.pubDate && <time class="card-date" datetime={r.pubDate.toISOString()}>{fmt(r.pubDate)}</time>}
                    <h3 class="card-title">{r.title}</h3>
                    <span class="card-desc">{r.description}</span>
                    <span class="read-more">Read article <span aria-hidden="true">→</span></span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </article>
  ) : (
    <div class="container">
      <slot />
    </div>
  )}
</Shell>

<script>
  // Reading progress and the page-index spine where scroll-driven CSS is missing: the same
  // measure blog.css gives animation-timeline (the post body from its top reaching the top of
  // the screen to its bottom reaching the bottom), written to --post-p on .post-body.
  const body = document.querySelector<HTMLElement>('.post-body');
  if (body && !CSS.supports('animation-timeline: view()') && document.documentElement.classList.contains('motion')) {
    let raf = 0;
    const update = () => {
      raf = 0;
      const r = body.getBoundingClientRect();
      const span = r.height - innerHeight;
      const p = span > 0 ? Math.min(1, Math.max(0, -r.top / span)) : r.top < 0 ? 1 : 0;
      body.style.setProperty('--post-p', p.toFixed(4));
    };
    const queue = () => { if (!raf) raf = requestAnimationFrame(update); };
    addEventListener('scroll', queue, { passive: true });
    addEventListener('resize', queue, { passive: true });
    update();
  }
</script>

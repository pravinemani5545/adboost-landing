---
// Blog index and posts on the AdBoost family layer: a port of adboost-media
// src/components/blog/PostPage.astro, in Health's hues. A thin wrapper over the Shell (skip link,
// nav, #main, phone CTA, footer) that owns the article chrome. The index lays out its own sections.
//   hero   full-width band (family Backdrop): crumbs, the back link and category, the H1, the
//          post's opening paragraph in the "In short" box, the byline (author, dates, reading
//          time); from 1180px the hero image in a framed card beside them, with the post's topics
//   body   one 780px reading column; from 1180px the sticky "On this page" rail with its
//          progress line (long posts only). Tables are cards, worked examples callouts, the FAQ
//          numbered cards, diagrams framed figures (src/components/resources/html.ts adds the hooks)
//   end    the author card, the closing card, "Keep reading" on a tinted band
// Styles: src/styles/family/{tokens,content,blog}.css (every rule under .family).
//
// Tracker contract: the closing card's Book link is "inline" for t.js (no nav, .mobile-cta,
// .cta-band or footer ancestor: src/family/blog/PostCta.astro), and the page index is a <nav>
// that never carries a /book/ link.
import Shell from './Shell.astro';
import { versioned } from '../lib/assets';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Backdrop from '../family/Backdrop.astro';
import Toc from '../family/Toc.astro';
import PostCard from '../family/blog/PostCard.astro';
import PostCta from '../family/blog/PostCta.astro';
import { decode } from '../components/resources/html';
import '../styles/family/tokens.css';
import '../styles/family/content.css';
import '../styles/family/blog.css';

interface RelatedPost {
  href: string;
  title: string;
  description: string;
  heroImage?: string;
  heroAlt?: string;
  pubDate?: Date;
  category?: string;
  minutes?: number;
}

interface Props {
  title: string;
  /** Short SERP title tag (≤60 chars); falls back to title */
  pageTitle?: string;
  description: string;
  canonical: string;
  /** The post's id (its URL slug), on post pages */
  slug?: string;
  /** Present on post pages, absent on the blog index */
  post?: {
    pubDate: Date;
    updatedDate?: Date;
    author: string;
    authorTitle: string;
    tags: string[];
    heroImage?: string;
    heroAlt?: string;
    ctaHeading?: string;
    ctaText?: string;
    itemList?: { name: string; url: string }[];
  };
  readMinutes?: number;
  related?: RelatedPost[];
  /** The post's visible FAQ section (faqFromHtml), emitted as FAQPage JSON-LD */
  faq?: { q: string; a: string }[];
  /** The post's h2s for the page index (long posts only; empty hides it) */
  toc?: { id: string; html: string }[];
  /** The post's opening paragraph (rendered HTML), shown under the H1 */
  lead?: string;
}

const { title, pageTitle, description, canonical, slug, post, readMinutes, related = [], faq = [], toc = [], lead = '' } = Astro.props;
const metaTitle = pageTitle ?? title;
const site = Astro.site?.href.replace(/\/$/, '') ?? 'https://www.adboost.health';

// Social scrapers (Facebook especially) don't render WebP - og images are JPEG copies.
const ogImage = post?.heroImage
  ? `${site}${post.heroImage.replace('/blog/', '/blog/og/').replace('.webp', '.jpg')}?v=2`
  : `${site}/og/og-home.png`;

const displayTitleEarly = title.replace(/ \| AdBoost Health$/, '');
const jsonLd = post
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'BlogPosting',
          headline: displayTitleEarly,
          description,
          url: canonical,
          datePublished: post.pubDate.toISOString(),
          dateModified: (post.updatedDate ?? post.pubDate).toISOString(),
          image: ogImage,
          keywords: post.tags.join(', '),
          // @id matches the Person node personNode() emits on /about/ (same slug algorithm),
          // so the author entity reconciles across pages. Author is always Amir Salihovic.
          author: {
            '@type': 'Person',
            '@id': `${site}/about/#${post.author.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')}`,
            name: post.author,
            jobTitle: post.authorTitle,
            url: `${site}/about/`,
            sameAs: ['https://www.linkedin.com/in/amir-salihovic-7b2844157/'],
            worksFor: { '@id': `${site}/#org` },
          },
          publisher: { '@type': 'Organization', '@id': `${site}/#org`, name: 'AdBoost Health', url: `${site}/`, logo: { '@type': 'ImageObject', url: `${site}/logos/adboost-mark.png` } },
          mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
        },
        {
          '@type': 'BreadcrumbList',
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
            { '@type': 'ListItem', position: 2, name: 'Blog', item: `${site}/blog/` },
            { '@type': 'ListItem', position: 3, name: displayTitleEarly, item: canonical },
          ],
        },
        ...(faq.length
          ? [{
              '@type': 'FAQPage',
              '@id': `${canonical}#faq`,
              mainEntity: faq.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
            }]
          : []),
        ...(post.itemList?.length
          ? [{
              '@type': 'ItemList',
              name: displayTitleEarly,
              itemListOrder: 'https://schema.org/ItemListOrderAscending',
              numberOfItems: post.itemList.length,
              itemListElement: post.itemList.map((e, i) => ({
                '@type': 'ListItem',
                position: i + 1,
                item: { '@type': 'Organization', name: e.name, url: e.url },
              })),
            }]
          : []),
      ],
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'Blog',
      name: 'AdBoost Health Blog',
      description,
      url: canonical,
      publisher: { '@type': 'Organization', '@id': `${site}/#org`, name: 'AdBoost Health', url: `${site}/` },
    };

const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const displayTitle = title.replace(/ \| AdBoost Health$/, '');
const category = post?.tags[0]?.toUpperCase();
const updated = post?.updatedDate && post.updatedDate.valueOf() > post.pubDate.valueOf() ? post.updatedDate : undefined;
// The answer box holds the post's opening paragraph (its answer-first summary); Media labels its
// box "The short answer" or "In short". An opening paragraph is a summary, not always an answer.
const ANSWER_LABEL = 'In short';
---

<Shell
  title={metaTitle}
  {description}
  {canonical}
  ogType={post ? 'article' : 'website'}
  ogImage={post?.heroImage ? ogImage : undefined}
  ogImageAlt={post?.heroAlt ?? title}
  article={post ? { publishedTime: post.pubDate.toISOString(), author: post.author } : undefined}
  {jsonLd}
  mainClass="blog-main"
>
  <Fragment slot="head">
    <script is:inline>
      // Card image to post hero morph. A view-transition-name goes only on the one element a
      // navigation needs (the clicked card's image, the post hero) and is cleared after the
      // transition, so no page ever carries a duplicate name. pagereveal must be registered
      // before first render, hence a classic inline script in <head>.
      // The site can be published in a folder (/health/), and a script is not rewritten by the
      // relocate step, so paths are read relative to wherever this page's own /blog/ sits.
      (() => {
        const root = location.pathname.replace(/\/blog\/(?:[^/]+\/)?$/, '');
        const rel = (u) => { try { const p = new URL(u, location.href).pathname; return p.startsWith(root + '/') ? p.slice(root.length) : ''; } catch { return ''; } };
        const slugOf = (u) => { const m = rel(u).match(/^\/blog\/([^/]+)\/$/); return m ? m[1] : null; };
        const isIndex = (u) => /^\/blog\/$/.test(rel(u));
        const pick = (here, there) => {
          const to = slugOf(there), from = slugOf(here);
          if (isIndex(here) && to) return [document.querySelector('[data-vt-card="' + CSS.escape(to) + '"]'), to];
          if (from && isIndex(there)) return [document.querySelector('[data-vt-hero]'), from];
          return [null, null];
        };
        const name = (el, slug) => { el.style.viewTransitionName = slug ? 'post-' + slug : ''; el.style.viewTransitionClass = slug ? 'k-post' : ''; };
        addEventListener('pageswap', async (e) => {
          if (!e.viewTransition || !e.activation) return;
          const [el, slug] = pick(location.href, e.activation.entry.url);
          if (!el) return;
          name(el, slug);
          try { await e.viewTransition.finished; } catch {} finally { name(el, null); }
        });
        addEventListener('pagereveal', async (e) => {
          const from = window.navigation && navigation.activation && navigation.activation.from;
          if (!e.viewTransition || !from) return;
          const [el, slug] = pick(location.href, from.url);
          if (!el) return;
          name(el, slug);
          try { await e.viewTransition.ready; } catch {} finally { name(el, null); }
        });
      })();
    </script>
  </Fragment>

  {post ? (
    <article class:list={['family', 'pg-post', toc.length > 0 && 'pg-has-rail', !post.heroImage && 'post-noimg']}>
      <div class="post-progress" aria-hidden="true"><i></i></div>

      <header class="post-hero" data-spot>
        <Backdrop texture={['dots', 'grid']} spotlight focus={['78%', '34%']} />
        <div class="container post-hero-grid">
          <div class="post-hero-text">
            <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Blog', href: '/blog/' }, { label: displayTitle }]} />
            <p class="post-kicker">
              <a class="post-back" href="/blog/">← All articles</a>
              {category && <span class="post-cat"><span class="k-dot" aria-hidden="true"></span>{category}</span>}
            </p>
            <h1 class="arrive">{displayTitle}</h1>
            {lead && (
              <div class="post-answer arrive" style="--d:60ms">
                <p class="post-answer-lab"><svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M13 2L4.5 13.5H11L10 22l8.5-11.5H12z" /></svg>{ANSWER_LABEL}</p>
                <div class="post-lead" set:html={lead} />
              </div>
            )}
            <div class="byline arrive" style="--d:90ms">
              <a class="who" href="/about/">
                <img src={versioned('/people/amir.webp')} alt="" width="44" height="44" loading="eager" />
                <span class="who-txt">
                  <b class="name">{post.author}</b>
                  <span class="role">{post.authorTitle}</span>
                </span>
              </a>
              <dl class="dates">
                <div><dt>Published</dt><dd><time datetime={post.pubDate.toISOString()}>{fmt(post.pubDate)}</time></dd></div>
                {updated && <div><dt>Updated</dt><dd><time datetime={updated.toISOString()}>{fmt(updated)}</time></dd></div>}
                {readMinutes && <div><dt>Read</dt><dd>{readMinutes} min</dd></div>}
              </dl>
            </div>
          </div>

          {post.heroImage && (
            <div class="post-art arrive" style="--d:120ms" data-mcta-anchor>
              <span class="post-art-plate" aria-hidden="true"></span>
              <div class="post-art-frame">
                <img src={`${post.heroImage}?v=2`} alt={post.heroAlt ?? ''} width="1600" height="900" fetchpriority="high" data-vt-hero={slug} />
                {post.tags.length > 1 && (
                  <ul class="post-tags" aria-label="Topics">
                    {post.tags.map((t) => <li>{t}</li>)}
                  </ul>
                )}
              </div>
            </div>
          )}
        </div>
      </header>

      <div class="container cp-grid post-grid">
        {toc.length > 0 && <div class="cp-toc-cell"><Toc items={toc.map((t) => ({ id: t.id, label: decode(t.html) }))} /></div>}

        <div class="cp-main post-main">
          <div class="post-body"><slot /></div>

          <div class="post-author reveal">
            <img src={versioned('/people/amir.webp')} alt="" width="64" height="64" loading="lazy" decoding="async" />
            <div class="post-author-txt">
              <p class="post-author-lab">Written by</p>
              <p class="post-author-name"><a href="/about/">{post.author}</a></p>
              <p class="post-author-role">{post.authorTitle}</p>
            </div>
          </div>
        </div>

        <section class="cp-cta post-cta">
          <PostCta
            heading={post.ctaHeading ?? 'Lower CAC. Scale profitably.'}
            text={post.ctaText ?? 'A free 30-minute strategy call with a full account audit - you leave with a written plan, whether we work together or not.'}
          />
        </section>
      </div>

      {related.length > 0 && (
        <section class="post-related" aria-labelledby="related-h">
          <div class="container">
            <div class="post-related-head">
              <h2 id="related-h">Keep reading</h2>
              <a class="post-related-all" href="/blog/">All articles <span aria-hidden="true">→</span></a>
            </div>
            <ul class="post-related-grid">
              {related.map((r, i) => (
                <li class:list={['reveal', i > 0 && `d${i}`]}>
                  <PostCard
                    href={r.href}
                    title={r.title}
                    description={r.description}
                    image={r.heroImage}
                    alt={r.heroAlt}
                    date={r.pubDate}
                    category={r.category}
                    minutes={r.minutes}
                    level={3}
                  />
                </li>
              ))}
            </ul>
          </div>
        </section>
      )}
    </article>
  ) : (
    <slot />
  )}
</Shell>

<script is:inline>
  // Reading progress where scroll-driven animations are missing (blog.css draws it with
  // animation-timeline where they exist). Nothing runs for reduced motion or without the bar.
  (function () {
    var bar = document.querySelector('.post-progress i');
    if (!bar || (window.CSS && CSS.supports && CSS.supports('animation-timeline: scroll()'))) return;
    if (!document.documentElement.classList.contains('motion')) return;
    var queued = false;
    function draw() {
      queued = false;
      var max = document.documentElement.scrollHeight - innerHeight;
      bar.style.transform = 'scaleX(' + (max > 0 ? Math.min(1, scrollY / max) : 0) + ')';
    }
    addEventListener('scroll', function () { if (!queued) { queued = true; requestAnimationFrame(draw); } }, { passive: true });
    addEventListener('resize', function () { if (!queued) { queued = true; requestAnimationFrame(draw); } }, { passive: true });
    draw();
  })();
</script>

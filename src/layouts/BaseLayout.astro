---
// The inner-page layout: the system shell with this site's SEO head. Pages still written against the
// pre-redesign components render inside the .legacy wrapper (legacy.css maps them onto the roles);
// run 2 moves them onto the system components.
import Shell from './Shell.astro';
import '../styles/legacy.css';
import { siteBase } from '../lib/site';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;      // e.g. "/industries/telehealth/"
  ogImage?: string;           // absolute path from root, e.g. "/og/og-home.png"
  ogType?: string;
  noindex?: boolean;          // gated/conversion pages (e.g. lead magnets)
  jsonLd?: unknown;           // object or array of schema.org nodes
  /** what sits under the nav at the top of the page */
  nav?: 'frame' | 'paper' | 'media';
}
const { title, description, canonicalPath, ogImage = '/og/og-home.png', ogType = 'website', jsonLd, noindex = false, nav = 'paper' } = Astro.props;
const SITE = siteBase(Astro.site);
const canonical = `${SITE}${canonicalPath}`;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${SITE}${ogImage}`;
const schemaNodes = jsonLd == null ? null : Array.isArray(jsonLd) ? jsonLd : [jsonLd];
---

<Shell nav={nav}>
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="AdBoost Health" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={title} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="AdBoost Health Blog" href={`${SITE}/rss.xml`} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {schemaNodes && <script type="application/ld+json" set:html={JSON.stringify(schemaNodes.length === 1 ? schemaNodes[0] : { '@context': 'https://schema.org', '@graph': schemaNodes })} />}
  </Fragment>
  <div class="legacy tone-paper" data-nav="paper">
    <slot />
  </div>
</Shell>

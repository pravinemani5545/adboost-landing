---
import '../styles/global.css';
import '../styles/interior.css';
import { CAL_LINK, CAL_NAMESPACE, CAL_URL, EMAIL, NAV, siteBase } from '../lib/site';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;      // e.g. "/industries/telehealth/"
  ogImage?: string;           // absolute path from root, e.g. "/og/og-home.png"
  ogType?: string;
  jsonLd?: unknown;           // object or array of schema.org nodes
}
const { title, description, canonicalPath, ogImage = '/og/og-home.png', ogType = 'website', jsonLd } = Astro.props;
const SITE = siteBase(Astro.site);
const canonical = `${SITE}${canonicalPath}`;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${SITE}${ogImage}`;
const schemaNodes = jsonLd == null ? null : Array.isArray(jsonLd) ? jsonLd : [jsonLd];
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="theme-color" content="#ffffff" />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content="AdBoost Health" />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<link rel="canonical" href={canonical} />
<link rel="alternate" type="application/rss+xml" title="AdBoost Health Blog" href={`${SITE}/rss.xml`} />
<link rel="sitemap" href="/sitemap-index.xml" />
{schemaNodes && <script type="application/ld+json" set:html={JSON.stringify(schemaNodes.length === 1 ? schemaNodes[0] : { '@context': 'https://schema.org', '@graph': schemaNodes })} />}
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="preconnect" href="https://cal.com" />
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap" />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap" media="print" onload="this.media='all'" />
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap" /></noscript>
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<script is:inline define:vars={{ CAL_NAMESPACE, CAL_LINK }}>
  (function () {
    let loaded = false;
    function loadCal() {
      if (loaded) return; loaded = true;
      (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if (typeof namespace === "string") { cal.ns[namespace] = cal.ns[namespace] || api; p(cal.ns[namespace], ar); p(cal, ["initNamespace", namespace]); } else p(cal, ar); return; } p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init");
      Cal("init", CAL_NAMESPACE, { origin: "https://cal.com" });
      Cal.ns[CAL_NAMESPACE]("ui", { hideEventTypeDetails: false, layout: "month_view" });
    }
    const triggers = ['scroll', 'keydown', 'mousemove'];
    function fire() { triggers.forEach(t => window.removeEventListener(t, fire)); loadCal(); }
    triggers.forEach(t => window.addEventListener(t, fire, { once: true, passive: true }));
    if ('requestIdleCallback' in window) window.requestIdleCallback(loadCal, { timeout: 4000 });
    else setTimeout(loadCal, 2500);
  })();
</script>
<script defer src="https://admin.adboost.health/t.js"></script>
</head>
<body>

<a href="#main" class="skip-link">Skip to content</a>

<!-- NAV -->
<nav class="nav scrolled" id="nav">
  <div class="container nav-inner">
    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true"></span>
      <span>AdBoost <span style="color:var(--mute);font-weight:400">Health</span></span>
    </a>
    <div class="nav-links" id="navLinks">
      {NAV.map((item) => (
        item.children ? (
          <div class="nav-group">
            <a href={item.href} class="nav-top">{item.label}
              <svg class="nav-caret" width="9" height="9" viewBox="0 0 9 9" fill="none" aria-hidden="true"><path d="M1.5 3l3 3 3-3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <div class="nav-menu">
              {item.children.map((c) => <a href={c.href}>{c.label}</a>)}
            </div>
          </div>
        ) : (
          <a href={item.href} class="nav-top">{item.label}</a>
        )
      ))}
    </div>
    <div style="display:flex;align-items:center;gap:10px">
      <a class="btn btn-primary" href={CAL_URL} target="_blank" rel="noopener" data-cal-namespace={CAL_NAMESPACE} data-cal-link={CAL_LINK} data-cal-config='{"layout":"month_view"}'>
        Book a call
        <span class="chev"><svg width="9" height="9" viewBox="0 0 9 9" fill="none" aria-hidden="true"><path d="M1 4.5h7M5 1l3.5 3.5L5 8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
      </a>
      <button class="nav-burger" id="burger" aria-label="Open menu" aria-expanded="false" aria-controls="mnav">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M2 4.5h14M2 9h14M2 13.5h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>
</nav>
<div class="mnav" id="mnav">
  {NAV.map((item) => (
    <>
      <a href={item.href} class="mnav-top">{item.label}</a>
      {item.children && <div class="mnav-sub">{item.children.map((c) => <a href={c.href}>{c.label}</a>)}</div>}
    </>
  ))}
</div>

<main id="main">
  <slot />
</main>

<!-- MOBILE STICKY CTA -->
<a class="mobile-cta" href={CAL_URL} target="_blank" rel="noopener" data-cal-namespace={CAL_NAMESPACE} data-cal-link={CAL_LINK} data-cal-config='{"layout":"month_view"}' aria-label="Book a free strategy call">
  <span>Book a free strategy call</span>
  <span class="m-chev"><svg width="10" height="10" viewBox="0 0 9 9" fill="none" aria-hidden="true"><path d="M1 4.5h7M5 1l3.5 3.5L5 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
</a>

<!-- FOOTER -->
<footer>
  <div class="container">
    <div class="foot foot-expanded">
      <div class="foot-brand">
        <a class="brand" href="/"><span class="brand-mark" aria-hidden="true"></span><span>AdBoost <span style="color:rgba(255,255,255,.5);font-weight:400">Health</span></span></a>
        <p class="about">Growth marketing built exclusively for health, telehealth, GLP-1, supplement & wellness brands.</p>
        <div class="foot-meta"><span class="foot-chip"><span class="ldot"></span>Booking 4 founders this month</span></div>
      </div>
      <div class="foot-col">
        <p class="foot-label">SERVICES</p>
        <ul>
          <li><a href="/services/paid-media/">Paid media</a></li>
          <li><a href="/services/creative/">Creative production</a></li>
          <li><a href="/services/cro/">CRO & funnels</a></li>
          <li><a href="/services/compliance/">Compliance review</a></li>
        </ul>
      </div>
      <div class="foot-col">
        <p class="foot-label">INDUSTRIES</p>
        <ul>
          <li><a href="/industries/glp-1-weight-loss/">GLP-1 & weight loss</a></li>
          <li><a href="/industries/telehealth/">Telehealth</a></li>
          <li><a href="/industries/supplements-dtc/">Supplements & DTC</a></li>
          <li><a href="/industries/">All industries</a></li>
        </ul>
      </div>
      <div class="foot-col">
        <p class="foot-label">RESOURCES</p>
        <ul>
          <li><a href="/benchmarks/">CAC benchmarks</a></li>
          <li><a href="/advertising/">Ad compliance</a></li>
          <li><a href="/tools/">Free tools</a></li>
          <li><a href="/glossary/">Glossary</a></li>
          <li><a href="/blog/">Blog</a></li>
        </ul>
      </div>
      <div class="foot-col">
        <p class="foot-label">GET IN TOUCH</p>
        <ul>
          <li><a href={CAL_URL} target="_blank" rel="noopener" data-cal-namespace={CAL_NAMESPACE} data-cal-link={CAL_LINK} data-cal-config='{"layout":"month_view"}'>Book a strategy call</a></li>
          <li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
          <li><span class="foot-loc">Toronto · Remote-first</span></li>
        </ul>
      </div>
    </div>
    <div class="legal">
      <span>© 2026 AdBoost Health. All rights reserved.</span>
      <span><a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a></span>
    </div>
  </div>
</footer>

<script is:inline>
  // sticky nav shadow
  const nav = document.getElementById('nav');
  const onScroll = () => nav && nav.classList.toggle('elevated', window.scrollY > 6);
  window.addEventListener('scroll', onScroll, { passive: true }); onScroll();

  // mobile menu
  const burger = document.getElementById('burger');
  const mnav = document.getElementById('mnav');
  if (burger && mnav) {
    burger.addEventListener('click', () => {
      const open = mnav.classList.toggle('open');
      burger.setAttribute('aria-expanded', String(open));
    });
    mnav.addEventListener('click', (e) => { if (e.target.tagName === 'A') mnav.classList.remove('open'); });
  }

  // reveal on scroll
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
  }, { threshold: .12, rootMargin: '0px 0px -40px 0px' });
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));

  // svg line draw
  const drawIO = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (!e.isIntersecting) return;
      const el = e.target;
      try { const len = el.getTotalLength ? el.getTotalLength() : 800; el.style.setProperty('--len', len.toFixed(1)); el.getBoundingClientRect(); } catch (_) {}
      el.classList.add('in'); drawIO.unobserve(el);
    });
  }, { threshold: .25 });
  document.querySelectorAll('.drawline').forEach(el => drawIO.observe(el));

  // FAQ accordions (any .faq-list on the page)
  document.querySelectorAll('.faq-list .qa').forEach(qa => {
    const btn = qa.querySelector('button');
    if (btn) btn.addEventListener('click', () => {
      const open = qa.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(open));
    });
  });

  // mobile sticky CTA: show after scrolling past the first viewport, hide near footer CTA
  const mcta = document.querySelector('.mobile-cta');
  if (mcta) {
    const onS = () => mcta.classList.toggle('show', window.scrollY > 620);
    window.addEventListener('scroll', onS, { passive: true }); onS();
  }

  // scroll-spy: highlight the active section in the "On this page" sidebar
  const toc = document.querySelector('.aside-toc');
  if (toc) {
    const links = new Map();
    toc.querySelectorAll('a[href^="#"]').forEach((a) => links.set(a.getAttribute('href').slice(1), a));
    const targets = [...links.keys()].map((id) => document.getElementById(id)).filter(Boolean);
    let current = null;
    const spy = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) current = e.target.id; });
      links.forEach((a) => a.classList.remove('active'));
      if (current && links.get(current)) links.get(current).classList.add('active');
    }, { rootMargin: '-88px 0px -70% 0px', threshold: 0 });
    targets.forEach((t) => spy.observe(t));
  }
</script>

<slot name="scripts" />
</body>
</html>

---
// Interior pages. A thin wrapper over the Shell; the Props API is unchanged.
import Shell from './Shell.astro';

interface Props {
  title: string;
  description?: string;      // omitted when a data record has no hand-written metaDescription yet
  canonicalPath: string;      // e.g. "/industries/telehealth/"
  ogImage?: string;           // absolute path from root; default: the page's card (src/lib/og.ts)
  ogType?: string;
  noindex?: boolean;          // gated/conversion pages (e.g. lead magnets)
  jsonLd?: unknown;           // object or array of schema.org nodes
  hideNewsletterPopup?: boolean;
}
const { title, description, canonicalPath, ogImage, ogType = 'website', jsonLd, noindex = false, hideNewsletterPopup = false } = Astro.props;
---
<Shell
  {title}
  {description}
  {canonicalPath}
  {ogImage}
  {ogType}
  {jsonLd}
  robots={noindex ? 'noindex, nofollow' : undefined}
  popup={!hideNewsletterPopup}
>
  <slot />
  <slot name="scripts" slot="scripts" />
</Shell>

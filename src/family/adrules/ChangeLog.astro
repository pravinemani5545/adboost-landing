---
// A dated change log on the family layer: the "What changed" notes of a rule sheet and the change
// log of a platform hub (the same entries, order and source links as the kit Timeline log they
// replace, src/components/adv/ChangeLog.astro). A window card: one row per entry with its date as
// the data has it (YYYY-MM stays a month), its badge and its text, then the caption and the
// sources line. Entries render in the order given: pass newest first.
import Pill from '../graphics/Pill.astro';
import type { Tone } from '../graphics/types';

interface Entry { date: string; text: string; badge?: string; tone?: Tone; sources?: { label: string; url: string }[] }
interface Props { entries: Entry[]; caption: string; sourcesLabel?: string; class?: string }
const { entries, caption, sourcesLabel = 'Sources', class: cls } = Astro.props;
const sources = [...new Map(entries.flatMap((e) => e.sources ?? []).map((s) => [s.url, s])).values()];
---
<div class:list={['adr-log', 'reveal', cls]}>
  <div class="cp-bar" aria-hidden="true"><span class="cp-dots"><i></i><i></i><i></i></span><span class="cp-bar-ghost"><i></i><i></i></span></div>
  <ol class="adr-log-list">
    {entries.map((e, i) => (
      <li style={`--i:${i}`}>
        <span class="adr-log-when"><span class="adr-log-dot" aria-hidden="true"></span><time datetime={e.date}>{e.date}</time></span>
        <div class="adr-log-body">
          {e.badge && <Pill text={e.badge} tone={e.tone ?? ''} />}
          <p>{e.text}</p>
        </div>
      </li>
    ))}
  </ol>
  <div class="adr-log-foot">
    <p class="adr-log-cap">{caption}</p>
    {sources.length > 0 && (
      <p class="adr-log-src">
        <span class="cp-k">{sourcesLabel}</span>
        {sources.map((s, i) => (
          <>{i > 0 && <span class="adr-sep" aria-hidden="true">·</span>}<a href={s.url} target="_blank" rel="noopener">{s.label}</a></>
        ))}
      </p>
    )}
  </div>
</div>

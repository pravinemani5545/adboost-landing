---
// Platform hub hero (/advertising/meta/, /advertising/google/): the platform's status for each of
// the five verticals, as a product list (vertical, status badge), with the chip restating the
// "Rules checked" line. Decorative (aria-hidden): the status card in the body holds the same data,
// linked to each rule sheet.
import Win from '../graphics/Win.astro';
import Chip from '../graphics/Chip.astro';
import Ic from '../graphics/Ic.astro';
import Badge from './Badge.astro';
import { LEGEND, PLATFORM_ICON } from './status';
import type { Platform, PolicyStatus } from '../../data/adPolicies';

interface Props { platform: Platform; title: string; rows: { label: string; status: PolicyStatus }[]; checked: string }
const { platform, title, rows, checked } = Astro.props;
---
<div class="adr-pp" aria-hidden="true">
  <Win name={title}>
    <div class="adr-pp-head"><span class="ui-ic g"><Ic name={PLATFORM_ICON[platform]} /></span><b>{platform}</b></div>
    <ul class="adr-pp-rows">
      {rows.map((r, i) => (
        <li style={`--i:${i}`}><span class="adr-pp-ic">{r.label.charAt(0)}</span><span class="adr-pp-name">{r.label}</span><Badge status={r.status} /></li>
      ))}
    </ul>
    <ul class="adr-pm-legend">
      {LEGEND.map((l) => <li data-level={l.level}><span class="adr-badge-m">{l.mark}</span>{l.label}</li>)}
    </ul>
  </Win>
  <Chip title="Rules checked" label={checked} icon="shield" style="right:-26px;bottom:-32px" />
</div>

---
// A link shown as a small card (port of adboost-media src/components/site/LinkCard.astro):
// related reading, the other services, definitions and tools. An icon tile says what kind of
// page it opens; the label and note carry the meaning, so the icon is hidden from assistive
// technology. The kind is read from the path, or passed with `kind`.
interface Props {
  href: string;
  label: string;
  note?: string;
  kind?: Kind;
}
type Kind = 'post' | 'tool' | 'term' | 'audience' | 'service' | 'rules' | 'compare' | 'page';
const { href, label, note } = Astro.props;
const kind: Kind = Astro.props.kind ?? (
  /\/blog\//.test(href) ? 'post'
  : /\/tools\//.test(href) ? 'tool'
  : /\/glossary\//.test(href) ? 'term'
  : /\/industries\//.test(href) ? 'audience'
  : /\/services\//.test(href) ? 'service'
  : /\/advertising\//.test(href) ? 'rules'
  : /\/compare\//.test(href) ? 'compare'
  : 'page');
const PATHS: Record<Kind, string> = {
  post: '<path d="M6 3.5h8.5L18 7v13.5H6z"/><path d="M14 3.5V7h4M9 11h6M9 14.5h6M9 18h3.5"/>',
  tool: '<rect x="5" y="3.5" width="14" height="17" rx="2.5"/><path d="M8.5 7.5h7M8.5 11.5h1M12 11.5h1M15.5 11.5h0M8.5 15h1M12 15h1M15.5 15v2.5"/>',
  term: '<path d="M5 5.5A2 2 0 0 1 7 3.5h12v14H7a2 2 0 0 0-2 2z"/><path d="M5 19.5a2 2 0 0 0 2 2h12v-4"/>',
  audience: '<rect x="4" y="4" width="6.5" height="6.5" rx="1.6"/><rect x="13.5" y="4" width="6.5" height="6.5" rx="1.6"/><rect x="4" y="13.5" width="6.5" height="6.5" rx="1.6"/><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.6"/>',
  service: '<path d="M12 3.5 14 9l5.5 1.5L15 14l1 6-4-3-4 3 1-6-4.5-3.5L10 9z"/>',
  rules: '<path d="M12 3.5 19 6v5.5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/><path d="m9 12 2.2 2.2L15.5 10"/>',
  compare: '<path d="M7 4v16M17 4v16M4 8h6M14 16h6"/>',
  page: '<path d="M5 12h14M13 6l6 6-6 6"/>',
};
---
<a href={href} class="lc" data-kind={kind} data-k-light>
  <span class="lc-ic" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={PATHS[kind]} /></span>
  <span class="lc-txt">
    <span class="lc-label">{label}</span>
    {note && <span class="lc-note">{note}</span>}
  </span>
  <svg class="lc-go" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" /></svg>
</a>

<style>
  .lc { position: relative; isolation: isolate; display: flex; align-items: flex-start; gap: 14px; height: 100%; min-height: 72px; padding: 16px 18px 16px 16px; border-radius: 18px; background: #fff; color: var(--text); box-shadow: var(--shadow-stack); transition: transform .3s var(--ease), box-shadow .3s; }
  .lc:hover { transform: translateY(-3px); box-shadow: var(--shadow-stack), 0 30px 56px -36px rgb(var(--hue-b) / .7); }
  .lc:focus-visible { outline: 2px solid var(--k-accent); outline-offset: 3px; }
  .lc-ic { position: relative; z-index: 1; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 12px; flex-shrink: 0; color: var(--deep-a); background: linear-gradient(135deg, rgb(var(--hue-a) / .13), rgb(var(--hue-b) / .1)); transition: background .3s, color .3s; }
  .lc-ic svg { width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .lc:hover .lc-ic { color: var(--on-grad); background: var(--grad-brand); }
  .lc-txt { position: relative; z-index: 1; min-width: 0; flex: 1; padding-top: 1px; }
  .lc-label { display: block; font-family: var(--font-display); font-size: 15.5px; font-weight: 600; line-height: 1.3; letter-spacing: -.012em; color: var(--text); }
  .lc-note { display: block; margin-top: 4px; font-size: 13.5px; line-height: 1.5; color: var(--text-2); }
  .lc-go { position: relative; z-index: 1; width: 16px; height: 16px; flex-shrink: 0; margin-top: 2px; fill: none; stroke: var(--line-3); stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; transition: transform .25s var(--ease), stroke .25s; }
  .lc:hover .lc-go { stroke: var(--text); transform: translate(2px, -2px); }
  @media (prefers-reduced-motion: reduce) { .lc, .lc-go { transition: none; } .lc:hover { transform: none; } }
</style>

---
// A small schematic drawing of what a service or page works on: a search result for Google,
// a feed post for Meta, a vertical video for TikTok, a landing page, a pulse for health, a
// policy shield, a booking calendar. Shapes only (no words, no numbers), hidden from assistive
// technology. Port of adboost-media src/components/blocks/ServiceGlyph.astro with Health's own
// kinds added. Colours: .fl-glyph rules in src/styles/family/landing.css (--ta = the hue).
export type GlyphKind = 'search' | 'feed' | 'video' | 'page' | 'pulse' | 'flow' | 'shield' | 'calendar';
interface Props { kind: GlyphKind; class?: string }
const { kind, class: cls } = Astro.props;
const DAYS = [0, 1, 2, 3, 4, 5, 6];
---
<svg class:list={['fl-glyph', `fl-glyph-${kind}`, cls]} viewBox="0 0 280 150" fill="none" aria-hidden="true" focusable="false">
  {kind === 'search' && (
    <>
      <rect class="s" x="24" y="16" width="232" height="36" rx="18" />
      <circle class="l" cx="44" cy="33" r="6" /><path class="l" d="M48.5 37.5l4.5 4.5" />
      <rect class="m" x="62" y="29" width="94" height="8" rx="4" />
      <rect class="a caret" x="161" y="25" width="2" height="16" rx="1" />
      <rect class="s lift" x="24" y="64" width="232" height="36" rx="11" />
      <rect class="a" x="35" y="76" width="24" height="12" rx="6" />
      <rect class="m d" x="68" y="73" width="118" height="7" rx="3.5" />
      <rect class="m" x="68" y="85" width="74" height="5" rx="2.5" />
      <rect class="s" x="24" y="108" width="232" height="30" rx="11" opacity=".72" />
      <rect class="m" x="35" y="117" width="96" height="6" rx="3" />
      <rect class="m" x="35" y="127" width="58" height="4" rx="2" />
    </>
  )}
  {kind === 'feed' && (
    <>
      <rect class="s" x="14" y="30" width="46" height="96" rx="12" opacity=".62" />
      <rect class="m" x="22" y="40" width="30" height="34" rx="6" />
      <rect class="s" x="220" y="30" width="46" height="96" rx="12" opacity=".62" />
      <rect class="m" x="228" y="40" width="30" height="34" rx="6" />
      <rect class="s lift" x="72" y="8" width="136" height="134" rx="15" />
      <circle class="at" cx="90" cy="26" r="8" />
      <rect class="m d" x="104" y="20" width="50" height="6" rx="3" />
      <rect class="m" x="104" y="30" width="30" height="5" rx="2.5" />
      <rect class="at" x="82" y="42" width="116" height="62" rx="9" />
      <rect class="a" x="124" y="56" width="32" height="38" rx="9" />
      <circle class="a" cx="140" cy="52" r="6" opacity=".55" />
      <circle class="m d" cx="90" cy="121" r="5" /><circle class="m" cx="104" cy="121" r="5" /><circle class="m" cx="118" cy="121" r="5" />
      <rect class="a beat" x="150" y="113" width="48" height="16" rx="8" />
    </>
  )}
  {kind === 'video' && (
    <>
      <rect class="s" x="52" y="26" width="58" height="104" rx="13" opacity=".6" transform="rotate(-7 81 78)" />
      <rect class="s" x="170" y="26" width="58" height="104" rx="13" opacity=".6" transform="rotate(7 199 78)" />
      <rect class="s lift" x="104" y="6" width="72" height="138" rx="15" />
      <rect class="at" x="110" y="12" width="60" height="126" rx="10" />
      <path class="a" d="M133 61v22l19-11z" />
      <circle class="s" cx="162" cy="92" r="4.5" /><circle class="s" cx="162" cy="106" r="4.5" /><circle class="s" cx="162" cy="120" r="4.5" />
      <rect class="a bar" x="116" y="128" width="40" height="3" rx="1.5" />
    </>
  )}
  {kind === 'page' && (
    <>
      <rect class="s" x="150" y="18" width="108" height="118" rx="12" opacity=".75" />
      <rect class="m" x="164" y="34" width="60" height="7" rx="3.5" />
      <rect class="m" x="164" y="48" width="80" height="34" rx="6" />
      <rect class="m" x="164" y="92" width="46" height="5" rx="2.5" />
      <rect class="al" x="164" y="106" width="52" height="17" rx="8.5" />
      <rect class="s lift" x="24" y="8" width="132" height="134" rx="13" />
      <rect class="m d" x="38" y="24" width="72" height="8" rx="4" />
      <rect class="m" x="38" y="38" width="52" height="6" rx="3" />
      <rect class="at" x="38" y="52" width="104" height="44" rx="7" />
      <rect class="a" x="38" y="106" width="62" height="20" rx="10" />
      <rect class="m" x="108" y="112" width="30" height="7" rx="3.5" />
    </>
  )}
  {kind === 'pulse' && (
    <>
      <rect class="s lift" x="34" y="14" width="212" height="122" rx="14" />
      <circle class="at" cx="62" cy="40" r="12" />
      <path class="al" d="M57 40l4 4 7-8" />
      <rect class="m d" x="84" y="33" width="78" height="7" rx="3.5" />
      <rect class="m" x="84" y="45" width="48" height="5" rx="2.5" />
      <rect class="a beat" x="196" y="32" width="36" height="16" rx="8" />
      <path class="al" d="M50 92h34l10-22 14 42 12-30 8 10h102" />
      <rect class="m" x="50" y="118" width="60" height="5" rx="2.5" />
      <rect class="m" x="118" y="118" width="34" height="5" rx="2.5" />
    </>
  )}
  {kind === 'flow' && (
    <>
      <path class="l" d="M74 75h34M172 75c14 0 14-34 34-34M172 75c14 0 14 34 34 34" />
      <rect class="s lift" x="22" y="56" width="52" height="38" rx="11" />
      <circle class="a beat" cx="48" cy="75" r="7" />
      <rect class="s lift" x="108" y="50" width="64" height="50" rx="13" />
      <rect class="at" x="118" y="60" width="44" height="30" rx="8" />
      <path class="al" d="M131 75l6 6 10-12" />
      <rect class="s" x="206" y="24" width="52" height="34" rx="10" />
      <rect class="m d" x="216" y="34" width="32" height="6" rx="3" /><rect class="m" x="216" y="44" width="20" height="5" rx="2.5" />
      <rect class="s" x="206" y="92" width="52" height="34" rx="10" />
      <rect class="m d" x="216" y="102" width="32" height="6" rx="3" /><rect class="m" x="216" y="112" width="20" height="5" rx="2.5" />
    </>
  )}
  {kind === 'shield' && (
    <>
      <rect class="s" x="24" y="26" width="72" height="22" rx="11" opacity=".85" /><circle class="at" cx="38" cy="37" r="5" /><rect class="m" x="48" y="34" width="36" height="6" rx="3" />
      <rect class="s" x="16" y="62" width="80" height="22" rx="11" opacity=".85" /><circle class="at" cx="30" cy="73" r="5" /><rect class="m" x="40" y="70" width="44" height="6" rx="3" />
      <rect class="s" x="24" y="98" width="72" height="22" rx="11" opacity=".85" /><circle class="at" cx="38" cy="109" r="5" /><rect class="m" x="48" y="106" width="36" height="6" rx="3" />
      <path class="l" d="M96 37c16 0 16 33 32 33M96 73h32M96 109c16 0 16-39 32-39" />
      <path class="s lift" d="M140 18l42 14v32c0 26-18 46-42 56-24-10-42-30-42-56V32z" />
      <path class="a" d="M140 30l30 10v24c0 19-13 34-30 42-17-8-30-23-30-42V40z" />
      <path d="M126 68l10 10 18-20" stroke="#fff" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" fill="none" />
      <path class="l" d="M182 70h28" />
      <rect class="s lift" x="210" y="52" width="56" height="36" rx="11" />
      <circle class="a beat" cx="226" cy="70" r="6" /><rect class="m d" x="238" y="66" width="20" height="8" rx="4" />
    </>
  )}
  {kind === 'calendar' && (
    <>
      <rect class="s lift" x="40" y="10" width="200" height="130" rx="14" />
      <path class="l" d="M40 38h200" />
      <rect class="m d" x="56" y="20" width="60" height="8" rx="4" />
      <circle class="m" cx="208" cy="24" r="5" /><circle class="m" cx="222" cy="24" r="5" />
      {DAYS.map((d) => [0, 1, 2].map((r) => (
        <rect class={d === 4 && r === 1 ? 'a beat' : (d + r) % 3 === 0 ? 'at' : 'm'} x={56 + d * 25} y={52 + r * 28} width="19" height="20" rx="6" />
      )))}
    </>
  )}
</svg>

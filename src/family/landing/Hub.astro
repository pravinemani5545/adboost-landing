---
// Points wired to one core, with a light that leaves one point, passes through the core and
// reaches the next: the family hub of adboost-media src/components/landing/FamilyHub.astro,
// made generic. Three points sit in a triangle (apex up), four in the corners. Labels must
// restate the page the hub sits on. Decorative (aria-hidden): the text beside it carries the
// meaning. On a .fl-dark band it switches to its night look.
interface Node { label: string; sub?: string; img?: string; hue?: 'a' | 'b' | 'c' | 'warm' }
interface Props {
  nodes: Node[];
  core?: 'mark' | 'shield' | 'pulse';
  label?: string;
  class?: string;
}
const { nodes, core = 'mark', label, class: cls } = Astro.props;
const W = 520, H = 380, C = [260, 190];
const AT = nodes.length === 3
  ? [[260, 52], [424, 300], [96, 300]]
  : [[96, 74], [424, 74], [424, 306], [96, 306]];
const HUE = { a: 'var(--hue-a)', b: 'var(--hue-b)', c: 'var(--hue-c)', warm: 'var(--hue-warm)' };
const pts = nodes.map((n, i) => {
  const [x, y] = AT[i];
  const [nx, ny] = AT[(i + 1) % nodes.length];
  return { ...n, x, y, x1: C[0] - x, y1: C[1] - y, x2: nx - x, y2: ny - y, c: HUE[n.hue ?? (['a', 'b', 'c', 'warm'] as const)[i % 4]] };
});
---
<div class:list={['fl-hub', cls]} aria-hidden="true">
  <svg class="fl-hub-svg" viewBox={`0 0 ${W} ${H}`} fill="none">
    <circle class="fl-hub-orbit" cx={C[0]} cy={C[1]} r="150" />
    <circle class="fl-hub-orbit" cx={C[0]} cy={C[1]} r="96" opacity=".7" />
    {pts.map((p) => <path class="fl-hub-wire" d={`M${p.x} ${p.y}L${C[0]} ${C[1]}`} style={`--c:${p.c}`} />)}
    {pts.map((p, i) => <circle class="fl-hub-pkt" cx={p.x} cy={p.y} r="4.5" style={`--x1:${p.x1}px;--y1:${p.y1}px;--x2:${p.x2}px;--y2:${p.y2}px;--c:${p.c};animation-delay:${(i * 6.4) / pts.length}s`} />)}
  </svg>
  {pts.map((p, i) => (
    <span class="fl-hub-node" style={`left:${(p.x / W) * 100}%;top:${(p.y / H) * 100}%;--c:${p.c};--i:${i}`}>
      {p.img ? <img src={p.img} alt="" width="34" height="34" loading="lazy" decoding="async" /> : <i></i>}
      {p.sub ? <span>{p.label}<span class="fl-hub-sub">{p.sub}</span></span> : p.label}
    </span>
  ))}
  <span class="fl-hub-core">
    {core === 'mark' && <span class="brand-mark"></span>}
    {core === 'shield' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5.5c0 4.2-3 7.6-7 9.5-4-1.9-7-5.3-7-9.5V6l7-3z" /><path d="M9 12l2.2 2.2L15.5 10" /></svg>}
    {core === 'pulse' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l2-5 4 10 2-5h6" /></svg>}
  </span>
  {label && <span class="fl-hub-label">{label}</span>}
</div>

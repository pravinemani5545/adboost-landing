---
// /services/paid-media/ hero: the ad account across the three platforms the page runs (its FAQ
// names them: Meta (Facebook/Instagram), Google (Search, PMax, YouTube), TikTok), each with a
// spend band, under the page's own four phases with their printed weeks. Chips restate the
// blended-MER dashboard ("the true-north metric") and Conversions API deduplication from the
// process. Decorative (aria-hidden): every word is on the page; bars are shapes, not values.
import Win from '../Win.astro';
import Row from '../Row.astro';
import Chip from '../Chip.astro';
import Ic from '../Ic.astro';
interface Props { phases: { label: string; meta?: string }[] }
const { phases } = Astro.props;
const NOW = 2; // the phase drawn as running: the scaling phase, between the builds and the ongoing work
---
<div class="pmh" aria-hidden="true">
  <Win name="Paid media" pill={{ text: 'Compliant', tone: 'ok', dot: true }}>
    <ul class="ui-rows pmh-rows">
      <Row name="Meta" sub="Facebook / Instagram" icon="feed" toggle="on" meter={88} i={0} />
      <Row name="Google" sub="Search, PMax, YouTube" icon="search" tone="b" toggle="on" meter={62} i={1} />
      <Row name="TikTok" icon="video" tone="c" toggle="on" meter={40} i={2} />
    </ul>
    <div class="pmh-phases">
      <ol>
        {phases.map((p, i) => (
          <li class:list={[i < NOW && 'is-done', i === NOW && 'is-now']} style={`--i:${i}`}>
            <span class="pmh-mark">{i < NOW ? <Ic name="check" /> : <span class="pmh-n">{i + 1}</span>}</span>
            <span class="pmh-name">{p.label}</span>
            {p.meta && <span class="pmh-wk">{p.meta}</span>}
          </li>
        ))}
      </ol>
    </div>
  </Win>
  <Chip title="Blended MER" label="true-north metric" icon="gauge" style="left:-48px;top:-58px" />
  <Chip title="Conversions API" label="with deduplication" icon="shield" tone="b" style="right:-30px;bottom:-40px" />
</div>

<style>
  .pmh { position: relative; }
  .pmh-rows { padding: 6px 0; }
  .pmh-phases { padding: 14px 16px 16px; border-top: 1px solid var(--line); background: linear-gradient(180deg, var(--bg-2), #fff); }
  .pmh-phases ol { list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin: 0; padding: 0; }
  .pmh-phases li { display: grid; grid-template-columns: 22px minmax(0, 1fr); grid-template-rows: auto auto; gap: 2px 8px; align-items: center; align-content: center; margin: 0; padding: 9px 10px; border-radius: 12px; background: #fff; box-shadow: 0 0 0 1px var(--line), 0 8px 16px -14px rgb(var(--k-shadow-rgb) / .3); }
  .pmh-mark { grid-row: 1 / 3; display: grid; place-items: center; width: 22px; height: 22px; border-radius: 7px; color: var(--mute); background: var(--bg-3); }
  .pmh-mark :global(.gi) { width: 12px; height: 12px; stroke-width: 2.6; }
  .pmh-n { font-family: var(--font-mono); font-size: 10px; font-weight: 500; }
  .is-done .pmh-mark { color: #fff; background: var(--grad-brand); }
  .is-now { box-shadow: 0 0 0 1.5px rgb(var(--hue-a) / .5), 0 14px 26px -16px rgb(var(--hue-a) / .7) !important; }
  .is-now .pmh-mark { color: #fff; background: var(--cp-vivid); }
  .pmh-name { min-width: 0; font-size: 11.5px; font-weight: 600; line-height: 1.25; letter-spacing: -.01em; color: var(--text); text-wrap: balance; }
  .pmh-wk { font-family: var(--font-mono); font-size: 9px; font-weight: 500; letter-spacing: .08em; text-transform: uppercase; color: var(--mute); }
  .is-now .pmh-wk { color: var(--deep-a); }
  :global(.js.motion) .is-now .pmh-mark { animation: pmh-beat 2.4s ease-in-out infinite; }
  @keyframes pmh-beat { 50% { scale: 1.12; } }
  /* first paint: the rows are there at once and settle in under 400ms */
  :global(.js.motion) .pmh-rows :global(.ui-row) { animation: pmh-in .3s var(--ease) backwards; animation-delay: calc(var(--i) * 30ms); }
  @keyframes pmh-in { from { translate: 0 6px; } }
  @media (max-width: 480px) {
    .pmh-phases ol { grid-template-columns: minmax(0, 1fr); }
    .pmh-rows :global(.ui-row) { grid-template-columns: auto minmax(0, 1fr) 26%; padding: 8px 12px; }
    .pmh-rows :global(.ui-tog) { display: none; }
  }
</style>

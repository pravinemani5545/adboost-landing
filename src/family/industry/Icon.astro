---
// One line icon for the industry pages: the family set (src/family/graphics/icons.ts) plus the
// vertical glyphs and a few marks the industry drawings need. Decorative: always aria-hidden.
import { ICONS } from '../graphics/icons';
const EXTRA: Record<string, string> = {
  mic: '<rect x="9" y="3.5" width="6" height="11" rx="3"/><path d="M6 11.5a6 6 0 0 0 12 0M12 17.5v3M9 20.5h6"/>',
  pin: '<path d="M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.3"/>',
  alert: '<path d="M12 4 21 19.5H3z"/><path d="M12 10v4.5M12 17.2h.01"/>',
  info: '<circle cx="12" cy="12" r="8.5"/><path d="M12 11v5M12 8h.01"/>',
  book: '<path d="M5 5.5A2 2 0 0 1 7 3.5h12v14H7a2 2 0 0 0-2 2z"/><path d="M5 19.5a2 2 0 0 0 2 2h12v-4"/>',
  // vertical glyphs (the hub cards and the services tiles)
  scale: '<rect x="4" y="4" width="16" height="16" rx="4.5"/><path d="M8.2 10.5a3.8 3.8 0 0 1 7.6 0"/><path d="m12 10.5 1.7-2.2"/><path d="M9 16h6"/>',
  bottle: '<rect x="7.5" y="8" width="9" height="12.5" rx="2.2"/><path d="M8.5 8V5.5h7V8M9.5 3.5h5"/><path d="M7.5 12.5h9M7.5 16.5h9"/>',
  vial: '<path d="M9.5 3.5h5M10.5 3.5v13a1.5 1.5 0 0 0 3 0v-13"/><path d="M10.5 10.5h3"/><path d="M5 20.5h14"/>',
  syringe: '<path d="m15.5 3.5 5 5M18 6l-9.5 9.5-3-3L15 3"/><path d="m11 9.5 1.5 1.5M8.5 12l1.5 1.5"/><path d="m5.5 15.5-2 2 3 3 2-2"/>',
  chat: '<path d="M4 11a6.5 6 0 0 1 13 0 6.5 6 0 0 1-9.6 5.3L4 17.5l.9-3A5.8 5.8 0 0 1 4 11z"/><path d="M18.5 9.5a5 5 0 0 1 1.4 7.6l.6 2.4-2.8-.9a5.6 5.6 0 0 1-4.7.2"/>',
  heart2: '<path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/><path d="M8.5 11h2l1-2 1.5 4 1-2h1.5"/>',
};
const ALL: Record<string, string> = { ...ICONS, ...EXTRA };
interface Props { name: string; class?: string }
const { name, class: cls } = Astro.props;
---
<svg class:list={['gi', cls]} viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={ALL[name] ?? ALL.target} />

---
// The hero graphic of a calculator page. The working calculator sits right below the hero, so
// this graphic never repeats it (no input fields, no default result): it shows what the page
// explains around the calculator instead, drawn as a product-UI card.
//   cac     what fully-loaded spend is made of (the FAQ's four items), the formula as a chain,
//           and every vertical's typical CAC range on one axis (the calculator shows one at a time)
//   ltv     how the four inputs feed the two answers (LTV:CAC and payback), with the page's own
//           benchmarks for each and retention marked as the biggest lever
//   mer     one conversion claimed by every touch (the page's Meta ad, Google ad and email), so
//           summed platform ROAS over-counts while MER counts it once
//   poas    the formula, then the FAQ's two campaigns with identical ROAS whose margins differ,
//           against 1.0 break-even and the 1.5-2.0 most brands target above
//   budget  the page's caveat: media is not the whole budget; the creative volume that holds a
//           benchmark CAC against the volume that pushes it up
// Every label restates the page; numbers only where the page prints them; bars are shapes.
// Decorative (aria-hidden). It paints complete at first paint (short transform-only entrances,
// under 400ms); chips are hidden below 1080px like every hero chip.
import Win from '../graphics/Win.astro';
import Ic from '../graphics/Ic.astro';
import Chip from '../graphics/Chip.astro';
import type { Tone } from '../graphics/types';

interface Range { label: string; lo: number; hi: number }
type Props = {
  name: string;
  pill?: { text: string; tone?: Tone };
  chip?: { title: string; label?: string; icon: string; tone?: Tone };
} & (
  | { kind: 'cac'; parts: string[]; ranges: Range[]; axis: { max: number; ticks: number[] } }
  | { kind: 'ltv' }
  | { kind: 'mer' }
  | { kind: 'poas' }
  | { kind: 'budget' }
);
const props = Astro.props;
const { name, pill, chip } = props;
const pct = (v: number, of: number) => `${Math.min(100, Math.max(0, (v / of) * 100)).toFixed(1)}%`;
---
<div class={`ch ch-${props.kind}`} aria-hidden="true">
  <Win name={name} pill={pill ?? { text: 'How it works', tone: 'b' }}>
    {props.kind === 'cac' && (
      <>
        <div class="ch-sec">
          <span class="ui-lab">Fully-loaded acquisition spend</span>
          <div class="ch-stack">{props.parts.map((_, i) => <i class={`s${i}`} style={`--i:${i}`}></i>)}</div>
          <ul class="ch-key">{props.parts.map((p, i) => <li><i class={`s${i}`}></i>{p}</li>)}</ul>
        </div>
        <div class="ch-eq">
          <span class="ui-lab ch-eq-lab">Formula</span>
          <span class="ch-t"><Ic name="layers" />Total acquisition spend</span>
          <span class="ch-g"><span class="ch-op">÷</span><span class="ch-t"><Ic name="users" />New customers</span></span>
          <span class="ch-g"><span class="ch-op">=</span><span class="ch-t ch-res">CAC</span></span>
        </div>
        <div class="ch-sec ch-ranges">
          <span class="ui-lab">Benchmarks by vertical</span>
          <ul>
            {props.ranges.map((r, i) => (
              <li style={`--i:${i}`}>
                <span class="ch-rl">{r.label}</span>
                <span class="ch-track"><i style={`left:${pct(r.lo, props.axis.max)};right:calc(100% - ${pct(r.hi, props.axis.max)})`}></i></span>
              </li>
            ))}
          </ul>
          <span class="ch-axis">{props.axis.ticks.map((t) => <span style={`left:${pct(t, props.axis.max)}`}>${t}</span>)}</span>
        </div>
      </>
    )}

    {props.kind === 'ltv' && (
      <div class="ch-tree">
        <ol class="ch-ins">
          <li><span class="ui-ic"><Ic name="tag" /></span>Monthly revenue</li>
          <li><span class="ui-ic b"><Ic name="chart" /></span>Gross margin</li>
          <li class="is-lever"><span class="ui-ic c"><Ic name="refresh" /></span>Months retained<span class="ch-lever">Biggest lever</span></li>
          <li class="is-cac"><span class="ui-ic"><Ic name="target" /></span>CAC</li>
        </ol>
        <svg class="ch-wires" viewBox="0 0 100 200" preserveAspectRatio="none">
          <path d="M0 25 C50 25 50 50 100 50" /><path d="M0 75 C50 75 50 50 100 50" /><path d="M0 125 C50 125 50 50 100 50" /><path d="M0 175 C50 175 50 50 100 50" />
          <path d="M0 25 C50 25 50 150 100 150" class="w2" /><path d="M0 75 C50 75 50 150 100 150" class="w2" /><path d="M0 175 C50 175 50 150 100 150" class="w2" />
        </svg>
        <div class="ch-outs">
          <div class="ch-out">
            <span class="ui-lab">LTV:CAC ratio</span>
            <b>Lifetime value ÷ acquisition cost</b>
            <span class="ch-bench"><Ic name="check" />3:1 or higher</span>
          </div>
          <div class="ch-out is-b">
            <span class="ui-lab">Payback</span>
            <b>CAC ÷ monthly gross profit</b>
            <span class="ch-bench"><Ic name="clock" />Under 12 months</span>
          </div>
        </div>
      </div>
    )}

    {props.kind === 'mer' && (
      <>
        <div class="ch-sec">
          <span class="ui-lab">One patient, three touches</span>
          <div class="ch-claim">
            <ul class="ch-touch">
              <li style="--i:0"><span class="ui-ic"><Ic name="feed" /></span>Meta ad<span class="ui-pill warn">Claims it</span></li>
              <li style="--i:1"><span class="ui-ic b"><Ic name="search" /></span>Google ad<span class="ui-pill warn">Claims it</span></li>
              <li style="--i:2"><span class="ui-ic c"><Ic name="mail" /></span>Email<span class="ui-pill warn">Claims it</span></li>
            </ul>
            <span class="ch-conv"><span class="ui-ic g"><Ic name="user" /></span>Same conversion</span>
          </div>
        </div>
        <div class="ch-vs">
          <div class="ch-vs-col is-bad">
            <span class="ui-lab">Summed platform ROAS</span>
            <span class="ch-bars"><i></i><i></i><i></i></span>
            <span class="ch-note">Over-counts revenue by 30-100%</span>
          </div>
          <div class="ch-vs-col is-ok">
            <span class="ui-lab">MER</span>
            <span class="ch-bars"><i></i></span>
            <span class="ch-note">Can't be double-counted</span>
          </div>
        </div>
        <div class="ch-eq">
          <span class="ui-lab ch-eq-lab">Formula</span>
          <span class="ch-t"><Ic name="chart" />Total revenue</span>
          <span class="ch-g"><span class="ch-op">÷</span><span class="ch-t"><Ic name="layers" />Total marketing spend</span></span>
          <span class="ch-g"><span class="ch-op">=</span><span class="ch-t ch-res">MER</span></span>
        </div>
      </>
    )}

    {props.kind === 'poas' && (
      <>
        <div class="ch-eq">
          <span class="ui-lab ch-eq-lab">Formula</span>
          <span class="ch-t"><Ic name="chart" />Revenue from ads</span>
          <span class="ch-g"><span class="ch-op">×</span><span class="ch-t"><Ic name="tag" />Gross margin</span></span>
          <span class="ch-g"><span class="ch-op">÷</span><span class="ch-t"><Ic name="layers" />Ad spend</span></span>
          <span class="ch-g"><span class="ch-op">=</span><span class="ch-t ch-res">POAS</span></span>
        </div>
        <div class="ch-sec">
          <span class="ui-lab">Two campaigns, identical ROAS</span>
          <div class="ch-camps">
            <div class="ch-plot">
              <span class="ch-line is-target"><b>1.5-2.0 target</b></span>
              <span class="ch-line is-be"><b>1.0 break-even</b></span>
              <div class="ch-pair"><span class="ch-col is-roas" style="--h:92%"></span><span class="ch-col is-poas" style="--h:64%"></span></div>
              <div class="ch-pair"><span class="ch-col is-roas" style="--h:92%"></span><span class="ch-col is-poas is-low" style="--h:24%"></span></div>
            </div>
            <div class="ch-camp-labs"><span>Higher margin</span><span>Lower margin</span></div>
            <ul class="ch-key ch-key-2"><li><i class="k-roas"></i>ROAS</li><li><i class="k-poas"></i>POAS</li></ul>
          </div>
        </div>
      </>
    )}

    {props.kind === 'budget' && (
      <>
        <div class="ch-sec">
          <span class="ui-lab">Media is not the whole budget</span>
          <div class="ch-split"><span class="is-media">Media</span><span class="is-cr">Creative</span></div>
        </div>
        <div class="ch-sec ch-vol">
          <span class="ui-lab">Creatives a month, and what CAC does</span>
          <ul>
            <li class="is-bad" style="--i:0">
              <span class="ch-vol-n"><Ic name="video" />5–10</span>
              <span class="ch-track"><i style="width:96%"></i><b class="ch-bm" style="left:56%"></b></span>
              <span class="ui-pill bad">CAC 40–80% over</span>
            </li>
            <li class="is-ok" style="--i:1">
              <span class="ch-vol-n"><Ic name="video" />30–60</span>
              <span class="ch-track"><i style="width:56%"></i><b class="ch-bm" style="left:56%"></b></span>
              <span class="ui-pill ok">Holds benchmark CAC</span>
            </li>
          </ul>
        </div>
        <div class="ch-eq">
          <span class="ui-lab ch-eq-lab">Formula</span>
          <span class="ch-t"><Ic name="users" />Target new customers</span>
          <span class="ch-g"><span class="ch-op">×</span><span class="ch-t"><Ic name="target" />CAC</span></span>
          <span class="ch-g"><span class="ch-op">=</span><span class="ch-t ch-res">Ad budget</span></span>
        </div>
      </>
    )}
  </Win>
  {chip && <Chip title={chip.title} label={chip.label} icon={chip.icon} tone={chip.tone ?? 'b'} style="right:-26px;bottom:-54px" />}
</div>

<style>
  .ch { position: relative; }
  .ch-sec { display: grid; gap: 9px; padding: 14px 16px; }
  .ch-sec + .ch-sec, .ch-eq + .ch-sec, .ch-sec + .ch-eq, .ch-vs + .ch-eq { border-top: 1px solid var(--line); }

  /* the formula as a chain of terms */
  .ch-eq { display: flex; flex-wrap: wrap; align-items: center; gap: 7px; padding: 12px 16px; background: linear-gradient(180deg, var(--bg-2), #fff); }
  .ch-t { display: inline-flex; align-items: center; gap: 6px; min-height: 30px; padding: 5px 10px 5px 7px; border-radius: 10px; font-size: 12px; font-weight: 600; line-height: 1.25; letter-spacing: -.01em; color: var(--text); background: #fff; box-shadow: 0 0 0 1px var(--line), 0 6px 12px -10px rgb(var(--k-shadow-rgb) / .4); }
  .ch-t :global(.gi) { width: 13px; height: 13px; color: var(--deep-a); }
  .ch-res { padding: 5px 12px; color: #fff; background: var(--cp-vivid); box-shadow: 0 10px 20px -10px rgb(var(--hue-b) / .9), inset 0 1px 0 rgb(255 255 255 / .3); }
  .ch-eq-lab { flex-basis: 100%; margin-bottom: 1px; }
  .ch-g { display: inline-flex; align-items: center; gap: 7px; }
  .ch-op { display: grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; font-family: var(--font-mono); font-size: 12px; color: var(--deep-a); background: #fff; box-shadow: 0 0 0 1px var(--line-2); }

  /* cac: the stacked spend bar and its key */
  .ch-stack { display: flex; gap: 3px; height: 14px; }
  .ch-stack i { display: block; border-radius: 5px; }
  .s0 { flex: 4.2; background: var(--cp-vivid); }
  .s1 { flex: 2.4; background: rgb(var(--hue-b) / .7); }
  .s2 { flex: 1.8; background: rgb(var(--hue-c) / .7); }
  .s3 { flex: 1; background: rgb(var(--hue-a) / .35); }
  .ch-key { list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 5px 12px; margin: 0; padding: 0; }
  .ch-key li { display: flex; align-items: center; gap: 7px; margin: 0; font-size: 11.5px; line-height: 1.3; color: var(--text-2); }
  .ch-key li > i { display: block; flex: 0 0 10px; width: 10px; height: 10px; border-radius: 3px; }
  /* cac: every vertical's typical range on one axis */
  .ch-ranges ul { list-style: none; display: grid; gap: 6px; margin: 0; padding: 0; }
  .ch-ranges li { display: grid; grid-template-columns: 118px minmax(0, 1fr); align-items: center; gap: 10px; margin: 0; }
  .ch-rl { font-size: 11.5px; font-weight: 500; line-height: 1.2; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ch-track { position: relative; display: block; height: 8px; border-radius: 99px; background: var(--bg-3); }
  .ch-track > i { position: absolute; top: 0; bottom: 0; border-radius: inherit; background: linear-gradient(90deg, rgb(var(--hue-a)), rgb(var(--hue-b)) 70%, rgb(var(--hue-c))); }
  .ch-ranges li:nth-child(even) .ch-track > i { background: linear-gradient(90deg, rgb(var(--hue-b) / .8), rgb(var(--hue-c))); }
  .ch-axis { position: relative; display: block; height: 14px; margin-left: 128px; font-family: var(--font-mono); font-size: 9.5px; color: var(--mute); }
  .ch-axis span { position: absolute; top: 0; translate: -50% 0; }
  .ch-axis span:first-child { translate: 0 0; }
  .ch-axis span:last-child { translate: -100% 0; }

  /* ltv: four inputs wired to the two answers */
  .ch-tree { display: grid; grid-template-columns: minmax(0, 1fr) 46px minmax(0, 1fr); align-items: stretch; padding: 16px; }
  .ch-ins { list-style: none; display: grid; grid-template-rows: repeat(4, 1fr); gap: 8px; margin: 0; padding: 0; }
  .ch-ins li { position: relative; display: flex; align-items: center; gap: 8px; margin: 0; padding: 8px 10px 8px 8px; border-radius: 12px; font-size: 12.5px; font-weight: 600; letter-spacing: -.01em; background: #fff; box-shadow: 0 0 0 1px var(--line), 0 8px 16px -14px rgb(var(--k-shadow-rgb) / .35); }
  .ch-ins .ui-ic { width: 26px; height: 26px; border-radius: 8px; }
  .ch-ins .ui-ic :global(.gi) { width: 13px; height: 13px; }
  .ch-ins .is-lever { box-shadow: 0 0 0 1.5px rgb(var(--hue-c) / .6), 0 12px 22px -14px rgb(var(--hue-c) / .8); }
  .ch-lever { position: absolute; right: 8px; top: -9px; padding: 2px 7px; border-radius: 99px; font-family: var(--font-mono); font-size: 8.5px; font-weight: 500; letter-spacing: .08em; text-transform: uppercase; color: #fff; background: linear-gradient(135deg, var(--deep-c), var(--deep-a)); }
  .ch-wires { width: 100%; height: 100%; overflow: visible; }
  .ch-wires path { fill: none; stroke: rgb(var(--hue-a) / .55); stroke-width: 1.5; vector-effect: non-scaling-stroke; }
  .ch-wires .w2 { stroke: rgb(var(--hue-b) / .5); stroke-dasharray: 3 3; }
  .ch-outs { display: grid; grid-template-rows: 1fr 1fr; gap: 10px; }
  .ch-out { display: grid; align-content: center; gap: 5px; padding: 12px; border-radius: 14px; background: radial-gradient(90% 120% at 100% 0%, rgb(var(--hue-a) / .14), transparent 60%), #fff; box-shadow: 0 0 0 1.5px rgb(var(--hue-a) / .4), 0 16px 30px -18px rgb(var(--hue-b) / .8); }
  .ch-out.is-b { background: radial-gradient(90% 120% at 100% 0%, rgb(var(--hue-b) / .14), transparent 60%), #fff; box-shadow: 0 0 0 1px var(--line-2), 0 14px 26px -18px rgb(var(--hue-b) / .6); }
  .ch-out b { font-size: 12.5px; font-weight: 600; line-height: 1.3; letter-spacing: -.01em; }
  .ch-bench { justify-self: start; display: inline-flex; align-items: center; gap: 5px; padding: 3px 8px 3px 6px; border-radius: 99px; font-size: 11px; font-weight: 600; color: var(--ok-ink); background: var(--ok-soft); }
  .is-b .ch-bench { color: var(--deep-b); background: rgb(var(--hue-b) / .12); }
  .ch-bench :global(.gi) { width: 11px; height: 11px; stroke-width: 2.6; }

  /* mer: three touches claiming one conversion, then the two ways of counting it */
  .ch-claim { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 14px; }
  .ch-touch { position: relative; list-style: none; display: grid; gap: 6px; margin: 0; padding: 0; }
  .ch-touch::after { content: ""; position: absolute; right: -9px; top: 17px; bottom: 17px; width: 8px; border: 1.5px solid rgb(var(--hue-a) / .55); border-left: 0; border-radius: 0 8px 8px 0; }
  .ch-touch li { display: grid; grid-template-columns: 24px minmax(0, 1fr) auto; align-items: center; gap: 8px; margin: 0; padding: 6px 8px 6px 6px; border-radius: 11px; font-size: 12px; font-weight: 600; background: #fff; box-shadow: 0 0 0 1px var(--line); }
  .ch-touch .ui-ic { width: 24px; height: 24px; border-radius: 7px; }
  .ch-touch .ui-ic :global(.gi) { width: 12px; height: 12px; }
  .ch-touch .ui-pill { padding: 3px 7px; font-size: 8.5px; }
  .ch-conv { position: relative; display: grid; justify-items: center; gap: 6px; padding: 12px 10px; border-radius: 14px; font-size: 11.5px; font-weight: 600; text-align: center; max-width: 96px; background: #fff; box-shadow: 0 0 0 1.5px rgb(var(--hue-a) / .45), 0 14px 26px -16px rgb(var(--hue-b) / .8); }
  .ch-conv::before { content: ""; position: absolute; right: 100%; top: 50%; width: 6px; height: 1.5px; background: rgb(var(--hue-a) / .55); }
  .ch-vs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--line); }
  .ch-vs-col { display: grid; gap: 8px; align-content: start; padding: 14px 16px; }
  .ch-vs-col + .ch-vs-col { border-left: 1px solid var(--line); }
  .ch-vs-col.is-bad { background: linear-gradient(180deg, rgb(220 38 38 / .035), transparent 80%); }
  .ch-bars { display: flex; gap: 3px; height: 14px; }
  .ch-bars i { display: block; flex: 1; border-radius: 4px; }
  .is-bad .ch-bars i { background: rgb(var(--hue-b) / .55); }
  .is-bad .ch-bars i:nth-child(2) { background: rgb(var(--hue-c) / .6); }
  .is-bad .ch-bars i:nth-child(3) { background: rgb(var(--hue-a) / .45); }
  .is-ok .ch-bars { width: 38%; }
  .is-ok .ch-bars i { background: var(--cp-vivid); }
  .ch-note { font-size: 11.5px; line-height: 1.35; font-weight: 500; color: var(--text-2); }
  .is-bad .ch-note { color: var(--k-bad-ink); }
  .is-ok .ch-note { color: var(--ok-ink); }

  /* poas: same ROAS, different margin */
  .ch-camps { display: grid; gap: 8px; }
  .ch-plot { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 18px; align-items: end; height: 132px; padding: 0 104px 0 8px; border-bottom: 1px solid var(--line-3); }
  .ch-line { position: absolute; left: 0; right: 0; height: 0; border-top: 1.5px dashed var(--line-3); }
  .ch-line b { position: absolute; right: 0; top: -8px; width: 96px; text-align: right; font-family: var(--font-mono); font-size: 9.5px; font-weight: 500; letter-spacing: .04em; color: var(--mute); background: rgb(255 255 255 / .85); padding: 0 3px; }
  .ch-line.is-be { bottom: 34%; border-color: rgb(220 38 38 / .45); }
  .ch-line.is-be b { color: var(--k-bad-ink); }
  .ch-line.is-target { bottom: 52%; border-top-style: solid; border-color: rgb(var(--ok-rgb, 22 163 74) / .45); }
  .ch-line.is-target b { color: var(--ok-ink); }
  .ch-pair { position: relative; z-index: 1; display: flex; align-items: flex-end; justify-content: center; gap: 6px; height: 100%; }
  .ch-col { display: block; width: 30px; height: var(--h); border-radius: 8px 8px 3px 3px; transform-origin: 50% 100%; }
  .ch-col.is-roas { background: rgb(var(--hue-b) / .3); box-shadow: inset 0 0 0 1px rgb(var(--hue-b) / .35); }
  .ch-col.is-poas { background: var(--cp-vivid); box-shadow: 0 10px 18px -10px rgb(var(--hue-b) / .9); }
  .ch-col.is-low { background: linear-gradient(180deg, rgb(220 38 38 / .75), rgb(220 38 38 / .55)); box-shadow: none; }
  .ch-camp-labs { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; padding: 0 104px 0 8px; font-size: 11.5px; font-weight: 600; text-align: center; color: var(--text-2); }
  .ch-key-2 { display: flex; justify-content: center; gap: 16px; }
  .k-roas { background: rgb(var(--hue-b) / .3); box-shadow: inset 0 0 0 1px rgb(var(--hue-b) / .35); }
  .k-poas { background: var(--cp-vivid); }

  /* budget: media and creative, and the creative volume that holds CAC */
  .ch-split { display: grid; grid-template-columns: 2.4fr 1fr; gap: 4px; }
  .ch-split span { display: flex; align-items: center; height: 30px; padding: 0 10px; border-radius: 8px; font-size: 11.5px; font-weight: 600; }
  .ch-split .is-media { color: #fff; background: var(--cp-vivid); }
  .ch-split .is-cr { color: #0e7490; background: rgb(var(--hue-c) / .2); box-shadow: inset 0 0 0 1.5px rgb(var(--hue-c) / .55); }
  .ch-vol ul { list-style: none; display: grid; gap: 8px; margin: 0; padding: 0; }
  .ch-vol li { display: grid; grid-template-columns: 64px minmax(0, 1fr); grid-template-rows: auto auto; align-items: center; gap: 6px 10px; margin: 0; padding: 10px 12px; border-radius: 12px; background: #fff; box-shadow: 0 0 0 1px var(--line); }
  .ch-vol-n { grid-row: 1 / 3; display: grid; justify-items: center; gap: 2px; font-family: var(--font-mono); font-size: 12.5px; font-weight: 500; color: var(--text); }
  .ch-vol-n :global(.gi) { width: 15px; height: 15px; color: var(--deep-a); }
  .ch-vol .ch-track { height: 9px; }
  .ch-vol .ch-track > i { left: 0; }
  .ch-vol .is-bad .ch-track > i { background: linear-gradient(90deg, rgb(var(--hue-b) / .6), rgb(220 38 38 / .7)); }
  .ch-bm { position: absolute; top: -4px; bottom: -4px; width: 2px; margin-left: -1px; border-radius: 2px; background: var(--text); }
  .ch-vol .ui-pill { justify-self: start; padding: 3px 8px; font-size: 8.5px; }

  /* first paint: everything is there at once and settles in under 400ms */
  :global(.js.motion) .ch-ranges li, :global(.js.motion) .ch-touch li, :global(.js.motion) .ch-vol li { animation: ch-in .3s var(--ease) backwards; animation-delay: calc(var(--i, 0) * 25ms); }
